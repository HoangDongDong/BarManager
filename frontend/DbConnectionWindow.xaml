<Window x:Class="QuanLyBar.Client.DbConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kết nối cơ sở dữ liệu" Height="380" Width="550" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#D5E3F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="White">
            <!-- Icon placeholder -->
            <Grid Width="50" Height="50" Margin="10,0" Background="#DDDDDD">
                <TextBlock Text="DB" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#555555"/>
            </Grid>
            <TextBlock Text="Thêm mới/sửa thông tin kết nối cơ sở dữ liệu" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>
        
        <Border Grid.Row="1" Background="#D5E3F5" Margin="0,5,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Radio Buttons -->
                <StackPanel Grid.Column="0" Margin="10">
                    <RadioButton x:Name="rbFirebirdServer" Content="Kết nối tới máy chủ Firebird" Margin="0,0,0,10" Checked="RbConnectionType_Checked"/>
                    <RadioButton x:Name="rbSqlServer" Content="Kết nối tới máy chủ SQL Server" Margin="0,0,0,10" Checked="RbConnectionType_Checked"/>
                    <RadioButton x:Name="rbFile" Content="Kết nối tới file" IsChecked="True" Checked="RbConnectionType_Checked"/>
                </StackPanel>

                <!-- Form -->
                <Grid Grid.Column="1" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Máy chủ:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtServer" Grid.Row="0" Grid.Column="1" Height="25" Margin="0,0,5,5" VerticalContentAlignment="Center"/>
                    <Button x:Name="btnSelectFile" Content="Chọn" Grid.Row="0" Grid.Column="2" Height="25" Margin="0,0,0,5" Background="White" Click="BtnSelectFile_Click"/>

                    <TextBlock Text="Tài khoản:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtUsername" Text="SYSDBA" Grid.Row="1" Grid.Column="1" Height="25" Margin="0,0,5,5" VerticalContentAlignment="Center"/>
                    <Button x:Name="btnConnect" Content="Kết nối" Grid.Row="1" Grid.Column="2" Height="25" Margin="0,0,0,5" Background="White" Click="BtnConnect_Click"/>

                    <TextBlock Text="Mật khẩu:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                    <PasswordBox x:Name="txtPassword" Grid.Row="2" Grid.Column="1" Height="25" Margin="0,0,5,5" VerticalContentAlignment="Center"/>

                    <TextBlock Text="Cơ sở dữ liệu:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtDatabase" Grid.Row="3" Grid.Column="1" Height="25" Margin="0,0,5,5" VerticalContentAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Bottom section -->
        <Grid Grid.Row="2" Margin="10">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="(Đường dẫn tới cơ sở dữ liệu không được chứa ký tự có dấu)" Foreground="Red" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="btnAccept" Content="Chấp nhận" Width="90" Height="30" Margin="0,0,10,0" Background="White" Click="BtnAccept_Click"/>
                    <Button x:Name="btnCancel" Content="Hủy bỏ" Width="90" Height="30" Background="White" Click="BtnCancel_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
