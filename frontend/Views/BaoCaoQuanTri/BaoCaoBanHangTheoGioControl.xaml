<UserControl x:Class="QuanLyBar.Client.Views.BaoCaoQuanTri.BaoCaoBanHangTheoGioControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Loaded="UserControl_Loaded">
    <Grid Background="#7b96b2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <!-- Top Filter Toolbar -->
        <Border Grid.Row="0" Background="#dbe5f1" BorderBrush="#a4bce3" BorderThickness="0,0,0,1" Padding="6,4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Từ ngày" VerticalAlignment="Center" Margin="5,0,5,0" FontWeight="SemiBold" Foreground="#1e3f66"/>
                <DatePicker x:Name="DpTuNgay" Width="110" Height="24" VerticalAlignment="Center"/>

                <TextBlock Text="Đến ngày" VerticalAlignment="Center" Margin="10,0,5,0" FontWeight="SemiBold" Foreground="#1e3f66"/>
                <DatePicker x:Name="DpDenNgay" Width="110" Height="24" VerticalAlignment="Center"/>

                <Button x:Name="BtnReload" Margin="15,0,0,0" Padding="10,2" Height="24" Click="BtnReload_Click"
                        Background="#f0f4fc" BorderBrush="#7096c8" FontWeight="SemiBold" Foreground="#1e3f66" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄" Margin="0,0,5,0"/>
                        <TextBlock Text="Tải dữ liệu (F5)"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Action Bar (F3, Print, Excel) -->
        <Border Grid.Row="1" Background="#c9d9eb" BorderBrush="#9cb8dd" BorderThickness="0,0,0,1" Padding="6,3">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="📁 Lọc (F3):" VerticalAlignment="Center" Margin="5,0,5,0" FontWeight="SemiBold" Foreground="#1e3f66"/>
                    <TextBox x:Name="TxtSearch" Width="180" Height="22" VerticalAlignment="Center" TextChanged="TxtSearch_TextChanged"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnPrintPreview" Margin="4,0" Padding="8,2" Height="22" Background="#f0f4fc" BorderBrush="#7096c8" Click="BtnPrint_Click" ToolTip="Xem trước bản in (Ctrl+Shift+P)">
                        <TextBlock Text="🔍 Xem (Ctrl + Shift + P)" FontSize="11"/>
                    </Button>
                    <Button x:Name="BtnPrint" Margin="4,0" Padding="8,2" Height="22" Background="#f0f4fc" BorderBrush="#7096c8" Click="BtnPrint_Click" ToolTip="In ấn (Ctrl+P)">
                        <TextBlock Text="🖨 In (Ctrl + P)" FontSize="11"/>
                    </Button>
                    <Button x:Name="BtnExcel" Margin="4,0" Padding="8,2" Height="22" Background="#f0f4fc" BorderBrush="#7096c8" Click="BtnExcel_Click" ToolTip="Xuất tập tin Excel/CSV (F12)">
                        <TextBlock Text="📊 (F12)" FontSize="11"/>
                    </Button>
                    
                    <Separator Width="1" Height="16" Margin="6,0" Background="#b0c4de"/>

                    <Button x:Name="BtnThietKeMau" Style="{StaticResource ActionButtonStyle}" Click="BtnThietKeMau_Click" ToolTip="Thiết kế mẫu bao cao" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#127912;" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Thiết kế mẫu" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Separator Width="1" Height="16" Margin="6,0" Background="#b0c4de"/>

                    <Button x:Name="BtnThamSoTuyChinh" Style="{StaticResource ActionButtonStyle}" Click="BtnThamSoTuyChinh_Click" ToolTip="Tham số tùy chỉnh báo cáo" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#9881;" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Tham số" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Separator Width="1" Height="16" Margin="6,0" Background="#b0c4de"/>

                    <Button x:Name="BtnXemDuLieuTho" Style="{StaticResource ActionButtonStyle}" Click="BtnXemDuLieuTho_Click" ToolTip="Xem du lieu tho dang luoi" Margin="0,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#128203;" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Dữ liệu thô" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Area with Left Sidebar Parameter Box -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Parameter Box -->
            <Border Grid.Column="0" Background="#f4f7fc" BorderBrush="#9cb8dd" BorderThickness="0,0,1,0" Padding="10">
                <StackPanel>
                    <Border Background="#e3eaf5" BorderBrush="#b0c4de" BorderThickness="1" CornerRadius="2" Padding="6,4" Margin="0,0,0,10">
                        <TextBlock Text="Tham số báo cáo" FontWeight="Bold" Foreground="#1e3f66" FontSize="12"/>
                    </Border>
                    <TextBlock Text="Từ ngày:" Margin="0,4,0,2" Foreground="#333" FontSize="11"/>
                    <DatePicker x:Name="SideTuNgay" Height="24" Margin="0,0,0,8" SelectedDateChanged="SideDate_SelectedDateChanged"/>

                    <TextBlock Text="Đến ngày:" Margin="0,4,0,2" Foreground="#333" FontSize="11"/>
                    <DatePicker x:Name="SideDenNgay" Height="24" Margin="0,0,0,15" SelectedDateChanged="SideDate_SelectedDateChanged"/>

                    <Button Padding="8,4" Background="#337ab7" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Click="BtnReload_Click" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" Margin="0,0,5,0"/>
                            <TextBlock Text="Tải dữ liệu (F5)"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Right Main Report Paper View -->
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="20">
                <Border x:Name="ReportPaper" Background="White" Width="780" HorizontalAlignment="Center" Margin="0,0,0,20"
                        BorderBrush="#333333" BorderThickness="1" CornerRadius="1">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Opacity="0.35" BlurRadius="12" ShadowDepth="4"/>
                    </Border.Effect>

                    <Grid Margin="35,25,35,30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header: Logo, Company info -->
                            <RowDefinition Height="Auto"/> <!-- Title & Subtitle Filter -->
                            <RowDefinition Height="Auto"/> <!-- Table Content -->
                            <RowDefinition Height="Auto"/> <!-- Footer: Signatures -->
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Company Logo -->
                            <Grid Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="70" Height="70">
                                <Image x:Name="ImgLogo" Stretch="Uniform" Visibility="Collapsed"/>
                                <Viewbox x:Name="VbDefaultLogo" Width="60" Height="60">
                                <Canvas Width="64" Height="64">
                                    <Path Data="M32 2 L38 22 L59 22 L42 35 L48 55 L32 42 L16 55 L22 35 L5 22 L26 22 Z" Fill="#444444"/>
                                    <Path Data="M20 45 L32 58 L44 45" Stroke="#333333" StrokeThickness="2" Fill="Transparent"/>
                                    <Path Data="M28 20 L36 20" Stroke="#333333" StrokeThickness="2"/>
                                </Canvas>
                            </Viewbox>
                            </Grid>

                            <!-- Company Details -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock x:Name="TxtCompanyName" Text="NÀNG HƯƠNG QUÁN" FontSize="15" FontWeight="Bold" Foreground="#000" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="TxtCompanyAddress" Text="Địa chỉ: Số 28 Giang Văn Minh - Đội Cấn - Ba Đình - Hà Nội" FontSize="11" Foreground="#333" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                <TextBlock x:Name="TxtCompanyContact" Text="Điện thoại: 0909090880   Email:" FontSize="11" Foreground="#333" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Title & Date -->
                        <StackPanel Grid.Row="1" Margin="0,5,0,15">
                            <TextBlock Text="BÁO CÁO BÁN HÀNG THEO GIỜ VÀO" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#000"/>
                            <TextBlock x:Name="TxtFilterSummary" Text="Từ ngày 01/09/2026 Đến ngày 08/09/2026" FontSize="12" FontStyle="Italic" HorizontalAlignment="Center" Foreground="#444" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- Report Table Container -->
                        <StackPanel x:Name="PnlReportContent" Grid.Row="2" Margin="0,5,0,15">
                            <!-- Dynamic content generated in Code-behind -->
                        </StackPanel>

                        <!-- Footer Signatures -->
                        <Grid Grid.Row="3" Margin="0,25,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center" Width="200">
                                <TextBlock x:Name="TxtSignDate" Text="Ngày 08 tháng 09 năm 2026" FontSize="11" FontStyle="Italic" HorizontalAlignment="Center"/>
                                <TextBlock Text="Người lập" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock Text="(Ký, họ tên)" FontSize="10" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,2,0,45"/>
                            </StackPanel>
                        </Grid>
</Grid>
                </Border>
            </ScrollViewer>
        </Grid>
    
        <!-- Inline Du Lieu Tho Panel -->
        <Border x:Name="InlineDataBorder" Grid.Row="3" Visibility="Collapsed"
                Background="#f8fafc" BorderBrush="#4a90d9" BorderThickness="0,2,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="260"/>
                </Grid.RowDefinitions>
                <!-- Header -->
                <Border Grid.Row="0" Background="#1e3a5f" Padding="12,6">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="&#128203; Dữ liệu thô - Dữ liệu hiển thị trong báo cáo" Foreground="White"
                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button x:Name="BtnDongDuLieuTho" DockPanel.Dock="Right" Content="&#x2715; Dong"
                                Click="BtnDongDuLieuTho_Click" Background="#c0392b" Foreground="White"
                                BorderThickness="0" Padding="10,4" FontWeight="SemiBold" Cursor="Hand"/>
                        <TextBlock x:Name="TxtSoBanGhi" DockPanel.Dock="Right" Foreground="#aaccee"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    </DockPanel>
                </Border>
                <!-- DataGrid -->
                <DataGrid x:Name="InlineDataGrid" Grid.Row="1"
                          IsReadOnly="True" AutoGenerateColumns="True"
                          CanUserSortColumns="True" CanUserResizeColumns="True"
                          GridLinesVisibility="All"
                          AlternatingRowBackground="#edf2f9"
                          HeadersVisibility="Column"
                          FontSize="12" Margin="0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
