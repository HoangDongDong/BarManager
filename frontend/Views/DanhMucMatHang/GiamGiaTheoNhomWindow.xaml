<Window x:Class="QuanLyBar.Client.Views.GiamGiaTheoNhomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Giảm giá theo nhóm" Height="250" Width="300"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#dbe7f2"
        Loaded="Window_Loaded">
    
    <Grid Margin="20,15,20,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Đồ ăn (%) -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Đồ ăn (%)" FontSize="14" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <TextBox x:Name="TxtDoAn" Grid.Row="0" Grid.Column="1" Text="0" FontSize="14" Height="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="0,0,0,10" GotFocus="TextBox_GotFocus"/>

        <!-- Đồ uống (%) -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Đồ uống (%)" FontSize="14" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <TextBox x:Name="TxtDoUong" Grid.Row="1" Grid.Column="1" Text="0" FontSize="14" Height="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="0,0,0,10" GotFocus="TextBox_GotFocus"/>

        <!-- Dịch vụ (%) -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Dịch vụ (%)" FontSize="14" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <TextBox x:Name="TxtDichVu" Grid.Row="2" Grid.Column="1" Text="0" FontSize="14" Height="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="0,0,0,10" GotFocus="TextBox_GotFocus"/>

        <!-- Đồ khác (%) -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Đồ khác (%)" FontSize="14" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <TextBox x:Name="TxtDoKhac" Grid.Row="3" Grid.Column="1" Text="0" FontSize="14" Height="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="0,0,0,10" GotFocus="TextBox_GotFocus"/>

        <!-- Nút thao tác -->
        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,10,0,0">
            <Button x:Name="BtnChapNhan" Content="Chấp nhận" Width="90" Height="28" Margin="0,0,15,0" IsDefault="True" Click="BtnChapNhan_Click" Cursor="Hand" Background="#eaf2f8" BorderBrush="#a4bce3"/>
            <Button x:Name="BtnHuyBo" Content="Hủy bỏ" Width="80" Height="28" IsCancel="True" Click="BtnHuyBo_Click" Cursor="Hand" Background="#eaf2f8" BorderBrush="#a4bce3"/>
        </StackPanel>
    </Grid>
</Window>
