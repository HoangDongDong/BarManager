<Window x:Class="QuanLyBar.Client.Views.DanhMucNhaCungCap.ThemNhomNhaCungCapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NHÓM NHÀ CUNG CẤP" Height="220" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#dbe6f3" WindowStyle="SingleBorderWindow"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Tên nhóm:" VerticalAlignment="Center" Margin="0,0,8,10" FontSize="12"/>
        <TextBox x:Name="TxtTenNhom" Grid.Row="0" Grid.Column="1" Height="24" Margin="0,0,0,10"
                 VerticalContentAlignment="Center" Background="#e6f9ff" BorderBrush="#9ab5cf" Padding="4,0"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Ghi chú:" VerticalAlignment="Top" Margin="0,4,8,10" FontSize="12"/>
        <TextBox x:Name="TxtGhiChu" Grid.Row="1" Grid.Column="1" Height="48" Margin="0,0,0,10"
                 AcceptsReturn="True" TextWrapping="Wrap" Background="White" BorderBrush="#9ab5cf" Padding="4"/>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button x:Name="BtnLuu" Content="💾 Lưu" Width="75" Height="25" Margin="4,0" Background="White" BorderBrush="#a0b8d4" Click="BtnLuu_Click"/>
            <Button x:Name="BtnThoat" Content="Thoát" Width="75" Height="25" Margin="4,0" Background="White" BorderBrush="#a0b8d4" Click="BtnThoat_Click"/>
        </StackPanel>
    </Grid>
</Window>
