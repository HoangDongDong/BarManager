<Window x:Class="QuanLyBar.Client.Views.DanhMucNhaCungCap.ThemNhaCungCapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NHÀ CUNG CẤP - THÊM MỚI" Height="460" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#dbe6f3" WindowStyle="SingleBorderWindow"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Style Sub-toolbar Button -->
        <Style x:Key="SubToolBtnStyle" TargetType="Button">
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Background" Value="#f4f7fb"/>
            <Setter Property="BorderBrush" Value="#c2d5ea"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e6f0fa"/>
                    <Setter Property="BorderBrush" Value="#6495ed"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Footer Button -->
        <Style x:Key="FooterBtnStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="74"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#a0b8d4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e6f0fa"/>
                    <Setter Property="BorderBrush" Value="#6495ed"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0. BANNER -->
            <RowDefinition Height="Auto"/> <!-- 1. SUB TOOLBAR -->
            <RowDefinition Height="*"/>    <!-- 2. FORM FIELDS -->
            <RowDefinition Height="Auto"/> <!-- 3. FOOTER -->
        </Grid.RowDefinitions>

        <!-- 0. BANNER -->
        <Border Grid.Row="0" Background="#fffde6" BorderBrush="#ece8ca" BorderThickness="0,0,0,1" Padding="14,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="👤" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtHeaderTitle" Text="Nhà cung cấp" FontWeight="Bold" FontSize="14.5" Foreground="#112233" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 1. SUB TOOLBAR -->
        <Border Grid.Row="1" Background="#eaf1fa" BorderBrush="#b6cadf" BorderThickness="0,0,0,1" Padding="6,3">
            <DockPanel LastChildFill="False">
                <!-- Nút Phím tắt -->
                <Button x:Name="BtnPhimTat" Style="{StaticResource SubToolBtnStyle}" Click="BtnPhimTat_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="↗️" FontSize="11" Margin="0,0,3,0"/>
                        <TextBlock Text="Phím tắt ▾" FontSize="11"/>
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="CmPhimTat">
                            <MenuItem Header="Tạo mới (Ctrl+N)" Click="MiTaoMoi_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="➕" Foreground="Green" FontWeight="Bold"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Sao chép (Alt+C)" Click="MiSaoChep_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="📑" Foreground="Navy"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Lưu (Ctrl+L)" Click="MiLuu_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="💾"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Lưu &amp; Mới (Ctrl+S)" Click="MiLuuVaMoi_Click"/>
                            <MenuItem Header="Lưu &amp; Thoát (Enter)" Click="MiLuuVaThoat_Click"/>
                            <Separator/>
                            <MenuItem Header="Thoát (ESC)" Click="MiThoat_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="❌" Foreground="Red"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <!-- Nút Trước (F10) -->
                <Button x:Name="BtnTruoc" Style="{StaticResource SubToolBtnStyle}" Click="BtnTruoc_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⬅" FontSize="11" Margin="0,0,3,0" Foreground="SteelBlue"/>
                        <TextBlock Text="Trước (F10)" FontSize="11"/>
                    </StackPanel>
                </Button>

                <!-- Nút Sau (F11) -->
                <Button x:Name="BtnSau" Style="{StaticResource SubToolBtnStyle}" Click="BtnSau_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➡" FontSize="11" Margin="0,0,3,0" Foreground="SteelBlue"/>
                        <TextBlock Text="Sau (F11)" FontSize="11"/>
                    </StackPanel>
                </Button>

                <!-- Nút Tạo mới -->
                <Button x:Name="BtnTaoMoi" Style="{StaticResource SubToolBtnStyle}" Click="BtnTaoMoi_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📁" Foreground="#d4a017" FontSize="11" Margin="0,0,3,0"/>
                        <TextBlock Text="Tạo mới" FontSize="11"/>
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <!-- 2. FORM FIELDS -->
        <Border Grid.Row="2" Margin="10,8,10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="118"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0. Mã NCC -->
                    <RowDefinition Height="Auto"/> <!-- 1. Tên NCC -->
                    <RowDefinition Height="Auto"/> <!-- 2. Địa chỉ -->
                    <RowDefinition Height="Auto"/> <!-- 3. Điện thoại -->
                    <RowDefinition Height="Auto"/> <!-- 4. Email -->
                    <RowDefinition Height="Auto"/> <!-- 5. Website -->
                    <RowDefinition Height="Auto"/> <!-- 6. Nhóm NCC -->
                    <RowDefinition Height="*"/>    <!-- 7. Ghi chú -->
                </Grid.RowDefinitions>

                <!-- Mã nhà cung cấp -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Mã nhà cung cấp" VerticalAlignment="Center" Margin="0,0,8,6" FontSize="12"/>
                <TextBox x:Name="TxtMaNcc" Grid.Row="0" Grid.Column="1" Height="24" Margin="0,0,0,6"
                         VerticalContentAlignment="Center" Background="#e1f5fe" BorderBrush="#0288d1" BorderThickness="1.5" Padding="4,0"
                         TextChanged="TxtMaNcc_TextChanged"/>

                <!-- Tên nhà cung cấp -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Tên nhà cung cấp" VerticalAlignment="Center" Margin="0,0,8,6" FontSize="12"/>
                <TextBox x:Name="TxtTenNcc" Grid.Row="1" Grid.Column="1" Height="24" Margin="0,0,0,6"
                         VerticalContentAlignment="Center" Background="#e1f5fe" BorderBrush="#0288d1" BorderThickness="1.5" Padding="4,0"
                         TextChanged="TxtTenNcc_TextChanged"/>

                <!-- Địa chỉ -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Địa chỉ" VerticalAlignment="Center" Margin="0,0,8,6" FontSize="12"/>
                <TextBox x:Name="TxtDiaChi" Grid.Row="2" Grid.Column="1" Height="24" Margin="0,0,0,6"
                         VerticalContentAlignment="Center" Background="White" BorderBrush="#9ab5cf" Padding="4,0"/>

                <!-- Điện thoại -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Điện thoại" VerticalAlignment="Center" Margin="0,0,8,6" FontSize="12"/>
                <TextBox x:Name="TxtDienThoai" Grid.Row="3" Grid.Column="1" Height="24" Margin="0,0,0,6"
                         VerticalContentAlignment="Center" Background="White" BorderBrush="#9ab5cf" Padding="4,0"/>

                <!-- Email -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Email" VerticalAlignment="Center" Margin="0,0,8,6" FontSize="12"/>
                <TextBox x:Name="TxtEmail" Grid.Row="4" Grid.Column="1" Height="24" Margin="0,0,0,6"
                         VerticalContentAlignment="Center" Background="White" BorderBrush="#9ab5cf" Padding="4,0"/>

                <!-- Website -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Website" VerticalAlignment="Center" Margin="0,0,8,6" FontSize="12"/>
                <TextBox x:Name="TxtWebsite" Grid.Row="5" Grid.Column="1" Height="24" Margin="0,0,0,6"
                         VerticalContentAlignment="Center" Background="White" BorderBrush="#9ab5cf" Padding="4,0"/>

                <!-- Nhóm nhà cung cấp -->
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Nhóm nhà cung cấp" VerticalAlignment="Center" Margin="0,0,8,6" FontSize="12"/>
                <ComboBox x:Name="CboNhomNcc" Grid.Row="6" Grid.Column="1" Height="24" Margin="0,0,0,6"
                          VerticalContentAlignment="Center" Background="White" BorderBrush="#9ab5cf"
                          SelectedValuePath="Id" DisplayMemberPath="Name"/>

                <!-- Ghi chú -->
                <TextBlock Grid.Row="7" Grid.Column="0" Text="Ghi chú" VerticalAlignment="Top" Margin="0,4,8,0" FontSize="12"/>
                <TextBox x:Name="TxtGhiChu" Grid.Row="7" Grid.Column="1"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         BorderBrush="#9ab5cf" Padding="4" Background="White"/>
            </Grid>
        </Border>

        <!-- 3. FOOTER -->
        <Border Grid.Row="3" Background="#dbe6f3" BorderBrush="#b6cadf" BorderThickness="0,1,0,0" Padding="10,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnLuu" Content="💾 Lưu" Style="{StaticResource FooterBtnStyle}" Click="BtnLuu_Click"/>
                <Button x:Name="BtnLuuVaMoi" Content="Lưu &amp; Mới" Style="{StaticResource FooterBtnStyle}" Click="BtnLuuVaMoi_Click"/>
                <Button x:Name="BtnLuuVaThoat" Content="Lưu &amp; thoát" Style="{StaticResource FooterBtnStyle}" Click="BtnLuuVaThoat_Click"/>
                <Button x:Name="BtnThoat" Content="Thoát" Style="{StaticResource FooterBtnStyle}" Click="BtnThoat_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
