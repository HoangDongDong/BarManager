<Window x:Class="QuanLyBar.Client.Views.ChonMatHangKhuyenMaiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:QuanLyBar.Client.Models"
        Title="TÌM KIẾM" Height="480" Width="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#b8d1ea"
        KeyDown="Window_KeyDown">
    
    <Grid>
        <Grid.RowDefinitions>
            <!-- 0. Header -->
            <RowDefinition Height="50"/>
            <!-- 1. Search Bar -->
            <RowDefinition Height="36"/>
            <!-- 2. Body (Tree + DataGrid) -->
            <RowDefinition Height="*"/>
            <!-- 3. Bottom Buttons -->
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <!-- 0. Header Banner -->
        <Border Grid.Row="0" Background="White" BorderBrush="#a3bde0" BorderThickness="0,0,0,1" Padding="15,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🔍" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Tìm kiếm" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Foreground="#111111"/>
            </StackPanel>
        </Border>

        <!-- 1. Search Bar -->
        <Grid Grid.Row="1" Margin="12,6,12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="45"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Tìm:" VerticalAlignment="Center" FontSize="12.5" Foreground="#111"/>
            <TextBox x:Name="TxtTimKiem" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Background="White" BorderBrush="#0078d7" BorderThickness="1.5" Padding="4,0" TextChanged="TxtTimKiem_TextChanged"/>
        </Grid>

        <!-- 2. Body: Tree Nhóm hàng (trái) + DataGrid Mặt hàng (phải) -->
        <Grid Grid.Row="2" Margin="12,2,12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" MinWidth="130" MaxWidth="260"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Cột trái: TreeView Nhóm hàng -->
            <Border Grid.Column="0" Background="White" BorderBrush="#b6cadf" BorderThickness="1">
                <TreeView x:Name="TvNhomHang" BorderThickness="0" SelectedItemChanged="TvNhomHang_SelectedItemChanged">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type models:NhomKhachHangTreeItem}" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="{Binding Icon}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="11.5"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

            <!-- Cột phải: DataGrid Mặt hàng -->
            <Border Grid.Column="2" Background="White" BorderBrush="#b6cadf" BorderThickness="1">
                <DataGrid x:Name="DgMatHang" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#e2e8f0" VerticalGridLinesBrush="#e2e8f0"
                          RowHeight="24" SelectionMode="Extended" SelectionUnit="FullRow"
                          Background="White" RowBackground="White" AlternatingRowBackground="#f9fbff"
                          MouseDoubleClick="DgMatHang_MouseDoubleClick">
                    <DataGrid.Columns>
                        <!-- STT Column -->
                        <DataGridTextColumn Header=" " Binding="{Binding SttStr}" Width="45">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#555"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Mã hàng -->
                        <DataGridTextColumn Header="Mã hàng" Binding="{Binding Mahang}" Width="100"/>

                        <!-- Tên mặt hàng -->
                        <DataGridTextColumn Header="Tên mặt hàng" Binding="{Binding Name}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- 3. Bottom Action Buttons -->
        <Border Grid.Row="3" Background="#b8d1ea" Padding="12,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BtnChon" Content="Chọn" Width="80" Height="26" Margin="0,0,8,0" Background="White" BorderBrush="#708090" Cursor="Hand" FontWeight="SemiBold" Click="BtnChon_Click"/>
                <Button x:Name="BtnHuyBo" Content="Hủy bỏ" Width="80" Height="26" Background="White" BorderBrush="#708090" Cursor="Hand" Click="BtnHuyBo_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
