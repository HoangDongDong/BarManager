<Window x:Class="QuanLyBar.Client.Views.ThemLoaiHinhKhuyenMaiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Loại hình khuyến mại" Height="260" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#b8d1ea">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <Border Grid.Row="0" Background="White" BorderBrush="#a3bde0" BorderThickness="0,0,0,1" Padding="15,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="💬✏️" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="TxtHeaderTitle" Text="Chỉnh sửa loại hình khuyến mại" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center" Foreground="#111111"/>
            </StackPanel>
        </Border>

        <!-- 2. Form Body -->
        <Grid Grid.Row="1" Margin="15,10,15,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tên & Ảnh -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="135"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="35"/>
                    <ColumnDefinition Width="65"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Tên loại hình khuyến ..." VerticalAlignment="Center" FontSize="12" Foreground="#222"/>
                <TextBox x:Name="TxtTen" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Background="White" BorderBrush="#0078d7" BorderThickness="1.5" Margin="0,0,8,0"/>
                <TextBlock Text="Ảnh:" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0" FontSize="12" Foreground="#222"/>
                <ComboBox x:Name="CboAnh" Grid.Column="3" Height="24" Background="White">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Image Source="{Binding ImageSource}" Width="16" Height="16" Stretch="Uniform"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <!-- Ghi chú -->
            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="135"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Ghi chú:" VerticalAlignment="Top" Margin="0,4,0,0" FontSize="12" Foreground="#222"/>
                <TextBox x:Name="TxtGhiChu" Grid.Column="1" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="White" BorderBrush="#999" BorderThickness="1"/>
            </Grid>
        </Grid>

        <!-- 3. Bottom Buttons -->
        <Border Grid.Row="2" Background="#b8d1ea" Padding="15,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BtnGhiDuLieu" Content="Ghi dữ liệu" Width="90" Height="26" Margin="0,0,10,0" Background="White" BorderBrush="#708090" Cursor="Hand" FontWeight="SemiBold" Click="BtnGhiDuLieu_Click"/>
                <Button x:Name="BtnThoat" Content="Thoát" Width="80" Height="26" Background="White" BorderBrush="#708090" Cursor="Hand" Click="BtnThoat_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
