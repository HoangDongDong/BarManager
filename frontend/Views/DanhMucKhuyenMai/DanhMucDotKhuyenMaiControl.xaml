<UserControl x:Class="QuanLyBar.Client.Views.DanhMucDotKhuyenMaiControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:models="clr-namespace:QuanLyBar.Client.Models"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1100"
             Loaded="UserControl_Loaded">
    
    <UserControl.Resources>
        <Style x:Key="HeaderTabStyle" TargetType="Border">
            <Setter Property="Background" Value="#dfe9f5"/>
            <Setter Property="BorderBrush" Value="#a3bde0"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="CornerRadius" Value="3,3,0,0"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#f0f4fa">
        <Grid.ColumnDefinitions>
            <!-- Cột trái: Loại hình khuyến mại -->
            <ColumnDefinition Width="220" MinWidth="160" MaxWidth="350"/>
            <ColumnDefinition Width="4"/>
            <!-- Cột phải: Đợt khuyến mại -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- CỘT TRÁI: LOẠI HÌNH KHUYẾN MẠI -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tab Header: Loại hình khuyến mại -->
            <Border Grid.Row="0" Style="{StaticResource HeaderTabStyle}" Margin="5,5,0,0">
                <Grid>
                    <TextBlock x:Name="TxtLeftHeaderTitle" Text="Loại hình khuyến mại" FontWeight="Bold" FontSize="12.5" Foreground="#1e3f66" VerticalAlignment="Center"/>
                    <TextBlock Text="⚙️" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" FontSize="13"/>
                </Grid>
            </Border>

            <!-- Sub Toolbar: 5 nút + Dropdown -->
            <Border Grid.Row="1" Background="#eaf1fa" BorderBrush="#b6cadf" BorderThickness="1,1,1,0" Margin="5,0,0,0" Padding="2,2">
                <DockPanel LastChildFill="False">
                    <Button x:Name="BtnThemLoaiHinh" ToolTip="Thêm mới loại hình khuyến mại" Margin="1,0" Padding="3,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnThemLoaiHinh_Click">
                        <TextBlock Text="➕" Foreground="Green" FontSize="13"/>
                    </Button>
                    <Button x:Name="BtnSuaLoaiHinh" ToolTip="Sửa loại hình khuyến mại" Margin="1,0" Padding="3,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnSuaLoaiHinh_Click">
                        <TextBlock Text="✏️" FontSize="13"/>
                    </Button>
                    <Button x:Name="BtnThemThuMuc" ToolTip="Tạo mới thư mục" Margin="1,0" Padding="3,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnThemThuMuc_Click">
                        <TextBlock Text="📁" Foreground="#d4a017" FontSize="13"/>
                    </Button>
                    <Button x:Name="BtnXemTheoThuMuc" ToolTip="Hiển thị theo thư mục" Margin="1,0" Padding="3,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnXemTheoThuMuc_Click">
                        <TextBlock Text="🗂️" FontSize="13"/>
                    </Button>
                    <Button x:Name="BtnTaiLaiNhom" ToolTip="Tải lại" Margin="1,0" Padding="3,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnTaiLaiNhom_Click">
                        <TextBlock Text="🔄" FontSize="13"/>
                    </Button>
                    <Button x:Name="BtnKhoiPhucLoaiHinh" ToolTip="Khôi phục loại hình đã xóa" Margin="1,0" Padding="3,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="MiKhoiPhucLoaiHinh_Click">
                        <TextBlock Text="♻️" Foreground="Green" FontSize="13"/>
                    </Button>

                    <Button x:Name="BtnMenuCheDo" DockPanel.Dock="Right" ToolTip="Tùy chọn" Margin="2,0" Padding="4,2" Background="#e2ecf8" BorderBrush="#a4bce3" Cursor="Hand" Click="BtnMenuCheDo_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗂️" FontSize="12" Margin="0,0,2,0"/>
                            <TextBlock Text="▾" FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </DockPanel>
            </Border>

            <!-- TreeView loại hình khuyến mại -->
            <Border Grid.Row="2" Background="White" BorderBrush="#b6cadf" BorderThickness="1" Margin="5,0,0,5">
                <TreeView x:Name="TvLoaiHinhKhuyenMai" BorderThickness="0" SelectedItemChanged="TvLoaiHinhKhuyenMai_SelectedItemChanged">
                    <TreeView.ContextMenu>
                        <ContextMenu x:Name="CmTreeView">
                            <!-- 1. Thêm mới -->
                            <MenuItem Header="Thêm mới">
                                <MenuItem Header="➕  Thêm loại hình khuyến mại" Click="MiThemMoiLoaiHinh_Click"/>
                                <MenuItem Header="Thêm nhanh" Click="MiThemNhanhLoaiHinh_Click"/>
                                <Separator/>
                                <MenuItem Header="Thêm phân cách" Click="MiThemPhanCach_Click"/>
                                <MenuItem Header="📁  Thêm thư mục" Click="MiThemThuMucLoaiHinh_Click"/>
                            </MenuItem>

                            <!-- 2. Thêm con -->
                            <MenuItem Header="Thêm con">
                                <MenuItem Header="➕  Thêm loại hình khuyến mại" Click="MiThemConLoaiHinh_Click"/>
                                <MenuItem Header="Thêm nhanh" Click="MiThemNhanhCon_Click"/>
                                <MenuItem Header="📁  Thêm thư mục" Click="MiThemThuMucCon_Click"/>
                            </MenuItem>

                            <!-- 3. Chỉnh sửa -->
                            <MenuItem Header="✏️  Chỉnh sửa" Click="MiChinhSuaLoaiHinh_Click"/>

                            <!-- 4. Sắp xếp theo -->
                            <MenuItem Header="Sắp xếp theo">
                                <MenuItem Header="Tên" IsCheckable="True" IsChecked="True" Click="MiSapXepTen_Click"/>
                                <MenuItem Header="Thứ tự tùy chọn" IsCheckable="True" Click="MiSapXepTuyChon_Click"/>
                            </MenuItem>

                            <!-- 5. Refresh -->
                            <MenuItem Header="🔄  Refresh" Click="BtnTaiLaiNhom_Click"/>

                            <Separator/>

                            <!-- 6. Sao chép, Mở rộng, Thu gọn -->
                            <MenuItem Header="📑  Sao chép" Click="MiSaoChep_Click"/>
                            <MenuItem Header="Mở rộng" Click="MiMoRong_Click"/>
                            <MenuItem Header="Thu gọn" Click="MiThuGon_Click"/>

                            <Separator/>

                            <!-- 7. Xóa, Khôi phục, Đổi tên, Thùng rác -->
                            <MenuItem Header="❌  Xóa" Click="BtnXoaLoaiHinh_Click"/>
                            <MenuItem x:Name="MiKhoiPhucLoaiHinh" Header="♻️  Khôi phục" Click="MiKhoiPhucLoaiHinh_Click"/>
                            <MenuItem Header="Đổi tên" Click="MiDoiTen_Click"/>
                            <MenuItem Header="Thùng rác" Click="MiThungRac_Click"/>

                            <Separator/>

                            <!-- 8. Biểu tượng, Thuộc tính -->
                            <MenuItem Header="Biểu tượng" Click="MiBieuTuong_Click"/>
                            <MenuItem Header="Thuộc tính" Click="MiThuocTinh_Click"/>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type models:NhomKhachHangTreeItem}" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="{Binding Icon}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12.5"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>
        </Grid>

        <!-- Grid Splitter -->
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

        <!-- CỘT PHẢI: ĐỢT KHUYẾN MẠI -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="120" MinHeight="70"/>
            </Grid.RowDefinitions>

            <!-- Tab Header: Đợt khuyến mại -->
            <Border Grid.Row="0" Style="{StaticResource HeaderTabStyle}" HorizontalAlignment="Left" Margin="0,5,0,0" Width="130">
                <TextBlock Text="Đợt khuyến mại" FontWeight="Bold" FontSize="12.5" Foreground="#1e3f66" HorizontalAlignment="Center"/>
            </Border>

            <!-- Toolbar trên DataGrid -->
            <Border Grid.Row="1" Background="#eaf1fa" BorderBrush="#b6cadf" BorderThickness="1,1,1,0" Padding="4,3">
                <DockPanel LastChildFill="False">
                    <!-- Ô lọc F3 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="Lọc (F3):" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="11.5" FontWeight="SemiBold" Foreground="#2c3e50"/>
                        <TextBox x:Name="TxtLoc" Width="100" Height="22" VerticalContentAlignment="Center" Padding="2,0" TextChanged="TxtLoc_TextChanged"/>
                    </StackPanel>

                    <!-- Nút Thêm mới -->
                    <Button x:Name="BtnThemMoi" Margin="2,0" Padding="5,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnThemMoi_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕" Foreground="Green" Margin="0,0,4,0" FontWeight="Bold"/>
                            <TextBlock Text="Thêm mới (Insert)" VerticalAlignment="Center" FontSize="11.5"/>
                        </StackPanel>
                    </Button>

                    <!-- Nút Chỉnh sửa -->
                    <Button x:Name="BtnChinhSua" Margin="2,0" Padding="5,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnChinhSua_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✏️" Foreground="#c07000" Margin="0,0,4,0"/>
                            <TextBlock Text="Chỉnh sửa (F4)" VerticalAlignment="Center" FontSize="11.5"/>
                        </StackPanel>
                    </Button>

                    <!-- Nút Xóa -->
                    <Button x:Name="BtnXoa" Margin="2,0" Padding="5,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnXoa_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="❌" Foreground="Red" Margin="0,0,4,0"/>
                            <TextBlock Text="Xóa (Del)" VerticalAlignment="Center" FontSize="11.5"/>
                        </StackPanel>
                    </Button>

                    <!-- Nút Khôi phục -->
                    <Button x:Name="BtnKhoiPhuc" Margin="2,0" Padding="5,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnKhoiPhuc_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="♻️" Foreground="Green" Margin="0,0,4,0"/>
                            <TextBlock Text="Khôi phục" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- Nút Thêm excel -->
                    <Button x:Name="BtnThemExcel" Margin="2,0" Padding="5,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnThemExcel_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💹" Foreground="DarkGreen" Margin="0,0,4,0"/>
                            <TextBlock Text="Thêm excel" VerticalAlignment="Center" FontSize="11.5"/>
                        </StackPanel>
                    </Button>

                    <!-- Nút Xuất excel -->
                    <Button x:Name="BtnXuatExcel" Margin="2,0" Padding="5,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnXuatExcel_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" Foreground="Green" Margin="0,0,4,0"/>
                            <TextBlock Text="Xuất excel" VerticalAlignment="Center" FontSize="11.5"/>
                        </StackPanel>
                    </Button>

                    <!-- Nút In -->
                    <Button x:Name="BtnIn" Margin="2,0" Padding="5,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnIn_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨️" Foreground="#0078d7" Margin="0,0,4,0"/>
                            <TextBlock Text="In" VerticalAlignment="Center" FontSize="11.5"/>
                        </StackPanel>
                    </Button>

                    <!-- Nút Tổng -->
                    <Button x:Name="BtnTong" Margin="2,0" Padding="5,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnTong_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="∑" FontWeight="Bold" Foreground="#333" Margin="0,0,4,0"/>
                            <TextBlock Text="Tổng" VerticalAlignment="Center" FontSize="11.5"/>
                        </StackPanel>
                    </Button>
                </DockPanel>
            </Border>

            <!-- DataGrid Danh sách Đợt khuyến mại -->
            <Border Grid.Row="2" Background="White" BorderBrush="#b6cadf" BorderThickness="1" Margin="0,0,5,5">
                <DataGrid x:Name="DgDotKhuyenMai" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          IsReadOnly="True" HeadersVisibility="All" GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#e2e8f0" VerticalGridLinesBrush="#e2e8f0"
                          RowHeight="24" SelectionMode="Single" SelectionUnit="FullRow"
                          Background="White" RowBackground="White" AlternatingRowBackground="#f9fbff"
                          MouseDoubleClick="DgDotKhuyenMai_MouseDoubleClick"
                          SelectionChanged="DgDotKhuyenMai_SelectionChanged">
                    
                    <!-- Row Header Style hiển thị STT -->
                    <DataGrid.RowHeaderStyle>
                        <Style TargetType="{x:Type DataGridRowHeader}">
                            <Setter Property="Width" Value="32"/>
                            <Setter Property="Background" Value="#dfe9f5"/>
                            <Setter Property="BorderBrush" Value="#b6cadf"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="Content" Value="{Binding Stt}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="11"/>
                        </Style>
                    </DataGrid.RowHeaderStyle>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="DataGridRow_PreviewMouseRightButtonDown"/>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.ContextMenu>
                        <ContextMenu x:Name="GridContextMenu" Opened="GridContextMenu_Opened">
                            <!-- Trash mode -->
                            <MenuItem x:Name="MenuKhoiPhuc" Header="Khôi phục" Click="MenuItem_KhoiPhuc_Click" Visibility="Collapsed">
                                <MenuItem.Icon>
                                    <TextBlock Text="↩️" Foreground="Green" FontWeight="Bold"/>
                                </MenuItem.Icon>
                            </MenuItem>

                            <!-- Normal items -->
                            <MenuItem x:Name="MenuThemMoi" Header="Thêm Đợt khuyến mại" Click="BtnThemMoi_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="➕" Foreground="Green" FontWeight="Bold"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuThemNhanhExcel" Header="Thêm nhanh (excel)" Click="BtnThemExcel_Click"/>
                            <MenuItem x:Name="MenuCapNhatNhanhExcel" Header="Cập nhật nhanh (excel)" Click="BtnThemExcel_Click"/>
                            <MenuItem x:Name="MenuChinhSua" Header="Chỉnh sửa" Click="BtnChinhSua_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="✏️" Foreground="#c07000"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator x:Name="SepDatLoc"/>
                            <MenuItem x:Name="MenuDatCot" Header="Đặt Tên đợt khuyến mại"/>
                            <MenuItem x:Name="MenuLocCot" Header="Lọc Tên đợt khuyến mại" Click="MenuLocCot_Click"/>
                            <Separator x:Name="SepSapXep"/>
                            <MenuItem x:Name="MenuSapXep" Header="Sắp xếp theo">
                                <MenuItem Header="Sắp xếp tăng dần" Click="MenuItem_SortAsc_Click"/>
                                <MenuItem Header="Sắp xếp giảm dần" Click="MenuItem_SortDesc_Click"/>
                                <Separator/>
                                <MenuItem Header="Tên đợt khuyến mại" Click="MenuItem_SortByName_Click"/>
                                <MenuItem Header="Loại hình khuyến mại" Click="MenuItem_SortByLoaiHinh_Click"/>
                                <MenuItem Header="Từ ngày" Click="MenuItem_SortByTuNgay_Click"/>
                                <MenuItem Header="Đến ngày" Click="MenuItem_SortByDenNgay_Click"/>
                            </MenuItem>
                            <MenuItem x:Name="MenuRefresh" Header="Refresh" Click="BtnTaiLaiNhom_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="🔄" Foreground="Green" FontWeight="Bold"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuInDanhSach" Header="In danh sách" Click="BtnIn_Click"/>
                            <Separator x:Name="SepSaoChep"/>
                            <MenuItem x:Name="MenuSaoChepO" Header="Sao chép ô" Click="MenuItem_SaoChepO_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="📄" Foreground="Navy"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuSaoChepVungChon" Header="Sao chép vùng chọn" Click="MenuItem_SaoChepVungChon_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="📑" Foreground="Navy"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuXoa" Header="Xóa" Click="BtnXoa_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="❌" Foreground="Red"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator x:Name="SepKhac"/>
                            <MenuItem x:Name="MenuTuDongGianCot" Header="Tự động giãn cột" Click="MenuItem_TuDongGianCot_Click"/>
                            <MenuItem x:Name="MenuCotHienThi" Header="Cột hiển thị" Click="MenuCotHienThi_Click"/>
                            <MenuItem x:Name="MenuThuocTinh" Header="Thuộc tính" Click="MenuItem_ThuocTinh_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tên đợt khuyến mại" Binding="{Binding Name}" Width="160">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,0"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Loại hình khuyến mại" Binding="{Binding TenLoaiHinhKhuyenMai}" Width="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Từ ngày" Binding="{Binding Tungay, StringFormat=dd/MM/yyyy}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,0"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Đến ngày" Binding="{Binding Denngay, StringFormat=dd/MM/yyyy}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,0"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridCheckBoxColumn Header="Ngừng áp dụng" Binding="{Binding IsNgungApDung, Mode=OneWay}" Width="100"/>

                        <DataGridTextColumn Header="Ghi chú" Binding="{Binding Note}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Tỉ lệ giảm giá" Binding="{Binding Tilegiamgia, StringFormat={}{0:N0}}" Width="95">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,0"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Tỉ lệ giảm&#x0a;giá tiền giờ" Binding="{Binding Tilegiamgiatiengio, StringFormat={}{0:N0}}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,0"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Khuyến&#x0a;mại giờ&#x0a;hát" Binding="{Binding Khuyenmaigiohat, StringFormat=HH:mm}" Width="75">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,0"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Tỉ lệ giảm&#x0a;giá tổng" Binding="{Binding Tilegiamgiatong, StringFormat={}{0:N0}}" Width="85">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,0"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Từ giờ" Binding="{Binding Tugio, StringFormat=HH:mm}" Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,0"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Đến giờ" Binding="{Binding Dengio, StringFormat=HH:mm}" Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,0"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Tỉ lệ&#x0a;giảm&#x0a;giá giờ&#x0a;hát" Binding="{Binding Tilegiamgiagiodau, StringFormat={}{0:N0}}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,0"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Grid Splitter ngang -->
            <GridSplitter Grid.Row="3" Height="4" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeNS"/>

            <!-- CỤM TAB DƯỚI: THÔNG TIN CHI TIẾT -->
            <Border Grid.Row="4" Background="White" BorderBrush="#b6cadf" BorderThickness="1" Margin="0,0,5,5">
                <TabControl BorderThickness="0" Background="Transparent">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="FontSize" Value="11.5"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </TabControl.Resources>

                    <TabItem Header="Thông tin">
                        <Grid Background="#f9fbff" Margin="10,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Khởi tạo:" FontSize="11.5" Foreground="#555" Margin="0,0,10,6"/>
                            <TextBlock x:Name="TxtInfoKhoiTao" Grid.Row="0" Grid.Column="1" Text="--/--/---- --:--:--" FontSize="11.5" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Khởi tạo bởi:" FontSize="11.5" Foreground="#555" Margin="0,0,10,6"/>
                            <TextBlock x:Name="TxtInfoNguoiTao" Grid.Row="0" Grid.Column="4" Text="Administrator" FontSize="11.5" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Sửa đổi gần nhất:" FontSize="11.5" Foreground="#555" Margin="0,0,10,0"/>
                            <TextBlock x:Name="TxtInfoSuaDoi" Grid.Row="1" Grid.Column="1" Text="--/--/---- --:--:--" FontSize="11.5" FontWeight="SemiBold" Foreground="#2c3e50"/>

                            <TextBlock Grid.Row="1" Grid.Column="3" Text="Sửa đổi bởi:" FontSize="11.5" Foreground="#555" Margin="0,0,10,0"/>
                            <TextBlock x:Name="TxtInfoNguoiSua" Grid.Row="1" Grid.Column="4" Text="Administrator" FontSize="11.5" FontWeight="SemiBold" Foreground="#2c3e50"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>
