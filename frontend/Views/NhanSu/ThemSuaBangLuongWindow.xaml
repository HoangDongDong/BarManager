<Window x:Class="QuanLyBar.Client.Views.NhanSu.ThemSuaBangLuongWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BẢNG LƯƠNG - THÊM MỚI"
        Width="520" Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#dbe6f3"
        WindowStyle="SingleBorderWindow"
        FontFamily="Segoe UI" FontSize="12"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- SubToolBtnStyle -->
        <Style x:Key="SubToolBtnStyle" TargetType="Button">
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Background" Value="#f4f7fb"/>
            <Setter Property="BorderBrush" Value="#c2d5ea"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e6f0fa"/>
                    <Setter Property="BorderBrush" Value="#6495ed"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- FooterBtnStyle -->
        <Style x:Key="FooterBtnStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="68"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#a0b8d4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e6f0fa"/>
                    <Setter Property="BorderBrush" Value="#6495ed"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FooterDefaultBtnStyle" TargetType="Button" BasedOn="{StaticResource FooterBtnStyle}">
            <Setter Property="BorderBrush" Value="#0078d7"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0. BANNER -->
            <RowDefinition Height="Auto"/> <!-- 1. SUB TOOLBAR -->
            <RowDefinition Height="*"/>    <!-- 2. FORM FIELDS -->
            <RowDefinition Height="Auto"/> <!-- 3. FOOTER -->
        </Grid.RowDefinitions>

        <!-- 0. BANNER -->
        <Border Grid.Row="0" Background="#fffde6" BorderBrush="#ece8ca" BorderThickness="0,0,0,1" Padding="14,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📅" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtHeaderTitle" Text="Bảng lương" FontWeight="Bold" FontSize="14.5" Foreground="#112233" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 1. SUB TOOLBAR -->
        <Border Grid.Row="1" Background="#eaf1fa" BorderBrush="#b6cadf" BorderThickness="0,0,0,1" Padding="6,3">
            <DockPanel LastChildFill="False">
                <!-- Phím tắt ▾ -->
                <Button x:Name="BtnPhimTat" Style="{StaticResource SubToolBtnStyle}" Click="BtnPhimTat_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="↗" FontSize="11" Margin="0,0,3,0"/>
                        <TextBlock Text="Phím tắt ▾" FontSize="11"/>
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="CmPhimTat">
                            <MenuItem Header="Tạo mới (Ctrl+N)" Click="BtnTaoMoi_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="➕" Foreground="Green" FontWeight="Bold"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Sao chép (Alt+C)" Click="MiSaoChep_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="📑" Foreground="Navy"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Xóa (Del)" Click="BtnXoa_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="❌" Foreground="Red"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Lưu (Ctrl+L)" Click="BtnLuu_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="💾"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Lưu &amp; Mới (Ctrl+S)" Click="BtnLuuVaMoi_Click"/>
                            <MenuItem Header="Lưu &amp; Thoát (Enter)" Click="BtnLuuVaThoat_Click"/>
                            <Separator/>
                            <MenuItem Header="Thoát (ESC)" Click="BtnThoat_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <!-- Trước (F10) -->
                <Button x:Name="BtnTruoc" Style="{StaticResource SubToolBtnStyle}" Click="BtnTruoc_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⬅" FontSize="11" Margin="0,0,3,0" Foreground="SteelBlue"/>
                        <TextBlock Text="Trước (F10)" FontSize="11"/>
                    </StackPanel>
                </Button>

                <!-- Sau (F11) -->
                <Button x:Name="BtnSau" Style="{StaticResource SubToolBtnStyle}" Click="BtnSau_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➡" FontSize="11" Margin="0,0,3,0" Foreground="SteelBlue"/>
                        <TextBlock Text="Sau (F11)" FontSize="11"/>
                    </StackPanel>
                </Button>

                <!-- Tạo mới -->
                <Button x:Name="BtnTaoMoi" Style="{StaticResource SubToolBtnStyle}" Click="BtnTaoMoi_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📁+" Foreground="#27ae60" FontSize="11" Margin="0,0,3,0"/>
                        <TextBlock Text="Tạo mới" FontSize="11"/>
                    </StackPanel>
                </Button>

                <!-- Sao chép -->
                <Button x:Name="BtnSaoChep" Style="{StaticResource SubToolBtnStyle}" Click="MiSaoChep_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📑" Foreground="Navy" FontSize="11" Margin="0,0,3,0"/>
                        <TextBlock Text="Sao chép" FontSize="11"/>
                    </StackPanel>
                </Button>

                <!-- Xóa -->
                <Button x:Name="BtnXoa" Style="{StaticResource SubToolBtnStyle}" Click="BtnXoa_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="❌" Foreground="#e74c3c" FontSize="11" Margin="0,0,3,0"/>
                        <TextBlock Text="Xóa" FontSize="11"/>
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <!-- 2. FORM FIELDS -->
        <Border Grid.Row="2" Margin="14,10,14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="75"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0. Số phiếu -->
                    <RowDefinition Height="Auto"/> <!-- 1. Tháng & Năm -->
                    <RowDefinition Height="*"/>    <!-- 2. Ghi chú -->
                </Grid.RowDefinitions>

                <!-- Row 0: Số phiếu -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Số phiếu" VerticalAlignment="Center" Margin="0,0,6,6" FontSize="12"/>
                <TextBox x:Name="TxtSoPhieu" Grid.Row="0" Grid.Column="1" Height="24" Margin="0,0,0,6"
                         VerticalContentAlignment="Center" Background="#e1f5fe" BorderBrush="#9ab5cf" Padding="4,0"
                         IsReadOnly="True" Focusable="False"/>

                <!-- Row 1: Tháng & Năm -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Tháng" VerticalAlignment="Center" Margin="0,0,6,6" FontSize="12"/>
                <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtThang" Grid.Column="0" Height="24" VerticalContentAlignment="Center"
                             Background="#ffffcc" BorderBrush="#9ab5cf" Padding="4,0" TextChanged="TxtThangNam_TextChanged"/>
                    <TextBlock Grid.Column="1" Text="Năm" VerticalAlignment="Center" Margin="16,0,8,0" FontSize="12"/>
                    <TextBox x:Name="TxtNam" Grid.Column="2" Height="24" VerticalContentAlignment="Center"
                             Background="White" BorderBrush="#9ab5cf" Padding="4,0" TextChanged="TxtThangNam_TextChanged"/>
                </Grid>

                <!-- Row 2: Ghi chú -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Ghi chú" VerticalAlignment="Top" Margin="0,4,6,0" FontSize="12"/>
                <TextBox x:Name="TxtGhiChu" Grid.Row="2" Grid.Column="1"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         BorderBrush="#9ab5cf" Padding="4" Background="White"/>
            </Grid>
        </Border>

        <!-- 3. FOOTER -->
        <Border Grid.Row="3" Background="#dbe6f3" BorderBrush="#b6cadf" BorderThickness="0,1,0,0" Padding="10,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnLuuVaIn" Content="🖨️ Lưu &amp; In" Style="{StaticResource FooterBtnStyle}" Click="BtnLuuVaIn_Click"/>
                <Button x:Name="BtnLuuVaXemIn" Content="🔍 Lưu &amp; Xem in" Style="{StaticResource FooterBtnStyle}" Click="BtnLuuVaXemIn_Click"/>
                <Button x:Name="BtnLuu" Content="💾 Lưu" Style="{StaticResource FooterBtnStyle}" Click="BtnLuu_Click"/>
                <Button x:Name="BtnLuuVaMoi" Content="Lưu &amp; Mới" Style="{StaticResource FooterBtnStyle}" Click="BtnLuuVaMoi_Click"/>
                <Button x:Name="BtnLuuVaThoat" Content="Lưu &amp; thoát" Style="{StaticResource FooterDefaultBtnStyle}" Click="BtnLuuVaThoat_Click"/>
                <Button x:Name="BtnThoat" Content="Thoát" Style="{StaticResource FooterBtnStyle}" Click="BtnThoat_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
