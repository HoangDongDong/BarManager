<UserControl x:Class="QuanLyBar.Client.Views.NhanSu.ThuongPhatControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             FontFamily="Segoe UI" FontSize="12">

    <UserControl.Resources>
        <Style x:Key="HeaderTabStyle" TargetType="Border">
            <Setter Property="Background" Value="#dfe9f5"/>
            <Setter Property="BorderBrush" Value="#a3bde0"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="CornerRadius" Value="3,3,0,0"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>

        <Style x:Key="ToolbarActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#fff0b3"/>
                    <Setter Property="BorderBrush" Value="#f5a623"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="DataGridRow_PreviewMouseRightButtonDown"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e0f2fe"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0078d7"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#f0f4fa">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="180" MaxWidth="450"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== 1. KHUNG BÊN TRÁI: NHÂN VIÊN / LÝ DO THƯỞNG PHẠT ==================== -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Tab Header -->
                <RowDefinition Height="Auto"/> <!-- Tree Toolbar -->
                <RowDefinition Height="*"/>    <!-- TreeView -->
            </Grid.RowDefinitions>

            <!-- Tab Header -->
            <Border Grid.Row="0" Style="{StaticResource HeaderTabStyle}" Margin="4,4,0,0">
                <Grid>
                    <TextBlock x:Name="TxtTreeHeader" Text="Nhân viên" FontWeight="Bold" FontSize="12.5" Foreground="#1e3f66" VerticalAlignment="Center"/>
                    <TextBlock Text="⚙️" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" FontSize="13" ToolTip="Cấu hình danh mục" MouseDown="BtnCauHinhTree_Click"/>
                </Grid>
            </Border>

            <!-- Sub Toolbar cho cây danh mục -->
            <Border Grid.Row="1" Background="#eaf1fa" BorderBrush="#b6cadf" BorderThickness="1,1,1,0" Margin="4,0,0,0" Padding="3,2">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button x:Name="BtnThemTree" ToolTip="Thêm mới" Margin="1,0" Padding="3,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnThemTree_Click">
                            <TextBlock Text="➕" Foreground="#27ae60" FontSize="12.5"/>
                        </Button>
                        <Button x:Name="BtnSuaTree" ToolTip="Chỉnh sửa" Margin="1,0" Padding="3,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnSuaTree_Click">
                            <TextBlock Text="✏️" Foreground="#f39c12" FontSize="12.5"/>
                        </Button>
                        <Button x:Name="BtnThemThuMucTree" ToolTip="Tạo mới thư mục" Margin="1,0" Padding="3,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnThemThuMucTree_Click">
                            <TextBlock Text="📁" Foreground="#d4a017" FontSize="12.5"/>
                        </Button>
                        <Button x:Name="BtnXemTheoThuMuc" ToolTip="Hiển thị theo thư mục / dạng phẳng" Margin="1,0" Padding="3,2" 
                                Background="#fff9e6" BorderBrush="#e6a800" BorderThickness="1" Cursor="Hand" Click="BtnXemTheoThuMuc_Click">
                            <TextBlock Text="📋" FontSize="12"/>
                        </Button>
                        <Button x:Name="BtnLamMoiTree" ToolTip="Tải lại danh mục" Margin="1,0" Padding="3,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnLamMoiTree_Click">
                            <TextBlock Text="🔄" Foreground="#2980b9" FontSize="12.5"/>
                        </Button>
                    </StackPanel>

                    <!-- Nút chuyển đổi bộ lọc cây (Nhân viên / Lý do thưởng phạt) ở góc phải khung bên trái -->
                    <Button x:Name="BtnTreeSwitcher" DockPanel.Dock="Right" Width="26" Height="22" Margin="0,0,2,0"
                            Background="#f4f7fb" BorderBrush="#a4bce3" BorderThickness="1"
                            ToolTip="Chuyển đổi bộ lọc (Nhân viên / Lý do thưởng phạt)"
                            Cursor="Hand" Click="BtnTreeSwitcher_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🗂️" FontSize="11" Margin="0,0,1,0"/>
                            <Polygon Points="0,0 6,0 3,4" Fill="#1e3f66" VerticalAlignment="Center" Margin="1,1,0,0"/>
                        </StackPanel>
                    </Button>
                </DockPanel>
            </Border>

            <!-- Cây hiển thị Nhân viên / Lý do thưởng phạt -->
            <Border Grid.Row="2" Background="White" BorderBrush="#b6cadf" BorderThickness="1" Margin="4,0,0,4">
                <TreeView x:Name="TvDanhMuc" BorderThickness="0" Background="Transparent"
                          SelectedItemChanged="TvDanhMuc_SelectedItemChanged"
                          PreviewMouseRightButtonDown="TvDanhMuc_PreviewMouseRightButtonDown"
                          MouseDoubleClick="TvDanhMuc_MouseDoubleClick">
                    <TreeView.ContextMenu>
                        <ContextMenu x:Name="CmTreeView" Opened="CmTreeView_Opened">
                            <!-- 1. Thêm mới -->
                            <MenuItem x:Name="MenuTreeThemMoi" Header="Thêm mới">
                                <MenuItem x:Name="MenuTreeThemMoiItem" Header="➕  Thêm lý do thưởng phạt" Click="MiThemMoiItem_Click"/>
                                <MenuItem x:Name="MenuTreeThemNhanhGoc" Header="Thêm nhanh" Click="MiThemNhanhGoc_Click"/>
                                <MenuItem x:Name="MenuTreeThemPhanCach" Header="➖  Thêm phân cách" Click="MiThemPhanCach_Click"/>
                                <MenuItem x:Name="MenuTreeThemThuMucGoc" Header="📁  Thêm thư mục" Click="MiThemThuMucGoc_Click"/>
                            </MenuItem>

                            <!-- 2. Thêm con -->
                            <MenuItem x:Name="MenuTreeThemCon" Header="Thêm con">
                                <MenuItem x:Name="MenuTreeThemConItem" Header="➕  Thêm lý do thưởng phạt" Click="MiThemConItem_Click"/>
                                <MenuItem x:Name="MenuTreeThemNhanhCon" Header="Thêm nhanh" Click="MiThemNhanhCon_Click"/>
                                <MenuItem x:Name="MenuTreeThemThuMucCon" Header="📁  Thêm thư mục" Click="MiThemThuMucCon_Click"/>
                            </MenuItem>

                            <!-- 3. Chỉnh sửa -->
                            <MenuItem x:Name="MenuTreeChinhSua" Header="✏️  Chỉnh sửa" Click="MiChinhSua_Click"/>

                            <!-- 4. Sắp xếp theo -->
                            <MenuItem x:Name="MenuTreeSapXep" Header="Sắp xếp theo">
                                <MenuItem x:Name="MenuTreeSapXepTen" Header="Tên" IsCheckable="True" IsChecked="True" Click="MiSapXepTen_Click"/>
                                <MenuItem x:Name="MenuTreeSapXepTuyChon" Header="Thứ tự tùy chọn" IsCheckable="True" Click="MiSapXepTuyChon_Click"/>
                            </MenuItem>

                            <!-- 5. Refresh -->
                            <MenuItem x:Name="MenuTreeRefresh" Header="Refresh" Click="BtnLamMoiTree_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="🔄" Foreground="#27ae60" FontSize="11" VerticalAlignment="Center"/>
                                </MenuItem.Icon>
                            </MenuItem>

                            <Separator/>

                            <!-- 6. Sao chép, Mở rộng, Thu gọn -->
                            <MenuItem x:Name="MenuTreeSaoChep" Header="Sao chép" Click="MiTreeSaoChep_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="📑" Foreground="Navy" FontSize="11" VerticalAlignment="Center"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuTreeMoRong" Header="Mở rộng" Click="MiTreeMoRong_Click"/>
                            <MenuItem x:Name="MenuTreeThuGon" Header="Thu gọn" Click="MiTreeThuGon_Click"/>

                            <Separator/>

                            <!-- 7. Xóa, Đổi tên, Thùng rác -->
                            <MenuItem x:Name="MenuTreeXoa" Header="Xóa" Click="MiTreeXoa_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="❌" Foreground="#e74c3c" FontSize="11" VerticalAlignment="Center"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuTreeDoiTen" Header="Đổi tên" Click="MiTreeDoiTen_Click"/>
                            <MenuItem x:Name="MenuTreeThungRac" Header="Thùng rác" Click="MiTreeThungRac_Click"/>

                            <Separator/>

                            <!-- 8. Biểu tượng, Thuộc tính -->
                            <MenuItem x:Name="MenuTreeBieuTuong" Header="Biểu tượng" Click="MiTreeBieuTuong_Click"/>
                            <MenuItem x:Name="MenuTreeThuocTinh" Header="Thuộc tính" Click="MiTreeThuocTinh_Click"/>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            <Setter Property="Padding" Value="2,2"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="1,1">
                                <TextBlock Text="{Binding IconText}" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" FontSize="11.5" Foreground="#1e3f66" VerticalAlignment="Center"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>
        </Grid>

        <!-- SPLITTER VÀ NÚT CHUYỂN ĐỔI BỘ LỌC CÂY (NHÂN VIÊN / LÝ DO THƯỞNG PHẠT) -->
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#c2d5ea" Cursor="SizeWE"/>

        <!-- ==================== 2. KHUNG BÊN PHẢI: BẢNG DỮ LIỆU THƯỞNG PHẠT ==================== -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Tab Header Thưởng phạt + Switcher -->
                <RowDefinition Height="Auto"/> <!-- Main Action Toolbar -->
                <RowDefinition Height="*"/>    <!-- DataGrid -->
                <RowDefinition Height="Auto"/> <!-- Footer / Summary Status -->
            </Grid.RowDefinitions>

            <!-- Tab Header Thưởng phạt -->
            <Border Grid.Row="0" Style="{StaticResource HeaderTabStyle}" Margin="0,4,4,0">
                <Grid>
                    <TextBlock Text="Thưởng phạt" FontWeight="Bold" FontSize="12.5" Foreground="#1e3f66" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Main Action Toolbar -->
            <Border Grid.Row="1" Background="#dfe9f5" BorderBrush="#b6cadf" BorderThickness="0,1,1,1" Margin="0,0,4,0" Padding="4,3">
                <DockPanel LastChildFill="False">
                    <!-- Ô lọc F3 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Lọc (F3):" VerticalAlignment="Center" Margin="4,0,4,0" Foreground="#1e3f66" FontWeight="SemiBold" FontSize="11.5"/>
                        <TextBox x:Name="TxtSearch" Width="140" Height="22" VerticalContentAlignment="Center" Padding="4,0"
                                 Background="White" BorderBrush="#a4bce3" TextChanged="TxtSearch_TextChanged"/>
                    </StackPanel>

                    <!-- Các nút tác vụ nghiệp vụ -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <!-- Thêm mới (Insert) -->
                        <Button x:Name="BtnThemMoi" Style="{StaticResource ToolbarActionBtnStyle}" Click="BtnThemMoi_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="➕" FontSize="12" Foreground="#27ae60" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Thêm mới (Insert)" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Chỉnh sửa (F4) -->
                        <Button x:Name="BtnChinhSua" Style="{StaticResource ToolbarActionBtnStyle}" Click="BtnChinhSua_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✏️" FontSize="11" Foreground="#f39c12" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Chỉnh sửa (F4)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Xóa (Del) -->
                        <Button x:Name="BtnXoa" Style="{StaticResource ToolbarActionBtnStyle}" Click="BtnXoa_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="❌" FontSize="11" Foreground="#e74c3c" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Xóa (Del)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Thêm excel -->
                        <Button x:Name="BtnImportExcel" Style="{StaticResource ToolbarActionBtnStyle}" Click="BtnImportExcel_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="11" Foreground="#16a085" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Thêm excel" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Xuất excel -->
                        <Button x:Name="BtnExportExcel" Style="{StaticResource ToolbarActionBtnStyle}" Click="BtnExportExcel_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📤" FontSize="11" Foreground="#2980b9" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Xuất excel" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- In -->
                        <Button x:Name="BtnIn" Style="{StaticResource ToolbarActionBtnStyle}" Click="BtnIn_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖨️" FontSize="11" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                <TextBlock Text="In" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Tổng -->
                        <Button x:Name="BtnTong" Style="{StaticResource ToolbarActionBtnStyle}" Click="BtnTong_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="∑" FontSize="13" FontWeight="Bold" Margin="0,0,2,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Tổng" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- P.tích -->
                        <Button x:Name="BtnPhanTich" Style="{StaticResource ToolbarActionBtnStyle}" Click="BtnPhanTich_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="11" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                <TextBlock Text="P.tích" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- DataGrid Danh sách Thưởng phạt -->
            <DataGrid x:Name="DgThuongPhat" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserResizeRows="False" IsReadOnly="True" SelectionMode="Single"
                      HeadersVisibility="Column" GridLinesVisibility="All" HorizontalGridLinesBrush="#e2e8f0"
                      VerticalGridLinesBrush="#e2e8f0" RowHeaderWidth="0" Background="White"
                      RowHeight="24" ColumnHeaderHeight="26" Margin="0,0,4,0"
                      RowStyle="{StaticResource DataGridRowStyle}"
                      MouseDoubleClick="DgThuongPhat_MouseDoubleClick">
                <DataGrid.ContextMenu>
                    <ContextMenu x:Name="GridContextMenu" Opened="GridContextMenu_Opened">
                        <!-- 1. Thêm Thưởng phạt -->
                        <MenuItem x:Name="MenuThem" Header="Thêm Thưởng phạt" Click="BtnThemMoi_Click">
                            <MenuItem.Icon>
                                <TextBlock Text="➕" Foreground="#27ae60" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <!-- 2. Thêm nhanh (excel) -->
                        <MenuItem x:Name="MenuThemNhanhExcel" Header="Thêm nhanh (excel)" Click="BtnImportExcel_Click"/>
                        <!-- 3. Cập nhật nhanh (excel) -->
                        <MenuItem x:Name="MenuCapNhatNhanhExcel" Header="Cập nhật nhanh (excel)" Click="BtnImportExcel_Click"/>
                        <!-- 4. Chỉnh sửa -->
                        <MenuItem x:Name="MenuChinhSua" Header="Chỉnh sửa" Click="BtnChinhSua_Click">
                            <MenuItem.Icon>
                                <TextBlock Text="✏️" Foreground="#f39c12" FontSize="11" VerticalAlignment="Center"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <!-- 5. Lọc {Tên Cột} -->
                        <MenuItem x:Name="MenuLocCot" Header="Lọc Số phiếu" Click="MenuLocCot_Click"/>
                        <!-- 6. Sắp xếp theo -->
                        <MenuItem x:Name="MenuSapXep" Header="Sắp xếp theo">
                            <MenuItem Header="Sắp xếp tăng dần" Click="MenuItem_SortAsc_Click"/>
                            <MenuItem Header="Sắp xếp giảm dần" Click="MenuItem_SortDesc_Click"/>
                            <Separator/>
                            <MenuItem Header="Số phiếu" Click="MenuItem_SortBySoPhieu_Click"/>
                            <MenuItem Header="Ngày" Click="MenuItem_SortByNgay_Click"/>
                            <MenuItem Header="Nhân viên" Click="MenuItem_SortByNhanVien_Click"/>
                            <MenuItem Header="Thưởng" Click="MenuItem_SortByThuong_Click"/>
                            <MenuItem Header="Phạt" Click="MenuItem_SortByPhat_Click"/>
                            <MenuItem Header="Lý do thưởng phạt" Click="MenuItem_SortByLyDo_Click"/>
                            <MenuItem Header="Ghi chú" Click="MenuItem_SortByGhiChu_Click"/>
                        </MenuItem>
                        <!-- 7. Refresh -->
                        <MenuItem x:Name="MenuRefresh" Header="Refresh" Click="BtnReload_Click">
                            <MenuItem.Icon>
                                <TextBlock Text="🔄" Foreground="#27ae60" FontSize="11" VerticalAlignment="Center"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <!-- 8. In danh sách -->
                        <MenuItem x:Name="MenuInDanhSach" Header="In danh sách" Click="BtnIn_Click"/>
                        <Separator/>
                        <!-- 9. Sao chép ô -->
                        <MenuItem x:Name="MenuSaoChepO" Header="Sao chép ô" Click="MenuItem_SaoChepO_Click">
                            <MenuItem.Icon>
                                <TextBlock Text="📄" Foreground="Navy" FontSize="11" VerticalAlignment="Center"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <!-- 10. Sao chép vùng chọn -->
                        <MenuItem x:Name="MenuSaoChepVungChon" Header="Sao chép vùng chọn" Click="MenuItem_SaoChepVungChon_Click">
                            <MenuItem.Icon>
                                <TextBlock Text="📑" Foreground="Navy" FontSize="11" VerticalAlignment="Center"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <!-- 11. Xóa -->
                        <MenuItem x:Name="MenuXoa" Header="Xóa" Click="BtnXoa_Click">
                            <MenuItem.Icon>
                                <TextBlock Text="❌" Foreground="#e74c3c" FontSize="11" VerticalAlignment="Center"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <!-- 12. Tự động giãn cột -->
                        <MenuItem x:Name="MenuTuDongGianCot" Header="Tự động giãn cột" Click="MenuItem_TuDongGianCot_Click"/>
                        <!-- 13. Cột hiển thị -->
                        <MenuItem x:Name="MenuCotHienThi" Header="Cột hiển thị" Click="MenuCotHienThi_Click"/>
                        <!-- 14. Thuộc tính -->
                        <MenuItem x:Name="MenuThuocTinh" Header="Thuộc tính" Click="MenuItem_ThuocTinh_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#dfe9f5"/>
                        <Setter Property="Foreground" Value="#1e3f66"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="11.5"/>
                        <Setter Property="BorderBrush" Value="#b6cadf"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="4,2"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <!-- 1. Số phiếu -->
                    <DataGridTextColumn Header="Số phiếu" Binding="{Binding SoPhieu}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="6,0"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#0055aa"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- 2. Ngày -->
                    <DataGridTextColumn Header="Ngày" Binding="{Binding NgayStr}" Width="95">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- 3. Nhân viên -->
                    <DataGridTextColumn Header="Nhân viên" Binding="{Binding TenNhanVien}" Width="160">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="6,0"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- 4. Thưởng -->
                    <DataGridTextColumn Header="Thưởng" Binding="{Binding ThuongStr}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Padding" Value="0,0,8,0"/>
                                <Setter Property="Foreground" Value="#107c41"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- 5. Phạt -->
                    <DataGridTextColumn Header="Phạt" Binding="{Binding PhatStr}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Padding" Value="0,0,8,0"/>
                                <Setter Property="Foreground" Value="#d83b01"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- 6. Lý do thưởng phạt -->
                    <DataGridTextColumn Header="Lý do thưởng phạt" Binding="{Binding TenLyDo}" Width="180">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- 7. Ghi chú -->
                    <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="6,0"/>
                                <Setter Property="Foreground" Value="#555555"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 3. FOOTER / SUMMARY STATUS BAR -->
            <Border Grid.Row="3" Background="#dfe9f5" BorderBrush="#b6cadf" BorderThickness="0,1,1,1" Margin="0,0,4,4" Padding="8,4">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Số dòng: " Foreground="#1e3f66" FontWeight="SemiBold" FontSize="11.5"/>
                        <TextBlock x:Name="TxtTotalCount" Text="0" FontWeight="Bold" Foreground="#0055aa" Margin="0,0,16,0" FontSize="11.5"/>

                        <TextBlock Text="Tổng thưởng: " Foreground="#1e3f66" FontWeight="SemiBold" FontSize="11.5"/>
                        <TextBlock x:Name="TxtTotalThuong" Text="0 VNĐ" FontWeight="Bold" Foreground="#107c41" Margin="0,0,16,0" FontSize="11.5"/>

                        <TextBlock Text="Tổng phạt: " Foreground="#1e3f66" FontWeight="SemiBold" FontSize="11.5"/>
                        <TextBlock x:Name="TxtTotalPhat" Text="0 VNĐ" FontWeight="Bold" Foreground="#d83b01" FontSize="11.5"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
