<Window x:Class="QuanLyBar.Client.Views.NhanSu.ThemPhieuTamUngLuongWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TẠM ỨNG LƯƠNG" Height="380" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#dce7f5" WindowStyle="SingleBorderWindow"
        FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>
        <!-- Style Footer Button -->
        <Style x:Key="ActionBtnStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="75"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#f4f7fb"/>
            <Setter Property="BorderBrush" Value="#a4bce3"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e6f0fa"/>
                    <Setter Property="BorderBrush" Value="#6495ed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0. Header -->
            <RowDefinition Height="*"/>    <!-- 1. Form content -->
            <RowDefinition Height="Auto"/> <!-- 2. Footer -->
        </Grid.RowDefinitions>

        <!-- 0. HEADER -->
        <Border Grid.Row="0" Background="#fffde6" BorderBrush="#e2d6b5" BorderThickness="0,0,0,1" Padding="15,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="💵" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtHeaderTitle" Text="Phiếu tạm ứng lương" FontSize="15" FontWeight="Bold" Foreground="#112233"/>
                    <TextBlock Text="Lập và quản lý phiếu tạm ứng lương cho nhân viên" FontSize="11" Foreground="#64748b"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 1. FORM CONTENT -->
        <Border Grid.Row="1" Padding="20,15" Background="#dce7f5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Dòng 0: Số phiếu -->
                    <RowDefinition Height="Auto"/> <!-- Dòng 1: Ngày lập -->
                    <RowDefinition Height="Auto"/> <!-- Dòng 2: Nhân viên -->
                    <RowDefinition Height="Auto"/> <!-- Dòng 3: Số tiền -->
                    <RowDefinition Height="Auto"/> <!-- Dòng 4: Ghi chú -->
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 0. Số phiếu -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Số phiếu:" VerticalAlignment="Center" Margin="0,5" Foreground="#1e293b"/>
                <TextBox x:Name="TxtSoPhieu" Grid.Row="0" Grid.Column="1" Height="24" Margin="0,4" Background="White" BorderBrush="#a0b8d4" VerticalContentAlignment="Center" Padding="4,0"/>

                <!-- 1. Ngày lập -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Ngày lập:" VerticalAlignment="Center" Margin="0,5" Foreground="#1e293b"/>
                <DatePicker x:Name="DpNgay" Grid.Row="1" Grid.Column="1" Height="24" Margin="0,4" Background="White" BorderBrush="#a0b8d4" VerticalContentAlignment="Center"/>

                <!-- 2. Nhân viên nhận -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Nhân viên nhận:" VerticalAlignment="Center" Margin="0,5" Foreground="#1e293b"/>
                <ComboBox x:Name="CboNhanVien" Grid.Row="2" Grid.Column="1" Height="24" Margin="0,4" Background="White" BorderBrush="#a0b8d4"
                          DisplayMemberPath="NAME" SelectedValuePath="ID" VerticalContentAlignment="Center"/>

                <!-- 3. Số tiền tạm ứng -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Số tiền tạm ứng:" VerticalAlignment="Center" Margin="0,5" Foreground="#1e293b" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtSoTien" Grid.Row="3" Grid.Column="1" Height="24" Margin="0,4" Background="#fffdf0" BorderBrush="#f39c12" BorderThickness="1.5"
                         FontWeight="Bold" Foreground="#d9534f" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Padding="4,0" Text="0"
                         TextChanged="TxtSoTien_TextChanged"/>

                <!-- 4. Ghi chú / Diễn giải -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Ghi chú:" VerticalAlignment="Top" Margin="0,8" Foreground="#1e293b"/>
                <TextBox x:Name="TxtGhiChu" Grid.Row="4" Grid.Column="1" Height="60" Margin="0,4" TextWrapping="Wrap" AcceptsReturn="True" Background="White" BorderBrush="#a0b8d4" VerticalContentAlignment="Top" Padding="4"/>
            </Grid>
        </Border>

        <!-- 2. FOOTER -->
        <Border Grid.Row="2" Background="#eaf1fa" BorderBrush="#b6cadf" BorderThickness="0,1,0,0" Padding="10,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- Lưu -->
                <Button x:Name="BtnLuu" Style="{StaticResource ActionBtnStyle}" Width="70" Click="BtnLuu_Click" ToolTip="Ctrl+L">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💾" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Lưu" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!-- Lưu & Mới -->
                <Button x:Name="BtnLuuVaMoi" Style="{StaticResource ActionBtnStyle}" Width="78" Click="BtnLuuVaMoi_Click" ToolTip="Ctrl+S">
                    <TextBlock Text="Lưu &amp; Mới" VerticalAlignment="Center"/>
                </Button>
                <!-- Lưu & Thoát -->
                <Button x:Name="BtnLuuVaThoat" Style="{StaticResource ActionBtnStyle}" Width="84" Background="White" BorderBrush="#0078d7" BorderThickness="1.5" FontWeight="SemiBold" Click="BtnLuuVaThoat_Click">
                    <TextBlock Text="Lưu &amp; thoát" VerticalAlignment="Center"/>
                </Button>
                <!-- Thoát -->
                <Button x:Name="BtnThoat" Style="{StaticResource ActionBtnStyle}" Width="70" Click="BtnThoat_Click" Content="Thoát"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
