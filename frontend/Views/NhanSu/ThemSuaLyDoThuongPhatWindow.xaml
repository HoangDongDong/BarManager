<Window x:Class="QuanLyBar.Client.Views.NhanSu.ThemSuaLyDoThuongPhatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lý do thưởng phạt"
        Width="490" Height="270"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#bfd3e8"
        FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>
        <Style x:Key="FooterBtnStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="85"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#a0b4cc"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#fff2a8"/>
                    <Setter Property="BorderBrush" Value="#f5a623"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Header -->
            <RowDefinition Height="*"/>    <!-- Form Fields -->
            <RowDefinition Height="Auto"/> <!-- Bottom Buttons -->
        </Grid.RowDefinitions>

        <!-- TOP HEADER -->
        <Border Grid.Row="0" Background="White" BorderBrush="#cbd5e1" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📝" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtHeaderTitle" Text="Chỉnh sửa lý do thưởng phạt" FontWeight="Bold" FontSize="13" Foreground="#0f172a" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- MAIN FORM -->
        <Grid Grid.Row="1" Margin="14,10,14,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="135"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="55"/>
            </Grid.ColumnDefinitions>

            <!-- Row 0: Tên lý do & Ảnh -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Tên lý do thưởng phạt" VerticalAlignment="Center" Foreground="#1e3f66" FontWeight="SemiBold"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtName" Height="22" VerticalContentAlignment="Center" Background="White" BorderBrush="#0055aa" BorderThickness="1" Padding="3,0"/>

            <TextBlock Grid.Row="0" Grid.Column="2" Text="Ảnh:" Margin="10,0,4,0" VerticalAlignment="Center" Foreground="#1e3f66" FontWeight="SemiBold"/>
            <ComboBox Grid.Row="0" Grid.Column="3" x:Name="CboAnh" Height="22" Background="White" VerticalContentAlignment="Center"/>

            <!-- Row 1: Ghi chú -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ghi chú:" Margin="0,6,0,0" VerticalAlignment="Top" Foreground="#1e3f66" FontWeight="SemiBold"/>
            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" x:Name="TxtGhiChu" Margin="0,6,0,0" Background="White" BorderBrush="#a4bce3"
                     TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
        </Grid>

        <!-- BOTTOM BUTTONS -->
        <Border Grid.Row="2" Padding="14,6,14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnGhiDuLieu" Style="{StaticResource FooterBtnStyle}" Content="Ghi dữ liệu" Click="BtnGhiDuLieu_Click"/>
                <Button x:Name="BtnThoat" Style="{StaticResource FooterBtnStyle}" Content="Thoát" Click="BtnThoat_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
