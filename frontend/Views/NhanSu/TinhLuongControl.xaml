<UserControl x:Class="QuanLyBar.Client.Views.NhanSu.TinhLuongControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             FontFamily="Segoe UI" FontSize="12">

    <UserControl.Resources>
        <!-- Toolbar Action Button Style -->
        <Style x:Key="TinhLuongToolBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#fff0b3"/>
                    <Setter Property="BorderBrush" Value="#f5a623"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Save Update Button Style -->
        <Style x:Key="CapNhatBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#f4f8fc"/>
            <Setter Property="BorderBrush" Value="#a0b8d4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1e3f66"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e0edfc"/>
                    <Setter Property="BorderBrush" Value="#0078d7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Left Table Row Selection Style -->
        <Style x:Key="LeftGridRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#43a047"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#f0f4fa">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" MinWidth="140" MaxWidth="320"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== 1. KHUNG BÊN TRÁI: BẢNG LƯƠNG ==================== -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Action Toolbar (Thêm, Sửa, Xóa) -->
                <RowDefinition Height="*"/>    <!-- DataGrid Bảng lương -->
            </Grid.RowDefinitions>

            <!-- Action Toolbar (Thêm, Sửa, Xóa) -->
            <Border Grid.Row="0" Background="#dfe9f5" BorderBrush="#b6cadf" BorderThickness="1,1,1,1" Margin="4,4,0,0" Padding="3,3">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- + Thêm -->
                    <Button x:Name="BtnThemBangLuong" Style="{StaticResource TinhLuongToolBtnStyle}" Click="BtnThemBangLuong_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕" Foreground="#27ae60" FontWeight="Bold" FontSize="11" Margin="0,0,3,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Thêm" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- ✏️ Sửa -->
                    <Button x:Name="BtnSuaBangLuong" Style="{StaticResource TinhLuongToolBtnStyle}" Click="BtnSuaBangLuong_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✏️" Foreground="#f39c12" FontSize="11" Margin="0,0,3,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Sửa" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- ❌ Xóa -->
                    <Button x:Name="BtnXoaBangLuong" Style="{StaticResource TinhLuongToolBtnStyle}" Click="BtnXoaBangLuong_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="❌" Foreground="#e74c3c" FontSize="11" Margin="0,0,3,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Xóa" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- DataGrid Danh sách Bảng lương -->
            <Border Grid.Row="1" Background="White" BorderBrush="#b6cadf" BorderThickness="1,0,1,1" Margin="4,0,0,4">
                <DataGrid x:Name="DgBangLuong" AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserResizeRows="False" IsReadOnly="True" SelectionMode="Single"
                          HeadersVisibility="All" GridLinesVisibility="All" HorizontalGridLinesBrush="#b6cadf"
                          VerticalGridLinesBrush="#b6cadf" RowHeaderWidth="24" Background="White"
                          RowHeight="26" ColumnHeaderHeight="26"
                          RowStyle="{StaticResource LeftGridRowStyle}"
                          SelectionChanged="DgBangLuong_SelectionChanged"
                          LoadingRow="DgBangLuong_LoadingRow"
                          MouseDoubleClick="DgBangLuong_MouseDoubleClick"
                          PreviewMouseRightButtonDown="DgBangLuong_PreviewMouseRightButtonDown">
                    <DataGrid.ContextMenu>
                        <ContextMenu x:Name="CmBangLuong">
                            <!-- 1. Thêm Bảng lương -->
                            <MenuItem Header="Thêm Bảng lương" Click="BtnThemBangLuong_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="➕" Foreground="#27ae60" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <!-- 2. Chỉnh sửa -->
                            <MenuItem Header="Chỉnh sửa" Click="BtnSuaBangLuong_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="✏️" Foreground="#f39c12" FontSize="11" VerticalAlignment="Center"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <!-- 3. Sắp xếp theo -->
                            <MenuItem Header="Sắp xếp theo">
                                <MenuItem Header="Sắp xếp tăng dần" Click="MenuSortAsc_Click"/>
                                <MenuItem Header="Sắp xếp giảm dần" Click="MenuSortDesc_Click"/>
                                <Separator/>
                                <MenuItem Header="Bảng lương" Click="MenuSortByName_Click"/>
                            </MenuItem>
                            <!-- 4. Refresh -->
                            <MenuItem Header="Refresh" Click="BtnNapLaiBangLuong_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="🔄" Foreground="#27ae60" FontSize="11" VerticalAlignment="Center"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <!-- 5. In danh sách -->
                            <MenuItem Header="In danh sách" Click="BtnInDanhSach_Click"/>
                            <Separator/>
                            <!-- 6. Sao chép ô -->
                            <MenuItem Header="Sao chép ô" Click="MenuSaoChepO_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="📄" Foreground="Navy" FontSize="11" VerticalAlignment="Center"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <!-- 7. Sao chép vùng chọn -->
                            <MenuItem Header="Sao chép vùng chọn" Click="MenuSaoChepVungChon_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="📑" Foreground="Navy" FontSize="11" VerticalAlignment="Center"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <!-- 8. Xóa -->
                            <MenuItem Header="Xóa" Click="BtnXoaBangLuong_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="❌" Foreground="#e74c3c" FontSize="11" VerticalAlignment="Center"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#ffffff"/>
                            <Setter Property="Foreground" Value="#112233"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="BorderBrush" Value="#b6cadf"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="Padding" Value="6,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Bảng lương" Binding="{Binding Name}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="6,0"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- SPLITTER -->
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#c2d5ea" Cursor="SizeWE"/>

        <!-- ==================== 2. KHUNG BÊN PHẢI: BẢNG TÍNH LƯƠNG ĐẦY ĐỦ ==================== -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Top Bar: Status Legends + Nút chức năng -->
                <RowDefinition Height="*"/>    <!-- DataGrid Ma trận Tính Lương -->
                <RowDefinition Height="Auto"/> <!-- Footer Status Bar -->
            </Grid.RowDefinitions>

            <!-- Top Bar: Status Legends + Nút Chức Năng -->
            <Border Grid.Row="0" Background="#dfe9f5" BorderBrush="#b6cadf" BorderThickness="0,1,1,1" Margin="0,4,4,0" Padding="6,4">
                <DockPanel LastChildFill="False">
                    <!-- Status Action Buttons matching screenshot -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                        <!-- Nút 1: Không có lịch -->
                        <Button x:Name="BtnKhongCoLich" Style="{StaticResource TinhLuongToolBtnStyle}" Padding="6,3" Margin="2,0,8,0" Click="BtnKhongCoLich_Click" ToolTip="Gán trạng thái 'Không có lịch' cho các ô đang chọn">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#ffffff" BorderBrush="#94a3b8" BorderThickness="1" CornerRadius="1" Width="18" Height="18" Margin="0,0,6,0"/>
                                <TextBlock Text="Không có lịch" VerticalAlignment="Center" FontSize="11.5" Foreground="#334155"/>
                            </StackPanel>
                        </Button>

                        <!-- Nút 2: Đi làm (Đỏ) -->
                        <Button x:Name="BtnDiLam" Style="{StaticResource TinhLuongToolBtnStyle}" Padding="6,3" Margin="0,0,8,0" Click="BtnDiLam_Click" ToolTip="Gán trạng thái 'Đi làm' cho các ô đang chọn">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#e60000" BorderBrush="#b91c1c" BorderThickness="1" CornerRadius="1" Width="18" Height="18" Margin="0,0,6,0"/>
                                <TextBlock Text="Đi làm" VerticalAlignment="Center" FontSize="11.5" Foreground="#334155"/>
                            </StackPanel>
                        </Button>

                        <!-- Nút 3: Nghỉ có phép (Xanh lá) -->
                        <Button x:Name="BtnNghiCoPhep" Style="{StaticResource TinhLuongToolBtnStyle}" Padding="6,3" Margin="0,0,8,0" Click="BtnNghiCoPhep_Click" ToolTip="Gán trạng thái 'Nghỉ có phép' cho các ô đang chọn">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#00cc00" BorderBrush="#15803d" BorderThickness="1" CornerRadius="1" Width="18" Height="18" Margin="0,0,6,0"/>
                                <TextBlock Text="Nghỉ có phép" VerticalAlignment="Center" FontSize="11.5" Foreground="#334155"/>
                            </StackPanel>
                        </Button>

                        <!-- Nút 4: Nghỉ không phép (Xanh ngọc / Cyan) -->
                        <Button x:Name="BtnNghiKhongPhep" Style="{StaticResource TinhLuongToolBtnStyle}" Padding="6,3" Margin="0,0,8,0" Click="BtnNghiKhongPhep_Click" ToolTip="Gán trạng thái 'Nghỉ không phép' cho các ô đang chọn">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#00e6d2" BorderBrush="#0891b2" BorderThickness="1" CornerRadius="1" Width="18" Height="18" Margin="0,0,6,0"/>
                                <TextBlock Text="Nghỉ không phép" VerticalAlignment="Center" FontSize="11.5" Foreground="#334155"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Nút chức năng ở góc phải -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <!-- 🔄 Refresh lương -->
                        <Button x:Name="BtnRefreshLuong" Style="{StaticResource TinhLuongToolBtnStyle}" Padding="6,3" Margin="0,0,6,0" Click="BtnRefreshLuong_Click" ToolTip="Tính toán lại toàn bộ lương, thưởng, phạt, tạm ứng">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄" FontSize="11" Foreground="#27ae60" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Refresh lương" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- 💵 Chi lương -->
                        <Button x:Name="BtnChiLuong" Style="{StaticResource TinhLuongToolBtnStyle}" Padding="6,3" Margin="0,0,6,0" Click="BtnChiLuong_Click" ToolTip="Lập phiếu chi trả lương cho nhân viên trong bảng lương này">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💵" FontSize="11" Foreground="#2980b9" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Chi lương" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- 💾 Cập nhật -->
                        <Button x:Name="BtnCapNhat" Style="{StaticResource CapNhatBtnStyle}" Click="BtnCapNhat_Click" ToolTip="Lưu bảng chấm công và bảng tổng hợp lương">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Cập nhật" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- DataGrid Ma trận Tính Lương -->
            <Border Grid.Row="1" Background="White" BorderBrush="#b6cadf" BorderThickness="0,0,1,1" Margin="0,0,4,0">
                <DataGrid x:Name="DgTinhLuong" AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserResizeRows="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="Cell"
                          HeadersVisibility="Column" GridLinesVisibility="All" HorizontalGridLinesBrush="#c8d7e6"
                          VerticalGridLinesBrush="#c8d7e6" RowHeaderWidth="0" Background="White"
                          RowHeight="24" ColumnHeaderHeight="36"
                          FrozenColumnCount="2"
                          PreviewMouseRightButtonDown="DgTinhLuong_PreviewMouseRightButtonDown">
                    <DataGrid.ContextMenu>
                        <ContextMenu x:Name="CmTinhLuong">
                            <MenuItem Header="Không có lịch" Click="BtnKhongCoLich_Click">
                                <MenuItem.Icon>
                                    <Border Background="#ffffff" BorderBrush="#94a3b8" BorderThickness="1" Width="16" Height="16"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Đi làm" Click="BtnDiLam_Click">
                                <MenuItem.Icon>
                                    <Border Background="#e60000" Width="16" Height="16"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Nghỉ có phép" Click="BtnNghiCoPhep_Click">
                                <MenuItem.Icon>
                                    <Border Background="#00cc00" Width="16" Height="16"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Nghỉ không phép" Click="BtnNghiKhongPhep_Click">
                                <MenuItem.Icon>
                                    <Border Background="#00e6d2" Width="16" Height="16"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#ffffff"/>
                            <Setter Property="Foreground" Value="#112233"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="11.5"/>
                            <Setter Property="BorderBrush" Value="#b6cadf"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="2,2"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                </DataGrid>
            </Border>

            <!-- Footer Status Bar -->
            <Border Grid.Row="2" Background="#dfe9f5" BorderBrush="#b6cadf" BorderThickness="0,1,1,1" Margin="0,0,4,4" Padding="8,4">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                        <TextBlock Text="Tổng số nhân viên: " Foreground="#1e3f66" FontWeight="SemiBold" FontSize="11.5"/>
                        <TextBlock x:Name="TxtTotalNhanVien" Text="0" FontWeight="Bold" Foreground="#0055aa" Margin="0,0,20,0" FontSize="11.5"/>

                        <TextBlock Text="Bảng lương: " Foreground="#1e3f66" FontWeight="SemiBold" FontSize="11.5"/>
                        <TextBlock x:Name="TxtSelectedBangLuongName" Text="-" FontWeight="Bold" Foreground="#112233" Margin="0,0,20,0" FontSize="11.5"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right">
                        <TextBlock Text="Tổng lương: " Foreground="#1e3f66" FontWeight="SemiBold" FontSize="11.5"/>
                        <TextBlock x:Name="TxtTotalTongLuong" Text="0 VNĐ" FontWeight="Bold" Foreground="#0055aa" Margin="0,0,20,0" FontSize="11.5"/>

                        <TextBlock Text="Tổng thực nhận: " Foreground="#1e3f66" FontWeight="SemiBold" FontSize="11.5"/>
                        <TextBlock x:Name="TxtTotalThucNhan" Text="0 VNĐ" FontWeight="Bold" Foreground="#d9534f" FontSize="12"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
