<UserControl x:Class="QuanLyBar.Client.Views.PhieuThuChi.DanhMucPhieuThuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:QuanLyBar.Client.Services"
             Background="#f0f4fa">

    <UserControl.Resources>
        <Style x:Key="HeaderTabStyle" TargetType="Border">
            <Setter Property="Background" Value="#dfe9f5"/>
            <Setter Property="BorderBrush" Value="#a3bde0"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="CornerRadius" Value="3,3,0,0"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <Style x:Key="ActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#9cb2c8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#fff0b3"/>
                    <Setter Property="BorderBrush" Value="#f5a623"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#f0f4fa">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" MinWidth="180" MaxWidth="360"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================== -->
        <!-- 1. CỘT TRÁI: BỘ LỌC NGÀY & CÂY PHÂN LOẠI       -->
        <!-- ============================================== -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header: Lý do thu chi -->
                <RowDefinition Height="Auto"/> <!-- Bộ lọc Ngày & Cửa hàng -->
                <RowDefinition Height="Auto"/> <!-- Sub Toolbar cây -->
                <RowDefinition Height="*"/>    <!-- TreeView -->
            </Grid.RowDefinitions>

            <!-- 0. Header Tab -->
            <Border Grid.Row="0" Style="{StaticResource HeaderTabStyle}" Margin="5,5,0,0">
                <Grid>
                    <TextBlock x:Name="TxtLeftHeaderTitle" Text="Lý do thu chi" FontWeight="Bold" FontSize="12.5" Foreground="#1e3f66" VerticalAlignment="Center"/>
                    <TextBlock Text="⚙️" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" FontSize="12" ToolTip="Quản lý danh mục" MouseLeftButtonDown="BtnCauHinh_Click"/>
                </Grid>
            </Border>

            <!-- 1. Bộ lọc Ngày & Cửa hàng -->
            <Border Grid.Row="1" Background="#eaf1fa" BorderBrush="#b6cadf" BorderThickness="1,1,1,0" Margin="5,0,0,0" Padding="6,4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Ngày Từ -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Ngày:" VerticalAlignment="Center" FontSize="11.5" Foreground="#1e3f66"/>
                    <Grid Grid.Row="0" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Từ:" VerticalAlignment="Center" FontSize="11" Foreground="#475569"/>
                        <DatePicker x:Name="DpFromDate" Grid.Column="1" Height="21" Background="White" BorderBrush="#a4bce3" VerticalContentAlignment="Center" FontSize="11" SelectedDateChanged="Filter_Changed"/>
                    </Grid>

                    <!-- Ngày Đến -->
                    <Grid Grid.Row="1" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Đến:" VerticalAlignment="Center" FontSize="11" Foreground="#475569"/>
                        <DatePicker x:Name="DpToDate" Grid.Column="1" Height="21" Background="White" BorderBrush="#a4bce3" VerticalContentAlignment="Center" FontSize="11" SelectedDateChanged="Filter_Changed"/>
                    </Grid>

                    <!-- Cửa hàng -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Cửa hàng:" VerticalAlignment="Center" FontSize="11" Foreground="#1e3f66"/>
                    <ComboBox x:Name="CboCuaHangFilter" Grid.Row="2" Grid.Column="1" Height="21" Background="White" BorderBrush="#a4bce3"
                              VerticalContentAlignment="Center" DisplayMemberPath="NAME" SelectedValuePath="ID" FontSize="11" SelectionChanged="Filter_Changed"/>
                </Grid>
            </Border>

            <!-- 2. Sub Toolbar Tree -->
            <Border Grid.Row="2" Background="#eaf1fa" BorderBrush="#b6cadf" BorderThickness="1,1,1,0" Margin="5,0,0,0" Padding="2,2">
                <DockPanel LastChildFill="False">
                    <Button x:Name="BtnThem" ToolTip="Thêm mới" Margin="1,0" Padding="3,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnThemLyDo_Click">
                        <TextBlock Text="➕" Foreground="Green" FontSize="12"/>
                    </Button>
                    <Button x:Name="BtnSua" ToolTip="Chỉnh sửa" Margin="1,0" Padding="3,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnSuaLyDo_Click">
                        <TextBlock Text="✏️" FontSize="12"/>
                    </Button>
                    <Button x:Name="BtnThemThuMuc" ToolTip="Tạo mới thư mục" Margin="1,0" Padding="3,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnThemThuMuc_Click">
                        <TextBlock Text="📁" Foreground="#d4a017" FontSize="12"/>
                    </Button>
                    <Button x:Name="BtnXemTheoThuMuc" ToolTip="Hiển thị theo thư mục" Margin="1,0" Padding="3,2" 
                            Background="#fff9e6" BorderBrush="#e6a800" BorderThickness="1" Cursor="Hand" Click="BtnXemTheoThuMuc_Click">
                        <TextBlock Text="🗂️" FontSize="12"/>
                    </Button>
                    <Button x:Name="BtnTaiLai" ToolTip="Tải lại" Margin="1,0" Padding="3,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnTaiLai_Click">
                        <TextBlock Text="🔄" FontSize="12"/>
                    </Button>

                    <!-- Nút Dropdown chế độ phân nhóm bên phải -->
                    <Button x:Name="BtnMenuCheDo" DockPanel.Dock="Right" ToolTip="Chế độ phân nhóm" Margin="2,0" Padding="4,2" 
                            Background="#e2ecf8" BorderBrush="#a4bce3" Cursor="Hand" Click="BtnMenuCheDo_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗂️" FontSize="11" Margin="0,0,2,0"/>
                            <TextBlock Text="▾" FontSize="9" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="CmCheDoPhanNhom">
                                <MenuItem Header="🏷️  Lý do thu chi" Click="MenuCheDoLyDo_Click"/>
                                <MenuItem Header="🏪  Cửa hàng" Click="MenuCheDoCuaHang_Click"/>
                                <MenuItem Header="🏛️  Tài khoản ngân hàng" Click="MenuCheDoTaiKhoan_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </DockPanel>
            </Border>

            <!-- 3. TreeView -->
            <Border Grid.Row="3" Background="White" BorderBrush="#b6cadf" BorderThickness="1" Margin="5,0,0,5">
                <TreeView x:Name="TvFilter" BorderThickness="0"
                          SelectedItemChanged="TvFilter_SelectedItemChanged">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}">
                            <Setter Property="IsExpanded" Value="True"/>
                            <Setter Property="Padding" Value="2,1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type TreeViewItem}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition MinWidth="16" Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>

                                            <!-- Dotted Vertical Line -->
                                            <Rectangle Grid.Column="0" Grid.RowSpan="2" HorizontalAlignment="Left" Margin="7,0,0,0"
                                                       Width="1" Stroke="#a0a0a0" StrokeThickness="1" StrokeDashArray="1 2"/>

                                            <!-- Dotted Horizontal Line -->
                                            <Rectangle Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" Margin="7,0,0,0"
                                                       Height="1" Stroke="#a0a0a0" StrokeThickness="1" StrokeDashArray="1 2"/>

                                            <ToggleButton x:Name="Expander" Grid.Column="0" Grid.Row="0"
                                                          IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                          ClickMode="Press" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Visibility="Hidden">
                                                <ToggleButton.Style>
                                                    <Style TargetType="ToggleButton">
                                                        <Setter Property="Focusable" Value="False"/>
                                                        <Setter Property="Width" Value="9"/>
                                                        <Setter Property="Height" Value="9"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border Width="9" Height="9" Background="White" BorderBrush="#888888" BorderThickness="1">
                                                                        <Path x:Name="ExpandPath" Fill="#333333" Margin="1" Data="M 0 2 L 0 3 L 5 3 L 5 2 Z M 2 0 L 3 0 L 3 5 L 2 5 Z"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsChecked" Value="True">
                                                                            <Setter Property="Data" TargetName="ExpandPath" Value="M 0 2 L 0 3 L 5 3 L 5 2 Z"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ToggleButton.Style>
                                            </ToggleButton>

                                            <Border x:Name="Bd" Grid.Column="1" Grid.Row="0" Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true" CornerRadius="1">
                                                <ContentPresenter x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                            </Border>

                                            <ItemsPresenter x:Name="ItemsHost" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="HasItems" Value="True">
                                                <Setter TargetName="Expander" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#0078d7"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TreeView.ItemContainerStyle>

                    <!-- Context Menu trên TreeView chuẩn theo ảnh thực tế -->
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <!-- 1. Thêm mới -->
                            <MenuItem Header="Thêm mới">
                                <MenuItem x:Name="MenuThemTreeCap1" Header="Thêm lý do thu chi" Click="MenuThemLyDo_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="➕" Foreground="#27ae60" FontSize="11" VerticalAlignment="Center"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Thêm nhanh" Click="MenuThemNhanh_Click"/>
                                <Separator/>
                                <MenuItem Header="Thêm phân cách" Click="MenuThemPhanCach_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="➖" Foreground="#888888" FontSize="11" VerticalAlignment="Center"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="MenuThemThuMucTree" Header="Thêm thư mục" Click="MenuThemThuMuc_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="📁" FontSize="11" VerticalAlignment="Center"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>

                            <!-- 2. Thêm con -->
                            <MenuItem Header="Thêm con">
                                <MenuItem x:Name="MenuThemTreeCon" Header="Thêm lý do thu chi con" Click="MenuThemLyDoCon_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="➕" Foreground="#27ae60" FontSize="11" VerticalAlignment="Center"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="MenuThemThuMucConTree" Header="Thêm thư mục con" Click="MenuThemThuMucCon_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="📁" FontSize="11" VerticalAlignment="Center"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>

                            <!-- 3. Chỉnh sửa -->
                            <MenuItem x:Name="MenuSuaTree" Header="Chỉnh sửa" Click="BtnSuaLyDo_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="✏️" Foreground="#f39c12" FontSize="11" VerticalAlignment="Center"/>
                                </MenuItem.Icon>
                            </MenuItem>

                            <!-- 4. Sắp xếp theo -->
                            <MenuItem Header="Sắp xếp theo">
                                <MenuItem x:Name="MenuSortByName" Header="Tên" IsCheckable="True" IsChecked="True" Click="MenuSapXepTen_Click"/>
                                <MenuItem x:Name="MenuSortByCustom" Header="Thứ tự tùy chọn" IsCheckable="True" IsChecked="False" Click="MenuSapXepThuTu_Click"/>
                            </MenuItem>

                            <!-- 5. Refresh -->
                            <MenuItem Header="Refresh" Click="BtnTaiLai_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="🔄" Foreground="#27ae60" FontSize="11" VerticalAlignment="Center"/>
                                </MenuItem.Icon>
                            </MenuItem>

                            <!-- 6. Sao chép -->
                            <MenuItem Header="Sao chép" Click="MenuSaoChepTree_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="📑" Foreground="#2980b9" FontSize="11" VerticalAlignment="Center"/>
                                </MenuItem.Icon>
                            </MenuItem>

                            <Separator/>

                            <!-- 7. Mở rộng & Thu gọn -->
                            <MenuItem Header="Mở rộng" Click="MenuMoRong_Click"/>
                            <MenuItem Header="Thu gọn" Click="MenuThuGon_Click"/>

                            <Separator/>

                            <!-- 8. Xóa, Đổi tên, Thùng rác -->
                            <MenuItem Header="Xóa" Click="MenuXoaTree_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="❌" Foreground="#e74c3c" FontSize="11" VerticalAlignment="Center"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Đổi tên" Click="BtnSuaLyDo_Click"/>
                            <MenuItem Header="Thùng rác" Click="MenuThungRac_Click"/>

                            <Separator/>

                            <!-- 9. Biểu tượng & Thuộc tính -->
                            <MenuItem Header="Biểu tượng" Click="BtnSuaLyDo_Click"/>
                            <MenuItem Header="Thuộc tính" Click="MenuThuocTinhTree_Click"/>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                </TreeView>
            </Border>
        </Grid>

        <!-- SPLITTER -->
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#cbd5e1" Cursor="SizeWE"/>

        <!-- ============================================== -->
        <!-- 2. CỘT PHẢI: BẢNG DANH MỤC PHIẾU THU           -->
        <!-- ============================================== -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Tab Header: Phiếu thu -->
                <RowDefinition Height="Auto"/> <!-- Toolbar thao tác -->
                <RowDefinition Height="*"/>    <!-- DataGrid danh sách -->
                <RowDefinition Height="Auto"/> <!-- Splitter / Footer tab thông tin -->
                <RowDefinition Height="120" MinHeight="80" MaxHeight="220"/>
            </Grid.RowDefinitions>

            <!-- 0. Tab Header: Phiếu thu -->
            <Border Grid.Row="0" Style="{StaticResource HeaderTabStyle}" Margin="0,5,5,0">
                <TextBlock Text="Phiếu thu" FontWeight="Bold" FontSize="12.5" Foreground="#1e3f66" VerticalAlignment="Center"/>
            </Border>

            <!-- 1. Toolbar -->
            <Border Grid.Row="1" Background="#eaf1fa" BorderBrush="#b6cadf" BorderThickness="1,1,1,0" Margin="0,0,5,0" Padding="4,3">
                <DockPanel LastChildFill="True">
                    <!-- Ô Tìm kiếm / Lọc (F3) -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="Lọc (F3):" VerticalAlignment="Center" FontSize="11.5" Foreground="#1e3f66" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtSearch" Width="140" Height="22" Background="White" BorderBrush="#a4bce3"
                                 VerticalContentAlignment="Center" Padding="4,1" FontSize="11.5" TextChanged="TxtSearch_TextChanged"/>
                    </StackPanel>

                    <!-- Các nút hành động chính -->
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Thêm mới (Insert) -->
                        <Button x:Name="BtnThemMoi" Style="{StaticResource ActionBtnStyle}" Click="BtnThemMoi_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="➕" Foreground="Green" FontSize="11" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Thêm mới (Insert)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Chỉnh sửa (F4) -->
                        <Button x:Name="BtnChinhSua" Style="{StaticResource ActionBtnStyle}" Click="BtnChinhSua_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✏️" Foreground="#f39c12" FontSize="11" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Chỉnh sửa (F4)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Xóa (Del) -->
                        <Button x:Name="BtnXoa" Style="{StaticResource ActionBtnStyle}" Click="BtnXoa_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="❌" Foreground="#e74c3c" FontSize="11" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Xóa (Del)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Thêm excel -->
                        <Button x:Name="BtnThemExcel" Style="{StaticResource ActionBtnStyle}" Click="BtnThemExcel_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="11" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Thêm excel" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Xuất excel -->
                        <Button x:Name="BtnXuatExcel" Style="{StaticResource ActionBtnStyle}" Click="BtnXuatExcel_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📥" FontSize="11" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Xuất excel" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- In -->
                        <Button x:Name="BtnIn" Style="{StaticResource ActionBtnStyle}" Click="BtnIn_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖨️" FontSize="11" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                <TextBlock Text="In" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Tổng -->
                        <Button x:Name="BtnTong" Style="{StaticResource ActionBtnStyle}" Click="BtnTong_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="∑" FontWeight="Bold" FontSize="12" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Tổng" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- P.tích -->
                        <Button x:Name="BtnPhanTich" Style="{StaticResource ActionBtnStyle}" Click="BtnPhanTich_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📈" FontSize="11" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                <TextBlock Text="P.tích" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </DockPanel>
            </Border>

            <!-- 2. DataGrid danh sách phiếu thu -->
            <Border Grid.Row="2" Background="White" BorderBrush="#b6cadf" BorderThickness="1" Margin="0,0,5,0">
                <DataGrid x:Name="DgPhieuThu" AutoGenerateColumns="False" CanUserAddRows="False"
                          IsReadOnly="True" SelectionMode="Single" GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#e2e8f0" VerticalGridLinesBrush="#e2e8f0"
                          AlternatingRowBackground="#f8fafc" RowHeight="23" FontSize="11.5"
                          SelectionChanged="DgPhieuThu_SelectionChanged"
                          MouseDoubleClick="DgPhieuThu_MouseDoubleClick">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Thêm mới phiếu thu (Insert)" Click="BtnThemMoi_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="➕" Foreground="Green" FontSize="11" VerticalAlignment="Center"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Chỉnh sửa phiếu thu (F4)" Click="BtnChinhSua_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="✏️" Foreground="#f39c12" FontSize="11" VerticalAlignment="Center"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Xóa phiếu thu (Del)" Click="BtnXoa_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="❌" Foreground="#e74c3c" FontSize="11" VerticalAlignment="Center"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="In phiếu thu" Click="BtnIn_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="🖨️" FontSize="11" VerticalAlignment="Center"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Xuất ra Excel" Click="BtnXuatExcel_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="📥" FontSize="11" VerticalAlignment="Center"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Tải lại danh sách" Click="BtnTaiLai_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="🔄" Foreground="#27ae60" FontSize="11" VerticalAlignment="Center"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#e2ecf8"/>
                            <Setter Property="Foreground" Value="#1e3f66"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="6,3"/>
                            <Setter Property="BorderBrush" Value="#cbd5e1"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Số phiếu" Binding="{Binding SoPhieu}" Width="100"/>
                        <DataGridTextColumn Header="Ngày" Binding="{Binding Ngay, StringFormat='dd/MM/yyyy'}" Width="85"/>
                        <DataGridTextColumn Header="Tên đối tượng" Binding="{Binding TenDoiTuong}" Width="150"/>
                        <DataGridTextColumn Header="Địa chỉ" Binding="{Binding DiaChi}" Width="130"/>
                        <DataGridTextColumn Header="Lý do thu chi" Binding="{Binding LyDoThuChi}" Width="130"/>
                        <DataGridTextColumn Header="Diễn giải" Binding="{Binding DienGiai}" Width="110"/>
                        <DataGridTextColumn Header="Chứng từ gốc" Binding="{Binding ChungTuGoc}" Width="90"/>
                        <DataGridTextColumn Header="Số tiền" Binding="{Binding SoTien, StringFormat='#,##0'}" Width="95">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="0,0,4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="120"/>
                        <DataGridTextColumn Header="Chuyển khoản" Binding="{Binding ChuyenKhoan}" Width="85"/>
                        <DataGridTextColumn Header="Đặt hàng" Binding="{Binding DatHang}" Width="75"/>
                        <DataGridTextColumn Header="Cửa hàng" Binding="{Binding CuaHang}" Width="110"/>
                        <DataGridTextColumn Header="Là phiếu thu công nợ" Binding="{Binding LaPhieuThuCongNo}" Width="125"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- 3. GridSplitter ngang giữa DataGrid và Footer Tab -->
            <GridSplitter Grid.Row="3" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#cbd5e1" Cursor="SizeNS"/>

            <!-- 4. Footer Tab: Thông tin & Chi tiết thanh toán -->
            <Border Grid.Row="4" Background="#eaf1fa" BorderBrush="#b6cadf" BorderThickness="1" Margin="0,0,5,5">
                <TabControl Background="Transparent" BorderThickness="0">
                    <!-- Tab 1: Thông tin -->
                    <TabItem Header="Thông tin" FontSize="11.5">
                        <Grid Margin="10,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                            </Grid.RowDefinitions>

                            <!-- Hàng 1 -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="Khởi tạo:" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,4,0"/>
                                <TextBlock x:Name="TxtKhoiTao" Text="--"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="Khởi tạo bởi:" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,4,0"/>
                                <TextBlock x:Name="TxtKhoiTaoBoi" Text="--"/>
                            </StackPanel>

                            <!-- Hàng 2 -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="Sửa đổi gần nhất:" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,4,0"/>
                                <TextBlock x:Name="TxtSuaDoi" Text="--"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="Sửa đổi bởi:" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,4,0"/>
                                <TextBlock x:Name="TxtSuaDoiBoi" Text="--"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- Tab 2: Chi tiết thanh toán -->
                    <TabItem Header="Chi tiết thanh toán" FontSize="11.5">
                        <Grid Margin="10,6">
                            <TextBlock x:Name="TxtChiTietThanhToan" Text="Chưa có dữ liệu thanh toán chi tiết." Foreground="#64748b"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>
