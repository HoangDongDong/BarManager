<Window x:Class="QuanLyBar.Client.Views.NguoiDungPhanQuyen.DoiMatKhauWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đổi mật khẩu" Height="275" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#D5E3F5" FontFamily="Segoe UI" FontSize="12">

    <Grid Margin="18,15,18,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: Lock icon & Account title -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
            <!-- Golden Padlock Icon -->
            <Viewbox Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center">
                <Canvas Width="32" Height="32">
                    <!-- Shackle -->
                    <Path Fill="#8A6615" Data="M 10,14 L 10,9 C 10,5.7 12.7,3 16,3 C 19.3,3 22,5.7 22,9 L 22,14 L 19.5,14 L 19.5,9 C 19.5,7.1 17.9,5.5 16,5.5 C 14.1,5.5 12.5,7.1 12.5,9 L 12.5,14 Z"/>
                    <!-- Lock Body -->
                    <Rectangle Canvas.Left="7" Canvas.Top="13" Width="18" Height="15" RadiusX="2.5" RadiusY="2.5" Fill="#E6A100"/>
                    <Rectangle Canvas.Left="8" Canvas.Top="14" Width="16" Height="13" RadiusX="2" RadiusY="2" Fill="#FFC233"/>
                    <!-- Keyhole -->
                    <Ellipse Canvas.Left="14.5" Canvas.Top="17" Width="3" Height="3" Fill="#664400"/>
                    <Polygon Points="15,19.5 17,19.5 16.5,23.5 15.5,23.5" Fill="#664400"/>
                </Canvas>
            </Viewbox>

            <TextBlock x:Name="TxtHeaderAccount" Text="Đổi mật khẩu cho tài khoản: Admin" 
                       FontWeight="Bold" FontSize="14" Foreground="#111111" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Subtitle instructions -->
        <TextBlock Grid.Row="1" 
                   Text="Để thay đổi mật khẩu, mời bạn nhập mật khẩu cũ, điền mật khẩu mới và nhắc lại mật khẩu mới một lần nữa"
                   TextWrapping="Wrap" Foreground="#222222" FontSize="11.5" Margin="4,0,0,14"/>

        <!-- Form fields -->
        <Grid Grid.Row="2" Margin="10,0,10,10" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Mật khẩu cũ -->
            <TextBlock Text="Mật khẩu cũ:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Foreground="#111111"/>
            <PasswordBox x:Name="TxtOldPassword" Grid.Row="0" Grid.Column="1" Height="24" 
                         VerticalContentAlignment="Center" Background="White" BorderBrush="#7a9ebf" BorderThickness="1"/>

            <!-- Mật khẩu mới -->
            <TextBlock Text="Mật khẩu mới:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Foreground="#111111"/>
            <PasswordBox x:Name="TxtNewPassword" Grid.Row="1" Grid.Column="1" Height="24" 
                         VerticalContentAlignment="Center" Background="White" BorderBrush="#7a9ebf" BorderThickness="1"/>

            <!-- Nhập lại -->
            <TextBlock Text="Nhập lại:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Foreground="#111111"/>
            <PasswordBox x:Name="TxtConfirmPassword" Grid.Row="2" Grid.Column="1" Height="24" 
                         VerticalContentAlignment="Center" Background="White" BorderBrush="#7a9ebf" BorderThickness="1"/>
        </Grid>

        <!-- Bottom Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,10,0">
            <Button x:Name="BtnGhiDuLieu" Content="Ghi dữ liệu" Width="88" Height="26" Margin="0,0,10,0" 
                    Background="White" BorderBrush="#8899aa" BorderThickness="1" 
                    Click="BtnGhiDuLieu_Click" IsDefault="True" Cursor="Hand"/>
            <Button x:Name="BtnThoat" Content="Thoát" Width="78" Height="26" 
                    Background="White" BorderBrush="#8899aa" BorderThickness="1" 
                    Click="BtnThoat_Click" IsCancel="True" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
