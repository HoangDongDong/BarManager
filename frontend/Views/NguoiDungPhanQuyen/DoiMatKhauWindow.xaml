<Window x:Class="QuanLyBar.Client.Views.NguoiDungPhanQuyen.DoiMatKhauWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đổi mật khẩu" WindowState="Maximized" WindowStyle="None" ResizeMode="NoResize"
        Background="#002D3A" FontFamily="Segoe UI" FontSize="13">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- 1. HEADER BANNER TOP -->
        <Border Grid.Row="0" Background="#1B4D5C" BorderBrush="#2C6B7C" BorderThickness="0,0,0,1.5">
            <TextBlock x:Name="TxtHeaderAccount" Text="ĐỔI MẬT KHẨU CHO TÀI KHOẢN: ADMIN" 
                       Foreground="White" FontWeight="Bold" FontSize="15"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- 2. MAIN FORM CONTENT -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="30,24,30,20">
                <!-- Instruction 1 -->
                <TextBlock Text="ĐỂ THAY ĐỔI MẬT KHẨU, mỜI BẠN NHẬP MẬT KHẨU CŨ" 
                           Foreground="#FFD700" FontWeight="Bold" FontSize="13" Margin="0,0,0,14"/>

                <!-- Field 1: Mật khẩu cũ -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="MẬT KHẨU CŨ:" Foreground="White" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                    <PasswordBox x:Name="TxtOldPassword" Grid.Column="1" Height="36" Padding="8,0"
                                 Background="White" Foreground="#111111" BorderBrush="#CCCCCC" BorderThickness="1"
                                 FontSize="15" VerticalContentAlignment="Center"/>
                    <Button x:Name="BtnKbOldPass" Grid.Column="2" Width="44" Height="36" Margin="6,0,0,0"
                            Background="#005A69" BorderBrush="#36B5B0" BorderThickness="1.5" Cursor="Hand" Click="BtnKbOldPass_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                    <TextBlock Text="⌨" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Instruction 2 -->
                <TextBlock Text="SAU ĐÓ NHẬP MẬT KHẨU MỚI VÀ NHẬP LẠI MỘT LẦN NỮA ĐỂ ĐẢM BẢO KHÔNG BỊ NHẰM" 
                           Foreground="#FFD700" FontWeight="Bold" FontSize="13" Margin="0,0,0,14"/>

                <!-- Field 2: Mật khẩu mới -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="MẬT KHẨU MỚI:" Foreground="White" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                    <PasswordBox x:Name="TxtNewPassword" Grid.Column="1" Height="36" Padding="8,0"
                                 Background="White" Foreground="#111111" BorderBrush="#CCCCCC" BorderThickness="1"
                                 FontSize="15" VerticalContentAlignment="Center"/>
                    <Button x:Name="BtnKbNewPass" Grid.Column="2" Width="44" Height="36" Margin="6,0,0,0"
                            Background="#005A69" BorderBrush="#36B5B0" BorderThickness="1.5" Cursor="Hand" Click="BtnKbNewPass_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                    <TextBlock Text="⌨" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Field 3: Nhập lại -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="NHẬP LẠI:" Foreground="White" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                    <PasswordBox x:Name="TxtConfirmPassword" Grid.Column="1" Height="36" Padding="8,0"
                                 Background="White" Foreground="#111111" BorderBrush="#CCCCCC" BorderThickness="1"
                                 FontSize="15" VerticalContentAlignment="Center"/>
                    <Button x:Name="BtnKbConfirmPass" Grid.Column="2" Width="44" Height="36" Margin="6,0,0,0"
                            Background="#005A69" BorderBrush="#36B5B0" BorderThickness="1.5" Cursor="Hand" Click="BtnKbConfirmPass_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                    <TextBlock Text="⌨" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- 3. ACTION BUTTONS AT BOTTOM RIGHT -->
        <Border Grid.Row="2" Background="#00212C" BorderBrush="#2C6B7C" BorderThickness="0,1,0,0" Padding="16,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- NÚT CHẤP NHẬN (Xanh lá) -->
                <Button x:Name="BtnGhiDuLieu" Content="CHẤP NHẬN" Width="140" Height="40" Margin="0,0,12,0" Cursor="Hand" Click="BtnGhiDuLieu_Click" IsDefault="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#008822" BorderBrush="#2E8B46" BorderThickness="1.5" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Foreground>White</Button.Foreground>
                    <Button.FontWeight>Bold</Button.FontWeight>
                    <Button.FontSize>14</Button.FontSize>
                </Button>

                <!-- NÚT HỦY BỎ (Đỏ) -->
                <Button x:Name="BtnThoat" Content="HỦY BỎ" Width="120" Height="40" Cursor="Hand" Click="BtnThoat_Click" IsCancel="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#880000" BorderBrush="#AA1111" BorderThickness="1.5" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Foreground>White</Button.Foreground>
                    <Button.FontWeight>Bold</Button.FontWeight>
                    <Button.FontSize>14</Button.FontSize>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
