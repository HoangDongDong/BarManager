<UserControl x:Class="QuanLyBar.Client.Views.NguoiDungPhanQuyen.ImageGalleryPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="28">
    <Grid>
        <ToggleButton x:Name="BtnToggle" Height="28" Background="White" BorderBrush="#cbd5e1"
                      BorderThickness="1" Cursor="Hand" Click="BtnToggle_Click">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="4,2">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Right" Text="▾" VerticalAlignment="Center" Margin="4,0,2,0" Foreground="#64748b" FontSize="11"/>
                            <Image x:Name="ImgSelected" Source="{Binding SelectedImageSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#3b82f6"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#2563eb"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>

        <Popup x:Name="PopupGallery" PlacementTarget="{Binding ElementName=BtnToggle}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" Closed="PopupGallery_Closed">
            <Border Background="White" BorderBrush="#94a3b8" BorderThickness="1" CornerRadius="2"
                    Width="380" MaxHeight="380" Margin="0,2,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.2" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top: <Không> option -->
                    <Button x:Name="BtnNone" Content="&lt;Không&gt;" Height="26" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="#e2e8f0"
                            Padding="12,3" Foreground="#1e293b" FontWeight="Medium" Cursor="Hand"
                            Click="BtnNone_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#eff6ff"/>
                                        <Setter Property="Foreground" Value="#2563eb"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Scrollable Gallery of Category Groups -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,4">
                        <ItemsControl x:Name="LstGroups">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4,0,8">
                                        <!-- Group Header with line -->
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding GroupName}" FontWeight="SemiBold" Foreground="#334155" FontSize="12" Margin="2,0,8,0"/>
                                            <Separator Grid.Column="1" VerticalAlignment="Center" Background="#cbd5e1" Margin="0,2,4,0"/>
                                        </Grid>

                                        <!-- Icons in a 3-column / Wrap panel grid -->
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Width="114" Height="28" Margin="2" Background="Transparent"
                                                            BorderThickness="1" BorderBrush="Transparent" Cursor="Hand"
                                                            ToolTip="{Binding Name}" Click="BtnIcon_Click">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="3" Padding="2">
                                                                    <Image Source="{Binding ImageSource}" Width="16" Height="16"
                                                                           Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="bd" Property="Background" Value="#eff6ff"/>
                                                                        <Setter TargetName="bd" Property="BorderBrush" Value="#93c5fd"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
