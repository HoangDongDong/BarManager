<Window x:Class="QuanLyBar.Client.Views.NguoiDungPhanQuyen.NguoiDungPhanQuyenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý người sử dụng" Height="680" Width="1080"
        WindowStartupLocation="CenterOwner"
        Background="#e4edf7" FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- DataGrid Styles -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#cbd5e1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="28"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#e2e8f0"/>
            <Setter Property="VerticalGridLinesBrush" Value="#e2e8f0"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="RowHeaderWidth" Value="24"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#f1f5f9"/>
            <Setter Property="Foreground" Value="#1e293b"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#cbd5e1"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="5,0"/>
        </Style>

        <!-- Button style for toolbar -->
        <Style x:Key="ToolBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1e3f66"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#dbeafe"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#bfdbfe"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Border Grid.Row="0" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="👥" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Quản lý tài khoản người sử dụng và phân quyền" FontSize="16" FontWeight="Bold" Foreground="#1e3f66" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="220"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: Groups and Users -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TOP: Nhóm người dùng -->
                <Border Grid.Row="0" Background="White" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Group Toolbar -->
                        <Border Grid.Row="0" Background="#f1f5f9" BorderBrush="#cbd5e1" BorderThickness="0,0,0,1" Padding="4,3">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnAddGroup" Content="➕ Thêm nhóm" Style="{StaticResource ToolBtnStyle}" Foreground="#15803d" FontWeight="SemiBold" Click="BtnAddGroup_Click"/>
                                <Button x:Name="BtnEditGroup" Content="✏️ Sửa" Style="{StaticResource ToolBtnStyle}" Foreground="#b45309" Click="BtnEditGroup_Click"/>
                                <Button x:Name="BtnDeleteGroup" Content="❌ Xóa" Style="{StaticResource ToolBtnStyle}" Foreground="#b91c1c" Click="BtnDeleteGroup_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Group ListBox with ContextMenu -->
                        <ListBox Grid.Row="1" x:Name="LstGroups" BorderThickness="0" Background="Transparent"
                                 SelectionChanged="LstGroups_SelectionChanged"
                                 PreviewMouseRightButtonDown="LstGroups_PreviewMouseRightButtonDown">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Thêm mới">
                                        <MenuItem Header="➕  Thêm nhóm người dùng" Click="BtnAddGroup_Click"/>
                                        <MenuItem Header="Thêm nhanh" Click="BtnAddGroup_Click"/>
                                        <Separator/>
                                        <MenuItem Header="➖  Thêm phân cách" Click="MenuThemPhanCach_Click"/>
                                        <MenuItem Header="📁  Thêm thư mục" Click="BtnAddGroup_Click"/>
                                    </MenuItem>
                                    <MenuItem Header="Thêm con">
                                        <MenuItem Header="➕  Thêm nhóm con" Click="BtnAddGroup_Click"/>
                                    </MenuItem>
                                    <MenuItem x:Name="MenuEditGroup" Header="✏️  Chỉnh sửa" Click="BtnEditGroup_Click"/>
                                    <MenuItem Header="Sắp xếp theo">
                                        <MenuItem Header="Tên" x:Name="MenuSortGroupByName" Click="MenuSortGroupByName_Click"/>
                                        <MenuItem Header="✓  Thứ tự tùy chọn" x:Name="MenuSortGroupByCustom" Click="MenuSortGroupByCustom_Click"/>
                                    </MenuItem>
                                    <MenuItem Header="🔄  Refresh" Click="MenuRefreshGroup_Click"/>
                                    <Separator/>
                                    <MenuItem Header="📋  Sao chép" Click="MenuCopyGroupName_Click"/>
                                    <MenuItem Header="Mở rộng" Click="MenuExpandGroup_Click"/>
                                    <MenuItem Header="Thu gọn" Click="MenuCollapseGroup_Click"/>
                                    <Separator/>
                                    <MenuItem x:Name="MenuDeleteGroup" Header="❌  Xóa" Click="BtnDeleteGroup_Click"/>
                                    <MenuItem x:Name="MenuRenameGroup" Header="Đổi tên" Click="BtnEditGroup_Click"/>
                                    <MenuItem Header="Thùng rác" Click="MenuTrash_Click"/>
                                    <Separator/>
                                    <MenuItem x:Name="MenuIconGroup" Header="Biểu tượng" Click="BtnEditGroup_Click"/>
                                    <MenuItem x:Name="MenuPropGroup" Header="Thuộc tính" Click="BtnEditGroup_Click"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2,4">
                                        <Grid Width="22" Height="18" Margin="0,0,4,0" VerticalAlignment="Center">
                                            <Image Source="{Binding ImageSource}" Width="16" Height="16" Stretch="Uniform"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding IconDisplay}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ImageSource}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" VerticalAlignment="Center" Foreground="#1e293b"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Splitter -->
                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="#cbd5e1" Height="4" Margin="0,1"/>

                <!-- BOTTOM: Tài khoản người dùng -->
                <Border Grid.Row="2" Background="White" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- User Toolbar -->
                        <Border Grid.Row="0" Background="#f1f5f9" BorderBrush="#cbd5e1" BorderThickness="0,0,0,1" Padding="4,3">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="➕ Thêm tài khoản" Style="{StaticResource ToolBtnStyle}" Foreground="#15803d" FontWeight="SemiBold" Click="BtnAddUser_Click"/>
                                <Button Content="✏️ Sửa" Style="{StaticResource ToolBtnStyle}" Foreground="#b45309" Click="BtnEditUser_Click"/>
                                <Button Content="❌ Xóa" Style="{StaticResource ToolBtnStyle}" Foreground="#b91c1c" Click="BtnDeleteUser_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- User DataGrid with ContextMenu -->
                        <DataGrid Grid.Row="1" x:Name="DgUsers" BorderThickness="0"
                                  HeadersVisibility="Column" SelectionMode="Single" AutoGenerateColumns="False"
                                  IsReadOnly="True" MouseDoubleClick="DgUsers_MouseDoubleClick"
                                  PreviewMouseRightButtonDown="DgUsers_PreviewMouseRightButtonDown">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="➕  Thêm Người dùng" Click="BtnAddUser_Click"/>
                                    <MenuItem Header="Thêm nhanh (excel)" Click="MenuUserExcelImport_Click"/>
                                    <MenuItem Header="Cập nhật nhanh (excel)" Click="MenuUserExcelUpdate_Click"/>
                                    <MenuItem Header="✏️  Chỉnh sửa" Click="BtnEditUser_Click"/>
                                    <MenuItem Header="Đặt Tài khoản" Click="BtnEditUser_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Sắp xếp theo">
                                        <MenuItem Header="Tên" x:Name="MenuSortUserByName" Click="MenuSortUserByName_Click"/>
                                        <MenuItem Header="Tài khoản" x:Name="MenuSortUserByUsername" Click="MenuSortUserByUsername_Click"/>
                                        <MenuItem Header="✓  Thứ tự tùy chọn" x:Name="MenuSortUserByCustom" Click="MenuSortUserByCustom_Click"/>
                                    </MenuItem>
                                    <MenuItem Header="🔄  Refresh" Click="MenuRefreshUsers_Click"/>
                                    <MenuItem Header="In danh sách" Click="MenuPrintUsers_Click"/>
                                    <Separator/>
                                    <MenuItem Header="📋  Sao chép ô" Click="MenuCopyUserCell_Click"/>
                                    <MenuItem Header="📋  Sao chép vùng chọn" Click="MenuCopyUserSelection_Click"/>
                                    <Separator/>
                                    <MenuItem Header="❌  Xóa" Click="BtnDeleteUser_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Tự động giãn cột" Click="MenuAutoFitUserColumns_Click"/>
                                    <MenuItem Header="Cột hiển thị" Click="MenuUserColumns_Click"/>
                                    <MenuItem Header="Thuộc tính" Click="BtnEditUser_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Tài khoản" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="4,2">
                                                <Grid Width="20" Height="18" Margin="0,0,4,0" VerticalAlignment="Center">
                                                    <Image Source="{Binding ImageSource}" Width="16" Height="16" Stretch="Uniform"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Text="👤" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ImageSource}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                <TextBlock Text="{Binding Username}" FontWeight="SemiBold" Foreground="#1e3f66" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" VerticalAlignment="Stretch" Background="#cbd5e1" Width="4" Margin="1,0"/>

            <!-- RIGHT PANEL: TabControl with Permissions -->
            <Border Grid.Column="2" Background="White" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="4">
                <TabControl x:Name="TabPermissions" Background="White" BorderThickness="0" Margin="4">
                    <!-- TAB 1: Quyền sử dụng -->
                    <TabItem Header="Quyền sử dụng" FontWeight="SemiBold">
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" MinWidth="130"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Sub-left: Categories Tree/List -->
                            <Border Grid.Column="0" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="3">
                                <ListBox x:Name="LstFuncCategories" BorderThickness="0" Background="Transparent"
                                         SelectionChanged="LstFuncCategories_SelectionChanged"
                                         PreviewMouseRightButtonDown="LstFuncCategories_PreviewMouseRightButtonDown">
                                    <ListBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Sắp xếp theo">
                                                <MenuItem x:Name="MenuFuncSortByName" Header="Tên" Click="MenuFuncSortByName_Click"/>
                                                <MenuItem x:Name="MenuFuncSortByCustom" Header="✓  Thứ tự tùy chọn" Click="MenuFuncSortByCustom_Click"/>
                                            </MenuItem>
                                            <MenuItem Header="🔄  Refresh" Click="MenuRefreshFuncCategories_Click"/>
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="2,4">
                                                <TextBlock Text="{Binding Icon}" FontSize="13" Width="20" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="#334155"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <GridSplitter Grid.Column="1" VerticalAlignment="Stretch" Background="#e2e8f0" Width="2"/>

                            <!-- Sub-right: Filter Bar & Permissions Table -->
                            <Grid Grid.Column="2" Margin="4,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Filter & Quick Actions Bar -->
                                <Border Grid.Row="0" Background="#f1f5f9" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="3" Padding="8,5" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="Lọc:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0" Foreground="#475569"/>
                                        <TextBox Grid.Column="1" x:Name="TxtFuncFilter" Height="26" VerticalContentAlignment="Center" Padding="4,1"
                                                 TextChanged="TxtFuncFilter_TextChanged"/>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <CheckBox x:Name="ChkLockAllFunc" Content="Khóa tất cả" Margin="0,0,15,0" FontWeight="SemiBold" Foreground="#b91c1c"
                                                      Click="ChkLockAllFunc_Click"/>
                                            <CheckBox x:Name="ChkAllowAllFunc" Content="Cho phép tất cả" Margin="0,0,15,0" FontWeight="SemiBold" Foreground="#15803d"
                                                      Click="ChkAllowAllFunc_Click"/>
                                        </StackPanel>

                                        <Button Grid.Column="3" Content="💾 Lưu quyền" Height="26" Padding="10,0"
                                                Background="#0284c7" Foreground="White" FontWeight="Bold" BorderThickness="0"
                                                Cursor="Hand" Click="BtnSaveFuncRoles_Click">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="3"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Functions Roles DataGrid -->
                                <DataGrid Grid.Row="1" x:Name="DgFuncRoles"
                                          HeadersVisibility="Column" CanUserSortColumns="True"
                                          PreviewMouseRightButtonDown="DgFuncRoles_PreviewMouseRightButtonDown">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="🔒  Khóa" Click="MenuLockFuncRole_Click"/>
                                            <MenuItem Header="👁️  Xem" Click="MenuAllowFuncView_Click"/>
                                            <MenuItem Header="➕  Thêm" Click="MenuAllowFuncAdd_Click"/>
                                            <MenuItem Header="✏️  Sửa" Click="MenuAllowFuncEdit_Click"/>
                                            <MenuItem Header="❌  Xóa" Click="MenuAllowFuncDelete_Click"/>
                                            <MenuItem Header="🌟  Tất cả" Click="MenuAllowFuncAll_Click"/>
                                            <Separator/>
                                            <MenuItem Header="✅  Cho phép tất cả" Click="ChkAllowAllFunc_Click"/>
                                            <MenuItem Header="❌  Khóa tất cả" Click="ChkLockAllFunc_Click"/>
                                            <Separator/>
                                            <MenuItem Header="🔄  Refresh" Click="MenuRefreshFuncCategories_Click"/>
                                            <MenuItem Header="💾  Lưu quyền" Click="BtnSaveFuncRoles_Click"/>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Chức năng" Binding="{Binding FunctionName}" Width="*" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Padding" Value="8,4"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="FontWeight" Value="Medium"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Khóa -->
                                        <DataGridTemplateColumn Header="Khóa" Width="65">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsLocked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Xem -->
                                        <DataGridTemplateColumn Header="Xem" Width="65">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding CanView, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Thêm -->
                                        <DataGridTemplateColumn Header="Thêm" Width="65">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding CanAdd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Visibility="{Binding HasCrud, Converter={StaticResource BoolToVis}}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              IsEnabled="{Binding HasCrud}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Sửa -->
                                        <DataGridTemplateColumn Header="Sửa" Width="65">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding CanEdit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Visibility="{Binding HasCrud, Converter={StaticResource BoolToVis}}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              IsEnabled="{Binding HasCrud}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Xóa -->
                                        <DataGridTemplateColumn Header="Xóa" Width="65">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding CanDelete, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Visibility="{Binding HasCrud, Converter={StaticResource BoolToVis}}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              IsEnabled="{Binding HasCrud}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Tất cả -->
                                        <DataGridTemplateColumn Header="Tất cả" Width="70">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsAll, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Visibility="{Binding HasCrud, Converter={StaticResource BoolToVis}}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- TAB 2: Quyền xem báo cáo -->
                    <TabItem Header="Quyền xem báo cáo" FontWeight="SemiBold">
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" MinWidth="150"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Sub-left: Report Hierarchical TreeView -->
                            <Border Grid.Column="0" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="3">
                                <TreeView x:Name="TreeReportCategories" BorderThickness="0" Background="Transparent"
                                          SelectedItemChanged="TreeReportCategories_SelectedItemChanged"
                                          PreviewMouseRightButtonDown="TreeReportCategories_PreviewMouseRightButtonDown">
                                    <TreeView.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Sắp xếp theo">
                                                <MenuItem x:Name="MenuReportTreeSortByName" Header="Tên" Click="MenuReportTreeSortByName_Click"/>
                                                <MenuItem x:Name="MenuReportTreeSortByCustom" Header="✓  Thứ tự tùy chọn" Click="MenuReportTreeSortByCustom_Click"/>
                                            </MenuItem>
                                            <MenuItem Header="🔄  Refresh" Click="MenuRefreshReportCategories_Click"/>
                                        </ContextMenu>
                                    </TreeView.ContextMenu>
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                            <StackPanel Orientation="Horizontal" Margin="2,3">
                                                <TextBlock Text="{Binding Icon}" FontSize="13" Width="18" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="#334155" FontSize="12.5"/>
                                            </StackPanel>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </Border>

                            <GridSplitter Grid.Column="1" VerticalAlignment="Stretch" Background="#e2e8f0" Width="2"/>

                            <!-- Sub-right: Filter Bar & Report Permissions Table -->
                            <Grid Grid.Column="2" Margin="4,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Filter & Quick Actions Bar -->
                                <Border Grid.Row="0" Background="#f1f5f9" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="3" Padding="8,5" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="Lọc:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0" Foreground="#475569"/>
                                        <TextBox Grid.Column="1" x:Name="TxtReportFilter" Height="26" VerticalContentAlignment="Center" Padding="4,1"
                                                 TextChanged="TxtReportFilter_TextChanged"/>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <CheckBox x:Name="ChkLockAllReport" Content="Khóa tất cả" Margin="0,0,15,0" FontWeight="SemiBold" Foreground="#b91c1c"
                                                      Click="ChkLockAllReport_Click"/>
                                            <CheckBox x:Name="ChkAllowAllReport" Content="Cho phép tất cả" Margin="0,0,15,0" FontWeight="SemiBold" Foreground="#15803d"
                                                      Click="ChkAllowAllReport_Click"/>
                                        </StackPanel>

                                        <Button Grid.Column="3" Content="💾 Lưu quyền" Height="26" Padding="10,0"
                                                Background="#0284c7" Foreground="White" FontWeight="Bold" BorderThickness="0"
                                                Cursor="Hand" Click="BtnSaveReportRoles_Click">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="3"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Reports Roles DataGrid -->
                                <DataGrid Grid.Row="1" x:Name="DgReportRoles"
                                          HeadersVisibility="Column" CanUserSortColumns="True"
                                          PreviewMouseRightButtonDown="DgReportRoles_PreviewMouseRightButtonDown">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="✔️  Được phép xem" Click="MenuAllowReportRole_Click"/>
                                            <MenuItem Header="🔒  Không được xem" Click="MenuLockReportRole_Click"/>
                                            <Separator/>
                                            <MenuItem Header="✅  Cho phép tất cả" Click="ChkAllowAllReport_Click"/>
                                            <MenuItem Header="❌  Khóa tất cả" Click="ChkLockAllReport_Click"/>
                                            <Separator/>
                                            <MenuItem Header="🔄  Refresh" Click="MenuRefreshReportCategories_Click"/>
                                            <MenuItem Header="💾  Lưu quyền" Click="BtnSaveReportRoles_Click"/>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Báo cáo" Binding="{Binding ReportName}" Width="*" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Padding" Value="8,4"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="FontWeight" Value="Medium"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Không được xem -->
                                        <DataGridTemplateColumn Header="Không được xem" Width="130">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding NotAllowed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Được phép xem -->
                                        <DataGridTemplateColumn Header="Được phép xem" Width="130">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsAllowed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- Bottom Footer -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Chú ý: Tài khoản hệ thống Admin không được hiển thị trong danh sách"
                       FontStyle="Italic" Foreground="#475569" VerticalAlignment="Center"/>

            <Button Grid.Column="1" Content="Thoát" Width="90" Height="30"
                    Background="#f1f5f9" Foreground="#1e293b" FontWeight="SemiBold" BorderBrush="#cbd5e1" BorderThickness="1"
                    Cursor="Hand" Click="BtnClose_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>
