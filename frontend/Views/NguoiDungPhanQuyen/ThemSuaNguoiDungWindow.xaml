<Window x:Class="QuanLyBar.Client.Views.NguoiDungPhanQuyen.ThemSuaNguoiDungWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QuanLyBar.Client.Views.NguoiDungPhanQuyen"
        Title="TÀI KHOẢN NGƯỜI DÙNG - THÊM MỚI" Height="640" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#eef3f9" FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="BorderBrush" Value="#8fa2b8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#8fa2b8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header Title -->
            <RowDefinition Height="Auto"/> <!-- Toolbar -->
            <RowDefinition Height="*"/>    <!-- Form Content -->
            <RowDefinition Height="Auto"/> <!-- Bottom Buttons -->
        </Grid.RowDefinitions>

        <!-- Top Header Banner -->
        <Border Grid.Row="0" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <Border Width="30" Height="30" CornerRadius="15" Background="#3b82f6" Margin="0,0,10,0">
                    <TextBlock Text="👤" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TxtHeaderTitle" Text="Tài khoản người dùng" FontSize="15" FontWeight="Bold" Foreground="#1e3f66" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Toolbar Strip -->
        <Border Grid.Row="1" Background="#e2e8f0" BorderBrush="#cbd5e1" BorderThickness="0,0,0,1" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <Button Content="↗ Phím tắt ▾" Margin="0,0,4,0" Padding="8,2" Background="White" BorderBrush="#94a3b8" BorderThickness="1" Cursor="Hand" FontSize="11"/>
                <Button x:Name="BtnPrev" Content="⬅ Trước (F10)" Margin="0,0,4,0" Padding="8,2" Background="White" BorderBrush="#94a3b8" BorderThickness="1" Cursor="Hand" FontSize="11" Click="BtnPrev_Click"/>
                <Button x:Name="BtnNext" Content="➡ Sau (F11)" Margin="0,0,4,0" Padding="8,2" Background="White" BorderBrush="#94a3b8" BorderThickness="1" Cursor="Hand" FontSize="11" Click="BtnNext_Click"/>
                <Button x:Name="BtnCreateNew" Content="➕ Tạo mới" Margin="0,0,4,0" Padding="8,2" Background="White" BorderBrush="#94a3b8" BorderThickness="1" Cursor="Hand" FontSize="11" Click="BtnCreateNew_Click"/>
            </StackPanel>
        </Border>

        <!-- Form Fields -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Nhân viên -->
                    <RowDefinition Height="Auto"/> <!-- Họ và tên & Ảnh -->
                    <RowDefinition Height="Auto"/> <!-- Tài khoản -->
                    <RowDefinition Height="Auto"/> <!-- Mật khẩu -->
                    <RowDefinition Height="Auto"/> <!-- Email -->
                    <RowDefinition Height="Auto"/> <!-- Nhóm người dùng -->
                    <RowDefinition Height="Auto"/> <!-- Cửa hàng truy cập -->
                    <RowDefinition Height="Auto"/> <!-- Đăng nhập ở giao diện cảm ứng header -->
                    <RowDefinition Height="Auto"/> <!-- ID đăng nhập -->
                    <RowDefinition Height="Auto"/> <!-- Mã thẻ -->
                </Grid.RowDefinitions>

                <!-- 1. Nhân viên -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Nhân viên" VerticalAlignment="Center" Margin="0,0,0,8" Foreground="#1e293b"/>
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CboNhanVien" Margin="0,0,0,8"
                          DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectionChanged="CboNhanVien_SelectionChanged"/>

                <!-- 2. Họ và tên & Ảnh -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Họ và tên" VerticalAlignment="Center" Margin="0,0,0,8" Foreground="#1e293b"/>
                <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="TxtFullName" Margin="0,0,8,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="Ảnh:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#1e293b"/>
                        <local:ImageGalleryPicker x:Name="PickerAnh" Width="55" Height="24"/>
                    </StackPanel>
                </Grid>

                <!-- 3. Tài khoản (Tên đăng nhập) -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Tài khoản" VerticalAlignment="Center" Margin="0,0,0,8" Foreground="#1e293b"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtUsername" Background="#eaf4fe" BorderBrush="#7ba4d5" Margin="0,0,0,8"/>

                <!-- 4. Mật khẩu -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Mật khẩu" VerticalAlignment="Center" Margin="0,0,0,8" Foreground="#1e293b"/>
                <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,8">
                    <PasswordBox x:Name="PbPassword" PasswordChar="*" Padding="4,1,26,1"
                                 PasswordChanged="PbPassword_PasswordChanged"/>
                    <TextBox x:Name="TxtPassword" Visibility="Collapsed" Padding="4,1,26,1"
                             TextChanged="TxtPassword_TextChanged"/>
                    <Button x:Name="BtnTogglePassword" Width="24" Height="22" HorizontalAlignment="Right" Margin="0,0,1,0"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Ẩn / Hiện mật khẩu"
                            Click="BtnTogglePassword_Click">
                        <TextBlock x:Name="TxtEyeIcon" Text="👁️" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <!-- 5. Email -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Email" VerticalAlignment="Center" Margin="0,0,0,8" Foreground="#1e293b"/>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtEmail" Margin="0,0,0,8"/>

                <!-- 6. Nhóm người dùng -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Nhóm người dùng" VerticalAlignment="Center" Margin="0,0,0,8" Foreground="#1e293b"/>
                <ComboBox Grid.Row="5" Grid.Column="1" x:Name="CboGroup" Background="#f6fee5" BorderBrush="#a4c639" Margin="0,0,0,8"
                          SelectedValuePath="Id">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding ImageSource}" Width="16" Height="16" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- 7. Cửa hàng truy cập -->
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Cửa hàng truy cập" VerticalAlignment="Top" Margin="0,4,0,8" Foreground="#1e293b"/>
                <Border Grid.Row="6" Grid.Column="1" BorderBrush="#94a3b8" BorderThickness="1" Background="White" Margin="0,0,0,12" Height="120">
                    <DataGrid x:Name="DgUserShops" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="All"
                              HorizontalGridLinesBrush="#e2e8f0" VerticalGridLinesBrush="#e2e8f0"
                              Background="White" RowHeaderWidth="0" SelectionMode="Single"
                              BorderThickness="0" FontSize="12">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#f1f5f9"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#334155"/>
                                <Setter Property="Height" Value="24"/>
                                <Setter Property="Padding" Value="6,2"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="BorderBrush" Value="#cbd5e1"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Cửa hàng" Binding="{Binding ShopName}" Width="*" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="Truy cập" Width="75">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding HasAccess, UpdateSourceTrigger=PropertyChanged}" 
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Section: Đăng nhập ở giao diện cảm ứng -->
                <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Text="Đăng nhập ở giao diện cảm ứng" FontWeight="Bold" Foreground="#1e3f66" Margin="0,4,0,6"/>

                <!-- 8. ID đăng nhập -->
                <TextBlock Grid.Row="8" Grid.Column="0" Text="ID đăng nhập" VerticalAlignment="Center" Margin="0,0,0,8" Foreground="#1e293b"/>
                <TextBox Grid.Row="8" Grid.Column="1" x:Name="TxtUserId" Margin="0,0,0,8"/>

                <!-- 9. Mã thẻ -->
                <TextBlock Grid.Row="9" Grid.Column="0" Text="Mã thẻ" VerticalAlignment="Center" Margin="0,0,0,8" Foreground="#1e293b"/>
                <TextBox Grid.Row="9" Grid.Column="1" x:Name="TxtCardCode" Margin="0,0,0,8"/>
            </Grid>
        </ScrollViewer>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="3" Background="#f1f5f9" BorderBrush="#cbd5e1" BorderThickness="0,1,0,0" Padding="12,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnSave" Content="💾 Lưu" Width="75" Height="26" Margin="0,0,6,0"
                        Background="#ffffff" BorderBrush="#94a3b8" BorderThickness="1" Cursor="Hand" Click="BtnSave_Click"/>
                <Button x:Name="BtnSaveAndNew" Content="Lưu &amp; Mới" Width="85" Height="26" Margin="0,0,6,0"
                        Background="#ffffff" BorderBrush="#94a3b8" BorderThickness="1" Cursor="Hand" Click="BtnSaveAndNew_Click"/>
                <Button x:Name="BtnSaveAndClose" Content="Lưu &amp; thoát" Width="90" Height="26" Margin="0,0,6,0"
                        Background="#ffffff" BorderBrush="#94a3b8" BorderThickness="1" Cursor="Hand" Click="BtnSaveAndClose_Click"/>
                <Button x:Name="BtnCancel" Content="Thoát" Width="70" Height="26"
                        Background="#ffffff" BorderBrush="#94a3b8" BorderThickness="1" Cursor="Hand" Click="BtnCancel_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
