<Window x:Class="QuanLyBar.Client.Views.ThemMoiMatHangWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MẶT HÀNG - THÊM MỚI" Height="600" Width="700"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ToolBar -->
        <ToolBar Grid.Row="0" Background="#dfe7f5">
            <Menu Background="Transparent">
                <MenuItem Header="↗ Phím tắt">
                    <MenuItem Header="Tạo mới" InputGestureText="(Ctrl+N)"/>
                    <MenuItem Header="Sao chép" InputGestureText="(Alt+C)"/>
                    <Separator/>
                    <MenuItem Header="Lưu" InputGestureText="(Ctrl+L)"/>
                    <MenuItem Header="Lưu &amp; Mới" InputGestureText="(Ctrl+S)"/>
                    <MenuItem Header="Lưu &amp; Thoát" InputGestureText="(Enter)"/>
                    <Separator/>
                    <MenuItem Header="Thoát" InputGestureText="(ESC)"/>
                </MenuItem>
            </Menu>
            <Separator/>
            <Button x:Name="BtnTruoc" Content="⬅ Trước (F10)" Padding="5" Click="BtnTruoc_Click"/>
            <Button x:Name="BtnSau" Content="➡ Sau (F11)" Padding="5" Click="BtnSau_Click"/>
            <Separator/>
            <Button x:Name="BtnTaoMoi" Content="Tạo mới" Padding="5" Click="BtnTaoMoi_Click"/>
            <Button Content="Sao chép" Padding="5"/>
            <Separator/>
            <Button Content="❌ Xóa" Padding="5" HorizontalAlignment="Right"/>
        </ToolBar>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="1" Margin="0,10,0,0">
            <TabItem Header="Thông tin mặt hàng">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Mã hàng -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Mã hàng" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox x:Name="TxtMaHang" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Margin="5" Background="#E0FFFF"/>

                    <!-- Row 1: Tên hàng -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Tên hàng" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox x:Name="TxtTenHang" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="5" Background="#E0FFFF"/>

                    <!-- Row 2: Tên tiếng anh -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Tên tiếng anh" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox x:Name="TxtTenTiengAnh" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="5"/>

                    <!-- Row 3: Giá bán -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Giá bán" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox x:Name="TxtGiaBan" Grid.Row="3" Grid.Column="1" Margin="5" Text="0"/>
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Giá 2" VerticalAlignment="Center" Margin="5,0"/>
                    <TextBox Grid.Row="3" Grid.Column="3" Margin="5" Text="0"/>

                    <!-- Row 4: Giá bán 3/4 -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Giá 3" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Margin="5" Text="0"/>
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="Giá 4" VerticalAlignment="Center" Margin="5,0"/>
                    <TextBox Grid.Row="4" Grid.Column="3" Margin="5" Text="0"/>

                    <!-- Row 5: ĐVT bán -->
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="ĐVT bán, định lượng" VerticalAlignment="Center" Margin="0,5"/>
                    <Grid Grid.Row="5" Grid.Column="1" Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="CboDvtBan" Background="#FFFFE0" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                        <Button Grid.Column="1" Content="➕" ToolTip="Thêm mới" Width="22" Margin="2,0,0,0" Click="BtnThemDvt_Click"/>
                        <Button Grid.Column="2" Content="🔄" ToolTip="Tải lại" Width="22" Margin="2,0,0,0" Click="BtnTaiDvt_Click"/>
                        <Button Grid.Column="3" Content="🗂️" ToolTip="Danh mục" Width="22" Margin="2,0,0,0" Click="BtnDanhMucDvt_Click"/>
                    </Grid>
                    <CheckBox x:Name="ChkGiaTheoThoiGia" Grid.Row="5" Grid.Column="2" Grid.ColumnSpan="2" Content="Giá theo thời giá" VerticalAlignment="Center" Margin="5"/>

                    <!-- Row 6: ĐVT nhập -->
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="ĐVT nhập mua" VerticalAlignment="Center" Margin="0,5"/>
                    <Grid Grid.Row="6" Grid.Column="1" Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="CboDvtNhap" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                        <Button Grid.Column="1" Content="➕" ToolTip="Thêm mới" Width="22" Margin="2,0,0,0" Click="BtnThemDvt_Click"/>
                        <Button Grid.Column="2" Content="🔄" ToolTip="Tải lại" Width="22" Margin="2,0,0,0" Click="BtnTaiDvt_Click"/>
                        <Button Grid.Column="3" Content="🗂️" ToolTip="Danh mục" Width="22" Margin="2,0,0,0" Click="BtnDanhMucDvt_Click"/>
                    </Grid>
                    <TextBlock Grid.Row="6" Grid.Column="2" Text="Quy đổi" VerticalAlignment="Center" Margin="5,0"/>
                    <TextBox x:Name="TxtQuyDoi" Grid.Row="6" Grid.Column="3" Margin="5" Text="1"/>

                    <!-- Row 7: Giá nhập -->
                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Giá nhập" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox x:Name="TxtGiaNhap" Grid.Row="7" Grid.Column="1" Margin="5" Text="0"/>
                    <TextBlock Grid.Row="7" Grid.Column="2" Text="Giá vốn" VerticalAlignment="Center" Margin="5,0"/>
                    <TextBox Grid.Row="7" Grid.Column="3" Margin="5" Text="0"/>

                    <!-- Row 8: Nhóm mặt hàng -->
                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Nhóm mặt hàng" VerticalAlignment="Center" Margin="0,5"/>
                    <ComboBox x:Name="CboNhomMatHang" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3" Margin="5" Background="#E0FFE0" DisplayMemberPath="Name" SelectedValuePath="Id"/>

                    <!-- Row 9: Loại mặt hàng -->
                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Loại mặt hàng" VerticalAlignment="Top" Margin="0,5"/>
                    <StackPanel Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="3" Margin="5">
                        <RadioButton x:Name="RdoPhaChe" Content="Mặt hàng pha chế" Margin="0,2"/>
                        <RadioButton x:Name="RdoKiemVatTu" Content="Mặt hàng kiêm vật tư" Margin="0,2" IsChecked="True"/>
                        <RadioButton x:Name="RdoVatTu" Content="Vật tư nguyên liệu" Margin="0,2"/>
                        <RadioButton x:Name="RdoMo" Content="Mặt hàng mở" Margin="0,2"/>
                        <RadioButton x:Name="RdoKhac" Content="Khác" Margin="0,2"/>
                    </StackPanel>

                    <!-- Image Section -->
                    <Border Grid.Row="0" Grid.RowSpan="7" Grid.Column="4" BorderBrush="Gray" BorderThickness="1" Margin="10,5,0,5">
                        <Grid>
                            <TextBlock Text="Ảnh:" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="2"/>
                            <!-- placeholder for image -->
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="7" Grid.RowSpan="3" Grid.Column="4" Margin="10,5,0,5">
                        <TextBlock>
                            <Hyperlink><Run Text="Lịch sử nhập mua hàng"/></Hyperlink>
                        </TextBlock>
                        <TextBlock Margin="0,5,0,0">
                            <Hyperlink><Run Text="Lịch sử xuất bán hàng"/></Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Định lượng">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <ToolBar Grid.Row="0" Background="#f0f0f0">
                        <Button Content="➕ Thêm dòng (F4)" Padding="5"/>
                        <Button Content="❌ Xóa dòng (F8)" Padding="5"/>
                        <Button Content="Xuất excel" Padding="5"/>
                        <Separator/>
                        <Label Content="Lọc" VerticalAlignment="Center"/>
                        <TextBox Width="150" Margin="5,0"/>
                    </ToolBar>
                    <DataGrid Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" AlternatingRowBackground="#f9f9f9" GridLinesVisibility="All">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Vật tư" Width="*"/>
                            <DataGridTextColumn Header="Số lượng" Width="80"/>
                            <DataGridTextColumn Header="ĐVT" Width="60"/>
                            <DataGridTextColumn Header="Giá nhập" Width="90"/>
                            <DataGridTextColumn Header="Thành tiền nhập" Width="100"/>
                            <DataGridTextColumn Header="Giá vốn" Width="90"/>
                            <DataGridTextColumn Header="Thành tiền vốn" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Khác">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <CheckBox x:Name="ChkTamKhoa" Grid.Row="0" Content="Tạm khóa" Margin="5"/>
                    <CheckBox Grid.Row="1" Content="Khối lượng theo cân" Margin="5"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="5,10,5,5">
                        <TextBlock Text="Tồn tối thiểu" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Width="80" Text="0"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="💾 Lưu" Width="80" Margin="0,0,10,0" Padding="5" Click="BtnLuu_Click"/>
            <Button Content="💾 Lưu &amp; Mới" Width="90" Margin="0,0,10,0" Padding="5"/>
            <Button Content="Lưu &amp; Thoát" Width="90" Margin="0,0,10,0" Padding="5" Click="BtnLuuThoat_Click"/>
            <Button Content="Thoát" Width="80" Padding="5" Click="BtnThoat_Click"/>
        </StackPanel>
    </Grid>
</Window>
