<Window x:Class="QuanLyBar.Client.Views.QuanLyBanHang.HoaDonNhaHangWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HÓA ĐƠN NHÀ HÀNG - SỬA" Height="680" Width="980"
        WindowStartupLocation="CenterOwner"
        Background="#d2e1f2" WindowStyle="SingleBorderWindow"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Style cho các nút bấm phụ / thanh công cụ -->
        <Style x:Key="MiniToolBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#a4c2e0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e6f0fa"/>
                    <Setter Property="BorderBrush" Value="#0078d7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CenterActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#f4f4f4"/>
            <Setter Property="BorderBrush" Value="#b6c1cd"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2,4"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e2edf8"/>
                    <Setter Property="BorderBrush" Value="#0078d7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FooterBtnStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#a0b8d4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e6f0fa"/>
                    <Setter Property="BorderBrush" Value="#6495ed"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Vertical TabItem Header Style -->
        <Style x:Key="VerticalTabItemStyle" TargetType="TabItem">
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="10" FontWeight="SemiBold" Margin="1,4">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="-90"/>
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0. Top Yellow Header Banner -->
            <RowDefinition Height="Auto"/> <!-- 1. General Invoice Info Form -->
            <RowDefinition Height="*"/>    <!-- 2. Main 3-Column Content -->
            <RowDefinition Height="Auto"/> <!-- 3. Bottom Footer Toolbar -->
        </Grid.RowDefinitions>

        <!-- 0. TOP YELLOW HEADER BANNER -->
        <Border Grid.Row="0" Background="#fffbe6" BorderBrush="#e8d8a0" BorderThickness="0,0,0,1" Padding="10,6">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#3b82f6" CornerRadius="3" Width="24" Height="22" Margin="0,0,8,0">
                        <TextBlock Text="🧾" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Hóa đơn nhà hàng" FontWeight="Bold" FontSize="13.5" Foreground="#0f172a" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="(Ctrl+S: Lưu&amp;Mới, Ctrl+L: Lưu, Ctrl+N: Mới, Ctrl+P: In, ESC: Thoát)" 
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="11" Foreground="#475569"/>
            </Grid>
        </Border>

        <!-- 1. GENERAL INVOICE INFO FORM -->
        <Border Grid.Row="1" Background="#dbe9f6" Padding="8,6" Margin="4,4,4,2" BorderBrush="#a4c2e0" BorderThickness="1" CornerRadius="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Inputs -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Row 0: Start Time + Bắt đầu, Ngày, Số phiếu, Số khách -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                        <TextBox x:Name="TxtGioBatDau" Width="115" Height="22" VerticalContentAlignment="Center" Background="#f8fafc" BorderBrush="#a4c2e0" IsReadOnly="True" Margin="0,0,3,0"/>
                        <Button Content="Bắt đầu" Width="55" Height="22" Background="#f0f5fa" BorderBrush="#a4c2e0" FontSize="11" Margin="0,0,10,0"/>
                    </StackPanel>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Ngày" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11" FontWeight="SemiBold"/>
                    <DatePicker x:Name="DpNgayOrder" Grid.Row="0" Grid.Column="3" Width="105" Height="22" Margin="0,0,10,0"/>

                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Số phiếu" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtSoPhieu" Grid.Row="0" Grid.Column="5" Width="100" Height="22" VerticalContentAlignment="Center" Margin="0,0,10,0" FontWeight="Bold" Foreground="#003399" Background="#fffde0" IsReadOnly="True" Padding="4,0"/>

                    <TextBlock Grid.Row="0" Grid.Column="6" Text="Số khách" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtSoKhach" Grid.Row="0" Grid.Column="7" Width="40" Height="22" Text="1" TextAlignment="Right" VerticalContentAlignment="Center" Background="White" BorderBrush="#a4c2e0"/>

                    <!-- Row 1: End Time -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                        <TextBox x:Name="TxtGioKetThuc" Width="115" Height="22" VerticalContentAlignment="Center" Background="#f8fafc" BorderBrush="#a4c2e0" IsReadOnly="True" Margin="0,0,3,0"/>
                    </StackPanel>

                    <!-- Row 2: Khách hàng (F12) -->
                    <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="8" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Khách hàng (F12)" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                        <TextBox x:Name="TxtKhachHang" Grid.Column="1" Height="22" VerticalContentAlignment="Center" Background="White" BorderBrush="#a4c2e0" Padding="4,0"/>
                    </Grid>
                </Grid>

                <!-- Right Action Buttons: Chuyển bàn, Gộp bàn -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Top">
                    <Button Width="56" Height="50" Margin="0,0,4,0" Background="#f0f5fa" BorderBrush="#a4c2e0" Cursor="Hand">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🔄" FontSize="14" HorizontalAlignment="Center"/>
                            <TextBlock Text="Chuyển&#x0a;bàn" FontSize="10" TextAlignment="Center" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Width="56" Height="50" Background="#f0f5fa" BorderBrush="#a4c2e0" Cursor="Hand">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🔗" FontSize="14" HorizontalAlignment="Center"/>
                            <TextBlock Text="Gộp&#x0a;bàn" FontSize="10" TextAlignment="Center" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. MAIN 3-COLUMN CONTENT -->
        <Grid Grid.Row="2" Margin="4,2,4,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4.6*" MinWidth="320"/>
                <ColumnDefinition Width="78"/>
                <ColumnDefinition Width="4.2*" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <!-- ======================= CỘT 1: HÓA ĐƠN CHI TIẾT & TỔNG ======================= -->
            <Border Grid.Column="0" Background="White" BorderBrush="#a4c2e0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="125"/>
                    </Grid.RowDefinitions>

                    <!-- Top TabControl (Hóa đơn / Chi tiết giờ) -->
                    <TabControl Grid.Row="0" Margin="2" Background="White">
                        <TabItem Header="Hóa đơn">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Mini Toolbar -->
                                <Border Grid.Row="0" Background="#f0f5fb" BorderBrush="#d0e0f0" BorderThickness="0,0,0,1" Padding="2,1">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="BtnThemMon" Style="{StaticResource MiniToolBtnStyle}" Width="24" ToolTip="Thêm" Click="BtnThemMon_Click">
                                            <TextBlock Text="➕" Foreground="#0050b3" FontSize="10"/>
                                        </Button>
                                        <Button x:Name="BtnGiamMon" Style="{StaticResource MiniToolBtnStyle}" Width="24" ToolTip="Giảm" Click="BtnGiamMon_Click">
                                            <TextBlock Text="➖" Foreground="#d4380d" FontSize="10"/>
                                        </Button>
                                        <Button x:Name="BtnXoaMonGrid" Style="{StaticResource MiniToolBtnStyle}" Width="24" ToolTip="Xóa món" Click="BtnXoaMonGrid_Click">
                                            <TextBlock Text="🚫" Foreground="#cf1322" FontSize="10"/>
                                        </Button>
                                        <Separator Width="1" Background="#b0c4de" Margin="3,2"/>
                                        <Button x:Name="BtnDatSl" Style="{StaticResource MiniToolBtnStyle}" Click="BtnDatSl_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🔢" FontSize="9" Margin="0,0,2,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Đặt sl" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnDoiGia" Style="{StaticResource MiniToolBtnStyle}" Click="BtnDoiGia_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="💲" FontSize="9" Margin="0,0,2,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Đổi giá" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnGhiChu" Style="{StaticResource MiniToolBtnStyle}" Click="BtnGhiChu_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📝" FontSize="9" Margin="0,0,2,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Ghi chú" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnChietKhau" Style="{StaticResource MiniToolBtnStyle}" Click="BtnChietKhau_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="%" FontSize="9" Margin="0,0,2,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="CK%" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- DataGrid Hóa đơn chi tiết -->
                                <DataGrid x:Name="DgChiTiet" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                                          IsReadOnly="True" GridLinesVisibility="All" AlternatingRowBackground="#f0f5fb" Background="White"
                                          HeadersVisibility="All" RowHeight="22" FontSize="11" SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Tên hàng" Binding="{Binding TenMon}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="ĐVT" Binding="{Binding Dvt}" Width="45">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="SL" Binding="{Binding SoLuong, StringFormat={}{0:0.##}}" Width="40">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter Property="Padding" Value="0,0,4,0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="Đ giá" Binding="{Binding DonGia, StringFormat={}{0:N0}}" Width="70">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter Property="Padding" Value="0,0,4,0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="CK%" Binding="{Binding PhanTramGiamGia, StringFormat={}{0:N0}}" Width="40">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter Property="Padding" Value="0,0,4,0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="T tiền" Binding="{Binding ThanhTien, StringFormat={}{0:N0}}" Width="80">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Padding" Value="0,0,4,0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Chi tiết giờ">
                            <Grid Background="White">
                                <TextBlock Text="Chi tiết giờ dịch vụ" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#888"/>
                            </Grid>
                        </TabItem>
                    </TabControl>

                    <!-- Bottom Summary Box (Vertical Tabs GHI CHÚ / TỔNG) -->
                    <TabControl Grid.Row="1" TabStripPlacement="Left" Margin="2,0,2,2" Background="#dbe9f6" BorderBrush="#a4c2e0">
                        <TabItem Header="GHI CHÚ" Style="{StaticResource VerticalTabItemStyle}">
                            <TextBox x:Name="TxtGhiChuTab" AcceptsReturn="True" TextWrapping="Wrap" Margin="3" Background="White"/>
                        </TabItem>

                        <TabItem Header="TỔNG" IsSelected="True" Style="{StaticResource VerticalTabItemStyle}">
                            <Grid Background="#dbe9f6" Margin="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="155"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="36"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Tiền hàng" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11" FontWeight="SemiBold"/>
                                <TextBox x:Name="TxtTienHang" Grid.Row="0" Grid.Column="2" Text="0" Background="#e2ecf5" BorderBrush="#a4c2e0" BorderThickness="1" IsReadOnly="True" TextAlignment="Right" VerticalContentAlignment="Center" Margin="2" FontWeight="Bold" Padding="4,0"/>

                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Giảm giá" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11" FontWeight="SemiBold"/>
                                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="2">
                                    <TextBox x:Name="TxtGiamGiaPt" Width="40" Text="0" TextAlignment="Right" VerticalContentAlignment="Center" Background="White" BorderBrush="#a4c2e0" TextChanged="TxtGiamGia_TextChanged"/>
                                    <TextBlock Text="%" VerticalAlignment="Center" Margin="3,0,4,0" FontSize="11"/>
                                    <TextBox x:Name="TxtGiamGia" Width="82" Text="0" Background="#e2ecf5" BorderBrush="#a4c2e0" BorderThickness="1" TextAlignment="Right" VerticalContentAlignment="Center" TextChanged="TxtGiamGia_TextChanged"/>
                                </StackPanel>

                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Tổng cộng" FontWeight="Bold" FontSize="15" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="TxtTongCong" Grid.Row="2" Grid.Column="2" Text="0" Background="#fffdc2" BorderBrush="#d48806" BorderThickness="1" FontWeight="Bold" FontSize="16" Foreground="Red" IsReadOnly="True" TextAlignment="Right" VerticalContentAlignment="Center" Margin="2" Padding="4,0"/>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <!-- ======================= CỘT 2: THANH NÚT CHỨC NĂNG Ở GIỮA ======================= -->
            <Grid Grid.Column="1" Margin="3,0,3,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Số lượng" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,2"/>
                    <TextBox x:Name="TxtSoLuongChon" Height="22" Text="1" TextAlignment="Center" VerticalContentAlignment="Center" Background="White" BorderBrush="#a4c2e0" Margin="0,0,0,6"/>

                    <Button x:Name="BtnThemSangHoaDon" Content="&lt;&lt; Thêm" Style="{StaticResource CenterActionBtnStyle}" Height="26" FontWeight="SemiBold" Click="BtnThemSangHoaDon_Click"/>
                    <Button x:Name="BtnGiamKhoiHoaDon" Content="Giảm &gt;&gt;" Style="{StaticResource CenterActionBtnStyle}" Height="26" Click="BtnGiamKhoiHoaDon_Click"/>
                    <Button x:Name="BtnXoaKhoiHoaDon" Style="{StaticResource CenterActionBtnStyle}" Height="26" Click="BtnXoaKhoiHoaDon_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="❌" FontSize="10" Margin="0,0,3,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Xóa" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnPhanTramTheoNhom" Content="% theo&#x0a;nhóm" Style="{StaticResource CenterActionBtnStyle}" Height="34" FontSize="10"/>
                </StackPanel>

                <!-- Bottom action buttons of center column -->
                <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                    <Button x:Name="BtnInCheBien" Style="{StaticResource CenterActionBtnStyle}" Height="38" Click="BtnInCheBien_Click">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🖨️" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Text="In chế biến&#x0a;(F10)" FontSize="9.5" TextAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnInLaiBill" Style="{StaticResource CenterActionBtnStyle}" Height="38" Click="BtnInLaiBill_Click">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="💵" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Text="In lại bill&#x0a;(F8)" FontSize="9.5" TextAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnThanhToan" Style="{StaticResource CenterActionBtnStyle}" Height="42" Background="#fff1b8" BorderBrush="#d48806" Click="BtnThanhToan_Click">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="💰" FontSize="12" HorizontalAlignment="Center"/>
                            <TextBlock Text="Thanh&#x0a;toán (F11)" FontWeight="Bold" FontSize="9.5" TextAlignment="Center" Foreground="#873800"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnThongKe" Style="{StaticResource CenterActionBtnStyle}" Height="34">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📊" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Text="Thống kê (F9)" FontSize="9" TextAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ======================= CỘT 3: THỰC ĐƠN / DANH MỤC MÓN BÊN PHẢI ======================= -->
            <Border Grid.Column="2" Background="White" BorderBrush="#a4c2e0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="130"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Search box Tìm (F3) -->
                    <Border Grid.Row="0" Background="#f0f5fb" BorderBrush="#d0e0f0" BorderThickness="0,0,0,1" Padding="4,2">
                        <DockPanel>
                            <TextBlock Text="Tìm (F3): " VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Margin="2,0,4,0"/>
                            <TextBox x:Name="TxtTimKiem" Height="20" VerticalContentAlignment="Center" Background="White" BorderBrush="#a4c2e0" TextChanged="TxtTimKiem_TextChanged"/>
                        </DockPanel>
                    </Border>

                    <!-- Row 1: TreeView Nhóm mặt hàng -->
                    <TreeView x:Name="TvMenu" Grid.Row="1" BorderThickness="0,0,0,1" BorderBrush="#d0e0f0"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              SelectedItemChanged="TvMenu_SelectedItemChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="{x:Type TreeViewItem}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <TextBlock Text="{Binding Icon}" Margin="0,0,4,0" FontSize="11"/>
                                    <TextBlock Text="{Binding Name}" FontSize="11"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <!-- Row 2: DataGrid Mặt hàng -->
                    <DataGrid x:Name="DgMatHang" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" GridLinesVisibility="All" AlternatingRowBackground="#f0f5fb" Background="White"
                              HeadersVisibility="Column" RowHeight="22" FontSize="11" SelectionMode="Single"
                              MouseDoubleClick="DgMatHang_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên hàng" Binding="{Binding Name}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="ĐVT" Binding="{Binding DonViTinh}" Width="40">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Giá bán" Binding="{Binding GiaBan, StringFormat={}{0:N0}}" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,4,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Mã hàng" Binding="{Binding Code}" Width="55"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. BOTTOM FOOTER TOOLBAR -->
        <Border Grid.Row="3" Background="#dbe9f6" BorderBrush="#a4c2e0" BorderThickness="0,1,0,0" Padding="8,4">
            <DockPanel>
                <!-- Left Buttons: Lưu & In, Lưu & Xem in -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="BtnLuuVaIn" Style="{StaticResource FooterBtnStyle}" Click="BtnLuuVaIn_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨️" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Lưu &amp; In" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnLuuVaXemIn" Style="{StaticResource FooterBtnStyle}" Click="BtnLuuVaXemIn_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📄" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Lưu &amp; Xem in" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right Buttons: Lưu, Lưu & thoát, Thoát -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button x:Name="BtnLuu" Style="{StaticResource FooterBtnStyle}" Click="BtnLuu_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Lưu" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnLuuVaThoat" Style="{StaticResource FooterBtnStyle}" Click="BtnLuuVaThoat_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Lưu &amp; thoát" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnThoat" Style="{StaticResource FooterBtnStyle}" Click="BtnThoat_Click">
                        <TextBlock Text="Thoát" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
