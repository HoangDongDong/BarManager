<Window x:Class="QuanLyBar.Client.Views.DanhMucCaLamViec.ThemSuaCaLamViecWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CA LÀM VIỆC - SỬA" Height="410" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#dce7f5" WindowStyle="SingleBorderWindow"
        FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>
        <!-- Style Toolbar Button -->
        <Style x:Key="SubToolbarBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#f4f7fb"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#c2d5ea"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#fff0b3"/>
                    <Setter Property="BorderBrush" Value="#f5a623"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Footer Button -->
        <Style x:Key="ActionBtnStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="75"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#f4f7fb"/>
            <Setter Property="BorderBrush" Value="#a4bce3"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e6f0fa"/>
                    <Setter Property="BorderBrush" Value="#6495ed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0. Header -->
            <RowDefinition Height="Auto"/> <!-- 1. Sub Toolbar -->
            <RowDefinition Height="*"/>    <!-- 2. Form content -->
            <RowDefinition Height="Auto"/> <!-- 3. Footer -->
        </Grid.RowDefinitions>

        <!-- 0. HEADER -->
        <Border Grid.Row="0" Background="#fffde6" BorderBrush="#e2d6b5" BorderThickness="0,0,0,1" Padding="15,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtHeaderIcon" Text="🕒" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtHeaderTitle" Text="Ca làm việc" FontSize="15" FontWeight="Bold" Foreground="#112233" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 1. SUB TOOLBAR -->
        <Border Grid.Row="1" Background="#eaf1fa" BorderBrush="#b6cadf" BorderThickness="0,0,0,1" Padding="6,3">
            <DockPanel LastChildFill="False">
                <!-- Phím tắt -->
                <Button Style="{StaticResource SubToolbarBtnStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="↗️" FontSize="10" Foreground="#2980b9" Margin="0,0,3,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Phím tắt ▾" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!-- Trước (F10) -->
                <Button x:Name="BtnPrevious" Style="{StaticResource SubToolbarBtnStyle}" Click="BtnPrevious_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⬅️" FontSize="10" Foreground="#2980b9" Margin="0,0,3,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Trước (F10)" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!-- Sau (F11) -->
                <Button x:Name="BtnNext" Style="{StaticResource SubToolbarBtnStyle}" Click="BtnNext_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➡️" FontSize="10" Foreground="#2980b9" Margin="0,0,3,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Sau (F11)" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!-- Tạo mới -->
                <Button x:Name="BtnTaoMoi" Style="{StaticResource SubToolbarBtnStyle}" Click="BtnTaoMoi_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➕" FontSize="10" Foreground="#27ae60" Margin="0,0,3,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Tạo mới" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <!-- 2. FORM CONTENT -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="15,10">
            <StackPanel>
                <!-- Dòng 1: Tên ca làm việc & Ảnh -->
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Tên ca làm việc" VerticalAlignment="Center" Foreground="#1e293b"/>
                    <TextBox x:Name="TxtName" Grid.Column="1" Height="24" Background="#e1f5fe" BorderBrush="#0288d1" BorderThickness="1.5" VerticalContentAlignment="Center" Padding="4,0"/>
                    
                    <TextBlock Text="Ảnh:" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0" Foreground="#1e293b"/>
                    <ComboBox x:Name="CboAnh" Grid.Column="3" Height="24" VerticalContentAlignment="Center" Background="White" BorderBrush="#a4bce3">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding ImageSource}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,3,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <!-- Dòng 2: Tỉ lệ lương -->
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Tỉ lệ lương" VerticalAlignment="Center" Foreground="#1e293b"/>
                    <TextBox x:Name="TxtTiLeLuong" Grid.Column="1" Text="100" Height="24" Background="White" BorderBrush="#a0b8d4" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" Padding="4,0"/>
                    <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="#1e293b"/>
                </Grid>

                <!-- Dòng 3: Từ giờ ... Đến giờ -->
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Từ giờ" VerticalAlignment="Center" Foreground="#1e293b"/>
                    <ComboBox x:Name="CboTuGio" Grid.Column="1" Height="24" IsEditable="True" Background="White" BorderBrush="#a0b8d4" VerticalContentAlignment="Center"/>
                    
                    <TextBlock Grid.Column="2" Text="Đến giờ" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#1e293b"/>
                    <ComboBox x:Name="CboDenGio" Grid.Column="3" Height="24" IsEditable="True" Background="White" BorderBrush="#a0b8d4" VerticalContentAlignment="Center"/>
                </Grid>

                <!-- Dòng 4: Ghi chú -->
                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Ghi chú" VerticalAlignment="Top" Margin="0,4,0,0" Foreground="#1e293b"/>
                    <TextBox x:Name="TxtNote" Grid.Column="1" Height="90" TextWrapping="Wrap" AcceptsReturn="True" Background="White" BorderBrush="#a0b8d4" VerticalContentAlignment="Top" Padding="4"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- 3. FOOTER -->
        <Border Grid.Row="3" Background="#eaf1fa" BorderBrush="#b6cadf" BorderThickness="0,1,0,0" Padding="10,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- Lưu -->
                <Button x:Name="BtnLuu" Style="{StaticResource ActionBtnStyle}" Width="70" Click="BtnLuu_Click" ToolTip="Ctrl+L">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💾" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Lưu" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!-- Lưu & Mới -->
                <Button x:Name="BtnLuuVaMoi" Style="{StaticResource ActionBtnStyle}" Width="78" Click="BtnLuuVaMoi_Click" ToolTip="Ctrl+S">
                    <TextBlock Text="Lưu &amp; Mới" VerticalAlignment="Center"/>
                </Button>
                <!-- Lưu & Thoát -->
                <Button x:Name="BtnLuuVaThoat" Style="{StaticResource ActionBtnStyle}" Width="84" Background="White" BorderBrush="#0078d7" BorderThickness="1.5" FontWeight="SemiBold" Click="BtnLuuVaThoat_Click">
                    <TextBlock Text="Lưu &amp; thoát" VerticalAlignment="Center"/>
                </Button>
                <!-- Thoát -->
                <Button x:Name="BtnThoat" Style="{StaticResource ActionBtnStyle}" Width="70" Click="BtnThoat_Click" Content="Thoát"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
