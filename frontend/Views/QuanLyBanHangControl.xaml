<UserControl x:Class="QuanLyBar.Client.Views.QuanLyBanHangControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200" Loaded="UserControl_Loaded">
             
    <Grid Background="#e5ecf3">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="3.5*"/>
            <ColumnDefinition Width="2.5*"/>
        </Grid.ColumnDefinitions>

        <!-- ======================= CỘT TRÁI: DANH SÁCH HÓA ĐƠN ======================= -->
        <Grid Grid.Column="0" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <Border Grid.Row="0" Margin="0,0,0,5" Background="#e3eaf5" Padding="5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Từ:" VerticalAlignment="Center" Margin="5,0"/>
                    <DatePicker x:Name="dpTuNgay" Width="100"/>
                    <TextBlock Text="Đến:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                    <DatePicker x:Name="dpDenNgay" Width="100"/>
                    <Button Content="Tải dữ liệu" Margin="10,0,0,0" Padding="10,2" Click="BtnTaiDuLieu_Click"/>
                </StackPanel>
            </Border>
            
            <DataGrid x:Name="DgHoaDon" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All" AlternatingRowBackground="#f9f9f9" SelectionChanged="DgHoaDon_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Số phiếu" Binding="{Binding SoPhieu}"/>
                    <DataGridTextColumn Header="Ngày" Binding="{Binding Ngay, StringFormat=dd/MM/yyyy}"/>
                    <DataGridTextColumn Header="Bàn" Binding="{Binding Ban}"/>
                    <DataGridTextColumn Header="Bắt đầu" Binding="{Binding BatDau, StringFormat=HH:mm}"/>
                    <DataGridTextColumn Header="Kết thúc" Binding="{Binding KetThuc, StringFormat=HH:mm}"/>
                    <DataGridTextColumn Header="Giờ thanh toán" Binding="{Binding GioThanhToan, StringFormat=HH:mm}"/>
                    <DataGridTextColumn Header="Tổng cộng" Binding="{Binding TongCong, StringFormat={}{0:N0}}"/>
                    <DataGridTextColumn Header="Khách hàng" Binding="{Binding KhachHang}"/>
                    <DataGridTextColumn Header="Tiền giảm giá" Binding="{Binding TienGiamGia, StringFormat={}{0:N0}}"/>
                    <DataGridTextColumn Header="Tỉ lệ giảm giá" Binding="{Binding TiLeGiamGia}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- ======================= CỘT GIỮA: ORDER CHI TIẾT ======================= -->
        <Border Grid.Column="1" BorderBrush="#b6c1cd" BorderThickness="1" Background="White" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <Border Grid.Row="0" Margin="5" Background="#cbe8f6" Padding="5">
                    <StackPanel>
                        <!-- Thêm nút Hủy phiếu ở góc phải -->
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <ComboBox Width="100" Margin="0,0,5,0" IsEditable="True" Text="__/__/____"/>
                                <Button Content="Bắt đầu" Width="70"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="Ngày" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <ComboBox Width="100" IsEditable="True" Text="__/__/____"/>
                            </StackPanel>
                            <!-- Nút Hủy phiếu -->
                            <Button Grid.Column="2" Content="X Hủy phiếu" Foreground="Gray" Margin="10,0,0,0" Padding="5,2"/>
                        </Grid>

                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <ComboBox Width="100" Margin="0,0,5,0" IsEditable="True" Text="__/__/____"/>
                                <TextBlock Text="0 phút" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="Số phiếu" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox Width="80" Margin="0,0,10,0"/>
                                <TextBlock Text="Số khách" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox Width="30" Text="0" TextAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Khách hàng (F12)" VerticalAlignment="Center" Margin="0,0,5,0" Width="100"/>
                            <ComboBox Grid.Column="1"/>
                        </Grid>

                        <!-- Tabs "Hóa đơn | Chi tiết giờ" và Toolbar -->
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <!-- Tabs thay thế bằng ToggleButton để mô phỏng -->
                            <Button Content="Hóa đơn" Background="#e3eaf5" BorderThickness="1" Margin="0,0,2,0"/>
                            <Button Content="Chi tiết giờ" Background="White" BorderThickness="1" Margin="0,0,10,0"/>
                            
                            <!-- Nút chức năng -->
                            <Button Content="+" Width="24" Height="24" Margin="0,0,2,0"/>
                            <Button Content="-" Width="24" Height="24" Margin="0,0,2,0"/>
                            <Button Content="Đặt sl" Background="Transparent" BorderThickness="0" Margin="0,0,5,0"/>
                            <Button Content="Đổi giá" Background="Transparent" BorderThickness="0" Margin="0,0,5,0"/>
                            <Button Content="Ghi chú" Background="Transparent" BorderThickness="0" Margin="0,0,5,0"/>
                            <Button Content="CK%" Background="Transparent" BorderThickness="0" Margin="0,0,5,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <DataGrid x:Name="DgChiTiet" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="All" AlternatingRowBackground="#f9f9f9">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tên hàng" Binding="{Binding TenMon}" Width="*"/>
                        <DataGridTextColumn Header="ĐVT" Binding="{Binding Dvt}" Width="50"/>
                        <DataGridTextColumn Header="SL" Binding="{Binding SoLuong, StringFormat={}{0:N2}}" Width="40"/>
                        <DataGridTextColumn Header="Đ.giá" Binding="{Binding DonGia, StringFormat={}{0:N0}}" Width="80"/>
                        <DataGridTextColumn Header="CK%" Binding="{Binding PhanTramGiamGia, StringFormat={}{0:N2}}" Width="40"/>
                        <DataGridTextColumn Header="T.tiền" Binding="{Binding ThanhTien, StringFormat={}{0:N0}}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
                
                <TabControl Grid.Row="2" Height="130" Margin="0,5,0,0">
                    <TabItem Header="Tổng">
                        <Grid Background="#cbe8f6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Tiền hàng" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="txtTienHang" Grid.Row="0" Grid.Column="2" Background="#d6ebf5" BorderThickness="1" IsReadOnly="True" TextAlignment="Right" VerticalAlignment="Center" Margin="5"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Giảm giá" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="5">
                                <TextBox x:Name="txtPhanTramGiamGia" Width="40" Text="0" TextAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Text="%" VerticalAlignment="Center" Margin="5,0,5,0"/>
                                <TextBox x:Name="txtTienGiamGia" Width="80" Background="#d6ebf5" BorderThickness="1" IsReadOnly="True" TextAlignment="Right" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Tổng cộng" FontWeight="Bold" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="txtTongCong" Grid.Row="2" Grid.Column="2" Background="#fffdc2" BorderThickness="1" FontWeight="Bold" FontSize="16" Foreground="Red" IsReadOnly="True" TextAlignment="Right" VerticalAlignment="Center" Margin="5"/>
                        </Grid>
                    </TabItem>
                    
                    <TabItem Header="Ghi chú">
                        <TextBox AcceptsReturn="True" TextWrapping="Wrap" Margin="5"/>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <!-- ======================= CỘT PHẢI: CHỨC NĂNG & THỰC ĐƠN ======================= -->
        <Grid Grid.Column="2" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                <Button Height="40" Margin="0,0,0,5">
                    <TextBlock Text="Số lượng" TextWrapping="Wrap" TextAlignment="Center" FontSize="11"/>
                </Button>
                <Button Content="&lt;&lt; Thêm" Height="30" Margin="0,0,0,5" FontSize="11"/>
                <Button Content="Giảm &gt;&gt;" Height="30" Margin="0,0,0,5" FontSize="11"/>
                <Button Content="Xóa" Height="30" Margin="0,0,0,5" FontSize="11"/>
                
                <!-- Spacer -->
                <Border Height="80"/>

                <Button Height="45" Margin="0,0,0,5">
                    <TextBlock Text="% theo nhóm" TextWrapping="Wrap" TextAlignment="Center" FontSize="11"/>
                </Button>

                <Border Height="80"/>

                <Button Height="45" Margin="0,0,0,5">
                    <TextBlock Text="In lại bill (F8)" TextWrapping="Wrap" TextAlignment="Center" FontSize="11"/>
                </Button>

                <Button Height="45" Margin="0,0,0,5" Background="#fffdc2">
                    <TextBlock Text="Thanh toán (F11)" TextWrapping="Wrap" TextAlignment="Center" FontSize="11" FontWeight="Bold"/>
                </Button>
            </StackPanel>
            
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Grid Grid.Row="0" Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Tìm (F3):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Grid.Column="1" Height="22"/>
                </Grid>
                
                <TreeView x:Name="TvMenu" Grid.Row="1" Margin="0,0,0,5" SelectedItemChanged="TvMenu_SelectedItemChanged" BorderBrush="#b6c1cd" BorderThickness="1">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="📁" Margin="0,0,5,0" Foreground="Orange"/>
                                <TextBlock Text="{Binding Name}"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                
                <DataGrid x:Name="DgMatHang" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="All" AlternatingRowBackground="#f9f9f9">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tên hàng" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="ĐVT" Binding="{Binding DonViTinh}" Width="50"/>
                        <DataGridTextColumn Header="Giá bán" Binding="{Binding GiaBan, StringFormat={}{0:N0}}" Width="80"/>
                        <DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="40"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
