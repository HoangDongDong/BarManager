<Window x:Class="QuanLyBar.Client.Views.QuanLyKiemKe.MatHangChuaKiemKeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuanLyBar.Client.Views.QuanLyKiemKe"
        mc:Ignorable="d"
        Title="🔍 CÁC MẶT HÀNG CHƯA KIỂM KÊ" Height="500" Width="820"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12" Background="#dbe8f5">

    <Window.Resources>
        <LinearGradientBrush x:Key="ButtonGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#ffffff" Offset="0"/>
            <GradientStop Color="#e2edf8" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="StandardBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ButtonGradient}"/>
            <Setter Property="BorderBrush" Value="#9bb7d4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#e3f0fc"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3c7fb1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#cbe1f7"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#205f94"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>

        <!-- KHU VỰC 2 PHẦN: CÂY NHÓM (TRÁI) VÀ DANH SÁCH MẶT HÀNG CHƯA KIỂM KÊ (PHẢI) -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="180" MaxWidth="350"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: CÂY NHÓM MẶT HÀNG -->
            <Border Grid.Column="0" Background="White" BorderBrush="#a6c0db" BorderThickness="1">
                <TreeView x:Name="TvNhomMatHang" BorderThickness="0" Background="White"
                          SelectedItemChanged="TvNhomMatHang_SelectedItemChanged">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="{Binding Icon}" Margin="0,0,5,0" VerticalAlignment="Center" FontSize="12"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" Foreground="#111111"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}">
                            <Setter Property="IsExpanded" Value="True"/>
                            <Setter Property="Padding" Value="2,2"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#cbe1f7"/>
                                    <Setter Property="BorderBrush" Value="#7da2ce"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </Border>

            <!-- THANH CO GIÃN -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

            <!-- CỘT PHẢI: LƯỚI MẶT HÀNG CHƯA KIỂM KÊ (Mặt hàng, ĐVT, Mã hàng) -->
            <Border Grid.Column="2" Background="White" BorderBrush="#a6c0db" BorderThickness="1">
                <DataGrid x:Name="DgMatHangChuaKiemKe" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          IsReadOnly="True" HeadersVisibility="All" GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#e2e8f0" VerticalGridLinesBrush="#e2e8f0"
                          RowHeight="22" SelectionMode="Single" SelectionUnit="FullRow"
                          Background="White" RowBackground="White" AlternatingRowBackground="#f8fbff"
                          MouseDoubleClick="DgMatHangChuaKiemKe_MouseDoubleClick">
                    <DataGrid.RowHeaderStyle>
                        <Style TargetType="{x:Type DataGridRowHeader}">
                            <Setter Property="Width" Value="34"/>
                            <Setter Property="Background" Value="#dfe9f5"/>
                            <Setter Property="BorderBrush" Value="#b6cadf"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="Content" Value="{Binding SttHienThi}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="FontSize" Value="11"/>
                        </Style>
                    </DataGrid.RowHeaderStyle>
                    <DataGrid.Columns>
                        <!-- Mặt hàng -->
                        <DataGridTextColumn Header="Mặt hàng" Binding="{Binding Name}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,0,0,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- ĐVT -->
                        <DataGridTextColumn Header="ĐVT" Binding="{Binding TenDonViTinh}" Width="100">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background" Value="#fffde6"/>
                                    <Setter Property="BorderBrush" Value="#e2e8f0"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#0078d7"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,0,0,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Mã hàng -->
                        <DataGridTextColumn Header="Mã hàng" Binding="{Binding Code}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,0,0,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- THANH NÚT DƯỚI CÙNG -->
        <Border Grid.Row="1" Padding="0,6,0,0">
            <DockPanel LastChildFill="False">
                <Button x:Name="BtnDong" DockPanel.Dock="Right" Content="Đóng" Width="90" Height="26" Style="{StaticResource StandardBtn}" Click="BtnDong_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
