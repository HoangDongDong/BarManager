<UserControl x:Class="QuanLyBar.Client.Views.QuanLyKiemKe.QuanLyKiemKeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuanLyBar.Client.Views.QuanLyKiemKe"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200"
             FontFamily="Segoe UI" FontSize="12" Background="#f0f4f9">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#dbe9f6" Offset="0"/>
            <GradientStop Color="#c9ddf0" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="ToolbarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#e3eefc"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#a4c4e8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#cce0f5"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#7da2ce"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallActionBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#d2e3f7"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#95b9e4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#b8d4f4"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#6f98cd"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#d8e8f8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#b8d4f4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderTabStyle" TargetType="Border">
            <Setter Property="Background" Value="#f4f8fc"/>
            <Setter Property="BorderBrush" Value="#b6cadf"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="CornerRadius" Value="4,4,0,0"/>
            <Setter Property="Padding" Value="12,5"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="180" MaxWidth="400"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= CỘT TRÁI: BỘ LỌC VÀ CÂY PHÂN NHÓM ================= -->
        <Border Grid.Column="0" Background="#dbe9f6" BorderBrush="#a6c0db" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header "Nhóm" -->
                    <RowDefinition Height="Auto"/> <!-- Bộ lọc ngày & Kho -->
                    <RowDefinition Height="Auto"/> <!-- Toolbar thao tác cây -->
                    <RowDefinition Height="*"/>    <!-- Cây phân nhóm -->
                </Grid.RowDefinitions>

                <!-- 1. Tiêu đề Phân nhóm -->
                <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" BorderBrush="#b6cadf" BorderThickness="0,0,0,1" Padding="6,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🏷️" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtHeaderPhanNhom" Text="Kho hàng" FontWeight="Bold" FontSize="12.5" Foreground="#1e3f66"/>
                    </StackPanel>
                </Border>

                <!-- 2. Form Lọc (Ngày Từ - Đến, Kho nhập) -->
                <Border Grid.Row="1" Background="#e2ecf7" BorderBrush="#b6cadf" BorderThickness="0,0,0,1" Padding="6,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Ngày Từ -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Ngày  Từ:" VerticalAlignment="Center" Margin="0,2" FontWeight="SemiBold" Foreground="#1e3f66"/>
                        <Grid Grid.Row="0" Grid.Column="1" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="22"/>
                            </Grid.ColumnDefinitions>
                            <DatePicker x:Name="DpTuNgay" Height="22" SelectedDateChanged="DpDate_SelectedDateChanged"/>
                            <Button Grid.Column="1" Style="{StaticResource SmallActionBtn}" ToolTip="Chọn nhanh khoảng thời gian" Margin="2,0,0,0" Click="BtnQuickDate_Click">
                                <TextBlock Text="▾" Foreground="#0056b3" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>

                        <!-- Ngày Đến -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Đến:" VerticalAlignment="Center" Margin="0,2" FontWeight="SemiBold" Foreground="#1e3f66" HorizontalAlignment="Right" Padding="0,0,4,0"/>
                        <DatePicker Grid.Row="1" Grid.Column="1" x:Name="DpDenNgay" Height="22" Margin="0,2" SelectedDateChanged="DpDate_SelectedDateChanged"/>

                        <!-- Kho nhập -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Kho nhập" VerticalAlignment="Center" Margin="0,2" TextWrapping="Wrap"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CboKhoNhap" Height="22" Margin="0,2" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="CboFilter_SelectionChanged"/>
                    </Grid>
                </Border>

                <!-- 3. Thanh tác vụ dưới Form Lọc (Thêm, Sửa, Thêm thư mục, Xem theo thư mục, Tải lại, Chế độ phân nhóm) -->
                <Border Grid.Row="2" Background="#eaf1fa" BorderBrush="#b6cadf" BorderThickness="0,0,0,1" Padding="2,2">
                    <DockPanel LastChildFill="False">
                        <Button x:Name="BtnThemKho" ToolTip="Thêm mới" Margin="1,0" Padding="3,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnThemKho_Click">
                            <TextBlock Text="➕" Foreground="Green" FontSize="13"/>
                        </Button>
                        <Button x:Name="BtnSuaKho" ToolTip="Chỉnh sửa" Margin="1,0" Padding="3,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnSuaKho_Click">
                            <TextBlock Text="✏️" FontSize="13"/>
                        </Button>
                        <Button x:Name="BtnThemThuMuc" ToolTip="Tạo mới thư mục" Margin="1,0" Padding="3,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnThemThuMuc_Click">
                            <TextBlock Text="📁" Foreground="#d4a017" FontSize="13"/>
                        </Button>
                        <Button x:Name="BtnXemTheoThuMuc" ToolTip="Hiển thị tất cả dữ liệu theo thư mục" Margin="1,0" Padding="3,2" 
                                Background="#fff9e6" BorderBrush="#e6a800" BorderThickness="1" Cursor="Hand" Click="BtnDanhMucKho_Click">
                            <TextBlock Text="🗂️" FontSize="13"/>
                        </Button>
                        <Button x:Name="BtnTaiLaiKho" ToolTip="Tải lại" Margin="1,0" Padding="3,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnRefreshTree_Click">
                            <TextBlock Text="🔄" FontSize="13"/>
                        </Button>

                        <Button x:Name="BtnMenuCheDo" DockPanel.Dock="Right" ToolTip="Chế độ phân nhóm" Margin="2,0" Padding="4,2" 
                                Background="#e2ecf8" BorderBrush="#a4bce3" Cursor="Hand" Click="BtnMenuCheDo_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗂️" FontSize="12" Margin="0,0,2,0"/>
                                <TextBlock Text="▾" FontSize="10" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu x:Name="CmCheDoPhanNhom">
                                    <MenuItem Header="🏠  Kho nhập" Click="MiCheDoKhoNhap_Click"/>
                                    <MenuItem Header="👩  Nhân viên nhập" Click="MiCheDoNhanVienNhap_Click"/>
                                    <MenuItem Header="🏪  Cửa hàng" Click="MiCheDoCuaHang_Click"/>
                                    <MenuItem Header="🏛️  Tài khoản ngân hàng" Click="MiCheDoTaiKhoanNganHang_Click"/>
                                    <MenuItem Header="📅  Bảng giá" Click="MiCheDoBangGia_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </DockPanel>
                </Border>

                <!-- 4. Cây danh mục phân nhóm -->
                <TreeView Grid.Row="3" x:Name="TvKhoHang" Background="White" BorderThickness="0"
                          SelectedItemChanged="TvKhoHang_SelectedItemChanged">
                    <TreeView.ContextMenu>
                        <ContextMenu x:Name="CmTreeView" Opened="CmTreeView_Opened">
                            <!-- 1. Thêm mới -->
                            <MenuItem Header="Thêm mới">
                                <MenuItem Header="➕  Thêm kho hàng" Click="MiThemMoiItem_Click"/>
                                <MenuItem Header="Thêm nhanh" Click="MiThemNhanhGoc_Click"/>
                                <MenuItem Header="📁  Thêm thư mục" Click="MiThemThuMucGoc_Click"/>
                            </MenuItem>

                            <!-- 2. Thêm con -->
                            <MenuItem Header="Thêm con">
                                <MenuItem Header="➕  Thêm kho hàng" Click="MiThemConItem_Click"/>
                                <MenuItem Header="Thêm nhanh" Click="MiThemNhanhCon_Click"/>
                                <MenuItem Header="📁  Thêm thư mục" Click="MiThemThuMucCon_Click"/>
                            </MenuItem>

                            <!-- 3. Chỉnh sửa -->
                            <MenuItem Header="✏️  Chỉnh sửa" Click="MiChinhSua_Click"/>

                            <!-- 4. Sắp xếp theo -->
                            <MenuItem Header="Sắp xếp theo">
                                <MenuItem Header="Tên" IsCheckable="True" IsChecked="True" Click="MiSapXepTen_Click"/>
                                <MenuItem Header="Thứ tự tùy chọn" IsCheckable="True" Click="MiSapXepTuyChon_Click"/>
                            </MenuItem>

                            <!-- 5. Refresh -->
                            <MenuItem Header="🔄  Refresh" Click="BtnLamMoiKho_Click"/>

                            <Separator/>

                            <!-- 6. Sao chép, Mở rộng, Thu gọn -->
                            <MenuItem Header="📑  Sao chép" Click="MiSaoChep_Click"/>
                            <MenuItem Header="Mở rộng" Click="MiMoRong_Click"/>
                            <MenuItem Header="Thu gọn" Click="MiThuGon_Click"/>

                            <Separator/>

                            <!-- 7. Xóa, Khôi phục, Đổi tên, Thùng rác -->
                            <MenuItem Header="❌  Xóa" Click="BtnXoaKho_Click"/>
                            <MenuItem Header="♻️  Khôi phục" Click="MiKhoiPhucTree_Click"/>
                            <MenuItem Header="Đổi tên" Click="MiDoiTen_Click"/>
                            <MenuItem Header="Thùng rác" Click="MiThungRac_Click"/>

                            <Separator/>

                            <!-- 8. Biểu tượng, Thuộc tính -->
                            <MenuItem Header="Biểu tượng" Click="MiBieuTuong_Click"/>
                            <MenuItem Header="Thuộc tính" Click="MiThuocTinh_Click"/>
                        </ContextMenu>
                    </TreeView.ContextMenu>

                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="{Binding Icon}" Margin="0,0,5,0" VerticalAlignment="Center" FontSize="12"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" Foreground="#111111"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}">
                            <Setter Property="IsExpanded" Value="True"/>
                            <Setter Property="Padding" Value="2,2"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#fff2b3"/>
                                    <Setter Property="BorderBrush" Value="#f1a93b"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </Grid>
        </Border>

        <!-- THANH KÉO CO GIÃN CỘT TRÁI / PHẢI -->
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#c2d5e8" Cursor="SizeWE"/>

        <!-- ================= PHẦN PHẢI: BẢNG DỮ LIỆU & TAB CHI TIẾT ================= -->
        <Grid Grid.Column="2" Background="#f0f4f9">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Tab Header: Phiếu kiểm kê -->
                <RowDefinition Height="Auto"/> <!-- Toolbar thao tác -->
                <RowDefinition Height="3*" MinHeight="160"/> <!-- Lưới Phiếu kiểm kê -->
                <RowDefinition Height="4"/>    <!-- Splitter ngang -->
                <RowDefinition Height="2*" MinHeight="120"/> <!-- Tab chi tiết bên dưới -->
            </Grid.RowDefinitions>

            <!-- 1. Tab Header: Phiếu kiểm kê -->
            <Border Grid.Row="0" Style="{StaticResource HeaderTabStyle}" Margin="0,5,5,0" HorizontalAlignment="Left" Width="130">
                <TextBlock Text="Phiếu kiểm kê" FontWeight="Bold" FontSize="12.5" Foreground="#1e3f66" HorizontalAlignment="Center"/>
            </Border>

            <!-- 2. Toolbar Thao tác -->
            <Border Grid.Row="1" Background="#eaf1fa" BorderBrush="#b6cadf" BorderThickness="1,1,1,0" Margin="0,0,5,0" Padding="5,4">
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="Lọc (F3):" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12"/>
                    <TextBox x:Name="TxtSearch" Width="130" Height="22" VerticalContentAlignment="Center" Margin="0,0,10,0" TextChanged="TxtSearch_TextChanged"/>

                    <Button x:Name="BtnThemMoi" Content="➕ Thêm mới (Insert)" Style="{StaticResource ActionBtnStyle}" Click="BtnThemMoi_Click"/>
                    <Button x:Name="BtnChinhSua" Content="✏️ Chỉnh sửa (F4)" Style="{StaticResource ActionBtnStyle}" Click="BtnChinhSua_Click"/>
                    <Button x:Name="BtnXoa" Content="❌ Xóa (Del)" Style="{StaticResource ActionBtnStyle}" Click="BtnXoa_Click"/>
                    <Separator Margin="5,0"/>
                    <Button x:Name="BtnThemExcel" Content="📊 Thêm excel" Style="{StaticResource ActionBtnStyle}" Click="BtnThemExcel_Click"/>
                    <Button x:Name="BtnXuatExcel" Content="📥 Xuất excel" Style="{StaticResource ActionBtnStyle}" Click="BtnXuatExcel_Click"/>
                    <Button x:Name="BtnIn" Content="🖨️ In" Style="{StaticResource ActionBtnStyle}" Click="BtnIn_Click"/>
                    <Button x:Name="BtnTong" Content="∑ Tổng" Style="{StaticResource ActionBtnStyle}" Click="BtnTong_Click"/>
                    <Button x:Name="BtnPhanTich" Content="📊 P.tích" Style="{StaticResource ActionBtnStyle}" Click="BtnPhanTich_Click"/>
                </WrapPanel>
            </Border>

            <!-- 3. LƯỚI DANH SÁCH PHIẾU KIỂM KÊ (44 CỘT CHUẨN GIAO DIỆN) -->
            <Border Grid.Row="2" Background="White" BorderBrush="#b6cadf" BorderThickness="1" Margin="0,0,5,0">
                <DataGrid x:Name="DgPhieuKiemKe" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          IsReadOnly="True" HeadersVisibility="All" GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#e2e8f0" VerticalGridLinesBrush="#e2e8f0"
                          RowHeight="23" SelectionMode="Single" SelectionUnit="FullRow"
                          Background="White" RowBackground="White" AlternatingRowBackground="#f8fbff"
                          SelectionChanged="DgPhieuKiemKe_SelectionChanged"
                          MouseDoubleClick="DgPhieuKiemKe_MouseDoubleClick">
                    <DataGrid.RowStyle>
                        <Style TargetType="{x:Type DataGridRow}">
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="DataGridRow_PreviewMouseRightButtonDown"/>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.RowHeaderStyle>
                        <Style TargetType="{x:Type DataGridRowHeader}">
                            <Setter Property="Width" Value="32"/>
                            <Setter Property="Background" Value="#dfe9f5"/>
                            <Setter Property="BorderBrush" Value="#b6cadf"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="Content" Value="{Binding Stt}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="FontSize" Value="11"/>
                        </Style>
                    </DataGrid.RowHeaderStyle>

                    <DataGrid.ContextMenu>
                        <ContextMenu x:Name="GridContextMenu" Opened="GridContextMenu_Opened">
                            <!-- Chế độ thùng rác -->
                            <MenuItem x:Name="MenuKhoiPhuc" Header="Khôi phục" Click="MenuItem_KhoiPhuc_Click" Visibility="Collapsed">
                                <MenuItem.Icon>
                                    <TextBlock Text="↩️" Foreground="Green" FontWeight="Bold"/>
                                </MenuItem.Icon>
                            </MenuItem>

                            <!-- Chế độ bình thường -->
                            <MenuItem x:Name="MenuThemMoi" Header="Thêm Phiếu kiểm kê" Click="BtnThemMoi_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="➕" Foreground="Green" FontWeight="Bold"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuThemNhanhExcel" Header="Thêm nhanh (excel)" Click="BtnThemExcel_Click"/>
                            <MenuItem x:Name="MenuCapNhatNhanhExcel" Header="Cập nhật nhanh (excel)" Click="BtnThemExcel_Click"/>
                            <MenuItem x:Name="MenuChinhSua" Header="Chỉnh sửa" Click="BtnChinhSua_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="✏️" Foreground="#c07000"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator x:Name="SepDatLoc"/>
                            <MenuItem x:Name="MenuLocCot" Header="Lọc Số phiếu" Click="MenuLocCot_Click"/>
                            <Separator x:Name="SepSapXep"/>
                            <MenuItem x:Name="MenuSapXep" Header="Sắp xếp theo">
                                <MenuItem Header="Sắp xếp tăng dần" Click="MenuItem_SortAsc_Click"/>
                                <MenuItem Header="Sắp xếp giảm dần" Click="MenuItem_SortDesc_Click"/>
                                <Separator/>
                                <MenuItem Header="Số phiếu" Click="MenuItem_SortBySoPhieu_Click"/>
                                <MenuItem Header="Ngày" Click="MenuItem_SortByNgay_Click"/>
                                <MenuItem Header="Kho hàng" Click="MenuItem_SortByKho_Click"/>
                                <MenuItem Header="Nhân viên" Click="MenuItem_SortByNv_Click"/>
                                <MenuItem Header="Tổng cộng" Click="MenuItem_SortByTongCong_Click"/>
                            </MenuItem>
                            <MenuItem x:Name="MenuRefresh" Header="Refresh" Click="BtnLamMoi_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="🔄" Foreground="Green" FontWeight="Bold"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuInDanhSach" Header="In danh sách" Click="BtnIn_Click"/>
                            <Separator x:Name="SepSaoChep"/>
                            <MenuItem x:Name="MenuSaoChepO" Header="Sao chép ô" Click="MenuItem_SaoChepO_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="📄" Foreground="Navy"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuSaoChepVungChon" Header="Sao chép vùng chọn" Click="MenuItem_SaoChepVungChon_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="📑" Foreground="Navy"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuXoa" Header="Xóa" Click="BtnXoa_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="❌" Foreground="Red"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator x:Name="SepKhac"/>
                            <MenuItem x:Name="MenuTuDongGianCot" Header="Tự động giãn cột" Click="MenuItem_TuDongGianCot_Click"/>
                            <MenuItem x:Name="MenuCotHienThi" Header="Cột hiển thị" Click="MenuCotHienThi_Click"/>
                            <MenuItem x:Name="MenuThuocTinh" Header="Thuộc tính" Click="MenuItem_ThuocTinh_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <!-- 1. Số phiếu -->
                        <DataGridTextColumn Header="Số phiếu" Binding="{Binding SoPhieu}" Width="100"/>

                        <!-- 2. Ngày -->
                        <DataGridTextColumn Header="Ngày" Binding="{Binding NgayHienThi}" Width="110"/>

                        <!-- 3. Kho hàng -->
                        <DataGridTextColumn Header="Kho hàng" Binding="{Binding TenKhoHang}" Width="110"/>

                        <!-- 4. Diễn giải -->
                        <DataGridTextColumn Header="Diễn giải" Binding="{Binding DienGiai}" Width="140"/>

                        <!-- 5. Nhân viên -->
                        <DataGridTextColumn Header="Nhân viên" Binding="{Binding TenNhanVien}" Width="110"/>

                        <!-- 6. Ghi chú -->
                        <DataGridTextColumn Header="Ghi chú" Binding="{Binding Note}" Width="110"/>

                        <!-- 7. Cửa hàng -->
                        <DataGridTextColumn Header="Cửa hàng" Binding="{Binding TenCuaHang}" Width="100"/>

                        <!-- 8. Còn lại -->
                        <DataGridTextColumn Header="Còn lại" Binding="{Binding ConLaiFormatted}" Width="85">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,4,0"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 9. Thanh toán -->
                        <DataGridTextColumn Header="Thanh toán" Binding="{Binding ThanhToanFormatted}" Width="85">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,4,0"/></Style>
                            </DataGridTextColumn.ElementStyle>
