<Window x:Class="QuanLyBar.Client.Views.QuanLyKiemKe.ThemPhieuKiemKeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuanLyBar.Client.Views.QuanLyKiemKe"
        mc:Ignorable="d"
        Title="PHIẾU KIỂM KÊ - THÊM MỚI" Height="720" Width="1200"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="12" Background="#f0f4f9">

    <Window.Resources>
        <!-- Header Gradient -->
        <LinearGradientBrush x:Key="TopBarGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#eef4fa" Offset="0"/>
            <GradientStop Color="#d7e5f3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#ffffff" Offset="0"/>
            <GradientStop Color="#e2edf8" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="FlatToolBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#d8e8f8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#bcd7f5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StandardBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ButtonGradient}"/>
            <Setter Property="BorderBrush" Value="#9bb7d4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#e3f0fc"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3c7fb1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#cbe1f7"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#205f94"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/> <!-- 1. Tab Phiếu kiểm kê & Phím tắt gợi ý -->
            <RowDefinition Height="28"/> <!-- 2. Toolbar nhanh (Phím tắt, Trước, Sau, Tạo mới, Sao chép, Xóa) -->
            <RowDefinition Height="Auto"/> <!-- 3. Khu vực nhập thông tin phiếu & Tìm kiếm -->
            <RowDefinition Height="*"/>    <!-- 4. Hai bảng dữ liệu -->
            <RowDefinition Height="38"/> <!-- 5. Thanh tác vụ dưới cùng -->
        </Grid.RowDefinitions>

        <!-- 1. TAB HEADER & PHÍM TẮT GỢI Ý -->
        <Border Grid.Row="0" Background="#dbe9f6" BorderBrush="#b6cadf" BorderThickness="0,0,0,1" Padding="6,2">
            <DockPanel LastChildFill="False">
                <Border DockPanel.Dock="Left" Background="#f4f8fc" BorderBrush="#b6cadf" BorderThickness="1,1,1,0" CornerRadius="4,4,0,0" Padding="8,4" Margin="2,0,0,-3">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="16" Height="16" Background="#cfa264" CornerRadius="2" Margin="0,0,5,0" VerticalAlignment="Center">
                            <TextBlock Text="⊞" Foreground="White" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                        </Border>
                        <TextBlock Text="Phiếu kiểm kê" FontWeight="Bold" FontSize="12.5" Foreground="#1e3f66" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <TextBlock DockPanel.Dock="Right" Text="(Ctrl+S: Lưu&amp;Mới, Ctrl+L: Lưu, Ctrl+N: Mới, Ctrl+P: In, ESC: Thoát)" 
                           Foreground="#333333" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
            </DockPanel>
        </Border>

        <!-- 2. TOOLBAR NHANH (Phím tắt, Trước, Sau, Tạo mới, Sao chép, Xóa) -->
        <Border Grid.Row="1" Background="#e2ecf8" BorderBrush="#b6cadf" BorderThickness="0,0,0,1" Padding="4,2">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button Style="{StaticResource FlatToolBtn}" Click="BtnPhimTat_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💻" Margin="0,0,3,0"/>
                            <TextBlock Text="Phím tắt"/>
                            <TextBlock Text=" ▾" FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Separator Margin="4,2"/>
                    <Button Style="{StaticResource FlatToolBtn}" Click="BtnTruoc_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⬅️" Foreground="#0056b3" Margin="0,0,3,0"/>
                            <TextBlock Text="Trước (F10)"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlatToolBtn}" Click="BtnSau_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➡️" Foreground="#0056b3" Margin="0,0,3,0"/>
                            <TextBlock Text="Sau (F11)"/>
                        </StackPanel>
                    </Button>
                    <Separator Margin="4,2"/>
                    <Button Style="{StaticResource FlatToolBtn}" Click="BtnHeaderThemMoi_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕" Foreground="Green" Margin="0,0,3,0"/>
                            <TextBlock Text="Tạo mới"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlatToolBtn}" Click="BtnSaoChep_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📄" Foreground="#666" Margin="0,0,3,0"/>
                            <TextBlock Text="Sao chép"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Style="{StaticResource FlatToolBtn}" Click="BtnHeaderXoa_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="❌" Foreground="#dc3545" Margin="0,0,3,0"/>
                            <TextBlock Text="Xóa" Foreground="#555"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 3. KHU VỰC FORM THÔNG TIN & TÌM KIẾM MẶT HÀNG -->
        <Border Grid.Row="2" Background="#dbe9f6" BorderBrush="#b6cadf" BorderThickness="0,0,0,1" Padding="8,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Dòng 1: Ngày, Số phiếu, Kho hàng, Nhân viên -->
                    <RowDefinition Height="Auto"/> <!-- Dòng 2: Diễn giải, Ghi chú -->
                    <RowDefinition Height="Auto"/> <!-- Dòng 3: Tìm (F3), Số lượng thực tế, Thêm, Checkbox máy kiểm kho -->
                </Grid.RowDefinitions>

                <!-- Dòng 1: Ngày, Số phiếu, Kho hàng, Nhân viên -->
                <Grid Grid.Row="0" Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Ngày" VerticalAlignment="Center" Foreground="#111"/>
                    <DatePicker Grid.Column="1" x:Name="DpNgay" Height="22"/>

                    <TextBlock Grid.Column="2" Text="Số phiếu" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0" Foreground="#111"/>
                    <TextBox Grid.Column="3" x:Name="TxtSoPhieu" Height="22" FontWeight="SemiBold" VerticalContentAlignment="Center" Padding="4,0"/>

                    <TextBlock Grid.Column="4" Text="Kho hàng" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0" Foreground="#111"/>
                    <ComboBox Grid.Column="5" x:Name="CboKhoHang" Height="22" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="CboKhoHang_SelectionChanged"/>

                    <TextBlock Grid.Column="6" Text="Nhân viên" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0" Foreground="#111"/>
                    <ComboBox Grid.Column="7" x:Name="CboNhanVien" Height="22" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                </Grid>

                <!-- Dòng 2: Diễn giải, Ghi chú -->
                <Grid Grid.Row="1" Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition Width="470"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Diễn giải" VerticalAlignment="Center" Foreground="#111"/>
                    <TextBox Grid.Column="1" x:Name="TxtDienGiai" Height="22" Text="Kiểm kê" VerticalContentAlignment="Center" Padding="4,0"/>

                    <TextBlock Grid.Column="2" Text="Ghi chú" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0" Foreground="#111"/>
                    <TextBox Grid.Column="3" x:Name="TxtGhiChu" Height="22" VerticalContentAlignment="Center" Padding="4,0"/>
                </Grid>

                <!-- Dòng 3: Tìm (F3), Số lượng thực tế, Thêm, Checkbox kiểm trực tiếp máy không dây -->
                <Grid Grid.Row="2" Margin="0,4,0,0">
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="Tìm (F3):" VerticalAlignment="Center" Margin="0,0,4,0" FontWeight="SemiBold" Foreground="#1e3f66"/>
                            <TextBox x:Name="TxtTimMatHang" Width="120" Height="22" VerticalContentAlignment="Center" Padding="4,0" TextChanged="TxtTimMatHang_TextChanged" KeyDown="TxtTimMatHang_KeyDown"/>

                            <TextBlock Text="Số lượng thực tế:" VerticalAlignment="Center" Margin="10,0,4,0" Foreground="#111"/>
                            <TextBox x:Name="TxtSoLuongThem" Width="45" Height="22" Text="1" TextAlignment="Right" VerticalContentAlignment="Center" Padding="2,0" KeyDown="TxtSoLuongThem_KeyDown"/>

                            <Button x:Name="BtnThemMatHang" Content="Thêm" Width="60" Height="22" Margin="6,0,0,0" Style="{StaticResource StandardBtn}" Click="BtnThemMatHang_Click"/>

                            <CheckBox x:Name="ChkKiemMayKhongDay" Content="Kiểm trực tiếp bằng máy không dây" VerticalAlignment="Center" Margin="15,0,0,0" Foreground="#111"/>
                        </StackPanel>

                        <Button x:Name="BtnMatHangChuaKiemKe" DockPanel.Dock="Right" Content="Mặt hàng chưa kiểm kê" Height="22" Padding="8,2" Margin="0,0,4,0" Style="{StaticResource StandardBtn}" Click="BtnMatHangChuaKiemKe_Click"/>
                    </DockPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 4. HAI BẢNG DỮ LIỆU (TRÁI: DANH MỤC MẶT HÀNG, PHẢI: CHI TIẾT KIỂM KÊ) -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="260" MaxWidth="550"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- BẢNG TRÁI: DANH MỤC MẶT HÀNG (Tên hàng, ĐVT, Mã hàng) -->
            <Border Grid.Column="0" Background="White" BorderBrush="#b6cadf" BorderThickness="0,0,1,0">
                <DataGrid x:Name="DgMatHangCatalog" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          IsReadOnly="True" HeadersVisibility="All" GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#e2e8f0" VerticalGridLinesBrush="#e2e8f0"
                          RowHeight="22" SelectionMode="Single" SelectionUnit="FullRow"
                          Background="White" RowBackground="White" AlternatingRowBackground="#f8fbff"
                          MouseDoubleClick="DgMatHangCatalog_MouseDoubleClick">
                    <DataGrid.RowHeaderStyle>
                        <Style TargetType="{x:Type DataGridRowHeader}">
                            <Setter Property="Width" Value="34"/>
                            <Setter Property="Background" Value="#dfe9f5"/>
                            <Setter Property="BorderBrush" Value="#b6cadf"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="Content" Value="{Binding SttHienThi}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="FontSize" Value="11"/>
                        </Style>
                    </DataGrid.RowHeaderStyle>
                    <DataGrid.Columns>
                        <!-- Tên hàng -->
                        <DataGridTextColumn Header="Tên hàng" Binding="{Binding Name}" Width="*"/>
                        <!-- ĐVT -->
                        <DataGridTextColumn Header="ĐVT" Binding="{Binding TenDonViTinh}" Width="65"/>
                        <!-- Mã hàng -->
                        <DataGridTextColumn Header="Mã hàng" Binding="{Binding Code}" Width="75"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- THANH CO GIÃN GIỮA 2 BẢNG -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#c2d5e8" Cursor="SizeWE"/>

            <!-- BẢNG PHẢI: CHI TIẾT PHIẾU KIỂM KÊ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="26"/> <!-- Toolbar bảng chi tiết -->
                    <RowDefinition Height="*"/>  <!-- DataGrid bảng chi tiết -->
                </Grid.RowDefinitions>

                <!-- Toolbar bảng chi tiết (Nhập từ máy kiểm kho, Xóa dòng F8, Nhập từ excel, Xuất excel, Lọc) -->
                <Border Grid.Row="0" Background="#dbe9f6" BorderBrush="#b6cadf" BorderThickness="0,0,0,1" Padding="4,1">
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <Button Style="{StaticResource FlatToolBtn}" Click="BtnNhapMayKiemKho_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📥" Foreground="#0056b3" Margin="0,0,3,0"/>
                                    <TextBlock Text="Nhập từ máy kiểm kho"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource FlatToolBtn}" Click="BtnXoaDong_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="❌" Foreground="#dc3545" Margin="0,0,3,0"/>
                                    <TextBlock Text="Xóa dòng (F8)"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource FlatToolBtn}" Click="BtnNhapExcel_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📊" Foreground="Green" Margin="0,0,3,0"/>
                                    <TextBlock Text="Nhập từ excel"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource FlatToolBtn}" Click="BtnXuatExcel_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📗" Foreground="DarkGreen" Margin="0,0,3,0"/>
                                    <TextBlock Text="Xuất excel"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                            <TextBlock Text="Lọc" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#333"/>
                            <TextBox x:Name="TxtLocChiTiet" Width="100" Height="20" VerticalContentAlignment="Center" Padding="2,0" TextChanged="TxtLocChiTiet_TextChanged"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <DataGrid Grid.Row="1" x:Name="DgPhieuKiemKeChiTiet" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="All" GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#e2e8f0" VerticalGridLinesBrush="#e2e8f0"
                          RowHeight="23" SelectionMode="Single" SelectionUnit="FullRow"
                          Background="White" RowBackground="White" AlternatingRowBackground="#f8fbff"
                          CellEditEnding="DgPhieuKiemKeChiTiet_CellEditEnding">
                    <DataGrid.RowHeaderStyle>
                        <Style TargetType="{x:Type DataGridRowHeader}">
                            <Setter Property="Width" Value="32"/>
                            <Setter Property="Background" Value="#dfe9f5"/>
                            <Setter Property="BorderBrush" Value="#b6cadf"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="Content" Value="{Binding SttHienThi}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="FontSize" Value="11"/>
                        </Style>
                    </DataGrid.RowHeaderStyle>
                    <DataGrid.Columns>
                        <!-- Tên hàng -->
                        <DataGridTextColumn Header="Tên hàng" Binding="{Binding TenHang}" Width="160" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,0,0,0"/>
                                    <Setter Property="Foreground" Value="{Binding RowForeground}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Mã hàng -->
                        <DataGridTextColumn Header="Mã hàng" Binding="{Binding MaHang}" Width="85" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,0,0,0"/>
                                    <Setter Property="Foreground" Value="{Binding RowForeground}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Số lượng hệ thống -->
                        <DataGridTextColumn Header="Số lượng hệ thống" Binding="{Binding SoLuongHeThong, StringFormat={}{0:N0}, UpdateSourceTrigger=LostFocus}" Width="120">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background" Value="#fffde6"/>
                                    <Setter Property="BorderBrush" Value="#e2e8f0"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#0078d7"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="0,0,4,0"/>
                                    <Setter Property="Foreground" Value="{Binding RowForeground}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Số lượng thực tế -->
                        <DataGridTextColumn Header="Số lượng thực tế" Binding="{Binding SoLuongThucTe, StringFormat={}{0:N0}, UpdateSourceTrigger=LostFocus}" Width="120">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background" Value="#fffde6"/>
                                    <Setter Property="BorderBrush" Value="#e2e8f0"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#0078d7"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Margin" Value="0,0,4,0"/>
                                    <Setter Property="Foreground" Value="{Binding RowForeground}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Tên đơn vị tính -->
                        <DataGridTextColumn Header="Tên đơn vị tính" Binding="{Binding TenDonViTinh}" Width="100" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,0,0,0"/>
                                    <Setter Property="Foreground" Value="{Binding RowForeground}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Điều chỉnh nhập -->
                        <DataGridTextColumn Header="Điều chỉnh nhập" Binding="{Binding DieuChinhNhapFormatted}" Width="110" IsReadOnly="True">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background" Value="#fffde6"/>
                                    <Setter Property="BorderBrush" Value="#e2e8f0"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#0078d7"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="0,0,4,0"/>
                                    <Setter Property="Foreground" Value="{Binding RowForeground}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Điều chỉnh xuất -->
                        <DataGridTextColumn Header="Điều chỉnh xuất" Binding="{Binding DieuChinhXuatFormatted}" Width="110" IsReadOnly="True">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background" Value="#fffde6"/>
                                    <Setter Property="BorderBrush" Value="#e2e8f0"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#0078d7"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="0,0,4,0"/>
                                    <Setter Property="Foreground" Value="{Binding RowForeground}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <!-- 5. THANH TÁC VỤ DƯỚI CÙNG -->
        <Border Grid.Row="4" Background="#dbe9f6" BorderBrush="#b6cadf" BorderThickness="0,1,0,0" Padding="8,4">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button x:Name="BtnLuuVaIn" Style="{StaticResource StandardBtn}" Click="BtnLuuVaIn_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨️" Margin="0,0,4,0"/>
                            <TextBlock Text="Lưu &amp; In"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnLuuVaXemIn" Style="{StaticResource StandardBtn}" Click="BtnLuuVaXemIn_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👁️" Margin="0,0,4,0"/>
                            <TextBlock Text="Lưu &amp; Xem in"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnLuu" Style="{StaticResource StandardBtn}" Click="BtnLuu_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" Foreground="Green" Margin="0,0,4,0"/>
                            <TextBlock Text="Lưu"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnLuuVaMoi" Style="{StaticResource StandardBtn}" Click="BtnLuuVaMoi_Click">
                        <TextBlock Text="Lưu &amp; Mới"/>
                    </Button>
                    <Button x:Name="BtnLuuVaThoat" Style="{StaticResource StandardBtn}" Click="BtnLuuVaThoat_Click">
                        <TextBlock Text="Lưu &amp; thoát"/>
                    </Button>
                    <Button x:Name="BtnThoat" Style="{StaticResource StandardBtn}" Click="BtnThoat_Click">
                        <TextBlock Text="Thoát"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
