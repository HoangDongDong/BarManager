<Window x:Class="QuanLyBar.Client.Views.ThemNhanhBanKhuVucWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="THÊM NHANH BÀN VÀ KHU VỰC" 
        Height="470" Width="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#B8CFE5"
        Loaded="Window_Loaded">
    
    <Grid Background="#B8CFE5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Hướng dẫn -->
        <Border Grid.Row="0" Margin="10,8,10,6" Padding="8" Background="#B8CFE5">
            <TextBlock TextWrapping="Wrap" LineHeight="19" FontSize="12" FontFamily="Segoe UI, Tahoma">
                <Run Text="Chức năng này cho phép bạn thêm nhiều bàn vào hệ thống một lúc" Foreground="#002060"/><LineBreak/>
                <Run Text="Để sử dụng, bạn thêm mới khu vực trước, sau đó truy cập vào chức năng này:"/><LineBreak/>
                <Run Text="+ Nhập từ số, đến số và tiền tố bắt đầu bằng."/><LineBreak/>
                <Run Text="Ví dụ"/><LineBreak/>
                <Run Text="    Tầng 1: Từ 1 đến 9, bắt đầu bằng B"/><LineBreak/>
                <Run Text="    Tầng 2: Từ 10 đến 29, bắt đầu bằng B"/><LineBreak/>
                <Run Text="    Tầng 3: Từ 29 đến 99 bắt đầu bằng B"/><LineBreak/>
                <Run Text="Chiều dài vùng số = 2"/><LineBreak/>
                <Run Text="Hệ thống sẽ sinh các bàn: B01-B09 cho tầng 1, B10 đến B29 cho tầng 2, B29-B99 cho tầng 3"/>
            </TextBlock>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="1" Margin="10,2,10,8" BorderBrush="#7088A0" BorderThickness="1" Background="White">
            <DataGrid x:Name="DgThemNhanh" AutoGenerateColumns="False" 
                      CanUserAddRows="False" CanUserDeleteRows="False" SelectionUnit="Cell"
                      Background="White" RowHeaderWidth="0" GridLinesVisibility="All" 
                      HorizontalGridLinesBrush="#D0D7DE" VerticalGridLinesBrush="#D0D7DE"
                      RowHeight="24" FontSize="12"
                      ColumnHeaderHeight="25"
                      BorderThickness="0">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F0F4F8"/>
                        <Setter Property="Foreground" Value="#000000"/>
                        <Setter Property="FontWeight" Value="Normal"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="BorderBrush" Value="#C0C8D0"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Padding" Value="4,2"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Khu vực" Binding="{Binding KhuVucName}" Width="140" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="6,2,4,2"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    
                    <DataGridTextColumn Header="Bàn từ số" Binding="{Binding TuSo, UpdateSourceTrigger=PropertyChanged}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="4,2,4,2"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="TextAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                    
                    <DataGridTextColumn Header="Bàn đến số" Binding="{Binding DenSo, UpdateSourceTrigger=PropertyChanged}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="4,2,4,2"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="TextAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                    
                    <DataGridTextColumn Header="Bắt đầu bằng" Binding="{Binding BatDauBang, UpdateSourceTrigger=PropertyChanged}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="4,2,4,2"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="TextAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                    
                    <DataGridTextColumn Header="Dữ liệu mẫu" Binding="{Binding DuLieuMau}" Width="*" IsReadOnly="True">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="#F7FAFD"/>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="6,2,4,2"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#003366"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Chiều dài vùng số: " VerticalAlignment="Center" FontSize="12"/>
                <TextBox x:Name="TxtChieuDai" Text="0" Width="60" Height="24" TextAlignment="Center" VerticalContentAlignment="Center" TextChanged="TxtChieuDai_TextChanged"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="Thực hiện" Width="85" Height="26" Margin="0,0,8,0" Background="#F0F4F8" BorderBrush="#7088A0" Click="BtnThucHien_Click"/>
                <Button Content="Thoát" Width="80" Height="26" Background="#F0F4F8" BorderBrush="#7088A0" Click="BtnThoat_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

