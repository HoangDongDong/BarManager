<Window x:Class="QuanLyBar.Client.Views.ThemNhanhPhuongThucDatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm nhanh" Height="350" Width="400"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid Background="#f0f4f9" Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Grid Grid.Row="0" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="➕" FontSize="24" Foreground="#1E90FF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TxtHeader" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" Margin="5,0,0,0">
                <Run Text="Mời bạn điền danh sách vào ô phía dưới, mỗi dòng một danh mục"/>
            </TextBlock>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock Text="Ảnh: " VerticalAlignment="Center"/>
                <ComboBox x:Name="CmbImage" Width="40" Height="22">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Image Source="{Binding ImageSource}" Width="16" Height="16"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Grid>
        
        <!-- Textbox -->
        <TextBox x:Name="TxtDanhSach" Grid.Row="1" Margin="5" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        
        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <Button Content="Chấp nhận" Width="80" Height="25" Margin="0,0,5,0" Click="BtnChapNhan_Click" Background="White"/>
            <Button Content="Hủy bỏ" Width="80" Height="25" Click="BtnHuyBo_Click" Background="White"/>
        </StackPanel>
    </Grid>
</Window>
