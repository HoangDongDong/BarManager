<UserControl x:Class="QuanLyBar.Client.Views.DieuChinhHoaDonControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200" Loaded="UserControl_Loaded" PreviewKeyDown="UserControl_PreviewKeyDown">
             
    <Grid Background="#dce7f5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3.8*"/>
            <ColumnDefinition Width="3.7*"/>
            <ColumnDefinition Width="2.5*"/>
        </Grid.ColumnDefinitions>

        <!-- ======================= CỘT TRÁI: DANH SÁCH HÓA ĐƠN ======================= -->
        <Grid Grid.Column="0" Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Filter Bar -->
            <Border Grid.Row="0" Margin="0,0,0,4" Background="#e3eaf5" Padding="6,4" BorderBrush="#b9cfe7" BorderThickness="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Từ:" VerticalAlignment="Center" Margin="2,0,5,0" FontWeight="SemiBold"/>
                    <DatePicker x:Name="dpTuNgay" Width="105" Height="24"/>
                    <TextBlock Text="Đến:" VerticalAlignment="Center" Margin="8,0,5,0" FontWeight="SemiBold"/>
                    <DatePicker x:Name="dpDenNgay" Width="105" Height="24"/>
                    <Button Content="Tải dữ liệu" Margin="10,0,0,0" Padding="12,2" Height="24" Background="White" BorderBrush="#a4b8cc" Cursor="Hand" Click="BtnTaiDuLieu_Click"/>
                </StackPanel>
            </Border>
            
            <!-- Danh sách hóa đơn -->
            <DataGrid x:Name="DgHoaDon" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                      GridLinesVisibility="All" AlternatingRowBackground="#f0f5fb" Background="White"
                      SelectionMode="Single" HeadersVisibility="Column" RowHeight="23" FontSize="11"
                      SelectionChanged="DgHoaDon_SelectionChanged">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="📑 Sao chép ô" Click="MnuSaoChepO_Click"/>
                        <MenuItem Header="📄 Sao chép dòng" Click="MnuSaoChepDong_Click"/>
                        <MenuItem Header="↔️ Tự động dãn cột" Click="MnuTuDongDanCot_Click"/>
                        <MenuItem Header="📊 Cột hiển thị" Click="MnuCotHienThi_Click"/>
                        <Separator/>
                        <MenuItem Header="📥 Xuất dữ liệu Excel" Click="MnuXuatExcel_Click"/>
                        <MenuItem Header="🖨️ In danh sách" Click="MnuInDanhSach_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Số phiếu" Binding="{Binding SoPhieu}" Width="85">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#003399"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Ngày" Binding="{Binding Ngay, StringFormat=dd/MM/yyyy}" Width="75"/>
                    <DataGridTextColumn Header="Bàn" Binding="{Binding Ban}" Width="65">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Bắt đầu" Binding="{Binding BatDau, StringFormat=HH:mm}" Width="55"/>
                    <DataGridTextColumn Header="Kết thúc" Binding="{Binding KetThuc, StringFormat=HH:mm}" Width="55"/>
                    <DataGridTextColumn Header="Giờ thanh toán" Binding="{Binding GioThanhToan, StringFormat=HH:mm}" Width="85"/>
                    <DataGridTextColumn Header="Tổng cộng" Binding="{Binding TongCong, StringFormat={}{0:N0}}" Width="75">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#0055aa"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Khách hàng" Binding="{Binding KhachHang}" Width="90"/>
                    <DataGridTextColumn Header="Tiền giảm giá" Binding="{Binding TienGiamGia, StringFormat={}{0:N0}}" Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Tỉ lệ giảm giá" Binding="{Binding TiLeGiamGia, StringFormat={}{0:N0}}" Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Tiền hàng" Binding="{Binding TienHang, StringFormat={}{0:N0}}" Width="75">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Khách đưa" Binding="{Binding KhachDua, StringFormat={}{0:N0}}" Width="75">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Trả lại" Binding="{Binding TraLai, StringFormat={}{0:N0}}" Width="60">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Thẻ tt" Binding="{Binding TheThanhToan, StringFormat={}{0:N0}}" Width="65">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Tiền mặt" Binding="{Binding TienMat, StringFormat={}{0:N0}}" Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Số khách" Binding="{Binding SoKhach}" Width="60">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Tỉ lệ giảm giá giờ" Binding="{Binding TiLeGiamGiaGio, StringFormat={}{0:N0}}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Số order" Binding="{Binding SoOrder}" Width="65">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Tiền giảm giá giờ" Binding="{Binding TienGiamGiaGio, StringFormat={}{0:N0}}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- ======================= CỘT GIỮA: ORDER CHI TIẾT ======================= -->
        <Border Grid.Column="1" BorderBrush="#b6c1cd" BorderThickness="1" Background="White" Margin="2,4,2,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Thông tin đầu phiếu của hóa đơn được chọn -->
                <Border Grid.Row="0" Margin="4" Background="#cbe8f6" Padding="6,5" BorderBrush="#9dc6e8" BorderThickness="1">
                    <StackPanel>
                        <!-- Hàng 1: Giờ bắt đầu, Nút Bắt đầu, Ngày -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBox x:Name="TxtGioBatDau" Width="125" Height="23" VerticalContentAlignment="Center" Background="White" BorderBrush="#a4c2e0" Text="30/08/2026 16:37"/>
                                <Button Content="Bắt đầu" Width="65" Height="23" Margin="4,0,0,0" Background="#f0f5fa" BorderBrush="#a4c2e0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="Ngày" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                                <DatePicker x:Name="DpNgayOrder" Width="105" Height="23"/>
                            </StackPanel>
                        </Grid>

                        <!-- Hàng 2: Giờ kết thúc, Số phiếu, Số khách -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBox x:Name="TxtGioKetThuc" Width="125" Height="23" VerticalContentAlignment="Center" Background="White" BorderBrush="#a4c2e0" Text="30/08/2026 17:15"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="Số phiếu" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                                <TextBox x:Name="TxtSoPhieu" Width="85" Height="23" VerticalContentAlignment="Center" Margin="0,0,8,0" FontWeight="Bold" Foreground="#003399" Background="White"/>
                                <TextBlock Text="Số khách" VerticalAlignment="Center" Margin="0,0,4,0" FontWeight="SemiBold"/>
                                <TextBox x:Name="TxtSoKhach" Width="30" Height="23" Text="1" TextAlignment="Right" VerticalContentAlignment="Center" Background="White"/>
                            </StackPanel>
                        </Grid>

                        <!-- Hàng 3: Bàn & Khách hàng -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtTenBan" Grid.Column="0" Height="23" VerticalContentAlignment="Center" Text="Bàn 06" FontWeight="Bold" Background="White" Margin="0,0,6,0"/>
                            <DockPanel Grid.Column="1">
                                <TextBlock Text="Khách hàng (F12)" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="22"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtKhachHang" Grid.Column="0" Height="23" VerticalContentAlignment="Center" Background="White"
                                             TextChanged="TxtKhachHang_TextChanged" KeyDown="TxtKhachHang_KeyDown"/>
                                    <ToggleButton x:Name="BtnKhachHangToggle" Grid.Column="1" Height="23" Content="▼" FontSize="9"
                                                  Background="#eaf2f8" BorderBrush="#a4bce3" Click="BtnKhachHangToggle_Click"/>
                                    
                                    <Popup x:Name="PopupKhachHang" IsOpen="{Binding IsChecked, ElementName=BtnKhachHangToggle}" 
                                           StaysOpen="False" PlacementTarget="{Binding ElementName=TxtKhachHang}" Width="520" MaxHeight="300">
                                        <Border Background="White" BorderBrush="#a4bce3" BorderThickness="1" SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="180"/>
                                                    <RowDefinition Height="36"/>
                                                </Grid.RowDefinitions>
                                                
                                                <DataGrid x:Name="DgKhachHang" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True" 
                                                          HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All"
                                                          HorizontalGridLinesBrush="#e0e0e0" VerticalGridLinesBrush="#e0e0e0"
                                                          Background="White" AlternatingRowBackground="#f2f8fc"
                                                          MouseDoubleClick="DgKhachHang_MouseDoubleClick" KeyDown="DgKhachHang_KeyDown">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Tên khách hàng" Binding="{Binding Name}" Width="*" FontWeight="SemiBold"/>
                                                        <DataGridTextColumn Header="Mã khách" Binding="{Binding Makhach}" Width="75">
                                                            <DataGridTextColumn.ElementStyle>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                </Style>
                                                            </DataGridTextColumn.ElementStyle>
                                                        </DataGridTextColumn>
                                                        <DataGridTextColumn Header="Địa chỉ" Binding="{Binding Diachi}" Width="160"/>
                                                        <DataGridTextColumn Header="Điện thoại" Binding="{Binding Dienthoai}" Width="100"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                                
                                                <Border Grid.Row="1" Background="#eaf2f8" BorderBrush="#b6c1cd" BorderThickness="0,1,0,0" Padding="4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="➕ Thêm" Width="70" Height="26" Margin="0,0,6,0" Background="White" BorderBrush="#a4bce3" Cursor="Hand" Click="BtnThemKhachHang_Click"/>
                                                        <Button Content="✏️ Sửa" Width="60" Height="26" Margin="0,0,6,0" Background="White" BorderBrush="#a4bce3" Cursor="Hand" Click="BtnSuaKhachHang_Click"/>
                                                        <Button Content="🔄 Tải" Width="60" Height="26" Margin="0,0,6,0" Background="White" BorderBrush="#a4bce3" Cursor="Hand" Click="BtnKhachHangReload_Click"/>
                                                        <Button Content="📜 Danh mục" Width="85" Height="26" Background="White" BorderBrush="#a4bce3" Cursor="Hand" Click="BtnKhachHangDanhMuc_Click"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </DockPanel>
                        </Grid>

                        <!-- Hàng 4: Thanh công cụ thao tác món: Thêm (+), Trả đồ -->
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Button x:Name="BtnThemMon" Width="26" Height="24" Margin="0,0,3,0" Background="#f0f5fa" BorderBrush="#a4c2e0" ToolTip="Thêm món">
                                <TextBlock Text="➕" Foreground="#0050b3" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button x:Name="BtnTraDo" Height="24" Padding="6,1" Background="#eef5fa" BorderBrush="#a4c2e0" Cursor="Hand" Click="BtnTraDo_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📝" Foreground="#d4380d" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Trả đồ" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- Bảng món ăn chi tiết -->
                <DataGrid x:Name="DgChiTiet" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                          GridLinesVisibility="All" AlternatingRowBackground="#f0f5fb" Background="White"
                          HeadersVisibility="Column" RowHeight="22" FontSize="11">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="" Binding="{Binding Stt}" Width="28">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Tên hàng" Binding="{Binding TenMon}" Width="*"/>
                        <DataGridTextColumn Header="ĐVT" Binding="{Binding Dvt}" Width="40">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="SL" Binding="{Binding SoLuong, StringFormat={}{0:0.##}}" Width="38">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Đ.giá" Binding="{Binding DonGia, StringFormat={}{0:N0}}" Width="65">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="CK%" Binding="{Binding PhanTramGiamGia, StringFormat={}{0:N0}}" Width="35">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="T.tiền" Binding="{Binding ThanhTien, StringFormat={}{0:N0}}" Width="75">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="0,0,4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
                
                <!-- Bottom Summary Box (Hiển thị ngang) -->
                <TabControl Grid.Row="2" Height="130" Margin="0,4,0,0">
                    <!-- Tab TỔNG -->
                    <TabItem Header="TỔNG">
                        <Grid Background="#cbe8f6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Tiền hàng" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                            <TextBox x:Name="TxtTienHang" Grid.Row="0" Grid.Column="2" Text="0" Background="#d6ebf5" BorderThickness="1" IsReadOnly="True" TextAlignment="Right" VerticalContentAlignment="Center" Margin="4" FontWeight="Bold"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Giảm giá" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="4">
                                <TextBox x:Name="TxtGiamGiaPt" Width="38" Text="0" TextAlignment="Right" VerticalContentAlignment="Center"/>
                                <TextBlock Text="%" VerticalAlignment="Center" Margin="3,0,3,0"/>
                                <TextBox x:Name="TxtGiamGia" Width="75" Text="0" Background="#d6ebf5" BorderThickness="1" TextAlignment="Right" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Tổng cộng" FontWeight="Bold" FontSize="15" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtTongCong" Grid.Row="2" Grid.Column="2" Text="0" Background="#fffdc2" BorderThickness="1" FontWeight="Bold" FontSize="15" Foreground="Red" IsReadOnly="True" TextAlignment="Right" VerticalContentAlignment="Center" Margin="4"/>
                        </Grid>
                    </TabItem>
                    
                    <!-- Tab GHI CHÚ -->
                    <TabItem Header="GHI CHÚ">
                        <TextBox x:Name="TxtGhiChu" AcceptsReturn="True" TextWrapping="Wrap" Margin="4"/>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <!-- ======================= CỘT PHẢI: CHỨC NĂNG & THỰC ĐƠN ======================= -->
        <Grid Grid.Column="2" Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="65"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Action Buttons -->
            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                <Button Content="Số lượng" Height="40" Margin="0,0,0,4" FontSize="11" Background="White" BorderBrush="#b6c1cd"/>
                <Button Content="&lt;&lt; Thêm" Height="30" Margin="0,0,0,8" FontSize="11" Background="#e2f0d9" BorderBrush="#a9d18e"/>
                
                <Border Height="280"/>

                <Button x:Name="BtnThanhToan" Height="50" Margin="0,0,0,4" Background="#ffe58f" BorderBrush="#d48806" Cursor="Hand" Click="BtnThanhToan_Click">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="💳" FontSize="14" HorizontalAlignment="Center"/>
                        <TextBlock Text="Thanh toán" FontSize="10" FontWeight="Bold" Foreground="#b32400" HorizontalAlignment="Center"/>
                        <TextBlock Text="(F11)" FontSize="9" Foreground="#b32400" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            
            <!-- Menu & Items -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="180"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Search Box -->
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Tìm (F3):" VerticalAlignment="Center" Margin="0,0,4,0" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtTimKiem" Grid.Column="1" Height="24" VerticalContentAlignment="Center" TextChanged="TxtTimKiem_TextChanged"/>
                </Grid>
                
                <!-- Category Tree -->
                <TreeView x:Name="TvMenu" Grid.Row="1" Margin="0,0,0,4" SelectedItemChanged="TvMenu_SelectedItemChanged" BorderBrush="#b6c1cd" BorderThickness="1" Background="White">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="📁" Margin="0,0,5,0" Foreground="Orange"/>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11.5"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                
                <!-- Items Grid -->
                <DataGrid x:Name="DgMatHang" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                          IsReadOnly="True" GridLinesVisibility="All" AlternatingRowBackground="#f0f5fb"
                          Background="White" RowHeight="22" FontSize="11" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tên hàng" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="ĐVT" Binding="{Binding DonViTinh}" Width="35">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Giá bán" Binding="{Binding GiaBan, StringFormat={}{0:N0}}" Width="65">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="35"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
