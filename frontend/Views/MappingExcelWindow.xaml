<Window x:Class="QuanLyBar.Client.Views.MappingExcelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm từ excel" Height="450" Width="400"
        WindowStartupLocation="CenterScreen" Background="#eef2f9">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Margin="0,0,0,10" TextWrapping="Wrap">
            <Run Text="Hướng dẫn: Cột bên trái là cột sẵn có trong file excel của bạn."/><LineBreak/>
            <Run Text="Bạn lựa chọn cột bên phải để hệ thống hiểu được cột trong file excel là dữ liệu nào"/>
        </TextBlock>

        <!-- DataGrid for Mapping -->
        <DataGrid x:Name="DgMapping" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" Background="White" RowHeaderWidth="0" GridLinesVisibility="All">
            <DataGrid.Columns>
                <!-- Left Column (Read Only) -->
                <DataGridTextColumn Header="Cột excel" Binding="{Binding ExcelColumn}" Width="150" IsReadOnly="True"/>
                
                <!-- Right Column (ComboBox) -->
                <DataGridTemplateColumn Header="Dữ liệu" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding AvailableFields}" SelectedItem="{Binding MappedField, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding AvailableFields}" SelectedItem="{Binding MappedField, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer Buttons -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Tự động chọn" Padding="10,5" Background="White" Click="BtnTuDongChon_Click"/>
            
            <Button Grid.Column="2" Content="Chấp nhận" Padding="15,5" Margin="0,0,10,0" Background="White" Click="BtnChapNhan_Click"/>
            <Button Grid.Column="3" Content="Hủy bỏ" Padding="15,5" Background="White" Click="BtnHuyBo_Click"/>
        </Grid>
    </Grid>
</Window>
