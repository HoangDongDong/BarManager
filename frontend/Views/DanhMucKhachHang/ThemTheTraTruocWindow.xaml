<Window x:Class="QuanLyBar.Client.Views.ThemTheTraTruocWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="THẺ TRẢ TRƯỚC - THÊM MỚI" Height="650" Width="550"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#dbe6f3" WindowStyle="SingleBorderWindow"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Style nút Ribbon trên thanh công cụ -->
        <Style x:Key="RibbonToolBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#1e3f66"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#c9dcf0"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#86aed6"/>
                                <Setter TargetName="bdr" Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#b3cce8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style nút chức năng phụ Nạp tiền / Chi trả tiền -->
        <Style x:Key="ActionSideBtn" TargetType="Button">
            <Setter Property="Background" Value="#f4f8fc"/>
            <Setter Property="BorderBrush" Value="#9bb9dc"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Width" Value="90"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#e0edfc"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#6f98c8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#bad5f5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style nút dưới Footer -->
        <Style x:Key="FooterBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#9bb9dc"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#dce9f8"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#6f98c8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#bad5f5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab Item Warm Yellow Style -->
        <Style x:Key="WarmTabItem" TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" BorderThickness="1,1,1,0" BorderBrush="#b6cadf" Background="#e2ecf8" 
                                CornerRadius="3,3,0,0" Margin="0,0,2,-1" Padding="12,5">
                            <ContentPresenter x:Name="contentPresenter" ContentSource="Header" Focusable="False"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#fff9e6"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#e6a800"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1,1,1,0"/>
                                <Setter Property="Panel.ZIndex" Value="100"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#8c5000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Banner tiêu đề -->
            <RowDefinition Height="Auto"/> <!-- Ribbon toolbar -->
            <RowDefinition Height="Auto"/> <!-- Form thông tin trên -->
            <RowDefinition Height="*"/>    <!-- TabControl lịch sử -->
            <RowDefinition Height="Auto"/> <!-- Tổng nạp / Tổng sử dụng / Còn lại -->
            <RowDefinition Height="Auto"/> <!-- Nút Footer -->
        </Grid.RowDefinitions>

        <!-- 1. BANNER TIÊU ĐỀ (Kem nhạt #fffbe6) -->
        <Border Grid.Row="0" Background="#fffbe6" BorderBrush="#eadba4" BorderThickness="0,0,0,1" Padding="10,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="34" Height="22" Background="#3db8f5" CornerRadius="3" Margin="0,0,10,0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="💳" FontSize="12" Foreground="White"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="Thẻ trả trước" FontSize="13.5" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 2. RIBBON TOOLBAR -->
        <Border Grid.Row="1" Background="#dbe6f3" BorderBrush="#b6cadf" BorderThickness="0,0,0,1" Padding="4,2">
            <DockPanel LastChildFill="False">
                <Button x:Name="BtnPhimTat" Style="{StaticResource RibbonToolBtn}" Click="BtnPhimTat_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="↗" FontWeight="Bold" Margin="0,0,3,0"/>
                        <TextBlock Text="Phím tắt ▾"/>
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Lưu (Ctrl+L)" Click="MiLuu_Click"/>
                            <MenuItem Header="Lưu &amp; Mới (Ctrl+S)" Click="MiLuuVaMoi_Click"/>
                            <MenuItem Header="Lưu &amp; Thoát (Ctrl+Enter)" Click="MiLuuVaThoat_Click"/>
                            <MenuItem Header="Tạo mới (Ctrl+N)" Click="MiTaoMoi_Click"/>
                            <Separator/>
                            <MenuItem Header="Trước (F10)" Click="BtnTruoc_Click"/>
                            <MenuItem Header="Sau (F11)" Click="BtnSau_Click"/>
                            <Separator/>
                            <MenuItem Header="Thoát (Esc)" Click="MiThoat_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <Button x:Name="BtnTruoc" Style="{StaticResource RibbonToolBtn}" Click="BtnTruoc_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⬅" Margin="0,0,3,0"/>
                        <TextBlock Text="Trước (F10)"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnSau" Style="{StaticResource RibbonToolBtn}" Click="BtnSau_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➡" Margin="0,0,3,0"/>
                        <TextBlock Text="Sau (F11)"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnTaoMoi" Style="{StaticResource RibbonToolBtn}" Click="BtnTaoMoi_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➕" Foreground="Green" Margin="0,0,3,0"/>
                        <TextBlock Text="Tạo mới"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnSaoChep" Style="{StaticResource RibbonToolBtn}" Click="BtnSaoChep_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📄" Margin="0,0,3,0"/>
                        <TextBlock Text="Sao chép"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnXoa" DockPanel.Dock="Right" Style="{StaticResource RibbonToolBtn}" Click="BtnXoa_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="❌" Foreground="Crimson" Margin="0,0,3,0"/>
                        <TextBlock Text="Xóa"/>
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <!-- 3. FORM THÔNG TIN THẺ -->
        <Border Grid.Row="2" Background="#dbe6f3" Padding="14,10,14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="115"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Mã thẻ -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Mã thẻ" VerticalAlignment="Center" FontSize="12.5"/>
                <TextBox x:Name="TxtMaThe" Grid.Row="0" Grid.Column="1" Height="24" Background="#eaf4fd"
                         BorderBrush="#9ab5cf" BorderThickness="1" VerticalContentAlignment="Center" Padding="4,0" FontWeight="Bold"/>
                <Button Grid.Row="0" Grid.Column="3" Content="Nạp tiền" Style="{StaticResource ActionSideBtn}" Click="BtnNapTien_Click"/>

                <!-- Row 1: Khóa thẻ & Ngày hết hạn -->
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkKhoa" Content="Khóa thẻ" VerticalAlignment="Center" Margin="0,0,20,0" FontSize="12"/>
                    <TextBlock Text="Ngày hết hạn" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12.5"/>
                    <DatePicker x:Name="DpNgayHetHan" Width="110" Height="24" VerticalContentAlignment="Center" BorderBrush="#9ab5cf"/>
                </StackPanel>
                <Button Grid.Row="1" Grid.Column="3" Content="Chi trả tiền" Style="{StaticResource ActionSideBtn}" Click="BtnChiTraTien_Click"/>

                <!-- Row 2: Nhóm thẻ trả trước -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Nhóm thẻ trả trước" VerticalAlignment="Center" FontSize="12.5"/>
                <ComboBox x:Name="CboNhomThe" Grid.Row="2" Grid.Column="1" Height="24" BorderBrush="#9ab5cf" VerticalContentAlignment="Center"/>

                <!-- Row 3: Ghi chú -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Ghi chú" VerticalAlignment="Center" FontSize="12.5"/>
                <TextBox x:Name="TxtGhiChu" Grid.Row="3" Grid.Column="1" Height="24" BorderBrush="#9ab5cf" BorderThickness="1" 
                         VerticalContentAlignment="Center" Padding="4,0" Background="White"/>
            </Grid>
        </Border>

        <!-- 4. TABCONTROL LỊCH SỬ -->
        <Border Grid.Row="3" Margin="10,4,10,0">
            <TabControl Background="White" BorderBrush="#b6cadf">
                <!-- Tab 1: Lịch sử nạp tiền -->
                <TabItem Header="Lịch sử nạp tiền" Style="{StaticResource WarmTabItem}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Toolbar của tab -->
                        <Border Grid.Row="0" Background="#eef4fa" BorderBrush="#b6cadf" BorderThickness="0,0,0,1" Padding="4,2">
                            <DockPanel LastChildFill="False">
                                <Button x:Name="BtnXuatExcelNap" Style="{StaticResource RibbonToolBtn}" Click="BtnXuatExcelNap_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📊" Margin="0,0,4,0"/>
                                        <TextBlock Text="Xuất excel"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Lọc" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12"/>
                                    <TextBox x:Name="TxtLocNap" Width="120" Height="22" BorderBrush="#9ab5cf" Padding="3,0" VerticalContentAlignment="Center"
                                             TextChanged="TxtLocNap_TextChanged"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Lưới Lịch sử nạp tiền -->
                        <DataGrid Grid.Row="1" x:Name="DgLichSuNapTien" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  IsReadOnly="True" HeadersVisibility="All" GridLinesVisibility="All"
                                  HorizontalGridLinesBrush="#cbd5e1" VerticalGridLinesBrush="#cbd5e1"
                                  RowHeight="24" Background="White" RowBackground="White" AlternatingRowBackground="#f8fbff">
                            <!-- STT ở RowHeader -->
                            <DataGrid.RowHeaderStyle>
                                <Style TargetType="{x:Type DataGridRowHeader}">
                                    <Setter Property="Width" Value="32"/>
                                    <Setter Property="Background" Value="#dfe9f5"/>
                                    <Setter Property="BorderBrush" Value="#b6cadf"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="Content" Value="{Binding Stt}"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </Style>
                            </DataGrid.RowHeaderStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Số phiếu" Binding="{Binding SoPhieu}" Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="4,0"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Ngày" Binding="{Binding Ngay, StringFormat='{}{0:dd/MM/yyyy}'}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Số tiền nạp" Binding="{Binding SoTienThu, StringFormat='{}{0:#,##0}'}" Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="TextAlignment" Value="Right"/>
                                            <Setter Property="Margin" Value="4,0"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Chi trả" Binding="{Binding SoTienChi, StringFormat='{}{0:#,##0}'}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="TextAlignment" Value="Right"/>
                                            <Setter Property="Margin" Value="4,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Cột trống giãn -->
                                <DataGridTextColumn Header="" Width="*" Binding="{Binding BlankFiller}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- Tab 2: Lịch sử sử dụng -->
                <TabItem Header="Lịch sử sử dụng" Style="{StaticResource WarmTabItem}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Toolbar của tab -->
                        <Border Grid.Row="0" Background="#eef4fa" BorderBrush="#b6cadf" BorderThickness="0,0,0,1" Padding="4,2">
                            <DockPanel LastChildFill="False">
                                <Button x:Name="BtnXuatExcelDung" Style="{StaticResource RibbonToolBtn}" Click="BtnXuatExcelDung_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📊" Margin="0,0,4,0"/>
                                        <TextBlock Text="Xuất excel"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Lọc" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12"/>
                                    <TextBox x:Name="TxtLocDung" Width="120" Height="22" BorderBrush="#9ab5cf" Padding="3,0" VerticalContentAlignment="Center"
                                             TextChanged="TxtLocDung_TextChanged"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Lưới Lịch sử sử dụng -->
                        <DataGrid Grid.Row="1" x:Name="DgLichSuSuDung" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  IsReadOnly="True" HeadersVisibility="All" GridLinesVisibility="All"
                                  HorizontalGridLinesBrush="#cbd5e1" VerticalGridLinesBrush="#cbd5e1"
                                  RowHeight="24" Background="White" RowBackground="White" AlternatingRowBackground="#f8fbff">
                            <!-- STT ở RowHeader -->
                            <DataGrid.RowHeaderStyle>
                                <Style TargetType="{x:Type DataGridRowHeader}">
                                    <Setter Property="Width" Value="32"/>
                                    <Setter Property="Background" Value="#dfe9f5"/>
                                    <Setter Property="BorderBrush" Value="#b6cadf"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="Content" Value="{Binding Stt}"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </Style>
                            </DataGrid.RowHeaderStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Số hóa đơn" Binding="{Binding SoHoaDon}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="4,0"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Ngày" Binding="{Binding Ngay, StringFormat='{}{0:dd/MM/yyyy}'}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Bàn" Binding="{Binding Ban}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="4,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Số tiền sử dụng" Binding="{Binding TongCong, StringFormat='{}{0:#,##0}'}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="TextAlignment" Value="Right"/>
                                            <Setter Property="Margin" Value="4,0"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Cột trống giãn -->
                                <DataGridTextColumn Header="" Width="*" Binding="{Binding BlankFiller}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <!-- 5. TỔNG NẠP / TỔNG SỬ DỤNG / CÒN LẠI -->
        <Border Grid.Row="4" Padding="14,6,14,6">
            <Grid HorizontalAlignment="Right">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="24"/>
                </Grid.RowDefinitions>

                <!-- Tổng nạp -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Tổng nạp:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0" FontSize="12"/>
                <TextBox x:Name="TxtTongNap" Grid.Row="0" Grid.Column="1" Text="0" IsReadOnly="True" TextAlignment="Right"
                         FontWeight="Bold" BorderBrush="#9ab5cf" Height="22" VerticalContentAlignment="Center" Padding="4,0" Background="White"/>

                <!-- Tổng sử dụng -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Tổng sử dụng:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0" FontSize="12"/>
                <TextBox x:Name="TxtTongSuDung" Grid.Row="1" Grid.Column="1" Text="0" IsReadOnly="True" TextAlignment="Right"
                         FontWeight="Bold" BorderBrush="#9ab5cf" Height="22" VerticalContentAlignment="Center" Padding="4,0" Background="White"/>

                <!-- Còn lại -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Còn lại:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0" FontSize="12"/>
                <TextBox x:Name="TxtConLai" Grid.Row="2" Grid.Column="1" Text="0" IsReadOnly="True" TextAlignment="Right"
                         FontWeight="Bold" BorderBrush="#9ab5cf" Height="22" VerticalContentAlignment="Center" Padding="4,0" Background="White"/>
            </Grid>
        </Border>

        <!-- 6. NÚT FOOTER -->
        <Border Grid.Row="5" Background="#dbe6f3" BorderBrush="#b6cadf" BorderThickness="0,1,0,0" Padding="10,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="BtnLuu" Content="💾 Lưu" Style="{StaticResource FooterBtnStyle}" Click="BtnLuu_Click"/>
                <Button x:Name="BtnLuuVaMoi" Content="Lưu &amp; Mới" Style="{StaticResource FooterBtnStyle}" Click="BtnLuuVaMoi_Click"/>
                <Button x:Name="BtnLuuVaThoat" Content="Lưu &amp; thoát" Style="{StaticResource FooterBtnStyle}" Click="BtnLuuVaThoat_Click"/>
                <Button x:Name="BtnThoat" Content="Thoát" Style="{StaticResource FooterBtnStyle}" Click="BtnThoat_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
