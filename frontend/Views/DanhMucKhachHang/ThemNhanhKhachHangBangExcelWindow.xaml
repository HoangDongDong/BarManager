<Window x:Class="QuanLyBar.Client.Views.ThemNhanhKhachHangBangExcelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm nhanh" 
        Height="650" Width="1000" 
        WindowStartupLocation="CenterOwner" 
        Background="#dce7f5"
        FontFamily="Segoe UI" FontSize="12">
    
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Toolbar -->
            <RowDefinition Height="*"/>    <!-- Content -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <Border Grid.Row="0" Background="#e4edf7" BorderBrush="#b6cadf" BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📁" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="Mời bạn điền danh sách Khách hàng vào lưới phía dưới." FontWeight="SemiBold" Foreground="#112233" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 2. Toolbar -->
        <Border Grid.Row="1" Background="#eaf1fa" BorderBrush="#b6cadf" BorderThickness="1" CornerRadius="3" Padding="6,4" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Số dòng" VerticalAlignment="Center" Margin="5,0,5,0"/>
                <TextBox x:Name="TxtSoDong" Width="40" Height="24" Text="1" TextAlignment="Center" VerticalContentAlignment="Center"/>
                
                <Button x:Name="BtnThemDuLieu" Margin="6,0" Padding="8,2" Background="#ffffff" BorderBrush="#b6cadf" Cursor="Hand" Click="BtnThemDuLieu_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➕" Foreground="Green" FontSize="11" Margin="0,0,4,0"/>
                        <TextBlock Text="Thêm dữ liệu" FontSize="11.5"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnXoaDuLieu" Margin="2,0" Padding="8,2" Background="#ffffff" BorderBrush="#b6cadf" Cursor="Hand" Click="BtnXoaDuLieu_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="❌" Foreground="Red" FontSize="11" Margin="0,0,4,0"/>
                        <TextBlock Text="Xóa dữ liệu" FontSize="11.5"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnDanDuLieu" Margin="6,0" Padding="8,2" Background="#ffffff" BorderBrush="#b6cadf" Cursor="Hand" Click="BtnDanDuLieu_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📋" FontSize="11" Margin="0,0,4,0"/>
                        <TextBlock Text="Dán dữ liệu" FontSize="11.5"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnChonFileExcel" Margin="2,0" Padding="8,2" Background="#ffffff" BorderBrush="#0078d7" BorderThickness="1.5" FontWeight="SemiBold" Cursor="Hand" Click="BtnChonFileExcel_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📊" FontSize="11" Margin="0,0,4,0"/>
                        <TextBlock Text="Chọn file Excel" FontSize="11.5"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- 3. Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <!-- DataGrid bên trái -->
            <Border Grid.Column="0" Background="White" BorderBrush="#b6cadf" BorderThickness="1" CornerRadius="2">
                <DataGrid x:Name="DgDuLieu" AutoGenerateColumns="False" CanUserAddRows="False"
                          GridLinesVisibility="All" HorizontalGridLinesBrush="#e0e0e0" VerticalGridLinesBrush="#e0e0e0"
                          HeadersVisibility="Column" SelectionMode="Extended" RowHeight="25" FontSize="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="ColMaKhach" Header="Mã khách" Binding="{Binding Makhach, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                        <DataGridTextColumn x:Name="ColTenKhach" Header="Tên khách hàng" Binding="{Binding Tenkhach, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                        <DataGridTextColumn x:Name="ColDiaChi" Header="Địa chỉ" Binding="{Binding Diachi, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                        <DataGridTextColumn x:Name="ColDienThoai" Header="Điện thoại" Binding="{Binding Dienthoai, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                        <DataGridTextColumn x:Name="ColEmail" Header="Email" Binding="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        <DataGridTextColumn x:Name="ColNhomKhach" Header="Nhóm khách hàng" Binding="{Binding Nhomkhach, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        <DataGridTextColumn x:Name="ColMasothue" Header="Mã số thuế" Binding="{Binding Masothue, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                        <DataGridTextColumn x:Name="ColNhanVien" Header="Nhân viên" Binding="{Binding Nhanvien, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                        <DataGridTextColumn x:Name="ColTinhThanh" Header="Tỉnh thành" Binding="{Binding Tinhthanh, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                        <DataGridTextColumn x:Name="ColFacebook" Header="Facebook" Binding="{Binding Facebook, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                        <DataGridTextColumn x:Name="ColTheTraTruoc" Header="Thẻ trả trước" Binding="{Binding Thetratruoc, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                        <DataGridTextColumn x:Name="ColGhiChu" Header="Ghi chú" Binding="{Binding Ghichu, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                        <DataGridTextColumn x:Name="ColDiemTichLuy" Header="Điểm tích lũy" Binding="{Binding Diemtichluy, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                        <DataGridTextColumn x:Name="ColNgaySinh" Header="Ngày sinh" Binding="{Binding Ngaysinh, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Panel Các thuộc tính chung bên phải -->
            <Border Grid.Column="2" Background="#f4f7fb" BorderBrush="#b6cadf" BorderThickness="1" CornerRadius="3" Padding="10,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Các thuộc tính chung" Foreground="#cc0000" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>

                        <!-- Mã khách -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkMaKhach" Content="Mã khách:" VerticalAlignment="Center"
                                      Checked="ChkThuocTinh_Changed" Unchecked="ChkThuocTinh_Changed"/>
                            <TextBox x:Name="TxtChungMaKhach" Grid.Column="1" Height="22" VerticalContentAlignment="Center"
                                     IsEnabled="{Binding IsChecked, ElementName=ChkMaKhach}"/>
                        </Grid>

                        <!-- Tên khách hàng -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkTenKhach" Content="Tên khách hàng:" VerticalAlignment="Center"
                                      Checked="ChkThuocTinh_Changed" Unchecked="ChkThuocTinh_Changed"/>
                            <TextBox x:Name="TxtChungTenKhach" Grid.Column="1" Height="22" VerticalContentAlignment="Center"
                                     IsEnabled="{Binding IsChecked, ElementName=ChkTenKhach}"/>
                        </Grid>

                        <!-- Địa chỉ -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkDiaChi" Content="Địa chỉ:" VerticalAlignment="Center"
                                      Checked="ChkThuocTinh_Changed" Unchecked="ChkThuocTinh_Changed"/>
                            <TextBox x:Name="TxtChungDiaChi" Grid.Column="1" Height="22" VerticalContentAlignment="Center"
                                     IsEnabled="{Binding IsChecked, ElementName=ChkDiaChi}"/>
                        </Grid>

                        <!-- Điện thoại -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkDienThoai" Content="Điện thoại:" VerticalAlignment="Center"
                                      Checked="ChkThuocTinh_Changed" Unchecked="ChkThuocTinh_Changed"/>
                            <TextBox x:Name="TxtChungDienThoai" Grid.Column="1" Height="22" VerticalContentAlignment="Center"
                                     IsEnabled="{Binding IsChecked, ElementName=ChkDienThoai}"/>
                        </Grid>

                        <!-- Email -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkEmail" Content="Email:" IsChecked="True" VerticalAlignment="Center"
                                      Checked="ChkThuocTinh_Changed" Unchecked="ChkThuocTinh_Changed"/>
                            <TextBox x:Name="TxtChungEmail" Grid.Column="1" Height="22" VerticalContentAlignment="Center"
                                     IsEnabled="{Binding IsChecked, ElementName=ChkEmail}"/>
                        </Grid>

                        <!-- Nhóm khách hàng -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkNhomKhach" Content="Nhóm khách hàng:" IsChecked="True" VerticalAlignment="Center"
                                      Checked="ChkThuocTinh_Changed" Unchecked="ChkThuocTinh_Changed"/>
                            <ComboBox x:Name="CboChungNhomKhach" Grid.Column="1" Height="22" VerticalContentAlignment="Center" DisplayMemberPath="NAME" SelectedValuePath="ID"
                                      IsEnabled="{Binding IsChecked, ElementName=ChkNhomKhach}"/>
                        </Grid>

                        <!-- Mã số thuế -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkMaSoThue" Content="Mã số thuế:" IsChecked="True" VerticalAlignment="Center"
                                      Checked="ChkThuocTinh_Changed" Unchecked="ChkThuocTinh_Changed"/>
                            <TextBox x:Name="TxtChungMaSoThue" Grid.Column="1" Height="22" VerticalContentAlignment="Center"
                                     IsEnabled="{Binding IsChecked, ElementName=ChkMaSoThue}"/>
                        </Grid>

                        <!-- Nhân viên -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkNhanVien" Content="Nhân viên:" IsChecked="True" VerticalAlignment="Center"
                                      Checked="ChkThuocTinh_Changed" Unchecked="ChkThuocTinh_Changed"/>
                            <ComboBox x:Name="CboChungNhanVien" Grid.Column="1" Height="22" VerticalContentAlignment="Center" DisplayMemberPath="NAME" SelectedValuePath="ID"
                                      IsEnabled="{Binding IsChecked, ElementName=ChkNhanVien}"/>
                        </Grid>

                        <!-- Tỉnh thành -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkTinhThanh" Content="Tỉnh thành:" IsChecked="True" VerticalAlignment="Center"
                                      Checked="ChkThuocTinh_Changed" Unchecked="ChkThuocTinh_Changed"/>
                            <ComboBox x:Name="CboChungTinhThanh" Grid.Column="1" Height="22" VerticalContentAlignment="Center" DisplayMemberPath="NAME" SelectedValuePath="ID"
                                      IsEnabled="{Binding IsChecked, ElementName=ChkTinhThanh}"/>
                        </Grid>

                        <!-- Facebook -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkFacebook" Content="Facebook:" IsChecked="True" VerticalAlignment="Center"
                                      Checked="ChkThuocTinh_Changed" Unchecked="ChkThuocTinh_Changed"/>
                            <TextBox x:Name="TxtChungFacebook" Grid.Column="1" Height="22" VerticalContentAlignment="Center"
                                     IsEnabled="{Binding IsChecked, ElementName=ChkFacebook}"/>
                        </Grid>

                        <!-- Thẻ trả trước -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkTheTraTruoc" Content="Thẻ trả trước:" IsChecked="True" VerticalAlignment="Center"
                                      Checked="ChkThuocTinh_Changed" Unchecked="ChkThuocTinh_Changed"/>
                            <ComboBox x:Name="CboChungTheTraTruoc" Grid.Column="1" Height="22" VerticalContentAlignment="Center"
                                      IsEnabled="{Binding IsChecked, ElementName=ChkTheTraTruoc}">
                                <ComboBoxItem Content="-- Không chọn --" IsSelected="True"/>
                            </ComboBox>
                        </Grid>

                        <!-- Ghi chú -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkGhiChu" Content="Ghi chú:" IsChecked="True" VerticalAlignment="Center"
                                      Checked="ChkThuocTinh_Changed" Unchecked="ChkThuocTinh_Changed"/>
                            <TextBox x:Name="TxtChungGhiChu" Grid.Column="1" Height="22" VerticalContentAlignment="Center"
                                     IsEnabled="{Binding IsChecked, ElementName=ChkGhiChu}"/>
                        </Grid>

                        <!-- Điểm tích lũy ban đầu -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkDiemTichLuy" Content="Điểm tích lũy ban đầu:" IsChecked="True" VerticalAlignment="Center"
                                      Checked="ChkThuocTinh_Changed" Unchecked="ChkThuocTinh_Changed"/>
                            <TextBox x:Name="TxtChungDiemTichLuy" Grid.Column="1" Height="22" Text="0" TextAlignment="Right" VerticalContentAlignment="Center"
                                     IsEnabled="{Binding IsChecked, ElementName=ChkDiemTichLuy}"/>
                        </Grid>

                        <!-- Ngày thành lập/sinh nhật -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkNgaySinh" Content="Ngày thành lập/sinh nhật:" IsChecked="True" VerticalAlignment="Center"
                                      Checked="ChkThuocTinh_Changed" Unchecked="ChkThuocTinh_Changed"/>
                            <DatePicker x:Name="DpChungNgaySinh" Grid.Column="1" Height="24" VerticalContentAlignment="Center"
                                        IsEnabled="{Binding IsChecked, ElementName=ChkNgaySinh}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 4. Footer -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Button x:Name="BtnXoaDongLoi" Content="Xóa mặt hàng lỗi" HorizontalAlignment="Left" Width="130" Height="26" 
                    Background="#ffffff" BorderBrush="#b6cadf" Cursor="Hand" Click="BtnXoaDongLoi_Click"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnChapNhan" Content="Chấp nhận" Width="90" Height="26" Margin="4,0" 
                        Background="#ffffff" BorderBrush="#0078d7" BorderThickness="1.5" FontWeight="SemiBold" Cursor="Hand" Click="BtnChapNhan_Click"/>
                <Button x:Name="BtnHuyBo" Content="Hủy bỏ" Width="80" Height="26" Margin="4,0" 
                        Background="#ffffff" BorderBrush="#b6cadf" Cursor="Hand" IsCancel="True" Click="BtnHuyBo_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
