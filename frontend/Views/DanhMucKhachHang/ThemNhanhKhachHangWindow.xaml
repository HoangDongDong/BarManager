<Window x:Class="QuanLyBar.Client.Views.ThemNhanhKhachHangWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm nhanh" Height="380" Width="360"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid Background="#cadbf2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="10,8,10,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <DockPanel LastChildFill="True">
                <Border Width="22" Height="22" Background="#28a7e9" CornerRadius="4" VerticalAlignment="Top" Margin="0,2,8,0">
                    <TextBlock Text="➕" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TxtHeaderInstruction" 
                           Text="Mời bạn điền danh sách Nhân viên vào ô phía dưới, mỗi dòng một Nhân viên" 
                           TextWrapping="Wrap" 
                           FontSize="12" 
                           Foreground="#1e3f66"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                <TextBlock Text="Ảnh: " VerticalAlignment="Center" FontSize="12" Foreground="#333333" Margin="0,0,4,0"/>
                <ComboBox x:Name="CmbImage" Width="50" Height="24" Background="White" BorderBrush="#a3bde0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Image Source="{Binding ImageSource}" Width="16" Height="16"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Text Box Content -->
        <Border Grid.Row="1" Margin="8,0,8,6" Background="White" BorderBrush="#1e73be" BorderThickness="1,1,1,2">
            <TextBox x:Name="TxtDanhSach" 
                     AcceptsReturn="True" 
                     TextWrapping="Wrap" 
                     VerticalScrollBarVisibility="Auto" 
                     HorizontalScrollBarVisibility="Auto" 
                     BorderThickness="0" 
                     Padding="6" 
                     FontSize="12.5"
                     FontFamily="Segoe UI"/>
        </Border>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Background="#cadbf2" Padding="8,0,8,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Chấp nhận" Width="75" Height="24" Margin="0,0,8,0" 
                        Background="White" BorderBrush="#a3bde0" BorderThickness="1" Cursor="Hand" Click="BtnChapNhan_Click"/>
                <Button Content="Hủy bỏ" Width="75" Height="24" 
                        Background="White" BorderBrush="#a3bde0" BorderThickness="1" Cursor="Hand" Click="BtnHuyBo_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
