<UserControl x:Class="QuanLyBar.Client.Views.DanhMucTheTraTruocControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:QuanLyBar.Client.Models"
             Background="#eaf1f8"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <!-- Header Tab Style phong cách phần mềm -->
        <Style x:Key="HeaderTabStyle" TargetType="Border">
            <Setter Property="Background" Value="#dfe9f5"/>
            <Setter Property="BorderBrush" Value="#b6cadf"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="CornerRadius" Value="4,4,0,0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Height" Value="26"/>
        </Style>

        <!-- Nút toolbar trên đỉnh lưới -->
        <Style x:Key="RibbonToolBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#b8cfe5"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#1e3f66"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#dbeafc"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#7da2ce"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#c3dbf7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mini button trên nhóm -->
        <Style x:Key="MiniBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#d0e2f5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="160"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- CỘT TRÁI: NHÓM THẺ TRẢ TRƯỚC -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tab Header Nhóm -->
            <Border Grid.Row="0" Style="{StaticResource HeaderTabStyle}" Margin="5,5,0,0">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Style="{StaticResource MiniBtn}" ToolTip="Thiết lập nhóm">
                        <TextBlock Text="⚙" FontSize="13" Foreground="#476282"/>
                    </Button>
                    <TextBlock Text="Nhóm thẻ trả trước" FontWeight="Bold" FontSize="12.5" Foreground="#1e3f66" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Toolbar mini thao tác nhóm giống Khách hàng thân thiết -->
            <Border Grid.Row="1" Background="#eaf1fa" BorderBrush="#b6cadf" BorderThickness="1,1,1,0" Margin="5,0,0,0" Padding="2,2">
                <DockPanel LastChildFill="False">
                    <Button x:Name="BtnThemNhom" ToolTip="Thêm mới nhóm thẻ trả trước" Margin="1,0" Padding="3,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnThemNhom_Click">
                        <TextBlock Text="➕" Foreground="Green" FontSize="13"/>
                    </Button>
                    <Button x:Name="BtnSuaNhom" ToolTip="Sửa nhóm thẻ trả trước" Margin="1,0" Padding="3,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnSuaNhom_Click">
                        <TextBlock Text="✏️" FontSize="13"/>
                    </Button>
                    <Button x:Name="BtnThemThuMuc" ToolTip="Tạo mới thư mục" Margin="1,0" Padding="3,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnThemThuMuc_Click">
                        <TextBlock Text="📁" Foreground="#d4a017" FontSize="13"/>
                    </Button>
                    <Button x:Name="BtnXemTheoThuMuc" ToolTip="Hiển thị tất cả dữ liệu theo thư mục" Margin="1,0" Padding="3,2" 
                            Background="#fff9e6" BorderBrush="#e6a800" BorderThickness="1" Cursor="Hand" Click="BtnXemTheoThuMuc_Click">
                        <TextBlock Text="🗂️" FontSize="13"/>
                    </Button>
                    <Button x:Name="BtnTaiLaiNhom" ToolTip="Tải lại" Margin="1,0" Padding="3,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnTaiLaiNhom_Click">
                        <TextBlock Text="🔄" Foreground="#2b78e4" FontSize="13"/>
                    </Button>

                    <!-- Nút Dropdown chọn chế độ hiển thị bên phải -->
                    <Button x:Name="BtnMenuCheDo" DockPanel.Dock="Right" ToolTip="Tìm theo / Phân loại theo" Margin="2,0" Padding="4,2" 
                            Background="#e2ecf8" BorderBrush="#a4bce3" Cursor="Hand" Click="BtnMenuCheDo_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗂️" FontSize="12" Margin="0,0,2,0"/>
                            <TextBlock Text="▾" FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="CmCheDoPhanNhom">
                                <MenuItem Header="📁  Nhóm thẻ trả trước" Click="MenuItem_CheDoNhom_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </DockPanel>
            </Border>

            <!-- TreeView nhóm thẻ trả trước -->
            <Border Grid.Row="2" Background="White" BorderBrush="#b6cadf" BorderThickness="1" Margin="5,0,0,5">
                <TreeView x:Name="TvNhomTheTraTruoc" BorderThickness="0" 
                          SelectedItemChanged="TvNhomTheTraTruoc_SelectedItemChanged"
                          PreviewMouseRightButtonDown="TvNhomTheTraTruoc_PreviewMouseRightButtonDown">

                    <TreeView.ContextMenu>
                        <ContextMenu x:Name="CmTreeView">
                            <!-- 1. Thêm mới -->
                            <MenuItem Header="Thêm mới">
                                <MenuItem Header="➕  Thêm nhóm thẻ trả trước" Click="MiThemMoiItem_Click"/>
                                <MenuItem Header="Thêm nhanh" Click="MiThemNhanhGoc_Click"/>
                                <Separator/>
                                <MenuItem Header="Thêm phân cách" Click="MiThemPhanCach_Click"/>
                                <MenuItem Header="📁  Thêm thư mục" Click="MiThemThuMucGoc_Click"/>
                            </MenuItem>

                            <!-- 2. Thêm con -->
                            <MenuItem Header="Thêm con">
                                <MenuItem Header="➕  Thêm nhóm thẻ trả trước" Click="MiThemConItem_Click"/>
                                <MenuItem Header="Thêm nhanh" Click="MiThemNhanhCon_Click"/>
                                <Separator/>
                                <MenuItem Header="Thêm phân cách" Click="MiThemPhanCach_Click"/>
                                <MenuItem Header="📁  Thêm thư mục" Click="MiThemThuMucCon_Click"/>
                            </MenuItem>

                            <!-- 3. Chỉnh sửa -->
                            <MenuItem Header="✏️  Chỉnh sửa" Click="MiChinhSua_Click"/>

                            <!-- 4. Sắp xếp theo -->
                            <MenuItem Header="Sắp xếp theo">
                                <MenuItem x:Name="MiSapXepTen" Header="Tên" IsCheckable="True" IsChecked="True" Click="MiSapXepTen_Click"/>
                                <MenuItem x:Name="MiSapXepTuyChon" Header="Thứ tự tùy chọn" IsCheckable="True" Click="MiSapXepTuyChon_Click"/>
                            </MenuItem>

                            <!-- 5. Refresh -->
                            <MenuItem Header="🔄  Refresh" Click="BtnTaiLaiNhom_Click"/>

                            <Separator/>

                            <!-- 6. Sao chép, Mở rộng, Thu gọn -->
                            <MenuItem Header="📑  Sao chép" Click="MiSaoChepNhom_Click"/>
                            <MenuItem Header="Mở rộng" Click="MiMoRong_Click"/>
                            <MenuItem Header="Thu gọn" Click="MiThuGon_Click"/>

                            <Separator/>

                            <!-- 7. Xóa, Đổi tên, Thùng rác -->
                            <MenuItem Header="❌  Xóa" Click="BtnXoaNhom_Click"/>
                            <MenuItem Header="Đổi tên" Click="MiDoiTen_Click"/>
                            <MenuItem Header="Thùng rác" Click="MiThungRac_Click"/>

                            <Separator/>

                            <!-- 8. Biểu tượng, Thuộc tính -->
                            <MenuItem Header="Biểu tượng" Click="MiBieuTuong_Click"/>
                            <MenuItem Header="Thuộc tính" Click="MiThuocTinh_Click"/>
                        </ContextMenu>
                    </TreeView.ContextMenu>

                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type models:NhomTheTraTruocTreeItem}" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Text="{Binding Icon}" FontSize="13" Foreground="{Binding IconColor}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>

                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}">
                            <Setter Property="IsExpanded" Value="True"/>
                            <Setter Property="Padding" Value="2,2"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </Border>
        </Grid>

        <!-- SPLITTER -->
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#cbd5e1" Cursor="SizeWE"/>

        <!-- CỘT PHẢI: NỬA TRÊN LÀ DANH SÁCH THẺ, NỬA DƯỚI LÀ CÁC TAB CHI TIẾT -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Tab Header "Thẻ trả trước" -->
                <RowDefinition Height="3*" MinHeight="160"/> <!-- Lưới thẻ trả trước -->
                <RowDefinition Height="5"/> <!-- GridSplitter -->
                <RowDefinition Height="2*" MinHeight="130"/> <!-- Các tab chi tiết -->
            </Grid.RowDefinitions>

            <!-- Tab Header: Thẻ trả trước -->
            <Border Grid.Row="0" Style="{StaticResource HeaderTabStyle}" Margin="0,5,5,0" HorizontalAlignment="Left" Width="150">
                <TextBlock Text="Thẻ trả trước" FontWeight="Bold" FontSize="12.5" Foreground="#1e3f66" HorizontalAlignment="Center"/>
            </Border>

            <!-- NỬA TRÊN: TOOLBAR + DATAGRID THẺ TRẢ TRƯỚC -->
            <Border Grid.Row="1" Background="White" BorderBrush="#b6cadf" BorderThickness="1" Margin="0,0,5,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Toolbar -->
                        <RowDefinition Height="*"/>    <!-- DataGrid -->
                        <RowDefinition Height="Auto"/> <!-- Summary Bar -->
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <Border Grid.Row="0" Background="#f0f5fa" BorderBrush="#b6cadf" BorderThickness="0,0,0,1" Padding="6,4">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Lọc (F3) -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="Lọc (F3):" FontWeight="SemiBold" FontSize="12" Foreground="#1e3f66" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="TxtLoc" Width="140" Height="22" VerticalContentAlignment="Center" Background="#ffffcc" 
                                         BorderBrush="#9ab5cf" BorderThickness="1" Padding="4,0" TextChanged="TxtLoc_TextChanged"/>
                            </StackPanel>

                            <!-- Các nút hành động chuẩn ribbon -->
                            <Button x:Name="BtnThemMoi" Style="{StaticResource RibbonToolBtn}" Click="BtnThemMoi_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="➕" Foreground="Green" Margin="0,0,4,0"/>
                                    <TextBlock Text="Thêm mới (Insert)"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnChinhSua" Style="{StaticResource RibbonToolBtn}" Click="BtnChinhSua_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✏️" Margin="0,0,4,0"/>
                                    <TextBlock Text="Chỉnh sửa (F4)"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnXoa" Style="{StaticResource RibbonToolBtn}" Click="BtnXoa_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="❌" Foreground="Crimson" Margin="0,0,4,0"/>
                                    <TextBlock Text="Xóa (Del)"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnThemExcel" Style="{StaticResource RibbonToolBtn}" Click="BtnThemExcel_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📊" Margin="0,0,4,0"/>
                                    <TextBlock Text="Thêm excel"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnXuatExcel" Style="{StaticResource RibbonToolBtn}" Click="BtnXuatExcel_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📈" Margin="0,0,4,0"/>
                                    <TextBlock Text="Xuất excel"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnIn" Style="{StaticResource RibbonToolBtn}" Click="BtnIn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🖨️" Margin="0,0,4,0"/>
                                    <TextBlock Text="In"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnTong" Style="{StaticResource RibbonToolBtn}" Click="BtnTong_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="∑" FontWeight="Bold" Margin="0,0,4,0"/>
                                    <TextBlock Text="Tổng"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Border>

                    <!-- DataGrid Thẻ trả trước -->
                    <DataGrid Grid.Row="1" x:Name="DgTheTraTruoc" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True" HeadersVisibility="All" GridLinesVisibility="All"
                              HorizontalGridLinesBrush="#e2e8f0" VerticalGridLinesBrush="#e2e8f0"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              RowHeight="25" SelectionMode="Single" SelectionUnit="FullRow"
                              Background="White" RowBackground="White" AlternatingRowBackground="#f8fbff"
                              SelectionChanged="DgTheTraTruoc_SelectionChanged"
                              MouseDoubleClick="DgTheTraTruoc_MouseDoubleClick">

                        <DataGrid.ContextMenu>
                            <ContextMenu x:Name="CmTheTraTruoc">
                                <MenuItem Header="➕  Thêm Thẻ trả trước" Click="BtnThemMoi_Click"/>
                                <MenuItem Header="Thêm nhanh (excel)" Click="BtnThemExcel_Click"/>
                                <MenuItem Header="Cập nhật nhanh (excel)" Click="MiCapNhatNhanhExcel_Click"/>
                                <MenuItem Header="✏️  Chỉnh sửa" Click="BtnChinhSua_Click"/>
                                
                                <MenuItem x:Name="MiDatNhomThe" Header="Đặt Nhóm thẻ trả trước"/>
                                <MenuItem x:Name="MiLocNhomThe" Header="Lọc Nhóm thẻ trả trước"/>
                                <MenuItem Header="Sắp xếp theo">
                                    <MenuItem Header="Mã thẻ" Click="MiSapXepMaThe_Click"/>
                                    <MenuItem Header="Nhóm thẻ trả trước" Click="MiSapXepNhomThe_Click"/>
                                    <MenuItem Header="Ngày hết hạn" Click="MiSapXepNgayHetHan_Click"/>
                                </MenuItem>
                                <MenuItem Header="🔄  Refresh" Click="BtnRefreshThe_Click"/>
                                <MenuItem Header="In danh sách" Click="BtnIn_Click"/>
                                <Separator/>
                                <MenuItem Header="📑  Sao chép ô" Click="MiSaoChepO_Click"/>
                                <MenuItem Header="📑  Sao chép vùng chọn" Click="MiSaoChepVungChon_Click"/>
                                <MenuItem Header="❌  Xóa" Click="BtnXoa_Click"/>
                                <Separator/>
                                <MenuItem Header="Tự động dãn cột" Click="MiTuDongGianCot_Click"/>
                                <MenuItem Header="Cột hiển thị" Click="MiCotHienThi_Click"/>
                                <MenuItem Header="Thuộc tính" Click="MiThuocTinhThe_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.RowStyle>
                            <Style TargetType="{x:Type DataGridRow}">
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="DgTheTraTruoc_Row_PreviewMouseRightButtonDown"/>
                            </Style>
                        </DataGrid.RowStyle>

                        <!-- STT ở RowHeader -->
                        <DataGrid.RowHeaderStyle>
                            <Style TargetType="{x:Type DataGridRowHeader}">
                                <Setter Property="Width" Value="32"/>
                                <Setter Property="Background" Value="#dfe9f5"/>
                                <Setter Property="BorderBrush" Value="#b6cadf"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="Content" Value="{Binding Stt}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="11"/>
                            </Style>
                        </DataGrid.RowHeaderStyle>

                        <DataGrid.Columns>
                            <!-- Mã thẻ (Badge nâu cam khi chọn #c26e38) -->
                            <DataGridTextColumn Header="Mã thẻ" Binding="{Binding MaThe}" Width="140">
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="{x:Type DataGridCell}">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="6,0"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#c26e38"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>

                            <!-- Nhóm thẻ trả trước -->
                            <DataGridTextColumn Header="Nhóm thẻ trả trước" Binding="{Binding TenNhomTheTraTruoc}" Width="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="6,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Khóa -->
                            <DataGridCheckBoxColumn Header="Khóa" Binding="{Binding Khoa}" Width="65">
                                <DataGridCheckBoxColumn.ElementStyle>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                    </Style>
                                </DataGridCheckBoxColumn.ElementStyle>
                            </DataGridCheckBoxColumn>

                            <!-- Ngày hết hạn -->
                            <DataGridTextColumn Header="Ngày hết hạn" Binding="{Binding NgayHetHan, StringFormat='{}{0:dd/MM/yyyy}'}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="6,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Ghi chú -->
                            <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="6,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Summary Bar (Toggle khi bấm ∑ Tổng) -->
                    <Border Grid.Row="2" x:Name="BdrTong" Background="#e2ecf7" BorderBrush="#b6cadf" BorderThickness="0,1,0,0" Padding="8,4" Visibility="Collapsed">
                        <TextBlock x:Name="TxtTongSummary" FontWeight="Bold" Foreground="#1e3f66" Text="Tổng cộng: 0 thẻ"/>
                    </Border>
                </Grid>
            </Border>

            <!-- SPLITTER NGANG -->
            <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="#cbd5e1" Cursor="SizeNS" Margin="0,0,5,0"/>

            <!-- NỬA DƯỚI: TABCONTROL CÁC THÔNG TIN CHI TIẾT -->
            <TabControl Grid.Row="3" Margin="0,0,5,5" Background="White" BorderBrush="#b6cadf">
                <!-- 1. Tab Thông tin (Mặc định trong ảnh chụp thực tế) -->
                <TabItem Header="Thông tin">
                    <Border Background="White" Padding="16,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" x:Name="TxtKhoiTao" Text="Khởi tạo: " FontSize="12" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtKhoiTaoBoi" Text="Khởi tạo bởi: " FontSize="12" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" x:Name="TxtSuaDoi" Text="Sửa đổi gần nhất: " FontSize="12"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtSuaDoiBoi" Text="Sửa đổi bởi: " FontSize="12"/>
                        </Grid>
                    </Border>
                </TabItem>

                <!-- 2. Hóa đơn nhà hàng -->
                <TabItem Header="Hóa đơn nhà hàng">
                    <DataGrid x:Name="DgHoaDonThe" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True" HeadersVisibility="All" GridLinesVisibility="All"
                              HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Auto"
                              HorizontalGridLinesBrush="#cbd5e1" VerticalGridLinesBrush="#cbd5e1"
                              RowHeight="25" Background="White" RowBackground="#e2f0d9" AlternatingRowBackground="#e2f0d9">

                        <!-- STT ở RowHeader -->
                        <DataGrid.RowHeaderStyle>
                            <Style TargetType="{x:Type DataGridRowHeader}">
                                <Setter Property="Width" Value="32"/>
                                <Setter Property="Background" Value="#dfe9f5"/>
                                <Setter Property="BorderBrush" Value="#b6cadf"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="Content" Value="{Binding Stt}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="11"/>
                            </Style>
                        </DataGrid.RowHeaderStyle>

                        <DataGrid.Columns>
                            <!-- 1. Số phiếu (Nền cam nâu như ảnh chụp) -->
                            <DataGridTemplateColumn Header="Số phiếu" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#c26e38" Padding="6,2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
