                            <!-- 16. Đặt hàng -->
                            <DataGridTextColumn Header="Đặt hàng" Binding="{Binding DatHang}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="4,0"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 17. Cửa hàng -->
                            <DataGridTextColumn Header="Cửa hàng" Binding="{Binding CuaHang}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="4,0"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 18. Là phiếu thu công nợ -->
                            <DataGridCheckBoxColumn Header="Là phiếu thu công nợ" Binding="{Binding LaPhieuThuCongNo}" Width="125">
                                <DataGridCheckBoxColumn.ElementStyle>
                                    <Style TargetType="CheckBox"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="IsEnabled" Value="False"/></Style>
                                </DataGridCheckBoxColumn.ElementStyle>
                            </DataGridCheckBoxColumn>

                            <!-- 19. Không thay đổi công nợ -->
                            <DataGridCheckBoxColumn Header="Không thay đổi công nợ" Binding="{Binding KhongThayDoiCongNo}" Width="135">
                                <DataGridCheckBoxColumn.ElementStyle>
                                    <Style TargetType="CheckBox"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="IsEnabled" Value="False"/></Style>
                                </DataGridCheckBoxColumn.ElementStyle>
                            </DataGridCheckBoxColumn>

                            <!-- 20. Tài khoản ngân hàng -->
                            <DataGridTextColumn Header="Tài khoản ngân hàng" Binding="{Binding TaiKhoanNganHang}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="4,0"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 21. Thẻ trả trước -->
                            <DataGridTextColumn Header="Thẻ trả trước" Binding="{Binding TheTraTruoc}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="4,0"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 22. Đơn hàng -->
                            <DataGridTextColumn Header="Đơn hàng" Binding="{Binding DonHang}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="4,0"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
