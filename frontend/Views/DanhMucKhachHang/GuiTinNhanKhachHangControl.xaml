<UserControl x:Class="QuanLyBar.Client.Views.GuiTinNhanKhachHangControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:models="clr-namespace:QuanLyBar.Client.Models"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="1200"
             Loaded="UserControl_Loaded">
    
    <UserControl.Resources>
        <Style x:Key="HeaderTabStyle" TargetType="Border">
            <Setter Property="Background" Value="#dfe9f5"/>
            <Setter Property="BorderBrush" Value="#a3bde0"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="CornerRadius" Value="3,3,0,0"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>

        <Style x:Key="YellowHeaderTabStyle" TargetType="Border">
            <Setter Property="Background" Value="#ffeaa7"/>
            <Setter Property="BorderBrush" Value="#fdcb6e"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="CornerRadius" Value="3,3,0,0"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#f0f4fa">
        <Grid.ColumnDefinitions>
            <!-- Cột trái: Nhóm khách hàng -->
            <ColumnDefinition Width="200" MinWidth="140" MaxWidth="300"/>
            <ColumnDefinition Width="4"/>
            <!-- Cột giữa: Danh sách khách hàng -->
            <ColumnDefinition Width="*" MinWidth="350"/>
            <ColumnDefinition Width="4"/>
            <!-- Cột phải: Lựa chọn danh sách người nhận -->
            <ColumnDefinition Width="320" MinWidth="240" MaxWidth="500"/>
        </Grid.ColumnDefinitions>

        <!-- CỘT 0: PHÂN LOẠI KHÁCH HÀNG -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tab Header -->
            <Border Grid.Row="0" Style="{StaticResource HeaderTabStyle}" Margin="5,5,0,0">
                <Grid>
                    <TextBlock x:Name="TxtLeftHeaderTitle" Text="Nhóm khách hàng" FontWeight="Bold" FontSize="12.5" Foreground="#1e3f66" VerticalAlignment="Center"/>
                    <TextBlock Text="⚙️" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" FontSize="13"/>
                </Grid>
            </Border>

            <!-- Sub Toolbar nhóm -->
            <Border Grid.Row="1" Background="#eaf1fa" BorderBrush="#b6cadf" BorderThickness="1,1,1,0" Margin="5,0,0,0" Padding="2,2">
                <DockPanel LastChildFill="False">
                    <Button x:Name="BtnThemNhom" ToolTip="Thêm mới nhóm khách hàng" Margin="1,0" Padding="3,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnThemNhom_Click">
                        <TextBlock Text="➕" Foreground="Green" FontSize="13"/>
                    </Button>
                    <Button x:Name="BtnSuaNhom" ToolTip="Sửa nhóm khách hàng" Margin="1,0" Padding="3,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnSuaNhom_Click">
                        <TextBlock Text="✏️" FontSize="13"/>
                    </Button>
                    <Button x:Name="BtnThemThuMuc" ToolTip="Tạo mới thư mục" Margin="1,0" Padding="3,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnThemThuMuc_Click">
                        <TextBlock Text="📁" Foreground="#d4a017" FontSize="13"/>
                    </Button>
                    <Button x:Name="BtnTaiLaiNhom" ToolTip="Tải lại" Margin="1,0" Padding="3,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnTaiLaiNhom_Click">
                        <TextBlock Text="🔄" FontSize="13"/>
                    </Button>
                </DockPanel>
            </Border>

            <!-- TreeView nhóm khách hàng -->
            <Border Grid.Row="2" Background="White" BorderBrush="#b6cadf" BorderThickness="1" Margin="5,0,0,5">
                <TreeView x:Name="TvNhomKhachHang" BorderThickness="0" SelectedItemChanged="TvNhomKhachHang_SelectedItemChanged">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type models:NhomKhachHangTreeItem}" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="{Binding Icon}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12.5"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>
        </Grid>

        <!-- Grid Splitter 1 -->
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

        <!-- CỘT 2: DANH SÁCH KHÁCH HÀNG (GIỮA) -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="130" MinHeight="80"/>
            </Grid.RowDefinitions>

            <!-- Tab Header: Khách hàng -->
            <Border Grid.Row="0" Style="{StaticResource HeaderTabStyle}" HorizontalAlignment="Left" Margin="0,5,0,0" Width="120">
                <TextBlock Text="Khách hàng" FontWeight="Bold" FontSize="12.5" Foreground="#1e3f66" HorizontalAlignment="Center"/>
            </Border>

            <!-- Toolbar trên của bảng khách hàng -->
            <Border Grid.Row="1" Background="#eaf1fa" BorderBrush="#b6cadf" BorderThickness="1,1,1,0" Padding="4,3">
                <DockPanel LastChildFill="False">
                    <!-- Ô lọc F3 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="Lọc (F3):" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="11.5" FontWeight="SemiBold" Foreground="#2c3e50"/>
                        <TextBox x:Name="TxtLoc" Width="100" Height="22" VerticalContentAlignment="Center" Padding="2,0" TextChanged="TxtLoc_TextChanged"/>
                    </StackPanel>

                    <!-- Các nút chức năng -->
                    <Button x:Name="BtnThemMoi" Margin="2,0" Padding="5,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnThemMoi_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕" Foreground="Green" Margin="0,0,4,0" FontWeight="Bold"/>
                            <TextBlock Text="Thêm mới (Insert)" VerticalAlignment="Center" FontSize="11.5"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnChinhSua" Margin="2,0" Padding="5,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnChinhSua_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✏️" Foreground="#c07000" Margin="0,0,4,0"/>
                            <TextBlock Text="Chỉnh sửa (F4)" VerticalAlignment="Center" FontSize="11.5"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnXoa" Margin="2,0" Padding="5,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnXoa_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="❌" Foreground="Red" Margin="0,0,4,0"/>
                            <TextBlock Text="Xóa (Del)" VerticalAlignment="Center" FontSize="11.5"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnThemExcel" Margin="2,0" Padding="5,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnThemExcel_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💹" Foreground="DarkGreen" Margin="0,0,4,0"/>
                            <TextBlock Text="Thêm excel" VerticalAlignment="Center" FontSize="11.5"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnXuatExcel" Margin="2,0" Padding="5,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnXuatExcel_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" Foreground="Green" Margin="0,0,4,0"/>
                            <TextBlock Text="Xuất excel" VerticalAlignment="Center" FontSize="11.5"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnIn" Margin="2,0" Padding="5,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnIn_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨️" Foreground="#0078d7" Margin="0,0,4,0"/>
                            <TextBlock Text="In" VerticalAlignment="Center" FontSize="11.5"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnTong" Margin="2,0" Padding="5,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnTong_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="∑" FontWeight="Bold" Foreground="#333" Margin="0,0,4,0"/>
                            <TextBlock Text="Tổng" VerticalAlignment="Center" FontSize="11.5"/>
                        </StackPanel>
                    </Button>
                </DockPanel>
            </Border>

            <!-- DataGrid Danh sách khách hàng -->
            <Border Grid.Row="2" Background="White" BorderBrush="#b6cadf" BorderThickness="1" Margin="0,0,0,5">
                <DataGrid x:Name="DgKhachHang" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          IsReadOnly="True" HeadersVisibility="All" GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#e2e8f0" VerticalGridLinesBrush="#e2e8f0"
                          RowHeight="24" SelectionMode="Extended" SelectionUnit="FullRow"
                          Background="White" RowBackground="White" AlternatingRowBackground="#f9fbff"
                          MouseDoubleClick="DgKhachHang_MouseDoubleClick">
                    
                    <!-- Row Header Style hiển thị STT -->
                    <DataGrid.RowHeaderStyle>
                        <Style TargetType="{x:Type DataGridRowHeader}">
                            <Setter Property="Width" Value="32"/>
                            <Setter Property="Background" Value="#dfe9f5"/>
                            <Setter Property="BorderBrush" Value="#b6cadf"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="Content" Value="{Binding Stt}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="11"/>
                        </Style>
                    </DataGrid.RowHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã khách" Binding="{Binding Makhach}" Width="75">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,0"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Tên khách hàng" Binding="{Binding Name}" Width="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Địa chỉ" Binding="{Binding Diachi}" Width="160">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Điện thoại" Binding="{Binding Dienthoai}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Nhóm khách hàng" Binding="{Binding TenNhomKhachHang}" Width="115">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Mã số thuế" Binding="{Binding Masothue}" Width="85">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Nhân viên" Binding="{Binding TenNhanVien}" Width="95">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Tỉnh thành" Binding="{Binding TinhThanh}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Facebook" Binding="{Binding Facebook}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Thẻ trả trước" Binding="{Binding TheTraTruoc}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Grid Splitter ngang giữa DataGrid và Tab phía dưới -->
            <GridSplitter Grid.Row="3" Height="4" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeNS"/>

            <!-- CỤM TAB DƯỚI: THÔNG TIN CHI TIẾT -->
            <Border Grid.Row="4" Background="White" BorderBrush="#b6cadf" BorderThickness="1" Margin="0,0,0,5">
                <TabControl x:Name="TabBottomDetails" BorderThickness="0" Background="Transparent">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="FontSize" Value="11.5"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </TabControl.Resources>

                    <TabItem Header="Thông tin">
                        <Grid Background="#f9fbff" Margin="10,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Khởi tạo:" FontSize="11.5" Foreground="#555" Margin="0,0,10,6"/>
                            <TextBlock x:Name="TxtInfoKhoiTao" Grid.Row="0" Grid.Column="1" Text="--/--/---- --:--:--" FontSize="11.5" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Khởi tạo bởi:" FontSize="11.5" Foreground="#555" Margin="0,0,10,6"/>
                            <TextBlock x:Name="TxtInfoNguoiTao" Grid.Row="0" Grid.Column="4" Text="Administrator" FontSize="11.5" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Sửa đổi gần nhất:" FontSize="11.5" Foreground="#555" Margin="0,0,10,0"/>
                            <TextBlock x:Name="TxtInfoSuaDoi" Grid.Row="1" Grid.Column="1" Text="--/--/---- --:--:--" FontSize="11.5" FontWeight="SemiBold" Foreground="#2c3e50"/>

                            <TextBlock Grid.Row="1" Grid.Column="3" Text="Sửa đổi bởi:" FontSize="11.5" Foreground="#555" Margin="0,0,10,0"/>
                            <TextBlock x:Name="TxtInfoNguoiSua" Grid.Row="1" Grid.Column="4" Text="Administrator" FontSize="11.5" FontWeight="SemiBold" Foreground="#2c3e50"/>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Báo giá"/>
                    <TabItem Header="Đặt hàng"/>
                    <TabItem Header="Hóa đơn nhà hàng"/>
                    <TabItem Header="Tăng giảm điểm"/>
                    <TabItem Header="Phiếu thu"/>
                    <TabItem Header="Phiếu chi"/>
                    <TabItem Header="Phiếu thu công nợ"/>
                    <TabItem Header="Voucher"/>
                </TabControl>
            </Border>
        </Grid>

        <!-- Grid Splitter 2 -->
        <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

        <!-- CỘT 4: LỰA CHỌN DANH SÁCH NGƯỜI NHẬN (PHẢI) -->
        <Grid Grid.Column="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tab Header Vàng: Lựa chọn danh sách người nhận -->
            <Border Grid.Row="0" Style="{StaticResource YellowHeaderTabStyle}" Margin="0,5,5,0" HorizontalAlignment="Left">
                <TextBlock Text="Lựa chọn danh sách người nhận" FontWeight="Bold" FontSize="12" Foreground="#2d3436" VerticalAlignment="Center"/>
            </Border>

            <!-- Toolbar bên phải: Thêm, Xóa, Thực hiện -->
            <Border Grid.Row="1" Background="#eaf1fa" BorderBrush="#b6cadf" BorderThickness="1,1,1,0" Margin="0,0,5,0" Padding="3,3">
                <DockPanel LastChildFill="False">
                    <!-- Nút Thêm -->
                    <Button x:Name="BtnThemNguoiNhan" Margin="2,0" Padding="6,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnThemNguoiNhan_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➲" Foreground="#0984e3" Margin="0,0,4,0" FontWeight="Bold" FontSize="13"/>
                            <TextBlock Text="Thêm" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- Nút Xóa -->
                    <Button x:Name="BtnXoaNguoiNhan" Margin="2,0" Padding="6,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnXoaNguoiNhan_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="❌" Foreground="Red" Margin="0,0,4,0" FontSize="11.5"/>
                            <TextBlock Text="Xóa" VerticalAlignment="Center" FontSize="11.5"/>
                        </StackPanel>
                    </Button>

                    <!-- Nút Thực hiện -->
                    <Button x:Name="BtnThucHien" Margin="2,0" Padding="6,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnThucHien_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✉️" Foreground="#e17055" Margin="0,0,4,0" FontSize="12"/>
                            <TextBlock Text="Thực hiện" VerticalAlignment="Center" FontSize="11.5"/>
                        </StackPanel>
                    </Button>
                </DockPanel>
            </Border>

            <!-- DataGrid Danh sách người nhận -->
            <Border Grid.Row="2" Background="White" BorderBrush="#b6cadf" BorderThickness="1" Margin="0,0,5,5">
                <DataGrid x:Name="DgNguoiNhan" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          IsReadOnly="True" HeadersVisibility="All" GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#e2e8f0" VerticalGridLinesBrush="#e2e8f0"
                          RowHeight="24" SelectionMode="Extended" SelectionUnit="FullRow"
                          Background="White" RowBackground="White" AlternatingRowBackground="#f9fbff">
                    
                    <!-- Row Header Style hiển thị STT -->
                    <DataGrid.RowHeaderStyle>
                        <Style TargetType="{x:Type DataGridRowHeader}">
                            <Setter Property="Width" Value="28"/>
                            <Setter Property="Background" Value="#dfe9f5"/>
                            <Setter Property="BorderBrush" Value="#b6cadf"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="Content" Value="{Binding Stt}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="11"/>
                        </Style>
                    </DataGrid.RowHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tên" Binding="{Binding Ten}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,0"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Điện thoại" Binding="{Binding Dienthoai}" Width="105">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
