<Window x:Class="QuanLyBar.Client.Views.ThemNhanVienWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="👩 NHÂN VIÊN - THÊM MỚI" 
        Height="540" Width="440" 
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize"
        Background="#dce7f5"
        FontFamily="Segoe UI" FontSize="12"
        PreviewKeyDown="Window_PreviewKeyDown">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Sub Toolbar -->
            <RowDefinition Height="*"/>    <!-- Content -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- 1. Header Banner (màu vàng nhạt ấm theo mẫu) -->
        <Border Grid.Row="0" Background="#fffde6" BorderBrush="#e2d6b5" BorderThickness="0,0,0,1" Padding="15,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="👩" FontSize="28" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtHeaderTitle" Text="Nhân viên" FontSize="15" FontWeight="Bold" Foreground="#112233" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 2. Sub Toolbar -->
        <Border Grid.Row="1" Background="#eaf1fa" BorderBrush="#b6cadf" BorderThickness="0,0,0,1" Padding="6,3">
            <DockPanel LastChildFill="False">
                <Button Margin="2,0" Padding="6,2" Background="#f4f7fb" BorderBrush="#c2d5ea" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="↗️" FontSize="11" Margin="0,0,3,0"/>
                        <TextBlock Text="Phím tắt ▾" FontSize="11"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnTruoc" Margin="2,0" Padding="6,2" Background="#f4f7fb" BorderBrush="#c2d5ea" Cursor="Hand" Click="BtnTruoc_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⬅️" FontSize="11" Margin="0,0,3,0"/>
                        <TextBlock Text="Trước (F10)" FontSize="11"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnSau" Margin="2,0" Padding="6,2" Background="#f4f7fb" BorderBrush="#c2d5ea" Cursor="Hand" Click="BtnSau_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➡️" FontSize="11" Margin="0,0,3,0"/>
                        <TextBlock Text="Sau (F11)" FontSize="11"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnTaoMoi" Margin="2,0" Padding="6,2" Background="#f4f7fb" BorderBrush="#c2d5ea" Cursor="Hand" Click="BtnTaoMoi_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➕" Foreground="Green" FontSize="11" Margin="0,0,3,0"/>
                        <TextBlock Text="Tạo mới" FontSize="11"/>
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <!-- 3. Form Content -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="15,10">
            <StackPanel>
                <!-- Tên nhân viên & Ảnh -->
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Tên nhân viên" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtTenNhanVien" Grid.Column="1" Height="24" Background="#e1f5fe" BorderBrush="#0288d1" BorderThickness="1.5" VerticalContentAlignment="Center" Padding="4,0"/>
                    
                    <TextBlock Text="Ảnh:" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                    <ComboBox x:Name="CboAnh" Grid.Column="3" Height="24" VerticalContentAlignment="Center" Background="White">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding ImageSource}" Width="16" Height="16" Stretch="Uniform"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <!-- Địa chỉ -->
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Địa chỉ" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtDiaChi" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Padding="4,0"/>
                </Grid>

                <!-- Điện thoại -->
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Điện thoại" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtDienThoai" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Padding="4,0"/>
                </Grid>

                <!-- Group: Cách tính lương -->
                <GroupBox Header="Cách tính lương" Margin="0,10,0,5" Padding="8,6" BorderBrush="#a4bce3" Background="#e4edf7">
                    <StackPanel>
                        <!-- 1. Lương theo ca -->
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="RbLuongTheoCa" Content="Lương theo ca" IsChecked="True" VerticalAlignment="Center" GroupName="CachTinhLuong" Checked="RbCachTinhLuong_Checked"/>
                            <TextBlock Text="Lương ca" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtLuongCa" Grid.Column="2" Text="0" Height="22" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Padding="4,0"/>
                        </Grid>
                        <TextBlock Text="(Cách tính: Lương = Tổng ca làm việc x Lương ca)" FontStyle="Italic" Foreground="#555" Margin="20,1,0,8"/>

                        <!-- 2. Lương tháng theo ca -->
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="RbLuongThangTheoCa" Content="Lương tháng theo ca" VerticalAlignment="Center" GroupName="CachTinhLuong" Checked="RbCachTinhLuong_Checked"/>
                            <TextBlock Text="Lương tháng" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtLuongThang" Grid.Column="2" Text="0" Height="22" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Padding="4,0"/>
                        </Grid>
                        <TextBlock Text="(Cách tính: Lương = Tổng ca làm việc x Lương tháng / số ngày tháng)" FontStyle="Italic" Foreground="#555" Margin="20,1,0,8"/>

                        <!-- 3. Lương tháng theo ngày -->
                        <RadioButton x:Name="RbLuongThangTheoNgay" Content="Lương tháng theo ngày" Margin="0,3" GroupName="CachTinhLuong" Checked="RbCachTinhLuong_Checked"/>
                        <StackPanel Orientation="Horizontal" Margin="40,2,0,4">
                            <CheckBox x:Name="ChkNghiThu7" Content="Nghỉ thứ 7" Margin="0,0,20,0" IsChecked="True"/>
                            <CheckBox x:Name="ChkNghiChuNhat" Content="Nghỉ chủ nhật"/>
                        </StackPanel>
                        <TextBlock Text="(Cách tính: Lương = Tổng ngày làm việc x Lương tháng / số ngày tháng)" FontStyle="Italic" Foreground="#555" Margin="20,1,0,2"/>
                    </StackPanel>
                </GroupBox>

                <!-- Ghi chú -->
                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Ghi chú" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtGhiChu" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Padding="4,0"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- 4. Footer Buttons -->
        <Border Grid.Row="3" Background="#eaf1fa" BorderBrush="#b6cadf" BorderThickness="0,1,0,0" Padding="10,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnLuu" Content="💾 Lưu" Width="70" Height="26" Margin="4,0" Background="#f4f7fb" BorderBrush="#a4bce3" Cursor="Hand" Click="BtnLuu_Click"/>
                <Button x:Name="BtnLuuVaMoi" Content="Lưu &amp; Mới" Width="78" Height="26" Margin="4,0" Background="#f4f7fb" BorderBrush="#a4bce3" Cursor="Hand" Click="BtnLuuVaMoi_Click"/>
                <Button x:Name="BtnLuuVaThoat" Content="Lưu &amp; thoát" Width="82" Height="26" Margin="4,0" Background="#f4f7fb" BorderBrush="#a4bce3" Cursor="Hand" Click="BtnLuuVaThoat_Click"/>
                <Button x:Name="BtnThoat" Content="Thoát" Width="70" Height="26" Margin="4,0" Background="#ffffff" BorderBrush="#0078d7" BorderThickness="1.5" FontWeight="SemiBold" Cursor="Hand" Click="BtnThoat_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
