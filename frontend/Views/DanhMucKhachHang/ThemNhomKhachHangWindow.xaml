<Window x:Class="QuanLyBar.Client.Views.ThemNhomKhachHangWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NHÓM KHÁCH HÀNG - THÊM MỚI" Height="520" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#cddfef">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <Border Grid.Row="0" Background="White" BorderBrush="#b6cadf" BorderThickness="0,0,0,1" Padding="15,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📁" FontSize="30" Foreground="#0078d7" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock x:Name="TxtHeaderTitle" Text="Nhóm khách hàng" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Foreground="#111111"/>
            </StackPanel>
        </Border>

        <!-- 2. Sub Toolbar -->
        <Border Grid.Row="1" Background="#e2ecf7" BorderBrush="#b6cadf" BorderThickness="0,0,0,1" Padding="5,0">
            <DockPanel LastChildFill="False">
                <Button Content="↗️ Phím tắt ▾" Margin="2,3" Padding="6,2" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                <Separator Margin="4,3"/>
                <Button Content="⬅️ Trước (F10)" Margin="2,3" Padding="6,2" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                <Button Content="➡️ Sau (F11)" Margin="2,3" Padding="6,2" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                <Separator Margin="4,3"/>
                <Button x:Name="BtnTaoMoi" Content="➕ Tạo mới" Margin="2,3" Padding="6,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnTaoMoi_Click"/>
                <Button Content="📑 Sao chép" Margin="2,3" Padding="6,2" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                <Button Content="❌ Xóa" Margin="2,3" Padding="6,2" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
            </DockPanel>
        </Border>

        <!-- 3. Form Body -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="20,12">
            <StackPanel>
                <!-- Tên nhóm & Ảnh -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Tên nhóm khách hàng" VerticalAlignment="Center" FontSize="12.5"/>
                    <TextBox x:Name="TxtTenNhom" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Background="#f0f9ff" BorderBrush="#0078d7" BorderThickness="1.5"/>
                    <TextBlock Text="Ảnh:" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0" FontSize="12.5"/>
                    <ComboBox x:Name="CboAnh" Grid.Column="3" Height="24" Background="White">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding ImageSource}" Width="16" Height="16" Stretch="Uniform"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <!-- Điểm tích lũy -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Điểm tích lũy" VerticalAlignment="Center" FontSize="12.5"/>
                    <TextBox x:Name="TxtDiemTichLuy" Grid.Column="1" Height="24" Text="0" VerticalContentAlignment="Center" TextAlignment="Right"/>
                </Grid>
                <TextBlock Text="(Khi khách hàng đạt tới số điểm này sẽ tự động được chuyển sang nhóm)" 
                           Foreground="#222222" FontSize="11.5" Margin="150,0,0,10"/>

                <!-- Giảm giá tổng hóa đơn -->
                <TextBlock Text="Giảm giá tổng hóa đơn" FontWeight="Bold" FontSize="13" Foreground="#111111" Margin="0,5,0,6"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Tỉ lệ giảm giá tiền hàng" VerticalAlignment="Center" FontSize="12.5"/>
                    <TextBox x:Name="TxtGiamTienHang" Grid.Column="1" Height="24" Text="0" VerticalContentAlignment="Center" TextAlignment="Right"/>
                    <TextBlock Text="%" Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="12.5"/>
                </Grid>

                <!-- Giảm giá trên từng mặt hàng -->
                <TextBlock Text="Giảm giá trên từng mặt hàng" FontWeight="Bold" FontSize="13" Foreground="#111111" Margin="0,5,0,6"/>
                
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Tỉ lệ giảm đồ ăn" VerticalAlignment="Center" FontSize="12.5"/>
                    <TextBox x:Name="TxtGiamDoAn" Grid.Column="1" Height="24" Text="0" VerticalContentAlignment="Center" TextAlignment="Right"/>
                    <TextBlock Text="%" Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="12.5"/>
                </Grid>

                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Tỉ lệ giảm đồ uống" VerticalAlignment="Center" FontSize="12.5"/>
                    <TextBox x:Name="TxtGiamDoUong" Grid.Column="1" Height="24" Text="0" VerticalContentAlignment="Center" TextAlignment="Right"/>
                    <TextBlock Text="%" Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="12.5"/>
                </Grid>

                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Tỉ lệ giảm dịch vụ" VerticalAlignment="Center" FontSize="12.5"/>
                    <TextBox x:Name="TxtGiamDichVu" Grid.Column="1" Height="24" Text="0" VerticalContentAlignment="Center" TextAlignment="Right"/>
                    <TextBlock Text="%" Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="12.5"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Tỉ lệ giảm đồ khác" VerticalAlignment="Center" FontSize="12.5"/>
                    <TextBox x:Name="TxtGiamDoKhac" Grid.Column="1" Height="24" Text="0" VerticalContentAlignment="Center" TextAlignment="Right"/>
                    <TextBlock Text="%" Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="12.5"/>
                </Grid>

                <!-- Ghi chú -->
                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Ghi chú" VerticalAlignment="Center" FontSize="12.5"/>
                    <TextBox x:Name="TxtGhiChu" Grid.Column="1" Height="24" VerticalContentAlignment="Center"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- 4. Footer Buttons -->
        <Border Grid.Row="3" Background="#cddfef" Padding="15,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BtnLuu" Content="💾 Lưu" Width="75" Height="28" Margin="0,0,8,0" Background="White" BorderBrush="#9cb2c8" Cursor="Hand" Click="BtnLuu_Click"/>
                <Button x:Name="BtnLuuVaMoi" Content="Lưu &amp; Mới" Width="85" Height="28" Margin="0,0,8,0" Background="White" BorderBrush="#9cb2c8" Cursor="Hand" Click="BtnLuuVaMoi_Click"/>
                <Button x:Name="BtnLuuVaThoat" Content="Lưu &amp; thoát" Width="90" Height="28" Margin="0,0,8,0" Background="White" BorderBrush="#9cb2c8" Cursor="Hand" Click="BtnLuuVaThoat_Click"/>
                <Button x:Name="BtnThoat" Content="Thoát" Width="80" Height="28" Background="White" BorderBrush="#1877f2" BorderThickness="1.5" Cursor="Hand" IsCancel="True" Click="BtnThoat_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
