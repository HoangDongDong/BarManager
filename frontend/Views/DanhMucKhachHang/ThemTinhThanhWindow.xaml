<Window x:Class="QuanLyBar.Client.Views.ThemTinhThanhWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tỉnh thành" 
        Height="270" Width="430" 
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize"
        Background="#dce7f5"
        FontFamily="Segoe UI" FontSize="12">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Form Content -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- 1. Header Banner -->
        <Border Grid.Row="0" Background="#ffffff" BorderBrush="#b6cadf" BorderThickness="0,0,0,1" Padding="15,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📝" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtHeaderTitle" Text="Chỉnh sửa tỉnh thành" FontSize="13.5" FontWeight="Bold" Foreground="#112233" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 2. Form Content -->
        <Grid Grid.Row="1" Margin="15,12,15,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="55"/>
            </Grid.ColumnDefinitions>

            <!-- Tên tỉnh thành & Ảnh -->
            <TextBlock Text="Tên tỉnh thành" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtTenTinhThanh" Grid.Row="0" Grid.Column="1" Height="24" BorderBrush="#0078d7" BorderThickness="1.5" VerticalContentAlignment="Center" Padding="4,0"/>
            
            <TextBlock Text="Ảnh:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
            <ComboBox x:Name="CboAnh" Grid.Row="0" Grid.Column="3" Height="24" VerticalContentAlignment="Center" Background="White">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <Image Source="{Binding ImageSource}" Width="16" Height="16" Stretch="Uniform"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- Ghi chú -->
            <TextBlock Text="Ghi chú:" Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" VerticalAlignment="Top"/>
            <TextBox x:Name="TxtGhiChu" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,8,0,0" 
                     TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="4"/>
        </Grid>

        <!-- 3. Footer Buttons -->
        <Border Grid.Row="2" Background="Transparent" Padding="15,8,15,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnGhiDuLieu" Content="Ghi dữ liệu" Width="85" Height="26" Margin="4,0" Background="#f4f7fb" BorderBrush="#a4bce3" Cursor="Hand" Click="BtnGhiDuLieu_Click"/>
                <Button x:Name="BtnThoat" Content="Thoát" Width="70" Height="26" Margin="4,0" Background="#ffffff" BorderBrush="#0078d7" BorderThickness="1.5" FontWeight="SemiBold" Cursor="Hand" Click="BtnThoat_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
