<Window x:Class="QuanLyBar.Client.Views.ThemNhomTheTraTruocWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NHÓM THẺ TRẢ TRƯỚC - THÊM MỚI" Height="220" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#eaf1f8" WindowStyle="SingleBorderWindow">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Tên nhóm:" VerticalAlignment="Center" Margin="0,0,0,12" FontSize="12.5"/>
        <TextBox x:Name="TxtTenNhom" Grid.Row="0" Grid.Column="1" Height="26" VerticalContentAlignment="Center" 
                 Background="#ffffcc" BorderBrush="#9ab5cf" Margin="0,0,0,12" Padding="4,0" FontWeight="SemiBold"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Nhóm cha:" VerticalAlignment="Center" FontSize="12.5"/>
        <ComboBox x:Name="CboNhomCha" Grid.Row="1" Grid.Column="1" Height="26" VerticalContentAlignment="Center" 
                  BorderBrush="#9ab5cf"/>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnLuu" Content="💾 Lưu" Width="85" Height="27" Margin="0,0,8,0" Click="BtnLuu_Click"/>
            <Button x:Name="BtnThoat" Content="Thoát" Width="75" Height="27" Click="BtnThoat_Click"/>
        </StackPanel>
    </Grid>
</Window>
