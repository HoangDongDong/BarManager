<Window x:Class="QuanLyBar.Client.Views.ThemKhachHangWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thông tin khách hàng" Height="420" Width="550"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#D5E3F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" BorderBrush="#b6cadf" BorderThickness="0,0,0,1" Padding="15,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="👤" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="TxtHeaderTitle" Text="Thêm mới khách hàng" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Foreground="#1a3a5c"/>
            </StackPanel>
        </Border>

        <!-- Form Content -->
        <Grid Grid.Row="1" Margin="20,12,20,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Mã khách -->
            <TextBlock Text="Mã khách (*):" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtMaKhach" Grid.Row="0" Grid.Column="1" Height="25" VerticalContentAlignment="Center" Margin="0,2"/>

            <!-- Tên khách hàng -->
            <TextBlock Text="Tên khách (*):" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtTenKhach" Grid.Row="1" Grid.Column="1" Height="25" VerticalContentAlignment="Center" Margin="0,2"/>

            <!-- Nhóm khách hàng -->
            <TextBlock Text="Nhóm khách:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
            <ComboBox x:Name="CboNhomKhach" Grid.Row="2" Grid.Column="1" Height="25" VerticalContentAlignment="Center" Margin="0,2"
                      DisplayMemberPath="Name" SelectedValuePath="Id"/>

            <!-- Điện thoại -->
            <TextBlock Text="Điện thoại:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtDienThoai" Grid.Row="3" Grid.Column="1" Height="25" VerticalContentAlignment="Center" Margin="0,2"/>

            <!-- Email -->
            <TextBlock Text="Email:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtEmail" Grid.Row="4" Grid.Column="1" Height="25" VerticalContentAlignment="Center" Margin="0,2"/>

            <!-- Địa chỉ -->
            <TextBlock Text="Địa chỉ:" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtDiaChi" Grid.Row="5" Grid.Column="1" Height="25" VerticalContentAlignment="Center" Margin="0,2"/>

            <!-- Ghi chú -->
            <TextBlock Text="Ghi chú:" Grid.Row="6" Grid.Column="0" VerticalAlignment="Top" Margin="0,5,0,0"/>
            <TextBox x:Name="TxtGhiChu" Grid.Row="6" Grid.Column="1" Height="45" TextWrapping="Wrap" VerticalContentAlignment="Top" Margin="0,2"/>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#cddfef" Padding="15,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BtnLuu" Content="💾 Lưu" Width="85" Height="28" Margin="0,0,10,0" 
                        Background="White" BorderBrush="#8ca2ba" Cursor="Hand" Click="BtnLuu_Click"/>
                <Button x:Name="BtnDong" Content="Đóng" Width="80" Height="28" 
                        Background="White" BorderBrush="#1877f2" BorderThickness="1.5" Cursor="Hand" IsCancel="True" Click="BtnDong_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
