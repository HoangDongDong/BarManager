<Window x:Class="QuanLyBar.Client.Views.ThemTangDiemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TĂNG GIẢM ĐIỂM - THÊM MỚI" 
        Height="430" Width="510" 
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize" 
        Background="#dbe7f5"
        FontFamily="Segoe UI" FontSize="12"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="SubToolBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#f4f7fb"/>
            <Setter Property="BorderBrush" Value="#c2d5ea"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="BottomBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#f4f7fb"/>
            <Setter Property="BorderBrush" Value="#9bb5cf"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinWidth" Value="75"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title Text -->
            <RowDefinition Height="Auto"/> <!-- Sub Toolbar -->
            <RowDefinition Height="*"/>    <!-- Form Body -->
            <RowDefinition Height="Auto"/> <!-- Bottom Buttons -->
        </Grid.RowDefinitions>

        <!-- 1. Header Centered Title -->
        <Border Grid.Row="0" Background="Transparent" Padding="0,8,0,6">
            <TextBlock Text="Tăng giảm điểm" FontSize="14.5" FontWeight="Bold" Foreground="#112233" HorizontalAlignment="Center"/>
        </Border>

        <!-- 2. Sub Toolbar Ribbon -->
        <Border Grid.Row="1" Background="#eaf1fa" BorderBrush="#b6cadf" BorderThickness="0,1,0,1" Padding="6,3">
            <DockPanel LastChildFill="False">
                <Button x:Name="BtnPhimTat" Style="{StaticResource SubToolBtnStyle}" Click="BtnPhimTat_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="↗️" FontSize="11" Margin="0,0,3,0"/>
                        <TextBlock Text="Phím tắt ▾" FontSize="11"/>
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="CmPhimTat">
                            <MenuItem Header="Tạo mới (Ctrl+N)" Click="MiTaoMoi_Click"/>
                            <Separator/>
                            <MenuItem Header="Lưu (Ctrl+L)" Click="MiLuu_Click"/>
                            <MenuItem Header="Lưu &amp; Mới (Ctrl+S)" Click="MiLuuVaMoi_Click"/>
                            <MenuItem Header="Lưu &amp; Thoát (Enter)" Click="MiLuuVaThoat_Click"/>
                            <Separator/>
                            <MenuItem Header="Thoát (ESC)" Click="MiThoat_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <Button x:Name="BtnTruoc" Style="{StaticResource SubToolBtnStyle}" Click="BtnTruoc_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⬅️" FontSize="11" Margin="0,0,3,0"/>
                        <TextBlock Text="Trước (F10)" FontSize="11"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnSau" Style="{StaticResource SubToolBtnStyle}" Click="BtnSau_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➡️" FontSize="11" Margin="0,0,3,0"/>
                        <TextBlock Text="Sau (F11)" FontSize="11"/>
                    </StackPanel>
                </Button>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,0"/>

                <Button x:Name="BtnTaoMoi" Style="{StaticResource SubToolBtnStyle}" Click="BtnTaoMoi_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➕" Foreground="Green" FontSize="11" Margin="0,0,3,0"/>
                        <TextBlock Text="Tạo mới" FontSize="11"/>
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <!-- 3. Form Body -->
        <Grid Grid.Row="2" Margin="15,10,15,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/> <!-- Ngày & Số phiếu -->
                <RowDefinition Height="30"/> <!-- Khách hàng -->
                <RowDefinition Height="30"/> <!-- Điểm tăng & Điểm giảm -->
                <RowDefinition Height="30"/> <!-- Lý do -->
                <RowDefinition Height="*"/>  <!-- Ghi chú -->
            </Grid.RowDefinitions>

            <!-- Row 1: Ngày & Số phiếu -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="145"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Ngày" VerticalAlignment="Center"/>
                <DatePicker Grid.Column="1" x:Name="DpNgay" Height="24" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Column="3" Text="Số phiếu" VerticalAlignment="Center"/>
                <TextBox Grid.Column="4" x:Name="TxtSoPhieu" Height="24" VerticalContentAlignment="Center" Background="#e0f7fa" BorderBrush="#90caf9" Padding="4,0"/>
            </Grid>

            <!-- Row 2: Khách hàng -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Khách hàng" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" x:Name="CboKhachHang" Height="24" Background="#ffffcc" BorderBrush="#dcdcaa" IsEditable="True" SelectionChanged="CboKhachHang_SelectionChanged"/>
            </Grid>

            <!-- Row 3: Điểm tăng & Điểm giảm -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="145"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Điểm tăng" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="TxtDiemTang" Height="24" VerticalContentAlignment="Center" Text="0" Padding="4,0"/>

                <TextBlock Grid.Column="3" Text="Điểm giảm" VerticalAlignment="Center"/>
                <TextBox Grid.Column="4" x:Name="TxtDiemGiam" Height="24" VerticalContentAlignment="Center" Text="0" Padding="4,0"/>
            </Grid>

            <!-- Row 4: Lý do -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Lý do" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="TxtLyDo" Height="24" VerticalContentAlignment="Center" Background="#ffffcc" BorderBrush="#dcdcaa" Padding="4,0"/>
            </Grid>

            <!-- Row 5: Ghi chú -->
            <Grid Grid.Row="4" Margin="0,3,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Ghi chú" VerticalAlignment="Top" Margin="0,4,0,0"/>
                <TextBox Grid.Column="1" x:Name="TxtGhiChu" Background="White" BorderBrush="#b6cadf"
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="4"/>
            </Grid>
        </Grid>

        <!-- 4. Bottom Actions -->
        <Border Grid.Row="3" Background="#e2ecf8" BorderBrush="#b6cadf" BorderThickness="0,1,0,0" Padding="10,6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="BtnLuu" Style="{StaticResource BottomBtnStyle}" Click="BtnLuu_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💾" FontSize="11" Margin="0,0,4,0"/>
                        <TextBlock Text="Lưu"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnLuuVaMoi" Style="{StaticResource BottomBtnStyle}" Click="BtnLuuVaMoi_Click" Content="Lưu &amp; Mới"/>
                <Button x:Name="BtnLuuVaThoat" Style="{StaticResource BottomBtnStyle}" Click="BtnLuuVaThoat_Click" Content="Lưu &amp; thoát"/>
                <Button x:Name="BtnThoat" Style="{StaticResource BottomBtnStyle}" Click="BtnThoat_Click" Content="Thoát"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
