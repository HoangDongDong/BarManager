<UserControl x:Class="QuanLyBar.Client.Views.SuDungDichVuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200" Loaded="UserControl_Loaded">
             
    <Grid Background="#e5ecf3">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3.5*"/>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="2.5*"/>
        </Grid.ColumnDefinitions>

        <!-- ======================= CỘT TRÁI: KHU VỰC & BÀN ======================= -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="5">
            <ItemsControl x:Name="IcKhuVuc">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#b6c1cd" BorderThickness="1" Background="White" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Tiêu đề Khu vực -->
                                <Border Grid.Row="0" Background="#fef0cd" BorderBrush="#b6c1cd" BorderThickness="0,0,0,1" Padding="5">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#333"/>
                                </Border>
                                
                                <!-- Danh sách Bàn -->
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding BanList}" Margin="5">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="80" Height="90" Margin="5" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Ban_Click">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="60"/>
                                                        <RowDefinition Height="30"/>
                                                    </Grid.RowDefinitions>
                                                    <!-- Icon Bàn -->
                                                    <Border Grid.Row="0" Width="50" Height="50" Background="#4a4a4a" CornerRadius="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="Đĩa" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
                                                    </Border>
                                                    
                                                    <!-- Thời gian (Nếu có khách) -->
                                                    <Border Grid.Row="0" Background="Red" CornerRadius="3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-5,-5,0,0" Padding="3,1" Visibility="{Binding TimerVisibility}">
                                                        <TextBlock Text="{Binding TimerText}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                    </Border>
                                                    
                                                    <!-- Tên bàn -->
                                                    <TextBlock Grid.Row="1" Text="{Binding Name}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding ForegroundColor}"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ======================= CỘT GIỮA: ORDER CHI TIẾT ======================= -->
        <Border Grid.Column="1" BorderBrush="#b6c1cd" BorderThickness="1" Background="White" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Khung trên: Thông tin phiếu và Toolbar -->
                <Border Grid.Row="0" Margin="5" Background="#cbe8f6" Padding="5">
                    <StackPanel>
                        <!-- Dòng 1: Thời gian bắt đầu và Ngày -->
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <ComboBox Width="100" Margin="0,0,5,0" IsEditable="True" Text="__/__/____"/>
                                <Button Content="Bắt đầu" Width="70"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="Ngày" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <ComboBox Width="100" IsEditable="True" Text="__/__/____"/>
                            </StackPanel>
                        </Grid>

                        <!-- Dòng 2: Thời gian kết thúc, Số phiếu, Số khách -->
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <ComboBox Width="100" Margin="0,0,5,0" IsEditable="True" Text="__/__/____"/>
                                <TextBlock Text="0 phút" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="Số phiếu" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox Width="80" Margin="0,0,10,0"/>
                                <TextBlock Text="Số khách" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox Width="30" Text="0" TextAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <!-- Dòng 3: Khách hàng -->
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Khách hàng (F12)" VerticalAlignment="Center" Margin="0,0,5,0" Width="100"/>
                            <ComboBox Grid.Column="1"/>
                        </Grid>

                        <!-- Dòng 4: Toolbar các nút nhỏ -->
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Button Content="+" Width="24" Height="24" Margin="0,0,2,0"/>
                            <Button Content="-" Width="24" Height="24" Margin="0,0,2,0"/>
                            <Button Content="=" Width="24" Height="24" Margin="0,0,10,0"/>
                            <Button Content="Đặt sl" Background="Transparent" BorderThickness="0" Margin="0,0,10,0"/>
                            <Button Content="Đổi giá" Background="Transparent" BorderThickness="0" Margin="0,0,10,0"/>
                            <Button Content="Ghi chú" Background="Transparent" BorderThickness="0" Margin="0,0,10,0"/>
                            <Button Content="CK%" Background="Transparent" BorderThickness="0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- Khung giữa: Lưới các món -->
                <DataGrid x:Name="DgChiTiet" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="All" AlternatingRowBackground="#f9f9f9">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tên hàng" Binding="{Binding MatHangName}" Width="*"/>
                        <DataGridTextColumn Header="ĐVT" Binding="{Binding DonViTinh}" Width="50"/>
                        <DataGridTextColumn Header="SL" Binding="{Binding SoLuong}" Width="40"/>
                        <DataGridTextColumn Header="Đ.giá" Binding="{Binding DonGia, StringFormat={}{0:N0}}" Width="80"/>
                        <DataGridTextColumn Header="CK%" Binding="{Binding ChietKhauPhanTram}" Width="40"/>
                        <DataGridTextColumn Header="T.tiền" Binding="{Binding ThanhTien, StringFormat={}{0:N0}}" Width="80"/>
                        <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
                
                <!-- Khung dưới: Tab Tổng kết / Ghi chú / Dịch vụ -->
                <TabControl Grid.Row="2" Height="130" Margin="0,5,0,0">
                    <TabItem Header="Tổng">
                        <Grid Background="#cbe8f6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Tiền hàng" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding TienHang, StringFormat={}{0:N0}}" Background="#d6ebf5" BorderThickness="1" IsReadOnly="True" TextAlignment="Right" VerticalAlignment="Center" Margin="5"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Giảm giá" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="5">
                                <TextBox Width="40" Text="0" TextAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Text="%" VerticalAlignment="Center" Margin="5,0,5,0"/>
                                <TextBox Width="80" Text="{Binding GiamGia, StringFormat={}{0:N0}}" Background="#d6ebf5" BorderThickness="1" IsReadOnly="True" TextAlignment="Right" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Tổng cộng" FontWeight="Bold" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding TongCong, StringFormat={}{0:N0}}" Background="#fffdc2" BorderThickness="1" FontWeight="Bold" FontSize="16" Foreground="Red" IsReadOnly="True" TextAlignment="Right" VerticalAlignment="Center" Margin="5"/>
                        </Grid>
                    </TabItem>
                    
                    <TabItem Header="Ghi chú">
                        <TextBox AcceptsReturn="True" TextWrapping="Wrap" Margin="5"/>
                    </TabItem>
                    
                    <TabItem Header="Dịch vụ">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="#e5ecf3" Padding="5">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Refresh" Margin="0,0,10,0" Padding="5,2"/>
                                    <Button Content="Vào phòng" Padding="5,2"/>
                                </StackPanel>
                            </Border>
                            <DataGrid Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="All" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nội dung" Width="*"/>
                                    <DataGridTextColumn Header="Phòng" Width="100"/>
                                    <DataGridTextColumn Header="Số lần" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <!-- ======================= CỘT PHẢI: CHỨC NĂNG & THỰC ĐƠN ======================= -->
        <Grid Grid.Column="2" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Phím chức năng dọc -->
            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                <Button Height="45" Margin="0,0,0,5">
                    <TextBlock Text="Chuyển bàn" TextWrapping="Wrap" TextAlignment="Center" FontSize="11"/>
                </Button>
                <Button Content="Gộp bàn" Height="45" Margin="0,0,0,5" FontSize="11"/>
                <Button Content="Số lượng" Height="45" Margin="0,0,0,5" FontSize="11"/>
                <Button Content="&lt;&lt; Thêm" Height="30" Margin="0,0,0,2" FontSize="11"/>
                <Button Content="Giảm &gt;&gt;" Height="30" Margin="0,0,0,2" FontSize="11"/>
                <Button Content="X Xóa" Height="30" Margin="0,0,0,10" FontSize="11" Foreground="Red"/>
                
                <Button Height="45" Margin="0,0,0,5">
                    <TextBlock Text="% theo nhóm" TextWrapping="Wrap" TextAlignment="Center" FontSize="11"/>
                </Button>
                <Button Height="45" Margin="0,0,0,5">
                    <TextBlock Text="In chế biến (F10)" TextWrapping="Wrap" TextAlignment="Center" FontSize="11"/>
                </Button>
                <Button Height="45" Margin="0,0,0,5">
                    <TextBlock Text="Thanh toán (F11)" TextWrapping="Wrap" TextAlignment="Center" FontSize="11" FontWeight="Bold"/>
                </Button>
                <Button Height="45" Margin="0,0,0,5">
                    <TextBlock Text="Thống kê (F9)" TextWrapping="Wrap" TextAlignment="Center" FontSize="11"/>
                </Button>
            </StackPanel>
            
            <!-- Menu Thực đơn -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Grid Grid.Row="0" Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Tìm (F3):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Grid.Column="1" Height="22"/>
                </Grid>
                
                <TreeView x:Name="TvMenu" Grid.Row="1" Margin="0,0,0,5" SelectedItemChanged="TvMenu_SelectedItemChanged" BorderBrush="#b6c1cd" BorderThickness="1">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <!-- Giả lập Icon tạm thời bằng ký tự/Emoji, bạn có thể thay bằng Image bind từ SQL sau -->
                                <TextBlock Text="📁" Margin="0,0,5,0" Foreground="Orange"/>
                                <TextBlock Text="{Binding Name}"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                
                <DataGrid x:Name="DgMatHang" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="All" AlternatingRowBackground="#f9f9f9">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tên hàng" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="ĐVT" Binding="{Binding DonViTinh}" Width="50"/>
                        <DataGridTextColumn Header="Giá bán" Binding="{Binding GiaBan, StringFormat={}{0:N0}}" Width="80"/>
                        <DataGridTextColumn Header="Mã hàng" Binding="{Binding Code}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
