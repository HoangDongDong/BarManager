<UserControl x:Class="QuanLyBar.Client.Views.KhachDatHangControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuanLyBar.Client.Models"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1200" Loaded="UserControl_Loaded">
    
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <!-- Thanh công cụ (Toolbar) -->
        <Border Grid.Row="0" Background="#f0f0f0" BorderBrush="#d4d4d4" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                <TextBlock Text="Khách đặt hàng" FontWeight="Bold" Margin="0,0,20,0" VerticalAlignment="Center"/>
                <TextBlock Text="Lọc (F3): " VerticalAlignment="Center"/>
                <TextBox x:Name="TxtLocNhanh" Width="120" Height="22" Margin="0,0,10,0" TextChanged="TxtLocNhanh_TextChanged"/>
                
                <Button x:Name="BtnToolbarThemMoi" Content="➕ Thêm mới (Insert)" Margin="5,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnThemMoi_Click"/>
                <Button x:Name="BtnToolbarChinhSua" Content="📝 Chỉnh sửa (F4)" Margin="5,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnToolbarChinhSua_Click"/>
                <Button x:Name="BtnToolbarXoa" Content="❌ Xóa (Del)" Margin="5,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnToolbarXoa_Click"/>
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="5,0"/>
                <Button x:Name="BtnToolbarThemExcel" Content="📄 Thêm excel" Margin="5,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnToolbarThemExcel_Click"/>
                <Button x:Name="BtnToolbarXuatExcel" Content="📥 Xuất excel" Margin="5,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnToolbarXuatExcel_Click"/>
                <Button x:Name="BtnToolbarIn" Content="🖨 In" Margin="5,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnToolbarIn_Click"/>
                <ToggleButton x:Name="BtnToolbarTong" Margin="5,0" Cursor="Hand" Click="BtnToolbarTong_Click">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="4,2"/>
                            <Setter Property="Content">
                                <Setter.Value>
                                    <TextBlock Text="∑ Tổng"/>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Background" Value="#ffe58f"/>
                                    <Setter Property="BorderBrush" Value="#d48806"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <Button x:Name="BtnToolbarPhanTich" Content="📊 P.tích" Margin="5,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnToolbarPhanTich_Click"/>
            </StackPanel>
        </Border>

        <!-- Nội dung chính chia 2 cột -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Cột trái: Bộ lọc và Cây phương thức đặt -->
            <Border Grid.Column="0" BorderBrush="#d4d4d4" BorderThickness="0,0,1,0" Background="#f9f9f9">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Background="#e6f2fa" BorderBrush="#d4d4d4" BorderThickness="0,0,0,1" Padding="5">
                        <TextBlock x:Name="TxtTreeHeader" Text="Phương thức đặt" FontWeight="Bold"/>
                    </Border>
                    
                    <StackPanel Grid.Row="1" Margin="5">
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Số phiếu" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtSoPhieuLoc" Grid.Column="1" Height="22" KeyDown="TxtSoPhieuLoc_KeyDown" TextChanged="TxtSoPhieuLoc_TextChanged"/>
                        </Grid>
                        
                        <GroupBox Header="Ngày" Margin="0,0,0,5">
                            <StackPanel Margin="2">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Từ:" VerticalAlignment="Center"/>
                                    <DatePicker x:Name="DpTuNgay" Grid.Column="1"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Đến:" VerticalAlignment="Center"/>
                                    <DatePicker x:Name="DpDenNgay" Grid.Column="1"/>
                                </Grid>
                                <Button Content="Lọc dữ liệu" Margin="0,5,0,0" Click="BtnLocDuLieu_Click"/>
                            </StackPanel>
                        </GroupBox>
                        
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Khách hàng" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbKhachHang" Grid.Column="1" Height="22"
                                      SelectedValuePath="Id"
                                      SelectionChanged="CmbKhachHang_SelectionChanged"
                                      IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#eeeeee"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="22" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" BorderBrush="#d4d4d4" BorderThickness="0,0,1,0" Padding="4,2">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                            <Border Grid.Column="1" BorderBrush="#d4d4d4" BorderThickness="0,0,1,0" Padding="4,2">
                                                <TextBlock Text="{Binding Makhach}" TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                            <Border Grid.Column="2" BorderBrush="#d4d4d4" BorderThickness="0,0,1,0" Padding="4,2">
                                                <TextBlock Text="{Binding Diachi}" TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                            <Border Grid.Column="3" Padding="4,2">
                                                <TextBlock Text="{Binding Dienthoai}" TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        
                        <!-- Toolbar nhỏ cho Cây danh mục -->
                        <Border BorderBrush="#d4d4d4" BorderThickness="1" Background="#f0f0f0" Padding="2" Margin="0,0,0,5">
                            <StackPanel Orientation="Horizontal">
                                <Button Width="24" Height="24" Margin="2,0" Background="Transparent" BorderThickness="0" Click="BtnThemPhuongThuc_Click" ToolTip="Thêm mới">
                                    <TextBlock Text="➕" Foreground="Green" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Button>
                                <Button Width="24" Height="24" Margin="2,0" Background="Transparent" BorderThickness="0" Click="BtnSuaPhuongThuc_Click" ToolTip="Chỉnh sửa">
                                    <TextBlock Text="✏️" Foreground="Goldenrod" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Button>
                                <Button Width="24" Height="24" Margin="2,0" Background="Transparent" BorderThickness="0" Click="BtnThemThuMucPhuongThuc_Click" ToolTip="Thêm thư mục">
                                    <TextBlock Text="📁" Foreground="Goldenrod" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Button>
                                <ToggleButton x:Name="BtnModeSwitch" Width="36" Height="24" Margin="2,0" Background="Transparent" BorderThickness="0" ToolTip="Chọn chế độ" Click="BtnModeSwitch_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🗂️" Foreground="DarkGoldenrod" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Text="▼" FontSize="8" Margin="2,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <ToggleButton.ContextMenu>
                                        <ContextMenu x:Name="ModeContextMenu" Placement="Bottom">
                                            <MenuItem Header="Phương thức đặt" Click="MenuItemModePhuongThuc_Click"/>
                                            <MenuItem Header="Mục đích đặt" Click="MenuItemModeMucDich_Click"/>
                                        </ContextMenu>
                                    </ToggleButton.ContextMenu>
                                </ToggleButton>
                                <Button Width="24" Height="24" Margin="2,0" Background="Transparent" BorderThickness="0" Click="BtnRefreshPhuongThuc_Click" ToolTip="Làm mới">
                                    <TextBlock Text="🔄" Foreground="Blue" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    
                    <TreeView x:Name="TvCategoryTree" Grid.Row="2" BorderThickness="0" Margin="5" SelectedItemChanged="TvPhuongThucDat_SelectedItemChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="{x:Type TreeViewItem}">
                                <Setter Property="IsExpanded" Value="True"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type local:TreeCategoryViewModel}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Image Source="{Binding ImageSource}" Width="16" Height="16" Margin="0,0,5,0">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ImageSource}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <TextBlock VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="🏷️ "/>
                                                <Setter Property="Foreground" Value="#0078D7"/>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ImageSource}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Id}" Value="-1">
                                                        <Setter Property="Text" Value="🗑️ "/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Id}" Value="{x:Null}">
                                                        <Setter Property="Text" Value="📁 "/>
                                                        <Setter Property="Foreground" Value="Goldenrod"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                             VerticalAlignment="Center" 
                                             Loaded="InlineEditTextBox_Loaded"
                                             IsVisibleChanged="InlineEditTextBox_IsVisibleChanged" 
                                             LostFocus="InlineEditTextBox_LostFocus" 
                                             KeyDown="InlineEditTextBox_KeyDown"
                                             Tag="{Binding Id}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Thêm mới">
                                    <MenuItem Header="Thêm danh mục" Click="MenuItem_ThemPhuongThuc_Click">
                                        <MenuItem.Icon>
                                            <TextBlock Text="➕" Foreground="Green"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Thêm nhanh" Click="MenuItem_ThemNhanh_Click" />
                                    <Separator />
                                    <MenuItem Header="Thêm phân cách" Click="MenuItem_ThemPhanCach_Click" />
                                    <MenuItem Header="Thêm thư mục" Click="MenuItem_ThemThuMuc_Click">
                                        <MenuItem.Icon>
                                            <TextBlock Text="📁" Foreground="Goldenrod"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Thêm con" Click="MenuItem_ThemCon_Click" />
                                </MenuItem>
                                
                                <MenuItem Header="Thêm con">
                                    <MenuItem Header="Thêm danh mục" Click="MenuItem_ThemPhuongThucCon_Click">
                                        <MenuItem.Icon>
                                            <TextBlock Text="➕" Foreground="Green"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Thêm nhanh" Click="MenuItem_ThemNhanhCon_Click" />
                                    <Separator />
                                    <MenuItem Header="Thêm phân cách" Click="MenuItem_ThemPhanCachCon_Click" />
                                    <MenuItem Header="Thêm thư mục" Click="MenuItem_ThemThuMucCon_Click">
                                        <MenuItem.Icon>
                                            <TextBlock Text="📁" Foreground="Goldenrod"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </MenuItem>

                                <MenuItem Header="Chỉnh sửa" Click="BtnSuaPhuongThuc_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="✏️" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Sắp xếp theo">
                                    <MenuItem Header="Tên" />
                                    <MenuItem Header="Thứ tự tùy chọn" IsChecked="True" />
                                </MenuItem>
                                <MenuItem Header="Refresh" Click="BtnRefreshPhuongThuc_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="🔄" Foreground="Green" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Sao chép" />
                                <MenuItem Header="Mở rộng" />
                                <MenuItem Header="Thu gọn" />
                                <Separator />
                                <MenuItem Header="Xóa" Click="BtnXoaPhuongThuc_Click" />
                                <MenuItem Header="Đổi tên" Click="BtnDoiTenPhuongThuc_Click" />
                                <MenuItem Header="Thùng rác" Click="MenuItem_ThungRac_Click" />
                                <Separator />
                                <MenuItem Header="Biểu tượng" />
                                <MenuItem Header="Thuộc tính" />
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#e0e0e0"/>

            <!-- Cột phải: Lưới danh sách Phiếu đặt hàng -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="DgDatHang" Grid.Row="0" AutoGenerateColumns="False" 
                          CanUserAddRows="False" IsReadOnly="True" 
                          AlternatingRowBackground="#f9f9f9" GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#e0e0e0" VerticalGridLinesBrush="#e0e0e0"
                          SelectionChanged="DgDatHang_SelectionChanged"
                          MouseDoubleClick="DgDatHang_MouseDoubleClick">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="DataGridRow_PreviewMouseRightButtonDown"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.ContextMenu>
                        <ContextMenu x:Name="GridContextMenu" Opened="GridContextMenu_Opened">
                            <MenuItem x:Name="MenuKhoiPhuc" Header="Khôi phục" Click="MenuItem_KhoiPhuc_Click" Visibility="Collapsed">
                                <MenuItem.Icon>
                                    <TextBlock Text="↩️" Foreground="Green" FontWeight="Bold"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuThemMoi" Header="Thêm Đặt hàng" Click="BtnThemMoi_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="➕" Foreground="Green" FontWeight="Bold"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuThemNhanhExcel" Header="Thêm nhanh (excel)" Click="BtnToolbarThemExcel_Click"/>
                            <MenuItem x:Name="MenuCapNhatNhanhExcel" Header="Cập nhật nhanh (excel)" Click="BtnToolbarThemExcel_Click"/>
                            <MenuItem x:Name="MenuChinhSua" Header="Chỉnh sửa" Click="BtnToolbarChinhSua_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="✏️" Foreground="Goldenrod" FontWeight="Bold"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuLocCot" Header="Lọc Số phiếu" Click="MenuLocCot_Click"/>
                            
                            <MenuItem x:Name="MenuSapXep" Header="Sắp xếp theo">
                                <MenuItem Header="Sắp xếp tăng dần" Click="MenuItem_SortAsc_Click"/>
                                <MenuItem Header="Sắp xếp giảm dần" Click="MenuItem_SortDesc_Click"/>
                                <Separator/>
                                <MenuItem Header="Ngày" Click="MenuItem_SortByNgay_Click"/>
                                <MenuItem Header="Số phiếu" Click="MenuItem_SortBySoPhieu_Click"/>
                                <MenuItem Header="Tên khách" Click="MenuItem_SortByTenKhach_Click"/>
                                <MenuItem Header="Địa chỉ" Click="MenuItem_SortByDiaChi_Click"/>
                                <MenuItem Header="Điện thoại" Click="MenuItem_SortByDienThoai_Click"/>
                                <MenuItem Header="Email" Click="MenuItem_SortByEmail_Click"/>
                                <MenuItem Header="Tổng cộng" Click="MenuItem_SortByTongCong_Click"/>
                                <MenuItem Header="Phương thức đặt" Click="MenuItem_SortByPhuongThuc_Click"/>
                                <MenuItem Header="Mục đích đặt" Click="MenuItem_SortByMucDich_Click"/>
                                <MenuItem Header="Từ giờ" Click="MenuItem_SortByTuGio_Click"/>
                                <MenuItem Header="Đến giờ" Click="MenuItem_SortByDenGio_Click"/>
                                <MenuItem Header="Từ ngày" Click="MenuItem_SortByTuNgay_Click"/>
                                <MenuItem Header="Đến ngày" Click="MenuItem_SortByDenNgay_Click"/>
                            </MenuItem>
                            
                            <MenuItem x:Name="MenuRefresh" Header="Refresh" Click="BtnRefreshPhuongThuc_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="🔄" Foreground="Green" FontWeight="Bold"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuInDanhSach" Header="In danh sách" Click="BtnToolbarIn_Click"/>
                            <Separator x:Name="SepSaoChep"/>
                            <MenuItem x:Name="MenuSaoChepO" Header="Sao chép ô" Click="MenuItem_SaoChepO_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="📄" Foreground="Navy"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuSaoChepVungChon" Header="Sao chép vùng chọn" Click="MenuItem_SaoChepVungChon_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="📑" Foreground="Navy"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuXoa" Header="Xóa" Click="BtnToolbarXoa_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="❌" Foreground="Red" FontWeight="Bold"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator x:Name="SepTienIch"/>
                            <MenuItem x:Name="MenuTuDongGianCot" Header="Tự động giãn cột" Click="MenuItem_TuDongGianCot_Click"/>
                            <MenuItem x:Name="MenuCotHienThi" Header="Cột hiển thị" Click="MenuCotHienThi_Click"/>
                            <MenuItem x:Name="MenuThuocTinh" Header="Thuộc tính" Click="MenuItem_ThuocTinh_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="STT" Binding="{Binding Stt}" Width="40"/>
                        <DataGridTextColumn Header="Ngày" Binding="{Binding Ngay, StringFormat=dd/MM/yyyy}" Width="80"/>
                        <DataGridTextColumn Header="Số phiếu" Binding="{Binding SoPhieu}" Width="100" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Tên khách" Binding="{Binding TenKhach}" Width="150"/>
                        <DataGridTextColumn Header="Địa chỉ" Binding="{Binding DiaChi}" Width="150"/>
                        <DataGridTextColumn Header="Điện thoại" Binding="{Binding DienThoai}" Width="100"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="120"/>
                        <DataGridTextColumn Header="Tổng cộng" Binding="{Binding TongCong}" Width="90"/>
                        <DataGridTextColumn Header="Phương thức đặt" Binding="{Binding PhuongThucDatName}" Width="120"/>
                        <DataGridTextColumn Header="Mục đích đặt" Binding="{Binding MucDichDatName}" Width="100"/>
                        <DataGridTextColumn Header="Từ giờ" Binding="{Binding TuGio, StringFormat=HH:mm}" Width="60"/>
                        <DataGridTextColumn Header="Đến giờ" Binding="{Binding DenGio, StringFormat=HH:mm}" Width="60"/>
                        <DataGridTextColumn Header="Từ ngày" Binding="{Binding TuNgay, StringFormat=dd/MM/yyyy}" Width="80"/>
                        <DataGridTextColumn Header="Đến ngày" Binding="{Binding DenNgay, StringFormat=dd/MM/yyyy}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Footer TỔNG -->
                <Border x:Name="BorderTongFooter" Grid.Row="1" Background="#dbe7f7" BorderBrush="#a4b9d6" BorderThickness="0,1,0,0" Padding="15,4" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="TỔNG" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtTongCongFooter" Grid.Column="2" Text="0" IsReadOnly="True" FontWeight="Bold" FontSize="12" 
                                 TextAlignment="Right" Background="White" BorderBrush="#a4b9d6" Height="22" VerticalContentAlignment="Center" Padding="8,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        
        <!-- Grid Splitter ngang -->
        <GridSplitter Grid.Row="2" Height="3" HorizontalAlignment="Stretch" VerticalAlignment="Top" Background="#e0e0e0" Margin="0,-1.5,0,0" Panel.ZIndex="1"/>
        
        <!-- Khung dưới: Chi tiết đơn hàng -->
        <TabControl x:Name="TcBottomTabs" SelectedIndex="1" Grid.Row="2" Margin="0,3,0,0">
            <TabItem Header="Thông tin">
                <Grid Background="#f5f8fd" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock x:Name="TxtInfoKhoiTao" Text="Khởi tạo:" Grid.Row="0" Grid.Column="0" Margin="0,5"/>
                    <TextBlock x:Name="TxtInfoNguoiTao" Text="Khởi tạo bởi:" Grid.Row="0" Grid.Column="1" Margin="0,5"/>
                    <TextBlock x:Name="TxtInfoSuaDoi" Text="Sửa đổi gần nhất:" Grid.Row="1" Grid.Column="0" Margin="0,5"/>
                    <TextBlock x:Name="TxtInfoNguoiSua" Text="Sửa đổi bởi:" Grid.Row="1" Grid.Column="1" Margin="0,5"/>
                </Grid>
            </TabItem>
            <TabItem Header="Đặt hàng chi tiết">
                <DataGrid x:Name="DgDatHangChiTiet" AutoGenerateColumns="False" 
                          CanUserAddRows="False" IsReadOnly="True" 
                          AlternatingRowBackground="#e6f2fa" GridLinesVisibility="All">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="STT" Binding="{Binding Stt}" Width="40"/>
                        <DataGridTextColumn Header="Mặt hàng" Binding="{Binding MatHangName}" Width="150" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Đơn vị tính" Binding="{Binding DonViTinhName}" Width="80"/>
                        <DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong, StringFormat={}{0:N0}}" Width="80"/>
                        <DataGridTextColumn Header="Đơn giá" Binding="{Binding DonGia, StringFormat={}{0:N0}}" Width="100"/>
                        <DataGridTextColumn Header="Giảm giá %" Binding="{Binding GiamGiaPhanTram, StringFormat={}{0:N0}}" Width="80"/>
                        <DataGridTextColumn Header="Thành tiền" Binding="{Binding ThanhTien, StringFormat={}{0:N0}}" Width="100"/>
                        <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="*"/>
                        <DataGridTextColumn Header="Mã hàng" Binding="{Binding MaHang}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Hóa đơn nhà hàng"/>
            <TabItem Header="Phiếu thu"/>
            <TabItem Header="Phiếu thu công nợ"/>
        </TabControl>
    </Grid>
</UserControl>
