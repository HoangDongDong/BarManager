<Window x:Class="QuanLyBar.Client.Views.KhoHang.DanhMucKhoHangWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:QuanLyBar.Client.Services"
        Title="Kho hàng" Height="570" Width="470"
        WindowStartupLocation="CenterOwner"
        Background="#dbe6f3" WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <!-- Style Toolbar Button -->
        <Style x:Key="ToolbarBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#fff0b3"/>
                    <Setter Property="BorderBrush" Value="#f5a623"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Footer Button -->
        <Style x:Key="FooterBtnStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="78"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#a0b8d4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e6f0fa"/>
                    <Setter Property="BorderBrush" Value="#6495ed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0. Banner -->
            <RowDefinition Height="Auto"/> <!-- 1. Toolbar -->
            <RowDefinition Height="Auto"/> <!-- 2. Sub-bar Giá trị mặc định -->
            <RowDefinition Height="*"/>    <!-- 3. TreeView Kho hàng -->
            <RowDefinition Height="Auto"/> <!-- 4. Footer -->
        </Grid.RowDefinitions>

        <!-- 0. BANNER -->
        <Border Grid.Row="0" Background="White" BorderBrush="#cbd5e1" BorderThickness="0,0,0,1" Padding="14,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Custom Form/Pencil Icon -->
                <Viewbox Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Canvas Width="48" Height="48">
                        <!-- Sheet background -->
                        <Border Width="38" Height="38" Canvas.Left="4" Canvas.Top="4" Background="#ffffff" BorderBrush="#5d9cec" BorderThickness="2" CornerRadius="3">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <!-- Top blue band -->
                                <Border Grid.Row="0" Background="#70a3e8"/>
                                <!-- Grid layout lines -->
                                <Grid Grid.Row="1" Margin="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <Rectangle Height="2" Fill="#a0b8d4" Margin="0,1"/>
                                        <Rectangle Height="2" Fill="#a0b8d4" Margin="0,1"/>
                                        <Rectangle Height="2" Fill="#a0b8d4" Margin="0,1"/>
                                        <Rectangle Height="2" Fill="#a0b8d4" Margin="0,1"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Margin="3,1,1,1" BorderBrush="#c2d5ec" BorderThickness="1" Background="#f4f8fc"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 3D Yellow Pencil -->
                        <Canvas Canvas.Left="10" Canvas.Top="12">
                            <!-- Body -->
                            <Polygon Points="6,34 32,8 36,12 10,38" Fill="#f7b731" Stroke="#d69213" StrokeThickness="1"/>
                            <!-- Tip -->
                            <Polygon Points="6,34 10,38 2,42" Fill="#fed330"/>
                            <Polygon Points="2,42 4,40 3,37" Fill="#4b6584"/>
                            <!-- Eraser & metal collar -->
                            <Polygon Points="32,8 36,12 39,9 35,5" Fill="#d1d8e0" Stroke="#a5b1c2" StrokeThickness="0.8"/>
                            <Polygon Points="35,5 39,9 43,5 39,1" Fill="#fc5c65" Stroke="#eb3b5a" StrokeThickness="0.8"/>
                        </Canvas>
                    </Canvas>
                </Viewbox>

                <TextBlock Text="Cho phép bạn quản lý và chỉnh sửa danh mục kho hàng"
                           FontWeight="Bold" FontSize="12.5" Foreground="#111" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 1. TOOLBAR -->
        <Border Grid.Row="1" Background="#dbe6f3" BorderBrush="#a4bce3" BorderThickness="0,0,0,1" Padding="6,3">
            <StackPanel Orientation="Horizontal">
                <!-- Nút Thêm mới ▾ -->
                <Button x:Name="BtnThemMoi" Style="{StaticResource ToolbarBtnStyle}" Click="BtnThemMoi_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➕" Foreground="#27ae60" FontWeight="Bold" Margin="0,0,4,0"/>
                        <TextBlock Text="Thêm mới ▾" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="CmThemMoi">
                            <MenuItem Header="Thêm kho hàng" Click="MiThemKhoHang_Click"/>
                            <MenuItem Header="📁  Thêm thư mục" Click="MiThemThuMuc_Click"/>
                            <MenuItem Header="Thêm thư mục con" Click="MiThemThuMucCon_Click"/>
                            <Separator/>
                            <MenuItem Header="Thêm phân cách" Click="MiThemPhanCach_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <!-- Nút Xóa -->
                <Button x:Name="BtnXoa" Style="{StaticResource ToolbarBtnStyle}" Click="BtnXoa_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="❌" Foreground="#c0392b" FontWeight="Bold" Margin="0,0,4,0"/>
                        <TextBlock Text="Xóa" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <!-- Nút Chỉnh sửa -->
                <Button x:Name="BtnChinhSua" Style="{StaticResource ToolbarBtnStyle}" Click="BtnChinhSua_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✏️" Foreground="#d35400" Margin="0,0,4,0"/>
                        <TextBlock Text="Chỉnh sửa" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <!-- Nút Xem theo thư mục -->
                <Button x:Name="BtnXemTheoThuMuc" Style="{StaticResource ToolbarBtnStyle}"
                        ToolTip="Xem theo thư mục" Click="BtnXemTheoThuMuc_Click">
                    <TextBlock Text="🗂️" FontSize="13"/>
                </Button>

                <!-- Nút Thùng rác -->
                <Button x:Name="BtnThungRac" Style="{StaticResource ToolbarBtnStyle}"
                        ToolTip="Xem, khôi phục hoặc xóa vĩnh viễn dữ liệu bị xóa" Click="BtnThungRac_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗑️" Margin="0,0,4,0"/>
                        <TextBlock Text="Thùng rác" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- 2. GIÁ TRỊ MẶC ĐỊNH -->
        <Border Grid.Row="2" Background="#dbe6f3" Padding="14,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Giá trị mặc định:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"/>
                <ComboBox x:Name="CboKhoMacDinh" Width="220" Height="24" VerticalContentAlignment="Center"
                          SelectedValuePath="Id"
                          SelectionChanged="CboKhoMacDinh_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,1">
                                <Image Source="{Binding ImageSource}" Width="16" Height="16" Margin="2,0,6,0" VerticalAlignment="Center"
                                       Visibility="{Binding ImageSource, Converter={x:Static services:KhoHangVisibilityConverters.NotNullToVisibilityConverter}}"/>
                                <TextBlock Text="🔍" FontSize="11" Margin="2,0,6,0" VerticalAlignment="Center"
                                           Visibility="{Binding ImageSource, Converter={x:Static services:KhoHangVisibilityConverters.NullToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- 3. TREEVIEW KHO HÀNG -->
        <Border Grid.Row="3" Background="White" BorderBrush="#9ab5cf" BorderThickness="1" Margin="10,2,10,8">
            <TreeView x:Name="TvKhoHang" BorderThickness="0" Background="White"
                      SelectedItemChanged="TvKhoHang_SelectedItemChanged"
                      MouseDoubleClick="TvKhoHang_MouseDoubleClick">
                
                <TreeView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="➕  Thêm kho hàng" Click="MiThemKhoHang_Click"/>
                        <MenuItem Header="📁  Thêm thư mục" Click="MiThemThuMuc_Click"/>
                        <MenuItem Header="Thêm thư mục con" Click="MiThemThuMucCon_Click"/>
                        <Separator/>
                        <MenuItem Header="✏️  Chỉnh sửa" Click="BtnChinhSua_Click"/>
                        <MenuItem Header="❌  Xóa" Click="BtnXoa_Click"/>
                        <Separator/>
                        <MenuItem Header="Đổi tên" Click="MiDoiTen_Click"/>
                        <MenuItem Header="🔄  Làm mới" Click="MiLamMoi_Click"/>
                    </ContextMenu>
                </TreeView.ContextMenu>

                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type services:KhoHangTreeItem}" ItemsSource="{Binding Children}">
                        <Grid Margin="1,2">
                            <!-- Node phân cách -->
                            <Rectangle Height="1" Width="300" Fill="#cbd5e1" Margin="0,4"
                                       Visibility="{Binding IsSeparator, Converter={x:Static services:KhoHangVisibilityConverters.BooleanToVisibilityConverter}}"/>

                            <!-- Node kho hàng hoặc thư mục -->
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding IsSeparator, Converter={x:Static services:KhoHangVisibilityConverters.InverseBooleanToVisibilityConverter}}">
                                <TextBlock Text="...... " Foreground="#a0a0a0" VerticalAlignment="Center" Margin="0,0,2,0" FontSize="11"/>
                                <Image Source="{Binding ImageSource}" Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center"
                                       Visibility="{Binding ImageSource, Converter={x:Static services:KhoHangVisibilityConverters.NotNullToVisibilityConverter}}"/>
                                <Border Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center"
                                        Visibility="{Binding ImageSource, Converter={x:Static services:KhoHangVisibilityConverters.NullToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Icon}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>

                <TreeView.ItemContainerStyle>
                    <Style TargetType="{x:Type TreeViewItem}">
                        <Setter Property="IsExpanded" Value="True"/>
                        <Setter Property="Padding" Value="2,2"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#fff2b3"/>
                                <Setter Property="BorderBrush" Value="#f1a93b"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>
        </Border>

        <!-- 4. FOOTER -->
        <Border Grid.Row="4" Background="#dbe6f3" BorderBrush="#b6cadf" BorderThickness="0,1,0,0" Padding="10,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnThoat" Content="Thoát" Style="{StaticResource FooterBtnStyle}" Click="BtnThoat_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
