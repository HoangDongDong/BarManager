<Window x:Class="QuanLyBar.Client.Views.KhoHang.ThemKhoHangWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KHO HÀNG - THÊM MỚI" Height="400" Width="470"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#dbe6f3" WindowStyle="SingleBorderWindow"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Style Button Ribbon -->
        <Style x:Key="RibbonBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#d0e1f9"/>
                    <Setter Property="BorderBrush" Value="#90b8e8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Footer Button -->
        <Style x:Key="FooterBtnStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="78"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#a0b8d4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e6f0fa"/>
                    <Setter Property="BorderBrush" Value="#6495ed"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Banner -->
            <RowDefinition Height="Auto"/> <!-- Toolbar -->
            <RowDefinition Height="*"/>    <!-- Form fields -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- 1. BANNER (Nền kem, chữ Kho hàng) -->
        <Border Grid.Row="0" Background="#fffbe6" BorderBrush="#f0e6b2" BorderThickness="0,0,0,1" Padding="12,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🏠" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Kho hàng" FontWeight="Bold" FontSize="16" Foreground="#222" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 2. RIBBON TOOLBAR -->
        <Border Grid.Row="1" Background="#e2ecf7" BorderBrush="#b6cadf" BorderThickness="0,0,0,1" Padding="4,3">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <!-- Phím tắt ▾ -->
                    <Button x:Name="BtnPhimTat" Content="↗ Phím tắt ▾" Style="{StaticResource RibbonBtnStyle}" Click="BtnPhimTat_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Tạo mới (Ctrl+N)" Click="MiTaoMoi_Click"/>
                                <MenuItem Header="Lưu (Ctrl+L)" Click="MiLuu_Click"/>
                                <MenuItem Header="Lưu &amp; Mới (Ctrl+S)" Click="MiLuuVaMoi_Click"/>
                                <MenuItem Header="Lưu &amp; Thoát (Ctrl+Enter)" Click="MiLuuVaThoat_Click"/>
                                <Separator/>
                                <MenuItem Header="Trước (F10)" Click="BtnTruoc_Click"/>
                                <MenuItem Header="Sau (F11)" Click="BtnSau_Click"/>
                                <Separator/>
                                <MenuItem Header="Thoát (Esc)" Click="MiThoat_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button x:Name="BtnTruoc" Style="{StaticResource RibbonBtnStyle}" Click="BtnTruoc_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⬅ " Foreground="#0055aa"/>
                            <TextBlock Text="Trước (F10)"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnSau" Style="{StaticResource RibbonBtnStyle}" Click="BtnSau_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➡ " Foreground="#555"/>
                            <TextBlock Text="Sau (F11)"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnTaoMoi" Style="{StaticResource RibbonBtnStyle}" Click="BtnTaoMoi_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕ " Foreground="Green" FontWeight="Bold"/>
                            <TextBlock Text="Tạo mới"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 3. FORM FIELDS -->
        <Border Grid.Row="2" Background="#dbe6f3" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Tên kho hàng + Ảnh -->
                    <RowDefinition Height="Auto"/> <!-- Cửa hàng -->
                    <RowDefinition Height="Auto"/> <!-- Cho phép âm kho -->
                    <RowDefinition Height="*"/>    <!-- Ghi chú -->
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Tên kho hàng + Ảnh -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Tên kho hàng" VerticalAlignment="Center" Margin="0,0,8,8" FontSize="12"/>
                <TextBox x:Name="TxtTenKho" Grid.Row="0" Grid.Column="1" Height="24" Margin="0,0,8,8"
                         VerticalContentAlignment="Center" Padding="4,0" BorderBrush="#7192b8" BorderThickness="1"
                         Background="#e6f9ff" TextChanged="TxtTenKho_TextChanged"/>

                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                    <TextBlock Text="Ảnh:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                    <ComboBox x:Name="CboAnh" Width="55" Height="24" Background="White" BorderBrush="#9ab5cf"
                              SelectedValuePath="Id">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding ImageSource}" Width="16" Height="16" Stretch="Uniform"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Cửa hàng (Custom Dropdown with Popup) -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Cửa hàng" VerticalAlignment="Center" Margin="0,0,8,8" FontSize="12"/>
                <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="22"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtSelectedCuaHang" Grid.Column="0" Height="24" VerticalContentAlignment="Center"
                             Padding="4,0" Background="#f6fae8" BorderBrush="#9ab5cf" IsReadOnly="True"
                             Cursor="Hand" PreviewMouseDown="TxtSelectedCuaHang_PreviewMouseDown"/>
                    
                    <ToggleButton x:Name="BtnToggleCuaHang" Grid.Column="1" Height="24" Background="#f6fae8"
                                  BorderBrush="#9ab5cf" BorderThickness="0,1,1,1" Cursor="Hand">
                        <TextBlock Text="▾" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#444"/>
                    </ToggleButton>

                    <!-- Popup Cửa hàng -->
                    <Popup x:Name="PopupCuaHang" PlacementTarget="{Binding ElementName=TxtSelectedCuaHang}"
                           Placement="Bottom" StaysOpen="False"
                           IsOpen="{Binding ElementName=BtnToggleCuaHang, Path=IsChecked, Mode=TwoWay}"
                           AllowsTransparency="True">
                        <Border Width="230" Background="White" BorderBrush="#7192b8" BorderThickness="1" Margin="0,2,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" MaxHeight="180"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Danh sách cửa hàng -->
                                <ListBox x:Name="LstCuaHang" Grid.Row="0" BorderThickness="0" Background="White"
                                         SelectionChanged="LstCuaHang_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="2,3">
                                                <Image Source="{Binding ImageSource}" Width="16" Height="16" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Thanh công cụ dưới Popup: Thêm, Tải, Danh mục -->
                                <Border Grid.Row="1" Background="#f0f4f9" BorderBrush="#d0dbe5" BorderThickness="0,1,0,0" Padding="4,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnThemCuaHang" Grid.Column="0" Margin="1" Height="24" Background="White" 
                                                BorderBrush="#b8c8d8" Cursor="Hand" Click="BtnThemCuaHang_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="➕" Foreground="Green" FontSize="10" Margin="0,0,3,0"/>
                                                <TextBlock Text="Thêm" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnTaiCuaHang" Grid.Column="1" Margin="1" Height="24" Background="White" 
                                                BorderBrush="#b8c8d8" Cursor="Hand" Click="BtnTaiCuaHang_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🔄" Foreground="#0055aa" FontSize="10" Margin="0,0,3,0"/>
                                                <TextBlock Text="Tải" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnDanhMucCuaHang" Grid.Column="2" Margin="1" Height="24" Background="White" 
                                                BorderBrush="#b8c8d8" Cursor="Hand" Click="BtnDanhMucCuaHang_Click">
                                            <TextBlock Text="Danh mục" FontSize="10.5"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>

                <!-- Cho phép âm kho -->
                <CheckBox x:Name="ChkChoPhepAmKho" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                          Content="Cho phép âm kho" Margin="0,2,0,10" VerticalContentAlignment="Center" FontSize="12"/>

                <!-- Ghi chú -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Ghi chú" VerticalAlignment="Top" Margin="0,4,8,0" FontSize="12"/>
                <TextBox x:Name="TxtGhiChu" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         BorderBrush="#9ab5cf" Padding="4" Background="White"/>
            </Grid>
        </Border>

        <!-- 4. FOOTER BUTTONS -->
        <Border Grid.Row="3" Background="#dbe6f3" BorderBrush="#b6cadf" BorderThickness="0,1,0,0" Padding="10,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnLuu" Content="💾 Lưu" Style="{StaticResource FooterBtnStyle}" Click="BtnLuu_Click"/>
                <Button x:Name="BtnLuuVaMoi" Content="Lưu &amp; Mới" Style="{StaticResource FooterBtnStyle}" Click="BtnLuuVaMoi_Click"/>
                <Button x:Name="BtnLuuVaThoat" Content="Lưu &amp; thoát" Style="{StaticResource FooterBtnStyle}" Click="BtnLuuVaThoat_Click"/>
                <Button x:Name="BtnThoat" Content="Thoát" Style="{StaticResource FooterBtnStyle}" Click="BtnThoat_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
