<UserControl x:Class="QuanLyBar.Client.Views.TonQuy.TonQuyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             FontFamily="Segoe UI" FontSize="12" Background="#f0f4f8"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <!-- DataGrid Header Style -->
        <Style x:Key="TonQuyGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#eaf2f8"/>
            <Setter Property="Foreground" Value="#2c3e50"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#cbd5e1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <!-- TreeViewItem Style -->
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="ContextMenu" Value="{x:Null}"/>
        </Style>

        <!-- Summary Box Style -->
        <Style x:Key="SummaryValueBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#fffde0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#cbd5e1"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#1e293b"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Height" Value="24"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Banner / Description -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Filter Toolbar -->
            <RowDefinition Height="36"/>
            <!-- 2: Split Content (Tree + Grid) -->
            <RowDefinition Height="*"/>
            <!-- 3: Bottom Summary Bar -->
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>

        <!-- 0. Header Banner / Description -->
        <Border Grid.Row="0" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="0,0,0,1" Padding="10,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🪙" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="Tồn quỹ bao gồm tất cả thu, chi, thanh toán tiền mua hàng, thu tiền hóa đơn, đặt hàng..." 
                           FontWeight="Bold" FontSize="12" Foreground="#334155" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 1. Thanh Filter Toolbar -->
        <Border Grid.Row="1" Background="#dbe7f3" BorderBrush="#b6cadf" BorderThickness="0,0,0,1" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Từ:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,4,0" Foreground="#1e293b"/>
                    <DatePicker x:Name="DpTuNgay" Width="110" Height="24" Margin="0,0,8,0" SelectedDateChanged="Filter_Changed"/>

                    <TextBlock Text="Đến" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,4,0" Foreground="#1e293b"/>
                    <DatePicker x:Name="DpDenNgay" Width="110" Height="24" Margin="0,0,12,0" SelectedDateChanged="Filter_Changed"/>

                    <TextBlock Text="Cửa hàng:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0" Foreground="#1e293b"/>
                    <ComboBox x:Name="CboCuaHang" Width="170" Height="24" Margin="0,0,12,0"
                              SelectedValuePath="ID" SelectionChanged="Filter_Changed" Background="White">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2,1">
                                    <TextBlock Text="🏠" Margin="0,0,4,0" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding NAME}" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Nút Refresh bên phải -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnRefresh" Height="25" Padding="10,0" Background="#f8fafc" BorderBrush="#94a3b8"
                            Cursor="Hand" Click="BtnRefresh_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" Margin="0,0,4,0" FontSize="11" Foreground="#0284c7"/>
                            <TextBlock Text="Refresh" FontSize="11.5" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Nội dung chính: SplitView Cây Quỹ bên trái & Bảng giao dịch bên phải -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="150" MaxWidth="350"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Cây phân loại Quỹ bên trái -->
            <Border Grid.Column="0" Background="White" BorderBrush="#cbd5e1" BorderThickness="0,0,1,0">
                <TreeView x:Name="TvQuy" BorderThickness="0" SelectedItemChanged="TvQuy_SelectedItemChanged"
                          ContextMenu="{x:Null}" PreviewMouseRightButtonDown="TvQuy_PreviewMouseRightButtonDown">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="2,1">
                                <TextBlock Text="{Binding Icon}" Margin="0,0,4,0" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#dbe7f3"/>

            <!-- Bảng giao dịch bên phải -->
            <Grid Grid.Column="2">
                <DataGrid x:Name="DgGiaoDich" AutoGenerateColumns="False" CanUserAddRows="False"
                          IsReadOnly="True" GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#e2e8f0" VerticalGridLinesBrush="#e2e8f0"
                          ColumnHeaderStyle="{StaticResource TonQuyGridHeaderStyle}"
                          RowHeight="22" Background="White" AlternatingRowBackground="#f8fafc"
                          SelectionMode="Single" MouseDoubleClick="DgGiaoDich_MouseDoubleClick">

                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Xem chi tiết phiếu" Click="MenuXemChiTiet_Click">
                                <MenuItem.Icon><TextBlock Text="🔍"/></MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Sao chép ô" Click="MenuSaoChepO_Click">
                                <MenuItem.Icon><TextBlock Text="📋"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Sao chép dòng" Click="MenuSaoChepDong_Click">
                                <MenuItem.Icon><TextBlock Text="📑"/></MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Xuất dữ liệu Excel" Click="MenuXuatExcel_Click">
                                <MenuItem.Icon><TextBlock Text="📊"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="In danh sách" Click="MenuInDanhSach_Click">
                                <MenuItem.Icon><TextBlock Text="🖨"/></MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Refresh" Click="BtnRefresh_Click">
                                <MenuItem.Icon><TextBlock Text="🔄"/></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.Columns>
                        <!-- STT -->
                        <DataGridTextColumn Header="" Binding="{Binding Stt}" Width="35">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#64748b"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Số phiếu -->
                        <DataGridTextColumn Header="Số phiếu" Binding="{Binding SoPhieu}" Width="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#0369a1"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Ngày -->
                        <DataGridTextColumn Header="Ngày" Binding="{Binding NgayHienThi}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Diễn giải -->
                        <DataGridTextColumn Header="Diễn giải" Binding="{Binding DienGiai}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="6,0"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Thu -->
                        <DataGridTextColumn Header="Thu" Binding="{Binding ThuHienThi}" Width="160">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="6,0"/>
                                    <Setter Property="FontWeight" Value="Normal"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Chi -->
                        <DataGridTextColumn Header="Chi" Binding="{Binding ChiHienThi}" Width="160">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="6,0"/>
                                    <Setter Property="FontWeight" Value="Normal"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <!-- 3. Thanh Tổng kết dưới cùng (Bottom Summary Bar) -->
        <Border Grid.Row="3" Background="#dbe7f3" BorderBrush="#b6cadf" BorderThickness="0,1,0,0" Padding="12,4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <!-- Tồn đầu -->
                <StackPanel Width="120" Margin="0,0,12,0">
                    <TextBlock Text="Tồn đầu" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="#334155" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtTonDau" Style="{StaticResource SummaryValueBoxStyle}" Text="0"/>
                </StackPanel>

                <!-- Tổng thu -->
                <StackPanel Width="120" Margin="0,0,12,0">
                    <TextBlock Text="Tổng thu" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="#334155" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtTongThu" Style="{StaticResource SummaryValueBoxStyle}" Text="0"/>
                </StackPanel>

                <!-- Tổng chi -->
                <StackPanel Width="130" Margin="0,0,12,0">
                    <TextBlock Text="Tổng chi" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="#334155" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtTongChi" Style="{StaticResource SummaryValueBoxStyle}" Text="0"/>
                </StackPanel>

                <!-- Tồn quỹ -->
                <StackPanel Width="130" Margin="0,0,12,0">
                    <TextBlock Text="Tồn quỹ" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="#334155" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtTonQuy" Style="{StaticResource SummaryValueBoxStyle}" Text="0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
