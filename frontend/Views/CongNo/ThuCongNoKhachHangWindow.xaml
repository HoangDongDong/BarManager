<Window x:Class="QuanLyBar.Client.Views.CongNo.ThuCongNoKhachHangWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PHIẾU THU - THÊM MỚI" Height="580" Width="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#d2e1f2" Loaded="Window_Loaded">
    
    <Window.Resources>
        <Style x:Key="YellowFieldStyle" TargetType="Control">
            <Setter Property="Background" Value="#ffffcc"/>
            <Setter Property="BorderBrush" Value="#a4bce3"/>
        </Style>

        <Style x:Key="StandardFieldStyle" TargetType="Control">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#a4bce3"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#f4f8fc"/>
            <Setter Property="BorderBrush" Value="#95a5a6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#1e3f66"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#dfe9f5"/>
                    <Setter Property="BorderBrush" Value="#2980b9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12,10,12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER: [🔙 Phiếu thu] -->
        <Border Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#2980b9" CornerRadius="3" Width="30" Height="26" Margin="0,0,8,0">
                    <TextBlock Text="↩️" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Phiếu thu" FontWeight="Bold" FontSize="16" Foreground="#000000" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- FORM NHẬP LIỆU -->
        <Border Grid.Row="1" Background="#e2ecf8" BorderBrush="#b6cadf" BorderThickness="1" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Ngày & Số phiếu -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Ngày" VerticalAlignment="Center" FontSize="12"/>
                <Grid Grid.Row="0" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DatePicker x:Name="DpNgay" Grid.Column="0" Height="23" Background="White" BorderBrush="#a4bce3" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Số phiếu" VerticalAlignment="Center" Margin="15,0,8,0" FontSize="12"/>
                    <TextBox x:Name="TxtSoPhieu" Grid.Column="2" Height="23" Background="White" BorderBrush="#a4bce3" VerticalContentAlignment="Center" Padding="4,1"/>
                </Grid>

                <!-- Row 1: Phân loại -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Phân loại" VerticalAlignment="Center" FontSize="12"/>
                <ComboBox x:Name="CboPhanLoai" Grid.Row="1" Grid.Column="1" Height="23" Background="#ffffcc" BorderBrush="#a4bce3"
                          VerticalContentAlignment="Center" DisplayMemberPath="NAME" SelectedValuePath="ID" IsEditable="True"
                          SelectionChanged="CboPhanLoai_SelectionChanged"/>

                <!-- Row 2: Lý do thu -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Lý do thu" VerticalAlignment="Center" FontSize="12"/>
                <ComboBox x:Name="CboLyDoThu" Grid.Row="2" Grid.Column="1" Height="23" Background="#ffffcc" BorderBrush="#a4bce3"
                          VerticalContentAlignment="Center" DisplayMemberPath="NAME" SelectedValuePath="ID" IsEditable="True"/>

                <!-- Row 3: Chứng từ gốc & Loại đối tượng -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Chứng từ gốc" VerticalAlignment="Center" FontSize="12"/>
                <Grid Grid.Row="3" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtChungTuGoc" Grid.Column="0" Height="23" Background="White" BorderBrush="#a4bce3" VerticalContentAlignment="Center" Padding="4,1"/>
                    <TextBlock Grid.Column="1" Text="Loại đối tượng" VerticalAlignment="Center" Margin="15,0,8,0" FontSize="12"/>
                    <ComboBox x:Name="CboLoaiDoiTuong" Grid.Column="2" Height="23" Background="White" BorderBrush="#a4bce3" VerticalContentAlignment="Center"
                              SelectionChanged="CboLoaiDoiTuong_SelectionChanged">
                        <ComboBoxItem Content="Khách hàng" IsSelected="True"/>
                        <ComboBoxItem Content="Nhà cung cấp"/>
                        <ComboBoxItem Content="Nhân viên"/>
                        <ComboBoxItem Content="Khác"/>
                    </ComboBox>
                </Grid>

                <!-- Row 4: Tên đối tượng -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Tên đối tượng" VerticalAlignment="Center" FontSize="12"/>
                <TextBox x:Name="TxtTenDoiTuong" Grid.Row="4" Grid.Column="1" Height="23" Background="White" BorderBrush="#a4bce3" VerticalContentAlignment="Center" Padding="4,1"/>

                <!-- Row 5: Địa chỉ -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Địa chỉ" VerticalAlignment="Center" FontSize="12"/>
                <TextBox x:Name="TxtDiaChi" Grid.Row="5" Grid.Column="1" Height="23" Background="White" BorderBrush="#a4bce3" VerticalContentAlignment="Center" Padding="4,1"/>

                <!-- Row 6: Nhân viên -->
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Nhân viên" VerticalAlignment="Center" FontSize="12"/>
                <ComboBox x:Name="CboNhanVien" Grid.Row="6" Grid.Column="1" Height="23" Background="White" BorderBrush="#a4bce3"
                          VerticalContentAlignment="Center" DisplayMemberPath="NAME" SelectedValuePath="ID" IsEditable="True"/>

                <!-- Row 7: Khách hàng -->
                <TextBlock Grid.Row="7" Grid.Column="0" Text="Khách hàng" VerticalAlignment="Center" FontSize="12"/>
                <ComboBox x:Name="CboKhachHang" Grid.Row="7" Grid.Column="1" Height="23" Background="White" BorderBrush="#a4bce3"
                          VerticalContentAlignment="Center" DisplayMemberPath="NAME" SelectedValuePath="ID" IsEditable="True"
                          SelectionChanged="CboKhachHang_SelectionChanged"/>

                <!-- Row 8: Nhà cung cấp -->
                <TextBlock Grid.Row="8" Grid.Column="0" Text="Nhà cung cấp" VerticalAlignment="Center" FontSize="12"/>
                <ComboBox x:Name="CboNhaCungCap" Grid.Row="8" Grid.Column="1" Height="23" Background="White" BorderBrush="#a4bce3"
                          VerticalContentAlignment="Center" DisplayMemberPath="NAME" SelectedValuePath="ID" IsEditable="True" IsEnabled="False"/>

                <!-- Row 9: Số tiền -->
                <TextBlock Grid.Row="9" Grid.Column="0" Text="Số tiền:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtSoTien" Grid.Row="9" Grid.Column="1" Width="140" HorizontalAlignment="Left" Height="23" 
                         Background="#ffffcc" BorderBrush="#a4bce3" VerticalContentAlignment="Center" Padding="4,1"
                         FontWeight="Bold" TextChanged="TxtSoTien_TextChanged"/>

                <!-- Row 10: Chuyển vào tài khoản -->
                <Grid Grid.Row="10" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="ChkChuyenKhoan" Content="Chuyển vào tài khoản" VerticalAlignment="Center" Margin="0,0,10,0" Checked="ChkChuyenKhoan_Checked" Unchecked="ChkChuyenKhoan_Unchecked"/>
                    <ComboBox x:Name="CboTaiKhoanNganHang" Grid.Column="1" Height="23" Background="White" BorderBrush="#a4bce3"
                              VerticalContentAlignment="Center" DisplayMemberPath="NAME" SelectedValuePath="ID" IsEnabled="False"/>
                </Grid>

                <!-- Row 11: Cửa hàng -->
                <TextBlock Grid.Row="11" Grid.Column="0" Text="Cửa hàng" VerticalAlignment="Center" FontSize="12"/>
                <ComboBox x:Name="CboCuaHang" Grid.Row="11" Grid.Column="1" Height="23" Background="#ffffcc" BorderBrush="#a4bce3"
                          VerticalContentAlignment="Center" DisplayMemberPath="NAME" SelectedValuePath="ID"/>

                <!-- Row 12: Không thay đổi công nợ -->
                <CheckBox x:Name="ChkKhongThayDoiCongNo" Grid.Row="12" Grid.Column="1" Content="Không thay đổi công nợ" VerticalAlignment="Center"/>

                <!-- Row 13: Ghi chú -->
                <TextBlock Grid.Row="13" Grid.Column="0" Text="Ghi chú" VerticalAlignment="Center" FontSize="12"/>
                <TextBox x:Name="TxtGhiChu" Grid.Row="13" Grid.Column="1" Height="23" Background="White" BorderBrush="#a4bce3" VerticalContentAlignment="Center" Padding="4,1"/>
            </Grid>
        </Border>

        <!-- FOOTER BUTTONS -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Nhóm nút bên trái -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="BtnLuuVaIn" Style="{StaticResource ActionButtonStyle}" Click="BtnLuuVaIn_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🖨️" Margin="0,0,4,0"/>
                        <TextBlock Text="Lưu &amp; In"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnLuuVaXemIn" Style="{StaticResource ActionButtonStyle}" Click="BtnLuuVaXemIn_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍" Margin="0,0,4,0"/>
                        <TextBlock Text="Lưu &amp; Xem in"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Nhóm nút bên phải -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="BtnLuu" Style="{StaticResource ActionButtonStyle}" Click="BtnLuu_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💾" Margin="0,0,4,0"/>
                        <TextBlock Text="Lưu"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnLuuVaThoat" Style="{StaticResource ActionButtonStyle}" Click="BtnLuuVaThoat_Click">
                    <TextBlock Text="Lưu &amp; thoát"/>
                </Button>
                <Button x:Name="BtnThoat" Style="{StaticResource ActionButtonStyle}" Click="BtnThoat_Click">
                    <TextBlock Text="Thoát"/>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
