<Window x:Class="QuanLyBar.Client.Views.DuLieuBanDau.ChonKhoTonBanDauWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Chọn dữ liệu" Height="460" Width="400"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12"
        Background="#dce8f5" ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="DlgBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#f4f8fc"/>
            <Setter Property="BorderBrush" Value="#a0b8d4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#112233"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="14,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e0edfc"/>
                    <Setter Property="BorderBrush" Value="#0078d7"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#cfe2f8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- Header text -->
        <TextBlock Grid.Row="0" Text="MỜI BẠN CHỌN KHO" FontWeight="Bold" FontSize="13" Foreground="#0d2b45" Margin="0,0,0,8"/>

        <!-- Warehouse Tree/List Border -->
        <Border Grid.Row="1" Background="White" BorderBrush="#a4bce3" BorderThickness="1" Padding="4">
            <ListBox x:Name="LbKhoHang" BorderThickness="0" SelectionMode="Single"
                     MouseDoubleClick="LbKhoHang_MouseDoubleClick"
                     SelectionChanged="LbKhoHang_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="4,4"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1565c0"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📁" FontSize="13" Margin="4,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Bottom Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,8,0,0">
            <Button x:Name="BtnChapNhan" Content="✔ Chấp nhận" Style="{StaticResource DlgBtnStyle}" Margin="0,0,8,0" IsDefault="True" Click="BtnChapNhan_Click"/>
            <Button x:Name="BtnHuyBo" Content="✖ Hủy bỏ" Style="{StaticResource DlgBtnStyle}" IsCancel="True" Click="BtnHuyBo_Click"/>
        </StackPanel>
    </Grid>
</Window>
