<Window x:Class="QuanLyBar.Client.Views.DuLieuBanDau.TonKhoBanDauWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="⇄ TỒN KHO BAN ĐẦU" Height="650" Width="950"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12"
        Background="#dce8f5"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="HeaderBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#f4f8fc"/>
            <Setter Property="BorderBrush" Value="#a0b8d4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#112233"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e0edfc"/>
                    <Setter Property="BorderBrush" Value="#0078d7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BottomBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#f4f8fc"/>
            <Setter Property="BorderBrush" Value="#a0b8d4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#112233"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="16,2"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e0edfc"/>
                    <Setter Property="BorderBrush" Value="#0078d7"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#cfe2f8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 1: Controls Header -->
            <RowDefinition Height="Auto"/> <!-- Row 2: Filter & Excel buttons -->
            <RowDefinition Height="Auto"/> <!-- Row 3: Info Banner -->
            <RowDefinition Height="*"/>    <!-- Row 4: DataGrid -->
            <RowDefinition Height="42"/>   <!-- Row 5: Bottom Toolbar -->
        </Grid.RowDefinitions>

        <!-- ROW 1: TOP CONTROLS (Ngày chốt, Kho hàng, Tổng giá trị) -->
        <Border Grid.Row="0" Background="#f0f5fa" BorderBrush="#b6cadf" BorderThickness="1" Padding="8,5" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>

                <!-- Ngày chốt -->
                <TextBlock Grid.Column="0" Text="Ngày chốt:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#1e3f66" Margin="0,0,6,0"/>
                <DatePicker x:Name="DpNgayChot" Grid.Column="1" Height="24" VerticalContentAlignment="Center"/>

                <!-- Kho hàng -->
                <TextBlock Grid.Column="3" Text="Kho hàng:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#1e3f66" Margin="0,0,6,0"/>
                <ComboBox x:Name="CboKhoHang" Grid.Column="4" Height="24" Background="White"
                          DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectionChanged="CboKhoHang_SelectionChanged"/>

                <!-- Tổng giá trị -->
                <TextBlock Grid.Column="6" Text="Tổng giá trị:" VerticalAlignment="Center" FontWeight="Bold" FontSize="13" Foreground="#1e3f66" Margin="0,0,6,0"/>
                <Border Grid.Column="7" Background="#d4edda" BorderBrush="#c3e6cb" BorderThickness="1" Padding="6,2">
                    <TextBlock x:Name="TxtTongGiaTri" Text="0" FontWeight="Bold" FontSize="14" Foreground="#155724" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- ROW 2: SEARCH FILTER & EXCEL BUTTONS -->
        <Border Grid.Row="1" Background="#f0f5fa" BorderBrush="#b6cadf" BorderThickness="1" Padding="6,4" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Lọc mặt hàng (F3) -->
                <TextBlock Grid.Column="0" Text="Lọc mặt hàng (F3):" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#1e3f66" Margin="0,0,6,0"/>
                <TextBox x:Name="TxtTimKiem" Grid.Column="1" Height="22" VerticalContentAlignment="Center" Background="White"
                         TextChanged="TxtTimKiem_TextChanged" KeyDown="TxtTimKiem_KeyDown"/>

                <!-- Buttons Excel -->
                <Button Grid.Column="3" Style="{StaticResource HeaderBtnStyle}" Click="BtnImportExcel_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📊" Margin="0,0,4,0"/>
                        <TextBlock Text="Import từ excel" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="4" Style="{StaticResource HeaderBtnStyle}" Click="BtnExportExcel_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📑" Margin="0,0,4,0"/>
                        <TextBlock Text="Export file mẫu" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ROW 3: INFO BANNER -->
        <Border Grid.Row="2" Background="White" BorderBrush="#b6cadf" BorderThickness="1" Padding="8,6" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📦" FontSize="16" Margin="4,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="Cập nhật thông tin tồn kho ban đầu khi sử dụng phần mềm" FontWeight="Bold" FontSize="12.5" Foreground="#0d2b45" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ROW 4: MAIN DATAGRID -->
        <Border Grid.Row="3" Background="White" BorderBrush="#a4bce3" BorderThickness="1">
            <DataGrid x:Name="DgTonKhoBanDau"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#d8e3ed"
                      VerticalGridLinesBrush="#d8e3ed"
                      RowHeaderWidth="30"
                      RowHeight="24"
                      AlternatingRowBackground="#eef8ea"
                      SelectionUnit="FullRow"
                      SelectionMode="Single">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#f2f6fb"/>
                        <Setter Property="Foreground" Value="#15428b"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderBrush" Value="#b6cadf"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <!-- Mã sẵn có -->
                    <DataGridTextColumn Header="Mã sẵn có" Binding="{Binding MaSanCo}" Width="80" IsReadOnly="True"/>

                    <!-- Mã hàng -->
                    <DataGridTextColumn Header="Mã hàng" Binding="{Binding MaHang}" Width="100" IsReadOnly="True"/>

                    <!-- Tên hàng -->
                    <DataGridTextColumn Header="Tên hàng" Binding="{Binding TenHang}" Width="220" IsReadOnly="True" FontWeight="SemiBold"/>

                    <!-- ĐVT -->
                    <DataGridTextColumn Header="ĐVT" Binding="{Binding Dvt}" Width="70" IsReadOnly="True"/>

                    <!-- Tồn (Editable) -->
                    <DataGridTemplateColumn Header="Tồn" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TonFormatted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Ton, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                         HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                                         Loaded="EditableTextBox_Loaded"
                                         TextChanged="EditableTextBox_TextChanged"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <!-- Giá vốn (Editable) -->
                    <DataGridTemplateColumn Header="Giá vốn" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding GiaVonFormatted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding GiaVon, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                         HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                                         Loaded="EditableTextBox_Loaded"
                                         TextChanged="EditableTextBox_TextChanged"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <!-- Giá trị (Readonly) -->
                    <DataGridTemplateColumn Header="Giá trị" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding GiaTriFormatted}" HorizontalAlignment="Right" VerticalAlignment="Center" 
                                           FontWeight="SemiBold" Margin="0,0,6,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ROW 5: BOTTOM BAR (Tổng số lượng, Ghi dữ liệu, Thoát) -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Tổng số lượng -->
            <TextBlock x:Name="TxtTongSoLuong" Grid.Column="0" Text="Tổng số lượng: 0" FontWeight="SemiBold" FontSize="12.5" Foreground="#1e3f66" VerticalAlignment="Center"/>

            <!-- Buttons -->
            <Button Grid.Column="2" Content="Ghi dữ liệu" Style="{StaticResource BottomBtnStyle}" Click="BtnGhiDuLieu_Click"/>
            <Button Grid.Column="3" Content="Thoát" Style="{StaticResource BottomBtnStyle}" Click="BtnThoat_Click"/>
        </Grid>
    </Grid>
</Window>
