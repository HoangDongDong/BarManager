<Window x:Class="QuanLyBar.Client.Views.DuLieuBanDau.MappingTonKhoExcelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Thêm từ excel" Height="420" Width="430"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12"
        Background="#dce8f5" ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="DlgBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#f4f8fc"/>
            <Setter Property="BorderBrush" Value="#a0b8d4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#112233"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Padding" Value="12,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e0edfc"/>
                    <Setter Property="BorderBrush" Value="#0078d7"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#cfe2f8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#a4bce3" BorderThickness="1">
            <DataGrid x:Name="DgMapping"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#c8d8ea"
                      VerticalGridLinesBrush="#c8d8ea"
                      HeadersVisibility="Column"
                      Background="White"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      RowHeight="26">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#f2f6fb"/>
                        <Setter Property="Foreground" Value="#15428b"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderBrush" Value="#b6cadf"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="Height" Value="25"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Cột excel" Binding="{Binding ExcelColumn}" Width="160" IsReadOnly="True"/>

                    <DataGridTemplateColumn Header="Dữ liệu" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding AvailableFields}"
                                          SelectedItem="{Binding MappedField, UpdateSourceTrigger=PropertyChanged}"
                                          BorderThickness="1" BorderBrush="#a0b8d4" Background="White"
                                          Height="22" VerticalContentAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Tự động chọn cột" Style="{StaticResource DlgBtnStyle}" Click="BtnTuDongChon_Click"/>

            <Button Grid.Column="2" Content="OK" Style="{StaticResource DlgBtnStyle}" Width="75" Margin="0,0,8,0" IsDefault="True" Click="BtnOk_Click"/>
            <Button Grid.Column="3" Content="Cancel" Style="{StaticResource DlgBtnStyle}" Width="75" IsCancel="True" Click="BtnCancel_Click"/>
        </Grid>
    </Grid>
</Window>
