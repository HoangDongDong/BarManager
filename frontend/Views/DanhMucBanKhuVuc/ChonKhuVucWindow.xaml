<Window x:Class="QuanLyBar.Client.Views.ChonKhuVucWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:QuanLyBar.Client.Models"
        Title="Chọn dữ liệu" Height="450" Width="400"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Mời bạn chọn Khu vực" FontWeight="Bold" Margin="0,0,0,10" Grid.Row="0"/>
        
        <TreeView x:Name="TvKhuVuc" Grid.Row="1" BorderBrush="LightGray" BorderThickness="1">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type models:KhuVucViewModel}" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="📁 " Foreground="Goldenrod" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
            <TreeView.ItemContainerStyle>
                <Style TargetType="{x:Type TreeViewItem}">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded}"/>
                </Style>
            </TreeView.ItemContainerStyle>
        </TreeView>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button Content="✔️ Chấp nhận" Width="100" Margin="0,0,10,0" Padding="5" Click="BtnChapNhan_Click"/>
            <Button Content="❌ Hủy bỏ" Width="100" Padding="5" Click="BtnHuyBo_Click"/>
        </StackPanel>
    </Grid>
</Window>
