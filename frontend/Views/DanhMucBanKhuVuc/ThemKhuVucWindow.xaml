<Window x:Class="QuanLyBar.Client.Views.ThemKhuVucWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KHU VỰC - SỬA" Height="360" Width="520"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#dce8f5" KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style TargetType="Button" x:Key="FlatToolBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#cfe0f2"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#8baecc"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#b8d2eb"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="BottomBtn">
            <Setter Property="Background" Value="#f4f7fc"/>
            <Setter Property="BorderBrush" Value="#a2b8cc"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#e2edf8"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#6292c2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#cce0f5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Banner -->
        <Border Grid.Row="0" Background="#fdfde4" BorderBrush="#e2dba0" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtHeaderIcon" Text="📝" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="TxtHeaderTitle" Text="Khu vực" FontSize="15" FontWeight="Bold" Foreground="#112233" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 2. ToolBar -->
        <Border Grid.Row="1" Background="#e4edf7" BorderBrush="#b0c2d6" BorderThickness="0,0,0,1" Padding="6,3">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Dropdown Phím tắt -->
                <Border BorderBrush="#a4b8cc" BorderThickness="1" CornerRadius="2" Background="#f4f8fc" Margin="0,0,4,0">
                    <Menu Background="Transparent">
                        <MenuItem Padding="5,2" Cursor="Hand">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="13" Height="13" BorderBrush="#0055aa" BorderThickness="1.2" CornerRadius="1.5" Background="White" Margin="0,0,4,0" VerticalAlignment="Center">
                                        <Path Data="M 2,7 L 7,2 M 4,2 L 7,2 L 7,5" Stroke="#0055aa" StrokeThickness="1.2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Phím tắt" VerticalAlignment="Center" Foreground="#112233" FontSize="12"/>
                                    <Path Data="M 0,0 L 3.5,4 L 7,0 Z" Fill="#556677" VerticalAlignment="Center" Margin="5,2,0,0"/>
                                </StackPanel>
                            </MenuItem.Header>
                            <MenuItem Header="Tạo mới" InputGestureText="(Ctrl+N)" Click="MenuTaoMoi_Click">
                                <MenuItem.Icon><TextBlock Text="➕" Foreground="Green"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Sao chép" InputGestureText="(Alt+C)" Click="MenuSaoChep_Click">
                                <MenuItem.Icon><TextBlock Text="📄" Foreground="#0055aa"/></MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Lưu" InputGestureText="(Ctrl+L)" Click="BtnLuu_Click">
                                <MenuItem.Icon><TextBlock Text="💾"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Lưu &amp; Mới" InputGestureText="(Ctrl+S)" Click="BtnLuuVaMoi_Click"/>
                            <MenuItem Header="Lưu &amp; Thoát" InputGestureText="(Enter)" Click="BtnLuuVaThoat_Click"/>
                            <Separator/>
                            <MenuItem Header="Thoát" InputGestureText="(ESC)" Click="BtnThoat_Click">
                                <MenuItem.Icon><TextBlock Text="❌" Foreground="Red"/></MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>
                    </Menu>
                </Border>

                <Separator Width="1" Height="18" Background="#b8c8d8" Margin="4,0"/>

                <!-- Nút Trước (F10) -->
                <Button x:Name="BtnTruoc" Style="{StaticResource FlatToolBtn}" Click="BtnTruoc_Click" ToolTip="Khu vực trước (F10)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 7,0 L 0,4.5 L 7,9 L 7,6 L 12,6 L 12,3 L 7,3 Z" Fill="#1b72cc" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Trước (F10)" VerticalAlignment="Center" Foreground="#112233" FontSize="12"/>
                    </StackPanel>
                </Button>

                <!-- Nút Sau (F11) -->
                <Button x:Name="BtnSau" Style="{StaticResource FlatToolBtn}" Click="BtnSau_Click" Margin="3,0,0,0" ToolTip="Khu vực kế tiếp (F11)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 5,0 L 12,4.5 L 5,9 L 5,6 L 0,6 L 0,3 L 5,3 Z" Fill="#1b72cc" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Sau (F11)" VerticalAlignment="Center" Foreground="#112233" FontSize="12"/>
                    </StackPanel>
                </Button>

                <Separator Width="1" Height="18" Background="#b8c8d8" Margin="4,0"/>

                <!-- Nút Tạo mới -->
                <Button x:Name="BtnTaoMoi" Style="{StaticResource FlatToolBtn}" Click="MenuTaoMoi_Click" ToolTip="Tạo mới (Ctrl+N)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center">
                            <Path Data="M 1,1 L 8,1 L 11,4 L 11,13 L 1,13 Z" Fill="White" Stroke="#3a70a8" StrokeThickness="1"/>
                            <Ellipse Width="8" Height="8" Fill="#28a745" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2"/>
                            <Path Data="M 2,4 L 6,4 M 4,2 L 4,6" Stroke="White" StrokeThickness="1.2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2" Width="8" Height="8"/>
                        </Grid>
                        <TextBlock Text="Tạo mới" VerticalAlignment="Center" Foreground="#112233" FontSize="12"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- 3. Form Body -->
        <Grid Grid.Row="2" Margin="14,14,14,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="34"/>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tên khu vực -->
            <TextBlock Text="Tên khu vực" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBox x:Name="TxtTenKhuVuc" Grid.Column="1" Height="25" VerticalContentAlignment="Center" Padding="4,0" 
                     Background="White" BorderBrush="#3399ff" BorderThickness="1.5"
                     GotFocus="TxtTenKhuVuc_GotFocus"/>

            <!-- Ảnh -->
            <TextBlock Text="Ảnh:" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0"/>
            <ComboBox x:Name="CboAnh" Grid.Column="3" Height="25" VerticalContentAlignment="Center" Background="White" BorderBrush="#a4b8cc">
                <ComboBoxItem Content="🏢" Tag="building" IsSelected="True"/>
                <ComboBoxItem Content="🏷️" Tag="tag"/>
                <ComboBoxItem Content="📁" Tag="folder"/>
                <ComboBoxItem Content="🏠" Tag="house"/>
                <ComboBoxItem Content="🍺" Tag="beer"/>
                <ComboBoxItem Content="🍹" Tag="cocktail"/>
                <ComboBoxItem Content="🍷" Tag="wine"/>
                <ComboBoxItem Content="☕" Tag="coffee"/>
                <ComboBoxItem Content="🏖️" Tag="beach"/>
                <ComboBoxItem Content="🌟" Tag="star"/>
            </ComboBox>

            <!-- Tab hiển thị -->
            <TextBlock Text="Tab hiển thị" Grid.Row="1" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" VerticalAlignment="Center">
                <RadioButton x:Name="RbTabPhiaTren" Content="Tab phía trên" IsChecked="True" Margin="0,0,30,0" VerticalAlignment="Center"/>
                <RadioButton x:Name="RbTabPhiaDuoi" Content="Tab phía dưới" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Ghi chú -->
            <TextBlock Text="Ghi chú" Grid.Row="2" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBox x:Name="TxtGhiChu" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Height="25" 
                     VerticalContentAlignment="Center" Padding="4,0" Background="White" BorderBrush="#a4b8cc"/>
        </Grid>

        <!-- 4. Footer Buttons -->
        <Border Grid.Row="3" Background="#dce8f5" BorderBrush="#b5c4d4" BorderThickness="0,1,0,0" Padding="12,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnLuu" Content="💾 Lưu" Style="{StaticResource BottomBtn}" Width="85" Margin="0,0,8,0" Click="BtnLuu_Click"/>
                <Button x:Name="BtnLuuVaMoi" Content="Lưu &amp; Mới" Style="{StaticResource BottomBtn}" Width="90" Margin="0,0,8,0" Click="BtnLuuVaMoi_Click"/>
                <Button x:Name="BtnLuuVaThoat" Content="Lưu &amp; thoát" Style="{StaticResource BottomBtn}" Width="95" Margin="0,0,8,0" Click="BtnLuuVaThoat_Click"/>
                <Button x:Name="BtnThoat" Content="Thoát" Style="{StaticResource BottomBtn}" Width="80" IsCancel="True" Click="BtnThoat_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
