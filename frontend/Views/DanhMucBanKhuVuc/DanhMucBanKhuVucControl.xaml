<UserControl x:Class="QuanLyBar.Client.Views.DanhMucBanKhuVucControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000" Loaded="UserControl_Loaded">
    
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Thanh công cụ (Toolbar) -->
        <Border Grid.Row="0" Background="#f0f0f0" BorderBrush="#d4d4d4" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                <TextBlock Text="Lọc (F3): " VerticalAlignment="Center"/>
                <TextBox x:Name="TxtLocBan" Width="150" Height="22" Margin="0,0,10,0" TextChanged="TxtLocBan_TextChanged"/>
                
                <Button x:Name="BtnToolbarThemMoi" Content="➕ Thêm mới (Insert)" Margin="5,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnThemMoiBan_Click"/>
                <Button x:Name="BtnToolbarChinhSua" Content="📝 Chỉnh sửa (F4)" Margin="5,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnSuaBan_Click"/>
                <Button x:Name="BtnToolbarXoa" Content="❌ Xóa (Del)" Margin="5,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnXoaBan_Click"/>
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="5,0"/>
                <Button x:Name="BtnToolbarThemNhanh" Content="➕ Thêm nhanh" Margin="5,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnThemNhanhBan_Click"/>
                <Button x:Name="BtnToolbarThemExcel" Content="📄 Thêm excel" Margin="5,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnThemBanExcel_Click"/>
                <Button Content="📥 Xuất excel" Margin="5,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnXuatExcel_Click"/>
                <Button Content="🖨 In" Margin="5,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnIn_Click"/>
                <Button Content="∑ Tổng" Margin="5,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnTong_Click"/>
            </StackPanel>
        </Border>

        <!-- Nội dung chính chia 2 cột -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Cột trái: Cây khu vực -->
            <Border Grid.Column="0" BorderBrush="#d4d4d4" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Background="#e6f2fa" BorderBrush="#d4d4d4" BorderThickness="0,0,0,1" Padding="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Khu vực" FontWeight="Bold" VerticalAlignment="Center"/>
                            <ToolBar Grid.Column="1" Background="Transparent" Padding="0" Margin="0,-3,0,-3">
                                <Button ToolTip="Thêm mới Khu vực" Padding="2" Click="BtnThemKhuVuc_Click">
                                    <TextBlock Text="➕" Foreground="Green"/>
                                </Button>
                                <Button ToolTip="Sửa Khu vực" Padding="2" Click="BtnSuaKhuVuc_Click">
                                    <TextBlock Text="✏️"/>
                                </Button>
                                <Button ToolTip="Xóa Khu vực" Padding="2" Click="BtnXoaKhuVuc_Click">
                                    <TextBlock Text="❌" Foreground="Red"/>
                                </Button>
                                <Button ToolTip="Tạo mới thư mục" Padding="2" Click="BtnThemThuMucKhuVuc_Click">
                                    <TextBlock Text="📁"/>
                                </Button>
                                <Button ToolTip="Hiển thị tất cả dữ liệu theo thư mục" Padding="2" Click="BtnHienThiTatCa_Click">
                                    <TextBlock Text="🗂️"/>
                                </Button>
                                <Button ToolTip="Tải lại" Padding="2" Click="BtnTaiLaiKhuVuc_Click">
                                    <TextBlock Text="🔄"/>
                                </Button>
                            </ToolBar>
                        </Grid>
                    </Border>
                    
                    <TreeView x:Name="TvKhuVuc" Grid.Row="1" BorderThickness="0" Margin="5" SelectedItemChanged="TvKhuVuc_SelectedItemChanged">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Thêm mới" Click="MenuItem_ThemMoiKhuVuc_Click" />
                                            <MenuItem Header="Thêm mới con" Click="MenuItem_ThemMoiConKhuVuc_Click" />
                                            <Separator />
                                            <MenuItem Header="Sửa đổi" Click="MenuItem_SuaDoiKhuVuc_Click" />
                                            <MenuItem Header="Xóa" Click="MenuItem_XoaKhuVuc_Click" />
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                    <Image Source="{Binding ImageSource}" Width="16" Height="16" Margin="0,0,5,0">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ImageSource}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <TextBlock Text="📁 " Foreground="Goldenrod" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ImageSource}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                             VerticalAlignment="Center" 
                                             Loaded="InlineEditTextBox_Loaded"
                                             IsVisibleChanged="InlineEditTextBox_IsVisibleChanged" 
                                             LostFocus="InlineEditTextBox_LostFocus" 
                                             KeyDown="InlineEditTextBox_KeyDown"
                                             Tag="{Binding Id}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="{x:Type TreeViewItem}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Thêm mới">
                                    <MenuItem Header="Thêm khu vực" Click="BtnThemKhuVuc_Click">
                                        <MenuItem.Icon>
                                            <TextBlock Text="➕" Foreground="Green"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Thêm nhanh" />
                                    <Separator />
                                    <MenuItem Header="Thêm phân cách" />
                                    <MenuItem Header="Thêm thư mục" Click="BtnThemThuMucKhuVuc_Click">
                                        <MenuItem.Icon>
                                            <TextBlock Text="📁" Foreground="Goldenrod"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Thêm con" />
                                </MenuItem>
                                <MenuItem Header="Chỉnh sửa" Click="BtnSuaKhuVuc_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="✏️" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Sắp xếp theo">
                                    <MenuItem Header="Tên" />
                                    <MenuItem Header="Thứ tự tùy chọn" IsChecked="True" />
                                </MenuItem>
                                <MenuItem Header="Refresh" Click="BtnTaiLaiKhuVuc_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="🔄" Foreground="Green" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Sao chép" />
                                <MenuItem Header="Mở rộng" />
                                <MenuItem Header="Thu gọn" />
                                <Separator />
                                <MenuItem Header="Xóa" Click="MenuItem_Placeholder_Click" />
                                <MenuItem Header="Đổi tên" Click="MenuItem_DoiTenKhuVuc_Click" />
                                <MenuItem Header="Thùng rác" Click="MenuItem_Placeholder_Click" />
                                <Separator />
                                <MenuItem Header="Biểu tượng" Click="MenuItem_BieuTuongKhuVuc_Click" />
                                <MenuItem Header="Thuộc tính" Click="MenuItem_Placeholder_Click" />
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>
                </Grid>
            </Border>

            <!-- Splitter để kéo thả thay đổi kích thước cột -->
            <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#e0e0e0"/>

            <!-- Cột phải: Lưới danh sách Bàn & Chi tiết bên dưới -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="200" MinHeight="100"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="DgBan" Grid.Row="0" AutoGenerateColumns="False" 
                          CanUserAddRows="False" IsReadOnly="True" 
                          SelectionMode="Extended"
                          KeyDown="DgBan_KeyDown"
                          SelectionChanged="DgBan_SelectionChanged"
                          AlternatingRowBackground="#f2f7fc" GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#e0e0e0" VerticalGridLinesBrush="#e0e0e0">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="DataGridRow_PreviewMouseRightButtonDown"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.ContextMenu>
                        <ContextMenu x:Name="GridContextMenu" Opened="GridContextMenu_Opened">
                            <!-- Items khi trong Thùng rác -->
                            <MenuItem x:Name="MenuKhoiPhuc" Header="Khôi phục" Click="MenuItem_KhoiPhuc_Click" Visibility="Collapsed">
                                <MenuItem.Icon>
                                    <TextBlock Text="↩️" Foreground="Green" FontWeight="Bold"/>
                                </MenuItem.Icon>
                            </MenuItem>

                            <!-- Items khi ở danh mục bình thường -->
                            <MenuItem x:Name="MenuThemBan" Header="Thêm Bàn" Click="BtnThemMoiBan_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="➕" Foreground="Green" FontWeight="Bold"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuThemNhanhExcel" Header="Thêm nhanh (excel)" Click="BtnThemBanExcel_Click"/>
                            <MenuItem x:Name="MenuCapNhatNhanhExcel" Header="Cập nhật nhanh (excel)" Click="BtnThemBanExcel_Click"/>
                            <MenuItem x:Name="MenuChinhSua" Header="Chỉnh sửa" Click="BtnSuaBan_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="✏️" Foreground="#c07000"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator x:Name="SepDatLoc"/>
                            <MenuItem x:Name="MenuDatCot" Header="Đặt Tên bàn"/>
                            <MenuItem x:Name="MenuLocCot" Header="Lọc Tên bàn"/>
                            <Separator x:Name="SepSapXep"/>
                            
                            <!-- Submenu Sắp xếp (Dùng chung cho cả bình thường và thùng rác) -->
                            <MenuItem x:Name="MenuSapXep" Header="Sắp xếp">
                                <MenuItem Header="Sắp xếp tăng dần" Click="MenuItem_SortAsc_Click"/>
                                <MenuItem Header="Sắp xếp giảm dần" Click="MenuItem_SortDesc_Click"/>
                                <Separator/>
                                <MenuItem Header="Tên bàn" Click="MenuItem_SortByName_Click"/>
                                <MenuItem Header="Ghi chú" Click="MenuItem_SortByNote_Click"/>
                                <MenuItem Header="Khu vực" Click="MenuItem_SortByKhuVuc_Click"/>
                                <MenuItem Header="Nhóm hiển thị" Click="MenuItem_SortByNhomHienThi_Click"/>
                                <MenuItem Header="Loại phòng" Click="MenuItem_SortByLoaiPhong_Click"/>
                                <MenuItem Header="Đơn giá" Click="MenuItem_SortByDonGia_Click"/>
                            </MenuItem>
                            
                            <MenuItem x:Name="MenuRefresh" Header="Refresh" Click="BtnTaiLaiKhuVuc_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="🔄" Foreground="Green" FontWeight="Bold"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuInDanhSach" Header="In danh sách" Click="BtnIn_Click"/>
                            <Separator x:Name="SepSaoChep"/>
                            <MenuItem x:Name="MenuSaoChep" Header="Sao chép" Click="MenuItem_SaoChepOClick">
                                <MenuItem.Icon>
                                    <TextBlock Text="📄" Foreground="Navy"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuSaoChepVungChon" Header="Sao chép vùng chọn" Click="MenuItem_SaoChepVungChon_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="📑" Foreground="Navy"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator x:Name="SepXoa"/>
                            <MenuItem x:Name="MenuXoa" Header="Xóa" Click="BtnXoaBan_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="❌" Foreground="Red"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator x:Name="SepKhac"/>
                            <MenuItem x:Name="MenuTuDongGianCot" Header="Tự động giãn cột" Click="MenuItem_TuDongGianCot_Click"/>
                            <MenuItem x:Name="MenuCotHienThi" Header="Cột hiển thị" Click="MenuCotHienThi_Click"/>
                            <MenuItem x:Name="MenuThuocTinh" Header="Thuộc tính" Click="MenuItem_ThuocTinh_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="ColStt" Header="STT" Binding="{Binding Stt, StringFormat={}{0:D2}}" Width="50"/>
                        <DataGridTextColumn x:Name="ColTenBan" Header="Tên bàn" Binding="{Binding Name}" Width="150" FontWeight="Bold"/>
                        <DataGridTextColumn x:Name="ColKhuVuc" Header="Khu vực" Binding="{Binding KhuVucName}" Width="150"/>
                        <DataGridTextColumn x:Name="ColNhomHienThi" Header="Nhóm hiển thị" Binding="{Binding NhomHienThiName}" Width="150"/>
                        <DataGridTextColumn x:Name="ColLoaiPhong" Header="Loại phòng" Binding="{Binding LoaiPhongName}" Width="150"/>
                        <DataGridTextColumn x:Name="ColGhiChu" Header="Ghi chú" Binding="{Binding Note}" Width="*"/>
                        <DataGridTextColumn x:Name="ColBangGia" Header="Bảng giá" Binding="{Binding BanggiaName}" Width="120" Visibility="Collapsed"/>
                        <DataGridTextColumn x:Name="ColDonGia" Header="Đơn giá" Binding="{Binding Dongia, StringFormat={}{0:N0}}" Width="100" Visibility="Collapsed"/>
                        <DataGridTextColumn x:Name="ColTienMoBan" Header="Tiền mở bàn" Binding="{Binding Tienmoban, StringFormat={}{0:N0}}" Width="120" Visibility="Collapsed"/>
                    </DataGrid.Columns>
                </DataGrid>

                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#b0c4de" ShowsPreview="True"/>

                <!-- Tab chi tiết dưới -->
                <TabControl Grid.Row="2" Background="#ffffff" BorderBrush="#7f9db9" BorderThickness="1">
                    <TabControl.Resources>
                        <Style TargetType="{x:Type TabControl}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type TabControl}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Background="#cce0f5" BorderBrush="#7f9db9" BorderThickness="0,0,0,1">
                                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" 
                                                              Focusable="False" PanningMode="HorizontalOnly">
                                                    <StackPanel IsItemsHost="True" Orientation="Horizontal"/>
                                                </ScrollViewer>
                                            </Border>
                                            <Border Grid.Row="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                <ContentPresenter ContentSource="SelectedContent"/>
                                            </Border>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style TargetType="{x:Type TabItem}">
                            <Setter Property="Background" Value="#dbe8f5"/>
                            <Setter Property="BorderBrush" Value="#8ea9db"/>
                            <Setter Property="Padding" Value="9,3"/>
                            <Setter Property="Margin" Value="0,0,1,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type TabItem}">
                                        <Border x:Name="TabBorder" Background="#dbe8f5" BorderBrush="#8ea9db" BorderThickness="1,1,1,0" CornerRadius="2,2,0,0" Padding="{TemplateBinding Padding}" Margin="0,1,1,0">
                                            <ContentPresenter x:Name="ContentSite" ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="#ffffff"/>
                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#3a6ea5"/>
                                                <Setter TargetName="TabBorder" Property="Margin" Value="0,0,1,-1"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="#edf4fb"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <TabItem Header="Thông tin">
                        <StackPanel Margin="12,10" Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Khởi tạo: " Foreground="Gray" Width="100"/>
                                <TextBlock x:Name="TxtInfoKhoiTao" Text="--/--/---- --:--:--" Margin="0,0,30,0" FontWeight="SemiBold"/>
                                <TextBlock Text="Khởi tạo bởi: " Foreground="Gray" Width="100"/>
                                <TextBlock x:Name="TxtInfoNguoiTao" Text="Administrator" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Sửa đổi: " Foreground="Gray" Width="100"/>
                                <TextBlock x:Name="TxtInfoSuaDoi" Text="--/--/---- --:--:--" Margin="0,0,30,0" FontWeight="SemiBold"/>
                                <TextBlock Text="Sửa bởi: " Foreground="Gray" Width="100"/>
                                <TextBlock x:Name="TxtInfoNguoiSua" Text="Administrator" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Bảng giá theo bàn">
                        <DataGrid x:Name="DgBangGiaTheoBan" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  AlternatingRowBackground="#f2f7fc" GridLinesVisibility="All"
                                  HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Auto"
                                  HorizontalGridLinesBrush="#e0e0e0" VerticalGridLinesBrush="#e0e0e0" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Bảng giá" Binding="{Binding BangGia}" Width="150"/>
                                <DataGridTextColumn Header="Đơn giá" Binding="{Binding DonGia, StringFormat={}{0:N0}}" Width="120"/>
                                <DataGridTextColumn Header="Giờ bắt đầu" Binding="{Binding GioBatDau}" Width="100"/>
                                <DataGridTextColumn Header="Giờ kết thúc" Binding="{Binding GioKetThuc}" Width="100"/>
                                <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="250"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="Đặt hàng">
                        <DataGrid x:Name="DgTabDatHang" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  AlternatingRowBackground="#f2f7fc" GridLinesVisibility="All"
                                  HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Auto"
                                  HorizontalGridLinesBrush="#e0e0e0" VerticalGridLinesBrush="#e0e0e0" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ngày" Binding="{Binding Ngay, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="120"/>
                                <DataGridTextColumn Header="Số phiếu" Binding="{Binding SoPhieu}" Width="110"/>
                                <DataGridTextColumn Header="Tên khách" Binding="{Binding TenKhach}" Width="150"/>
                                <DataGridTextColumn Header="Địa chỉ" Binding="{Binding DiaChi}" Width="160"/>
                                <DataGridTextColumn Header="Điện thoại" Binding="{Binding DienThoai}" Width="110"/>
                                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="150"/>
                                <DataGridTextColumn Header="Tổng cộng" Binding="{Binding TongCong, StringFormat={}{0:N0}}" Width="110"/>
                                <DataGridTextColumn Header="Phương thức đặt" Binding="{Binding PhuongThucDat}" Width="130"/>
                                <DataGridTextColumn Header="Mục đích đặt" Binding="{Binding MucDichDat}" Width="130"/>
                                <DataGridTextColumn Header="Từ giờ" Binding="{Binding TuGio, StringFormat={}{0:HH:mm}}" Width="90"/>
                                <DataGridTextColumn Header="Đến giờ" Binding="{Binding DenGio, StringFormat={}{0:HH:mm}}" Width="90"/>
                                <DataGridTextColumn Header="Từ ngày" Binding="{Binding TuNgay, StringFormat={}{0:dd/MM/yyyy}}" Width="100"/>
                                <DataGridTextColumn Header="Đến ngày" Binding="{Binding DenNgay, StringFormat={}{0:dd/MM/yyyy}}" Width="100"/>
                                <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="180"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="Hóa đơn nhà hàng">
                        <DataGrid x:Name="DgTabHoaDon" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  AlternatingRowBackground="#f2f7fc" GridLinesVisibility="All"
                                  HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Auto"
                                  HorizontalGridLinesBrush="#e0e0e0" VerticalGridLinesBrush="#e0e0e0" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Số phiếu" Binding="{Binding SoPhieu}" Width="120"/>
                                <DataGridTextColumn Header="Ngày" Binding="{Binding Ngay, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="130"/>
                                <DataGridTextColumn Header="Nhân viên" Binding="{Binding NhanVien}" Width="120"/>
                                <DataGridTextColumn Header="Khách hàng" Binding="{Binding KhachHang}" Width="150"/>
                                <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TongTien, StringFormat={}{0:N0}}" Width="110"/>
                                <DataGridTextColumn Header="Giảm giá" Binding="{Binding GiamGia, StringFormat={}{0:N0}}" Width="100"/>
                                <DataGridTextColumn Header="Thanh toán" Binding="{Binding ThanhToan, StringFormat={}{0:N0}}" Width="110"/>
                                <DataGridTextColumn Header="Hình thức" Binding="{Binding HinhThuc}" Width="110"/>
                                <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="Phiếu nhập kho">
