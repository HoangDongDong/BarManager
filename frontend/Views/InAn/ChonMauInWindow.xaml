<Window x:Class="QuanLyBar.Client.Views.ChonMauInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CHỌN MẪU IN" Height="420" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#dbe7f7" Loaded="Window_Loaded">
    <Grid Margin="12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Danh sách mẫu in (Dạng cây có icon và nét đứt) -->
        <Border Grid.Row="0" Background="White" BorderBrush="#a3b8d4" BorderThickness="1" Margin="0,0,0,10">
            <TreeView x:Name="TvMauIn" BorderThickness="0" Background="Transparent" Margin="6">
                <TreeViewItem x:Name="Item58mm" IsExpanded="True">
                    <TreeViewItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⭐" Foreground="#e6ac00" Margin="0,0,6,0" FontSize="13"/>
                            <TextBlock Text="58mm" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TreeViewItem.Header>
                </TreeViewItem>
                <TreeViewItem x:Name="Item80mm" IsExpanded="True">
                    <TreeViewItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🟩" Foreground="#33aa33" Margin="0,0,6,0" FontSize="13"/>
                            <TextBlock Text="80mm" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TreeViewItem.Header>
                </TreeViewItem>
                <TreeViewItem x:Name="ItemA4BanHang" IsExpanded="True">
                    <TreeViewItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌟" Foreground="#9933cc" Margin="0,0,6,0" FontSize="13"/>
                            <TextBlock Text="Báo cáo tổng hợp bán hàng A4" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TreeViewItem.Header>
                </TreeViewItem>
                <TreeViewItem x:Name="ItemA4ThanhToan" IsSelected="True" IsExpanded="True">
                    <TreeViewItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📄" Foreground="#0055aa" Margin="0,0,6,0" FontSize="13"/>
                            <TextBlock Text="Báo cáo tổng hợp thanh toán A4" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TreeViewItem.Header>
                </TreeViewItem>
            </TreeView>
        </Border>

        <!-- Khung Tùy chọn -->
        <GroupBox Grid.Row="1" Header="Tùy chọn" Margin="0,0,0,10" Padding="12,8" Background="Transparent" BorderBrush="#a3b8d4">
            <StackPanel>
                <RadioButton x:Name="RbXemManHinh" GroupName="PrintOptions" Content="Xem trên màn hình" IsChecked="True" Margin="0,4,0,8" FontWeight="SemiBold" Checked="Option_Checked"/>
                
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="RbInMayIn" GroupName="PrintOptions" Content="In ra máy in" VerticalAlignment="Center" Checked="Option_Checked" Unchecked="Option_Checked"/>
                    <ComboBox x:Name="CmbPrinters" Grid.Column="1" Height="24" IsEnabled="False"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="RbXuatExcel" GroupName="PrintOptions" Content="Xuất excel" Grid.Column="0" Checked="Option_Checked"/>
                    <RadioButton x:Name="RbXuatPdf" GroupName="PrintOptions" Content="Xuất pdf" Grid.Column="1" Checked="Option_Checked"/>
                </Grid>

                <RadioButton x:Name="RbThietKe" GroupName="PrintOptions" Content="Thiết kế mẫu in" Margin="0,0,0,4" Checked="Option_Checked"/>
            </StackPanel>
        </GroupBox>

        <!-- Nút OK / Cancel -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button x:Name="BtnOk" Content="OK" Width="85" Height="26" Margin="0,0,10,0" IsDefault="True"
                    Background="White" BorderBrush="#0055cc" BorderThickness="1.5" FontWeight="SemiBold" Click="BtnOk_Click"/>
            <Button x:Name="BtnCancel" Content="Cancel" Width="85" Height="26" IsCancel="True"
                    Background="White" BorderBrush="#999" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
