<UserControl x:Class="QuanLyBar.Client.Views.InAn.FastReportDesignerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1150"
             Background="#8da4c4">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Action Bar -->
        <Border Grid.Row="0" Background="#b0c4de" BorderBrush="#5b7b9c" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTabReportName" Text="Mẫu 80" FontWeight="Bold" FontSize="15" Foreground="#1e293b" VerticalAlignment="Center"/>
                    <TextBlock Text=" (FastReport.NET Official Designer)" FontSize="12" FontStyle="Italic" Foreground="#475569" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnOpenFastReportDesigner" Click="BtnOpenFastReportDesigner_Click" 
                            Background="#0284c7" Foreground="White" FontWeight="Bold" FontSize="13" Padding="14,6" 
                            BorderBrush="#0284c7" BorderThickness="1" Cursor="Hand" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎨 " FontSize="14"/>
                            <TextBlock Text="Mở FastReport Designer Native Window"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnPreview" Click="BtnPreview_Click" 
                            Background="#047857" Foreground="White" FontWeight="Bold" FontSize="13" Padding="14,6" 
                            BorderBrush="#047857" BorderThickness="1" Cursor="Hand" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍 " FontSize="14"/>
                            <TextBlock Text="Xem trước (Preview)"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnCapNhatVaoCSDL" Click="BtnCapNhatVaoCSDL_Click" 
                            Background="#1e3f66" Foreground="White" FontWeight="Bold" FontSize="13" Padding="16,6" 
                            BorderBrush="#0f172a" BorderThickness="1" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾 " FontSize="14"/>
                            <TextBlock Text="Cập nhật vào cơ sở dữ liệu"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Info Panel -->
        <Border Grid.Row="1" Background="#F1F5F9" Margin="20" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" Padding="24">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="📊 FastReport.NET Designer Engine" FontSize="22" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock x:Name="TxtInfoTemplate" Text="Mẫu báo cáo: Mẫu 80" FontSize="15" Foreground="#475569" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Content="🚀 MỞ NATIVE FASTREPORT DESIGNER" Click="BtnOpenFastReportDesigner_Click" Height="42" Padding="20,0" FontSize="14" FontWeight="Bold" Background="#0284c7" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,12,0"/>
                    <Button Content="💾 CẬP NHẬT CSDL FIREBIRD" Click="BtnCapNhatVaoCSDL_Click" Height="42" Padding="20,0" FontSize="14" FontWeight="Bold" Background="#1e3f66" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
