<Window x:Class="QuanLyBar.Client.Views.InLuoiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="In lưới" Height="520" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#dbe7f7">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Cấu hình trang in -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5,0,0,10">
            <TextBlock Text="🖨" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock Text="Cấu hình trang in" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
        </StackPanel>

        <GroupBox Header="Thiết lập" Grid.Row="1" Margin="0,0,0,8" Padding="8" BorderBrush="#a3b8d4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="65"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Tiêu đề:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtTieuDe" Grid.Row="0" Grid.Column="1" Margin="0,0,0,5" Height="24" Text="Đặt hàng"/>

                <TextBlock Text="Ghi chú:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtGhiChu" Grid.Row="1" Grid.Column="1" Margin="0,0,0,5" Height="24"/>

                <TextBlock Text="Mẫu in:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Top" Margin="0,5,0,0"/>
                <ListBox x:Name="LstMauIn" Grid.Row="2" Grid.Column="1" Height="85" SelectionMode="Single">
                    <ListBoxItem Tag="Mẫu 80">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊 " Foreground="Teal"/>
                            <TextBlock Text="Mẫu 80"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Mẫu A4 nằm ngang" IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📄 " Foreground="RoyalBlue"/>
                            <TextBlock Text="Mẫu A4 nằm ngang"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Mẫu A4 thẳng đứng">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📈 " Foreground="Crimson"/>
                            <TextBlock Text="Mẫu A4 thẳng đứng"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>
        </GroupBox>

        <!-- Cột hiển thị -->
        <Grid Grid.Row="2" Margin="0,0,0,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Cột hiển thị" FontWeight="SemiBold" Margin="2,0,0,4"/>
            <Border Grid.Row="1" BorderBrush="#a3b8d4" BorderThickness="1" Background="White">
                <ListBox x:Name="LstCotHienThi" SelectionMode="Multiple" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Header}" IsChecked="{Binding IsChecked}" Margin="2,2"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>
        
        <CheckBox x:Name="ChkInSTT" Grid.Row="3" Content="In cột số thứ tự" IsChecked="True" HorizontalAlignment="Left" Margin="4,5,0,5"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
            <Button x:Name="BtnHienThi" Content="Hiển thị" Width="85" Height="28" Margin="0,0,10,0" IsDefault="True"
                    Background="White" BorderBrush="#0055cc" BorderThickness="1.5" FontWeight="SemiBold" Click="BtnHienThi_Click"/>
            <Button x:Name="BtnThoat" Content="Thoát" Width="80" Height="28" IsCancel="True"
                    Background="White" BorderBrush="#999" Click="BtnThoat_Click"/>
        </StackPanel>
    </Grid>
</Window>
