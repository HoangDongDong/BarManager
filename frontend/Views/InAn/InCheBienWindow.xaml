<Window x:Class="QuanLyBar.Client.Views.InCheBienWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IN CHẾ BIẾN" WindowState="Maximized" WindowStyle="None"
        ResizeMode="NoResize" Background="#3E779D"
        Loaded="Window_Loaded" KeyDown="Window_KeyDown">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- TOP BANNER TITLE BAR -->
            <RowDefinition Height="45"/>
            <!-- 4 COLUMNS CONTENT AREA -->
            <RowDefinition Height="*"/>
            <!-- BOTTOM PRINTER SELECTION & ACTION BUTTONS -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP BANNER -->
        <Border Grid.Row="0" Background="#800000" CornerRadius="4">
            <TextBlock Text="IN CHẾ BIẾN" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- 4 COLUMNS AREA -->
        <Grid Grid.Row="1" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= COLUMN 1: ĐỒ ĂN ================= -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#004D1A" CornerRadius="6">
                    <TextBlock Text="ĐỒ ĂN" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <ScrollViewer Grid.Row="1" Margin="0,8,0,8" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="IcDoAn">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#800000" CornerRadius="6" Margin="0,4" Padding="12,10">
                                    <Grid>
                                        <TextBlock Text="{Binding MatHangName}" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SoLuong, StringFormat={}{0:N0}}" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- PRINTER BUTTON FOR ĐỒ ĂN -->
                <Button Grid.Row="2" x:Name="BtnPrinterDoAn" Cursor="Hand" Click="BtnPrinterDoAn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1.5" CornerRadius="6">
                                <TextBlock x:Name="TxtPrinterDoAn" Text="{Binding PrinterDoAn, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- ================= COLUMN 2: ĐỒ UỐNG ================= -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#004D1A" CornerRadius="6">
                    <TextBlock Text="ĐỒ UỐNG" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <ScrollViewer Grid.Row="1" Margin="0,8,0,8" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="IcDoUong">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#800000" CornerRadius="6" Margin="0,4" Padding="12,10">
                                    <Grid>
                                        <TextBlock Text="{Binding MatHangName}" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SoLuong, StringFormat={}{0:N0}}" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- PRINTER BUTTON FOR ĐỒ UỐNG -->
                <Button Grid.Row="2" x:Name="BtnPrinterDoUong" Cursor="Hand" Click="BtnPrinterDoUong_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1.5" CornerRadius="6">
                                <TextBlock Text="{Binding PrinterDoUong, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- ================= COLUMN 3: DỊCH VỤ ================= -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#004D1A" CornerRadius="6">
                    <TextBlock Text="DỊCH VỤ" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <ScrollViewer Grid.Row="1" Margin="0,8,0,8" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="IcDichVu">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#800000" CornerRadius="6" Margin="0,4" Padding="12,10">
                                    <Grid>
                                        <TextBlock Text="{Binding MatHangName}" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SoLuong, StringFormat={}{0:N0}}" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- PRINTER BUTTON FOR DỊCH VỤ -->
                <Button Grid.Row="2" x:Name="BtnPrinterDichVu" Cursor="Hand" Click="BtnPrinterDichVu_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1.5" CornerRadius="6">
                                <TextBlock Text="{Binding PrinterDichVu, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- ================= COLUMN 4: ĐỒ KHÁC ================= -->
            <Grid Grid.Column="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#004D1A" CornerRadius="6">
                    <TextBlock Text="ĐỒ KHÁC" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <ScrollViewer Grid.Row="1" Margin="0,8,0,8" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="IcDoKhac">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#800000" CornerRadius="6" Margin="0,4" Padding="12,10">
                                    <Grid>
                                        <TextBlock Text="{Binding MatHangName}" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SoLuong, StringFormat={}{0:N0}}" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- PRINTER BUTTON FOR ĐỒ KHÁC -->
                <Button Grid.Row="2" x:Name="BtnPrinterDoKhac" Cursor="Hand" Click="BtnPrinterDoKhac_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1.5" CornerRadius="6">
                                <TextBlock Text="{Binding PrinterDoKhac, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>

        <!-- BOTTOM ACTION BUTTONS PANEL -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,4,0,4">
            <Button x:Name="BtnThucHien" Width="130" Height="42" Margin="0,0,12,0" Cursor="Hand" Click="BtnThucHienIn_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#1B5E20" BorderBrush="#4CAF50" BorderThickness="1.5" CornerRadius="6">
                            <TextBlock Text="THỰC HIỆN" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="BtnHuyBo" Width="130" Height="42" Cursor="Hand" Click="BtnThoat_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#B71C1C" BorderBrush="#EF5350" BorderThickness="1.5" CornerRadius="6">
                            <TextBlock Text="HỦY BỎ" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
