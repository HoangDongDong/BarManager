<Window x:Class="QuanLyBar.Client.Views.InCheBienWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="In chế biến" Height="520" Width="550"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#dbe7f2" Loaded="Window_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề Banner trên cùng -->
        <Border Grid.Row="0" Background="White" BorderBrush="#b6c1cd" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🖨️" FontSize="26" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="IN CÁC MÓN ĂN/ĐỒ UỐNG XUỐNG BẾP / RA QUẦY BAR ĐỂ CHẾ BIẾN" 
                           FontWeight="Bold" FontSize="12.5" Foreground="#002b5b" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ================= KHUNG 1: DANH SÁCH MÓN CẦN IN ================= -->
        <Grid x:Name="GridInCheBien" Grid.Row="1" Margin="10,8,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tab giả lập Đồ ăn, đồ uống, đồ khác -->
            <Border Grid.Row="0" Background="#fdf3d8" BorderBrush="#d8cbb0" BorderThickness="1,1,1,0" CornerRadius="3,3,0,0" Padding="8,4" HorizontalAlignment="Left">
                <TextBlock Text="Đồ ăn, đồ uống, đồ khác" FontWeight="Bold" FontSize="11" Foreground="#333"/>
            </Border>

            <!-- Tên máy in -->
            <Border Grid.Row="1" Background="White" BorderBrush="#b6c1cd" BorderThickness="1,0,1,0" Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Máy in: " FontWeight="SemiBold" FontSize="11"/>
                    <TextBlock x:Name="TxtSelectedPrinterName" Text="Microsoft Print to PDF" FontWeight="Bold" Foreground="#0055aa" FontSize="11"/>
                </StackPanel>
            </Border>

            <!-- Lưới danh sách món -->
            <DataGrid x:Name="DgMonIn" Grid.Row="2" AutoGenerateColumns="False" 
                      CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="All"
                      Background="White" HorizontalGridLinesBrush="#e0e0e0" VerticalGridLinesBrush="#e0e0e0"
                      SelectionMode="Single" AlternatingRowBackground="#f9f9f9">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="STT" Binding="{Binding STT}" Width="35">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Tên hàng" Binding="{Binding MatHangName}" Width="*" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="ĐVT" Binding="{Binding DonViTinh}" Width="50">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="110"/>
                    <DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong, StringFormat={}{0:N0}}" Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- ================= KHUNG 2: THIẾT LẬP MÁY IN ================= -->
        <Grid x:Name="GridThietLapMayIn" Grid.Row="1" Margin="10,8,10,0" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tab Cài đặt máy in -->
            <Border Grid.Row="0" Background="#fdf3d8" BorderBrush="#d8cbb0" BorderThickness="1,1,1,0" CornerRadius="3,3,0,0" Padding="8,4" HorizontalAlignment="Left">
                <TextBlock Text="Cài đặt máy in" FontWeight="Bold" FontSize="11" Foreground="#333"/>
            </Border>

            <!-- Khung thông báo hướng dẫn màu vàng -->
            <Border Grid.Row="1" Background="#fffae6" BorderBrush="#ffe58f" BorderThickness="1" Padding="8,6" Margin="0,0,0,4">
                <StackPanel>
                    <TextBlock Text="Bạn thiết lập máy in bằng cách chọn máy in với loại đồ tương ứng." Foreground="Red" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="Vui lòng thiết lập lại máy in pha chế sau đó click &quot;Lưu thông tin&quot;" Foreground="Red" FontSize="11" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <!-- Lưới cấu hình loại đồ & máy in -->
            <DataGrid x:Name="DgConfigMayIn" Grid.Row="2" AutoGenerateColumns="False" 
                      CanUserAddRows="False" GridLinesVisibility="All" Background="White"
                      HorizontalGridLinesBrush="#e0e0e0" VerticalGridLinesBrush="#e0e0e0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Loại đồ" Binding="{Binding LoaiDoName}" Width="150" IsReadOnly="True" FontWeight="SemiBold"/>
                    <DataGridTemplateColumn Header="Máy in" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.AvailablePrinters, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding SelectedPrinter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Height="24" VerticalContentAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Thanh nút điều khiển dưới cùng -->
        <Border Grid.Row="2" Background="#dbe7f2" BorderBrush="#b6c1cd" BorderThickness="0,1,0,0" Padding="10,6">
            <Grid>
                <!-- Nút chế độ In -->
                <Grid x:Name="GridButtonsInCheBien">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="⚙️ Thiết lập máy in" Width="130" Height="28" 
                            Background="#eaf2f8" BorderBrush="#a4bce3" Cursor="Hand" Click="BtnThietLapMayIn_Click"/>

                    <Button Grid.Column="2" Content="Thực hiện in" Width="110" Height="28" Margin="0,0,10,0"
                            FontWeight="Bold" Background="#0078d7" Foreground="White" BorderThickness="0" 
                            IsDefault="True" Cursor="Hand" Click="BtnThucHienIn_Click"/>

                    <Button Grid.Column="3" Content="Thoát" Width="75" Height="28" 
                            Background="#eaf2f8" BorderBrush="#a4bce3" IsCancel="True" Cursor="Hand" Click="BtnThoat_Click"/>
                </Grid>

                <!-- Nút chế độ Cài đặt -->
                <Grid x:Name="GridButtonsThietLap" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Lưu thông tin" Width="100" Height="28" Margin="0,0,10,0"
                            FontWeight="Bold" Background="#27ae60" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnLuuThongTin_Click"/>

                    <Button Grid.Column="1" Content="Hủy bỏ" Width="80" Height="28" 
                            Background="#eaf2f8" BorderBrush="#a4bce3" Cursor="Hand" Click="BtnHuyBoThietLap_Click"/>

                    <Button Grid.Column="3" Content="Thoát" Width="75" Height="28" 
                            Background="#eaf2f8" BorderBrush="#a4bce3" IsCancel="True" Cursor="Hand" Click="BtnThoat_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
