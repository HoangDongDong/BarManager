<Window x:Class="QuanLyBar.Client.Views.InAn.TuyChonThamSoBaoCaoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TÙY CHỌN THAM SỐ BÁO CÁO" 
        Width="720" Height="480" 
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#dbe5f2"
        FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#f8fafc"/>
            <Setter Property="BorderBrush" Value="#a4bce3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1e293b"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e0f2fe"/>
                    <Setter Property="BorderBrush" Value="#38bdf8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Padding="12" Background="#edf3f9">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Title -->
            <TextBlock x:Name="TxtTitle" Grid.Row="0" Text="TÙY CHỌN THAM SỐ HIỂN THỊ TRÊN BÁO CÁO" 
                       FontSize="13" FontWeight="Bold" Foreground="#1e3f66" Margin="0,0,0,4"/>

            <!-- Row 1: Subtitle note -->
            <TextBlock x:Name="TxtSubTitle" Grid.Row="1" Text="Tích chọn các tham số cần sử dụng khi xem hoặc lọc báo cáo:" 
                       FontSize="12" Foreground="#475569" Margin="0,0,0,8"/>

            <!-- Row 2: DataGrid of Parameters -->
            <Border Grid.Row="2" Background="White" BorderBrush="#a4bce3" BorderThickness="1">
                <DataGrid x:Name="DgThamSo" BorderThickness="0" AutoGenerateColumns="False" CanUserAddRows="False"
                          AlternatingRowBackground="#f0f7fc" RowHeight="26" SelectionMode="Single"
                          GridLinesVisibility="All" HorizontalGridLinesBrush="#e2e8f0" VerticalGridLinesBrush="#e2e8f0"
                          LoadingRow="DgThamSo_LoadingRow">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Hiển thị" Width="65">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding HienThi, UpdateSourceTrigger=PropertyChanged}" 
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Tên tham số" Binding="{Binding TenThamSo}" IsReadOnly="True" Width="220" FontWeight="SemiBold"/>

                        <DataGridTextColumn Header="Mã tham số" Binding="{Binding MaThamSo}" IsReadOnly="True" Width="140" Foreground="#64748b"/>

                        <DataGridTextColumn Header="Thứ tự" Binding="{Binding SortOrder, UpdateSourceTrigger=PropertyChanged}" Width="60"/>

                        <DataGridTemplateColumn Header="Giá trị mặc định" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox Text="{Binding DefaultValue, UpdateSourceTrigger=PropertyChanged}" 
                                              IsEditable="True" Height="22" BorderThickness="0" Background="Transparent"
                                              VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Tất cả"/>
                                        <ComboBoxItem Content="Hôm nay"/>
                                        <ComboBoxItem Content="Hôm qua"/>
                                        <ComboBoxItem Content="Tuần này"/>
                                        <ComboBoxItem Content="Tháng này"/>
                                        <ComboBoxItem Content="Tháng trước"/>
                                        <ComboBoxItem Content="Năm này"/>
                                        <ComboBoxItem Content="30 ngày gần nhất"/>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Row 3: Action Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="BtnGhiDuLieu" Content="Ghi dữ liệu" Style="{StaticResource ActionButtonStyle}" 
                        Width="105" Height="28" Margin="0,0,8,0" Click="BtnGhiDuLieu_Click"/>
                <Button x:Name="BtnThoat" Content="Thoát" Style="{StaticResource ActionButtonStyle}" 
                        Width="85" Height="28" Click="BtnThoat_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
