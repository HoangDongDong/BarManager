<Window x:Class="QuanLyBar.Client.Views.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IN PHIẾU" Height="780" Width="1050" 
        WindowStartupLocation="CenterScreen" Background="#90b5df">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Thanh công cụ Toolbar mô phỏng chuẩn giao diện phần mềm -->
        <Border Grid.Row="0" Background="#e3edf7" BorderBrush="#a4bcd5" BorderThickness="0,0,0,1" Padding="4,3">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button x:Name="BtnPrint" Margin="2,0" Padding="6,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnPrint_Click" ToolTip="In ấn">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨️" FontSize="14" Margin="0,0,4,0"/>
                            <TextBlock Text="Print" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnSave" Margin="2,0" Padding="6,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnSave_Click" ToolTip="Lưu / Xuất Excel">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" FontSize="14" Margin="0,0,4,0"/>
                            <TextBlock Text="Save" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Separator Width="1" Margin="6,2" Background="#b0c4de"/>
                    <Button Margin="2,0" Padding="4,2" Background="Transparent" BorderThickness="0" ToolTip="Gửi Email">
                        <TextBlock Text="✉️" FontSize="14"/>
                    </Button>
                    <Button Margin="2,0" Padding="4,2" Background="Transparent" BorderThickness="0" ToolTip="Tìm kiếm">
                        <TextBlock Text="🔍" FontSize="14"/>
                    </Button>
                    <Button Margin="2,0" Padding="4,2" Background="Transparent" BorderThickness="0" ToolTip="Sao chép">
                        <TextBlock Text="📑" FontSize="14"/>
                    </Button>
                    <Button Margin="2,0" Padding="4,2" Background="Transparent" BorderThickness="0" ToolTip="Cài đặt trang">
                        <TextBlock Text="📄" FontSize="14"/>
                    </Button>
                </StackPanel>

                <!-- Phân trang ở giữa -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="20,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="BtnFirst" Content="|◄◄" Width="26" Height="20" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                    <Button x:Name="BtnPrev" Content="◄" Width="20" Height="20" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                    <Border Background="White" BorderBrush="#a4bcd5" BorderThickness="1" Margin="4,0" Padding="6,1">
                        <TextBlock Text="1" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="of 1" VerticalAlignment="Center" Margin="2,0,4,0"/>
                    <Button x:Name="BtnNext" Content="►" Width="20" Height="20" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                    <Button x:Name="BtnLast" Content="►►|" Width="26" Height="20" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>

                <!-- Nút Đóng bên phải -->
                <Button x:Name="BtnClose" DockPanel.Dock="Right" Content="Close" Margin="4,0" Padding="12,2" 
                        Background="White" BorderBrush="#a4bcd5" Cursor="Hand" Click="BtnClose_Click"/>
            </DockPanel>
        </Border>

        <!-- Vùng hiển thị trang in (Nền gradient xanh, trang giấy A4/Khổ in viền vàng cam) -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#96bee7" Offset="0"/>
                    <GradientStop Color="#709ecd" Offset="1"/>
                </LinearGradientBrush>
            </ScrollViewer.Background>

            <Grid HorizontalAlignment="Center" Margin="30">
                <!-- Tờ giấy in có viền màu vàng cam như ảnh mẫu -->
                <Border x:Name="PaperContainer" Background="White" BorderBrush="#e69500" BorderThickness="2" Padding="25">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.35" Color="#000000"/>
                    </Border.Effect>

                    <StackPanel x:Name="PrintContentPanel" Width="720">
                        <!-- Tên cửa hàng/Quán -->
                        <TextBlock x:Name="TxtTenCuaHang" Text="NÀNG HƯƠNG QUÁN" FontWeight="Bold" FontSize="13" 
                                   FontStyle="Italic" Margin="0,0,0,8"/>

                        <!-- Tiêu đề Báo Cáo -->
                        <TextBlock x:Name="TxtTieuDeBaoCao" Text="BÁO CÁO TỔNG HỢP BÁN HÀNG" FontWeight="Bold" FontSize="16" 
                                   HorizontalAlignment="Center" Margin="0,0,0,4"/>

                        <!-- Khoảng thời gian -->
                        <TextBlock x:Name="TxtKhoangThoiGian" Text="Từ ngày 19/08/2026 đến ngày 31/08/2026" 
                                   HorizontalAlignment="Center" FontStyle="Italic" FontSize="12" Margin="0,0,0,15"/>

                        <!-- Bảng dữ liệu hóa đơn -->
                        <Border BorderBrush="Black" BorderThickness="1,1,0,0" Margin="0,0,0,15">
                            <Grid x:Name="GridTable">
                                <!-- Tạo các hàng động qua code C# -->
                            </Grid>
                        </Border>

                        <!-- Chữ ký & Ngày lập ở góc phải/dưới -->
                        <Grid Margin="0,10,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtNgayLap" Text="Ngày 31 tháng 8 năm 2026" FontSize="11" FontStyle="Italic" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                <TextBlock Text="Người lập" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                <TextBlock Text="(ký, họ tên)" FontSize="10" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,2,0,50"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
