<Window x:Class="QuanLyBar.Client.Views.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="In danh sách" Height="700" Width="1000" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Toolbar simulating DevExpress -->
        <ToolBarTray DockPanel.Dock="Top" Background="#F0F0F0">
            <ToolBar Background="#F0F0F0" Padding="2,5">
                <Button Name="BtnPrint" Click="BtnPrint_Click" Margin="2,0" ToolTip="In tài liệu">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🖨" FontSize="16" Margin="0,0,5,0" Foreground="#0055AA"/>
                        <TextBlock Text="Print" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Separator/>
                <Button Name="BtnSave" Click="BtnSave_Click" Margin="2,0" ToolTip="Lưu ra Excel/XPS">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💾" FontSize="16" Margin="0,0,5,0" Foreground="#00AA00"/>
                        <TextBlock Text="Save" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Separator/>
                <Button Name="BtnClose" Click="BtnClose_Click" Margin="2,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="❌" FontSize="14" Margin="0,0,5,0" Foreground="#AA0000"/>
                        <TextBlock Text="Close" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <FlowDocumentReader x:Name="DocViewer" ViewingMode="Page" IsFindEnabled="True" IsPrintEnabled="True" />
    </DockPanel>
</Window>
