<Window x:Class="QuanLyBar.Client.Views.HoaDonBanHangPrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xem trước Hóa đơn" Height="680" Width="480"
        WindowStartupLocation="CenterScreen" Background="#eef2f6"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Action Bar -->
        <Border Grid.Row="0" Background="White" BorderBrush="#d0d7de" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="BtnPrint" Content="🖨 In hóa đơn" Height="32" Padding="15,0" Margin="0,0,10,0"
                            Background="#1890ff" Foreground="White" FontWeight="Bold" FontSize="13"
                            BorderThickness="0" Cursor="Hand" Click="BtnPrint_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <ComboBox x:Name="CmbPrinters" Height="32" Width="180" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                </StackPanel>

                <Button x:Name="BtnClose" Content="Đóng" Height="32" Padding="15,0" DockPanel.Dock="Right"
                        Background="#f0f0f0" Foreground="#333" FontWeight="SemiBold" FontSize="13"
                        BorderBrush="#ccc" BorderThickness="1" Cursor="Hand" Click="BtnClose_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </DockPanel>
        </Border>

        <!-- Bill Container ScrollViewer -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="20">
            <!-- Paper / Thermal Bill (80mm ~ 320px - 360px) -->
            <Border x:Name="BillPaper" Width="360" Background="White" HorizontalAlignment="Center"
                    BorderBrush="#ccc" BorderThickness="1" Padding="18,22" Margin="0,0,0,20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" Color="#33000000" Direction="270" ShadowDepth="3" Opacity="0.2"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Header with Logo and Store Info -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Logo Icon / Graphic -->
                        <Border Grid.Column="0" Width="55" Height="55" HorizontalAlignment="Left" VerticalAlignment="Top"
                                BorderBrush="#333" BorderThickness="1" CornerRadius="4" Background="#fafafa">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🍴" FontSize="24" HorizontalAlignment="Center"/>
                                <TextBlock Text="BAR POS" FontSize="7" FontWeight="Bold" Foreground="#666" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Restaurant Info -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" Margin="5,0,0,0">
                            <TextBlock x:Name="TxtTenQuan" Text="NÀNG HƯƠNG QUÁN" FontWeight="Bold" FontSize="15" 
                                       TextAlignment="Center" TextWrapping="Wrap" Foreground="#000"/>
                            <TextBlock x:Name="TxtDiaChi" Text="ĐC: Số 28 Giang Văn Minh - Đội Cấn - Ba Đình - Hà Nội" 
                                       FontSize="10.5" TextAlignment="Center" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="#222"/>
                            <TextBlock x:Name="TxtDienThoai" Text="ĐT: Điện thoại: 0909090880" 
                                       FontSize="10.5" TextAlignment="Center" Margin="0,2,0,0" Foreground="#222"/>
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,4,0,8" Background="#444"/>

                    <!-- Title -->
                    <TextBlock x:Name="TxtTitle" Text="HÓA ĐƠN BÁN HÀNG" FontWeight="Bold" FontSize="18" 
                               TextAlignment="Center" Foreground="#000" Margin="0,2,0,4"/>
                    
                    <!-- Table Name -->
                    <TextBlock x:Name="TxtTenBan" Text="Bàn 09" FontWeight="Bold" FontSize="14" 
                               TextAlignment="Center" Foreground="#000" Margin="0,0,0,8"/>

                    <!-- Metadata Grid -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Ngày & Số -->
                        <TextBlock Grid.Row="0" Grid.Column="0" FontSize="11" Margin="0,1">
                            <Run Text="Ngày: "/><Run x:Name="RunNgay" Text="30/08/2026"/>
                        </TextBlock>
                        <TextBlock Grid.Row="0" Grid.Column="1" FontSize="11" TextAlignment="Right" Margin="0,1">
                            <Run Text="Số: "/><Run x:Name="RunSoPhieu" Text="082600012" FontWeight="SemiBold"/>
                        </TextBlock>

                        <!-- Row 1: Thu ngân & In lúc -->
                        <TextBlock Grid.Row="1" Grid.Column="0" FontSize="11" Margin="0,1">
                            <Run Text="Thu ngân: "/><Run x:Name="RunThuNgan" Text="Administrator"/>
                        </TextBlock>
                        <TextBlock Grid.Row="1" Grid.Column="1" FontSize="11" TextAlignment="Right" Margin="0,1">
                            <Run Text="In lúc: "/><Run x:Name="RunInLuc" Text="18:23"/>
                        </TextBlock>

                        <!-- Row 2: Giờ vào & Giờ ra -->
                        <TextBlock Grid.Row="2" Grid.Column="0" FontSize="11" Margin="0,1">
                            <Run Text="Giờ vào: "/><Run x:Name="RunGioVao" Text="16:37"/>
                        </TextBlock>
                        <TextBlock Grid.Row="2" Grid.Column="1" FontSize="11" TextAlignment="Right" Margin="0,1">
                            <Run Text="Giờ ra: "/><Run x:Name="RunGioRa" Text="18:23"/>
                        </TextBlock>
                    </Grid>

                    <!-- Items Table -->
                    <Border BorderBrush="Black" BorderThickness="1" Margin="0,4,0,0">
                        <StackPanel>
                            <!-- Table Header -->
                            <Border Background="#fcf8e3" BorderBrush="Black" BorderThickness="0,0,0,1" Padding="4,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="62"/>
                                        <ColumnDefinition Width="68"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Mặt hàng" FontWeight="Bold" FontSize="11" Foreground="#000"/>
                                    <TextBlock Grid.Column="1" Text="SL" FontWeight="Bold" FontSize="11" TextAlignment="Center" Foreground="#000"/>
                                    <TextBlock Grid.Column="2" Text="ĐVT" FontWeight="Bold" FontSize="11" TextAlignment="Center" Foreground="#000"/>
                                    <TextBlock Grid.Column="3" Text="Giá" FontWeight="Bold" FontSize="11" TextAlignment="Right" Foreground="#000"/>
                                    <TextBlock Grid.Column="4" Text="T tiền" FontWeight="Bold" FontSize="11" TextAlignment="Right" Foreground="#000"/>
                                </Grid>
                            </Border>

                            <!-- Item List -->
                            <ItemsControl x:Name="ListItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#666" BorderThickness="0,0,0,1" Padding="4,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="62"/>
                                                    <ColumnDefinition Width="68"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding MatHangName}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding SoLuong, StringFormat={}{0:0.##}}" FontSize="11" TextAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding DonViTinh}" FontSize="11" TextAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding DonGia, StringFormat={}{0:N0}}" FontSize="11" TextAlignment="Right" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding ThanhTien, StringFormat={}{0:N0}}" FontSize="11" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Discount (if any) -->
                    <Grid x:Name="PanelGiamGia" Visibility="Collapsed" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Giảm giá:" FontSize="12" Foreground="#333"/>
                        <TextBlock x:Name="TxtGiamGia" Grid.Column="1" Text="0" FontSize="12" TextAlignment="Right" Foreground="#333"/>
                    </Grid>

                    <!-- Total Section -->
                    <Grid Margin="0,10,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tổng:" FontWeight="Bold" FontSize="18" Foreground="#000" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtTongCong" Grid.Column="1" Text="25,000" FontWeight="Bold" FontSize="20" 
                                   TextAlignment="Right" Foreground="#000" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Footer Message -->
                    <TextBlock Text="Cảm ơn Quý khách. Hẹn gặp lại.!" 
                               FontStyle="Italic" FontSize="11.5" TextAlignment="Center" 
                               Margin="0,14,0,5" Foreground="#333"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
