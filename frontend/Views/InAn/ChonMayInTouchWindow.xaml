<Window x:Class="QuanLyBar.Client.Views.InAn.ChonMayInTouchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CHỌN MÁY IN" Height="420" Width="550"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#2B5F6F"
        Loaded="Window_Loaded" KeyDown="Window_KeyDown">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- TITLE BANNER -->
            <RowDefinition Height="45"/>
            <!-- PRINTER LIST -->
            <RowDefinition Height="*"/>
            <!-- ACTION BUTTON -->
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1C4B6B" CornerRadius="6" Margin="0,0,0,8">
            <TextBlock x:Name="TxtTitle" Text="CHỌN MÁY IN KẾT NỐI" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="IcPrinters" Margin="4">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Height="48" Margin="0,4" Cursor="Hand" Click="BtnPrinter_Click" Tag="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#3E779D" BorderBrush="White" BorderThickness="1.5" CornerRadius="8" Padding="12,0">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🖨️ " Foreground="White" FontSize="20" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding}" Foreground="White" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="2" Content="HỦY BỎ" Width="120" Height="40" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="Hand" Click="BtnCancel_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="#B71C1C" BorderBrush="#EF5350" BorderThickness="1.5" CornerRadius="6">
                        <TextBlock Text="HỦY BỎ" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
