<UserControl x:Class="QuanLyBar.Client.Views.TonKho.TonNhieuKhoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             FontFamily="Segoe UI" FontSize="12" Background="#f0f4f8">

    <UserControl.Resources>
        <!-- Style DataGrid Header -->
        <Style x:Key="TonNhieuKhoGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#eaf2f8"/>
            <Setter Property="Foreground" Value="#2c3e50"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#cbd5e1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <!-- Style TreeView Item -->
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="2"/>
        </Style>

        <!-- Style Row DataGrid: Nền đỏ nhạt nếu âm -->
        <Style x:Key="TonNhieuKhoRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAm}" Value="True">
                    <Setter Property="Background" Value="#ffd8d8"/>
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0078d7"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Thanh Filter Toolbar phía trên -->
        <Border Grid.Row="0" Background="#dbe7f3" BorderBrush="#b6cadf" BorderThickness="0,0,0,1" Padding="8,4">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnRefresh" Height="25" Padding="8,0" Background="#f8fafc" BorderBrush="#94a3b8"
                            Cursor="Hand" Click="BtnRefresh_Click" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" Margin="0,0,4,0" FontSize="11"/>
                            <TextBlock Text="Refresh" FontSize="11.5"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="Tìm (F3):" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#1e293b"/>
                    <TextBox x:Name="TxtTimKiem" Width="140" Height="24" VerticalContentAlignment="Center"
                             Padding="4,0" TextChanged="TxtTimKiem_TextChanged" Margin="0,0,14,0"/>

                    <CheckBox x:Name="ChkChiTonKhoKhacKhong" Content="Chỉ hiển thị mặt hàng có tồn kho &lt;&gt; 0"
                              IsChecked="True" VerticalAlignment="Center" FontWeight="Normal" Checked="FilterChanged" Unchecked="FilterChanged"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Nội dung chính: SplitView Cây nhóm bên trái & Bảng tồn nhiều kho bên phải -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="160" MaxWidth="350"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Cây nhóm mặt hàng bên trái -->
            <Border Grid.Column="0" Background="White" BorderBrush="#cbd5e1" BorderThickness="0,0,1,0">
                <TreeView x:Name="TvNhomMatHang" BorderThickness="0" SelectedItemChanged="TvNhomMatHang_SelectedItemChanged">
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Sắp xếp theo">
                                <MenuItem Header="Mã nhóm" Click="MenuSortByCode_Click"/>
                                <MenuItem Header="Tên nhóm" Click="MenuSortByName_Click"/>
                            </MenuItem>
                            <MenuItem Header="Refresh" Click="MenuRefreshTree_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="🔄"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                </TreeView>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#dbe7f3"/>

            <!-- Khối bên phải: Bảng Tồn nhiều kho & Thẻ kho -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" MinHeight="150"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="2*" MinHeight="120"/>
                </Grid.RowDefinitions>

                <!-- Bảng Tồn nhiều kho chính -->
                <DataGrid Grid.Row="0" x:Name="DgTonNhieuKho" AutoGenerateColumns="False" CanUserAddRows="False"
                          IsReadOnly="True" GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#e2e8f0" VerticalGridLinesBrush="#e2e8f0"
                          ColumnHeaderStyle="{StaticResource TonNhieuKhoGridHeaderStyle}"
                          RowStyle="{StaticResource TonNhieuKhoRowStyle}"
                          RowHeight="22" Background="White"
                          SelectionMode="Single" SelectionChanged="DgTonNhieuKho_SelectionChanged">
                    
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Sao chép ô" Click="MenuSaoChepO_Click">
                                <MenuItem.Icon><TextBlock Text="📋"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Sao chép dòng" Click="MenuSaoChepDong_Click">
                                <MenuItem.Icon><TextBlock Text="📑"/></MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Tự động dãn cột" Click="MenuTuDongDanCot_Click">
                                <MenuItem.Icon><TextBlock Text="↔"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Cột hiển thị" Click="MenuCotHienThi_Click">
                                <MenuItem.Icon><TextBlock Text="☷"/></MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Xuất dữ liệu Excel" Click="MenuXuatExcel_Click">
                                <MenuItem.Icon><TextBlock Text="📊"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="In danh sách" Click="MenuInDanhSach_Click">
                                <MenuItem.Icon><TextBlock Text="🖨"/></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="STT" Binding="{Binding Stt}" Width="45">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#64748b"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Mã hàng" Binding="{Binding MaHang}" Width="85"/>
                        <DataGridTextColumn Header="Mặt hàng" Binding="{Binding TenHang}" Width="160"/>
                        <DataGridTextColumn Header="ĐVT" Binding="{Binding TenDonViTinh}" Width="55"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Dòng Tổng Footer -->
                <Border Grid.Row="1" Background="#e2e8f0" BorderBrush="#cbd5e1" BorderThickness="0,1,0,1" Padding="8,0">
                    <StackPanel x:Name="SpFooterTotals" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="TỔNG" FontWeight="Bold" Foreground="#0f172a" Width="345" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" Background="#cbd5e1"/>

                <!-- Khối Thẻ kho chi tiết phía dưới -->
                <TabControl Grid.Row="3" Background="White" BorderBrush="#cbd5e1">
                    <TabItem Header="Thẻ kho" FontSize="11.5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Toolbar Thẻ kho -->
                            <Border Grid.Row="0" Background="#f1f5f9" BorderBrush="#e2e8f0" BorderThickness="0,0,0,1" Padding="8,2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Từ:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11.5"/>
                                    <DatePicker x:Name="DpTheKhoTuNgay" Width="110" Height="23" FontSize="11" SelectedDateChanged="DpTheKho_SelectedDateChanged"/>

                                    <TextBlock Text="Đến" VerticalAlignment="Center" Margin="8,0,6,0" FontSize="11.5"/>
                                    <DatePicker x:Name="DpTheKhoDenNgay" Width="110" Height="23" FontSize="11" SelectedDateChanged="DpTheKho_SelectedDateChanged"/>

                                    <Button x:Name="BtnTheKhoRefresh" Height="23" Padding="8,0" Margin="8,0,0,0"
                                            Background="#f8fafc" BorderBrush="#94a3b8" Cursor="Hand" Click="BtnTheKhoRefresh_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔄" Margin="0,0,4,0" FontSize="11"/>
                                            <TextBlock Text="Refresh" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- DataGrid Thẻ kho -->
                            <DataGrid Grid.Row="1" x:Name="DgTheKho" AutoGenerateColumns="False" CanUserAddRows="False"
                                      IsReadOnly="True" GridLinesVisibility="All"
                                      HorizontalGridLinesBrush="#e2e8f0" VerticalGridLinesBrush="#e2e8f0"
                                      ColumnHeaderStyle="{StaticResource TonNhieuKhoGridHeaderStyle}"
                                      RowHeight="22" Background="White" AlternatingRowBackground="#f8fafc">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Số phiếu" Binding="{Binding SoPhieu}" Width="110"/>
                                    <DataGridTextColumn Header="Ngày" Binding="{Binding NgayFormatted}" Width="85"/>
                                    <DataGridTextColumn Header="Diễn giải" Binding="{Binding DienGiai}" Width="120"/>

                                    <DataGridTextColumn Header="Đơn giá" Binding="{Binding DonGiaFormatted}" Width="85">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Right"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="0,0,4,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="Thành tiền" Binding="{Binding ThanhTienFormatted}" Width="95">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Right"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="0,0,4,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="Giảm giá %" Binding="{Binding GiamGiaFormatted}" Width="75">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Right"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="0,0,4,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="ĐVT" Binding="{Binding TenDonViTinh}" Width="55"/>

                                    <DataGridTextColumn Header="Số lượng nhập" Binding="{Binding SlNhapFormatted}" Width="95">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Right"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="0,0,4,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="Số lượng xuất" Binding="{Binding SlXuatFormatted}" Width="95">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Right"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="0,0,4,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="Tồn" Binding="{Binding TonFormatted}" Width="75">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Right"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="0,0,4,0"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="Đối tượng" Binding="{Binding DoiTuong}" Width="130"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
