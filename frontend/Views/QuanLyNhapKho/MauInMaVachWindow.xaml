<Window x:Class="QuanLyBar.Client.Views.QuanLyNhapKho.MauInMaVachWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MẪU IN MÃ VẠCH" 
        Height="420" Width="550" 
        WindowStartupLocation="CenterOwner" 
        Background="#dce7f5"
        FontFamily="Segoe UI" FontSize="12">
    
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Toolbar -->
            <RowDefinition Height="*"/>    <!-- Template List -->
            <RowDefinition Height="Auto"/> <!-- Footer Buttons -->
        </Grid.RowDefinitions>

        <!-- 1. Toolbar -->
        <Border Grid.Row="0" Background="#eaf1fa" BorderBrush="#b6cadf" BorderThickness="1" CornerRadius="3" Padding="6,4" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnThemMoi" Margin="4,0" Padding="8,2" Background="#ffffff" BorderBrush="#b6cadf" Cursor="Hand" Click="BtnThemMoi_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➕" Foreground="Green" FontSize="11" Margin="0,0,4,0"/>
                        <TextBlock Text="Thêm mới" FontSize="11.5"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnChinhSua" Margin="4,0" Padding="8,2" Background="#ffffff" BorderBrush="#b6cadf" Cursor="Hand" Click="BtnChinhSua_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✏️" Foreground="#d9822b" FontSize="11" Margin="0,0,4,0"/>
                        <TextBlock Text="Chỉnh sửa" FontSize="11.5"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnXoaMau" Margin="4,0" Padding="8,2" Background="#ffffff" BorderBrush="#b6cadf" Cursor="Hand" Click="BtnXoaMau_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="❌" Foreground="Red" FontSize="11" Margin="0,0,4,0"/>
                        <TextBlock Text="Xóa mẫu" FontSize="11.5"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- 2. Danh sách mẫu in mã vạch -->
        <Border Grid.Row="1" Background="White" BorderBrush="#b6cadf" BorderThickness="1" CornerRadius="3">
            <ListBox x:Name="LbMauIn" BorderThickness="0" Background="Transparent"
                     SelectionMode="Single" MouseDoubleClick="LbMauIn_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="6,5">
                            <TextBlock Text="{Binding Icon}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TenMau}" FontSize="12.5" VerticalAlignment="Center" FontWeight="{Binding FontWeight}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- 3. Footer -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="True">
            <Button x:Name="BtnThietKe" Content="Thiết kế" Width="90" Height="28" DockPanel.Dock="Left"
                    Background="#ffffff" BorderBrush="#b6cadf" Cursor="Hand" Click="BtnThietKe_Click"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button x:Name="BtnChapNhan" Content="Chấp nhận" Width="95" Height="28" Margin="0,0,8,0"
                        Background="#0078d7" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnChapNhan_Click"/>
                <Button x:Name="BtnThoat" Content="Thoát" Width="85" Height="28"
                        Background="#ffffff" BorderBrush="#b6cadf" Cursor="Hand" Click="BtnThoat_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
