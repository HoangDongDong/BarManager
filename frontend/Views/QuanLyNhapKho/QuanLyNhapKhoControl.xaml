<UserControl x:Class="QuanLyBar.Client.Views.QuanLyNhapKho.QuanLyNhapKhoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             FontFamily="Segoe UI" FontSize="12">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <Style x:Key="HeaderTabStyle" TargetType="Border">
            <Setter Property="Background" Value="#dfe9f5"/>
            <Setter Property="BorderBrush" Value="#a3bde0"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="CornerRadius" Value="3,3,0,0"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#f0f4fa">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="200" MaxWidth="400"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- PANEL TRÁI: KHO HÀNG & BỘ LỌC -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tab Header: Kho hàng -->
            <Border Grid.Row="0" Style="{StaticResource HeaderTabStyle}" Margin="5,5,0,0">
                <Grid>
                    <TextBlock x:Name="TxtTreeHeader" Text="Kho hàng" FontWeight="Bold" FontSize="12.5" Foreground="#1e3f66" VerticalAlignment="Center"/>
                    <TextBlock Text="⚙️" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" FontSize="13" MouseDown="BtnCauHinhKho_Click"/>
                </Grid>
            </Border>

            <!-- Bộ lọc ngày & thuộc tính -->
            <Border Grid.Row="1" Background="#eaf1fa" BorderBrush="#b6cadf" BorderThickness="1,0,1,0" Margin="5,0,0,0" Padding="4,4">
                <StackPanel>
                    <!-- Ngày -->
                    <Grid Margin="2,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Ngày" VerticalAlignment="Center" Foreground="#333333" FontSize="11.5"/>
                        <TextBlock Grid.Column="1" Text="Từ:" VerticalAlignment="Center" Foreground="#555555" FontSize="11"/>
                        <DatePicker Grid.Column="2" x:Name="DpTuNgay" SelectedDateChanged="Filter_Changed" Height="22" FontSize="11"/>
                    </Grid>
                    <Grid Margin="2,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="Đến:" VerticalAlignment="Center" Foreground="#555555" FontSize="11"/>
                        <DatePicker Grid.Column="2" x:Name="DpDenNgay" SelectedDateChanged="Filter_Changed" Height="22" FontSize="11"/>
                    </Grid>

                    <!-- Kho nhập -->
                    <Grid Margin="2,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Kho nhập" VerticalAlignment="Center" Foreground="#333333" FontSize="11"/>
                        <ComboBox Grid.Column="1" x:Name="CboKhoNhap" DisplayMemberPath="Name" SelectedValuePath="Id" Height="22" SelectionChanged="Filter_Changed" FontSize="11"/>
                    </Grid>

                    <!-- Nhân viên nhập -->
                    <Grid Margin="2,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Nhân viên nhập" VerticalAlignment="Center" Foreground="#333333" FontSize="11"/>
                        <ComboBox Grid.Column="1" x:Name="CboNhanVienNhap" DisplayMemberPath="Name" SelectedValuePath="Id" Height="22" SelectionChanged="Filter_Changed" FontSize="11"/>
                    </Grid>

                    <!-- Nhà cung cấp -->
                    <Grid Margin="2,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Nhà cung cấp" VerticalAlignment="Center" Foreground="#333333" FontSize="11"/>
                        <ComboBox Grid.Column="1" x:Name="CboNhaCungCap" DisplayMemberPath="Name" SelectedValuePath="Id" Height="22" SelectionChanged="Filter_Changed" FontSize="11"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Sub Toolbar nhóm kho: chuẩn giống bên danh mục khách hàng -->
            <Border Grid.Row="2" Background="#eaf1fa" BorderBrush="#b6cadf" BorderThickness="1,1,1,0" Margin="5,0,0,0" Padding="2,2">
                <DockPanel LastChildFill="False">
                    <Button x:Name="BtnThemKho" ToolTip="Thêm mới" Margin="1,0" Padding="3,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnThemKho_Click">
                        <TextBlock Text="➕" Foreground="Green" FontSize="13"/>
                    </Button>
                    <Button x:Name="BtnSuaKho" ToolTip="Sửa" Margin="1,0" Padding="3,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnSuaKho_Click">
                        <TextBlock Text="✏️" FontSize="13"/>
                    </Button>
                    <Button x:Name="BtnThemThuMucKho" ToolTip="Tạo mới thư mục" Margin="1,0" Padding="3,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnThemThuMucKho_Click">
                        <TextBlock Text="📁" Foreground="#d4a017" FontSize="13"/>
                    </Button>
                    <Button x:Name="BtnXemTheoThuMuc" ToolTip="Hiển thị tất cả dữ liệu theo thư mục" Margin="1,0" Padding="3,2" 
                            Background="#fff9e6" BorderBrush="#e6a800" BorderThickness="1" Cursor="Hand" Click="BtnXemTheoThuMuc_Click">
                        <TextBlock Text="🗂️" FontSize="13"/>
                    </Button>
                    <Button x:Name="BtnLamMoiKho" ToolTip="Tải lại" Margin="1,0" Padding="3,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnLamMoiKho_Click">
                        <TextBlock Text="🔄" FontSize="13"/>
                    </Button>

                    <Button x:Name="BtnMenuCheDo" DockPanel.Dock="Right" ToolTip="Chế độ phân nhóm" Margin="2,0" Padding="4,2" 
                            Background="#e2ecf8" BorderBrush="#a4bce3" Cursor="Hand" Click="BtnMenuCheDo_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗂️" FontSize="12" Margin="0,0,2,0"/>
                            <TextBlock Text="▾" FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="CmCheDoPhanNhom">
                                <MenuItem Header="🏠  Kho nhập" Click="MiCheDoKhoNhap_Click"/>
                                <MenuItem Header="👩  Nhân viên nhập" Click="MiCheDoNhanVienNhap_Click"/>
                                <MenuItem Header="🏪  Cửa hàng" Click="MiCheDoCuaHang_Click"/>
                                <MenuItem Header="🏛️  Tài khoản ngân hàng" Click="MiCheDoTaiKhoanNganHang_Click"/>
                                <MenuItem Header="📅  Bảng giá" Click="MiCheDoBangGia_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </DockPanel>
            </Border>

            <!-- Cây danh mục kho hàng kèm ContextMenu giống khách hàng -->
            <Border Grid.Row="3" Background="White" BorderBrush="#b6cadf" BorderThickness="1" Margin="5,0,0,5">
                <TreeView x:Name="TvKhoHang" BorderThickness="0" SelectedItemChanged="TvKhoHang_SelectedItemChanged">
                    <TreeView.ContextMenu>
                        <ContextMenu x:Name="CmTreeView" Opened="CmTreeView_Opened">
                            <!-- 1. Thêm mới -->
                            <MenuItem Header="Thêm mới">
                                <MenuItem Header="➕  Thêm kho hàng" Click="MiThemMoiItem_Click"/>
                                <MenuItem Header="Thêm nhanh" Click="MiThemNhanhGoc_Click"/>
                                <MenuItem Header="📁  Thêm thư mục" Click="MiThemThuMucGoc_Click"/>
                            </MenuItem>

                            <!-- 2. Thêm con -->
                            <MenuItem Header="Thêm con">
                                <MenuItem Header="➕  Thêm kho hàng" Click="MiThemConItem_Click"/>
                                <MenuItem Header="Thêm nhanh" Click="MiThemNhanhCon_Click"/>
                                <MenuItem Header="📁  Thêm thư mục" Click="MiThemThuMucCon_Click"/>
                            </MenuItem>

                            <!-- 3. Chỉnh sửa -->
                            <MenuItem Header="✏️  Chỉnh sửa" Click="MiChinhSua_Click"/>

                            <!-- 4. Sắp xếp theo -->
                            <MenuItem Header="Sắp xếp theo">
                                <MenuItem Header="Tên" IsCheckable="True" IsChecked="True" Click="MiSapXepTen_Click"/>
                                <MenuItem Header="Thứ tự tùy chọn" IsCheckable="True" Click="MiSapXepTuyChon_Click"/>
                            </MenuItem>

                            <!-- 5. Refresh -->
                            <MenuItem Header="🔄  Refresh" Click="BtnLamMoiKho_Click"/>

                            <Separator/>

                            <!-- 6. Sao chép, Mở rộng, Thu gọn -->
                            <MenuItem Header="📑  Sao chép" Click="MiSaoChep_Click"/>
                            <MenuItem Header="Mở rộng" Click="MiMoRong_Click"/>
                            <MenuItem Header="Thu gọn" Click="MiThuGon_Click"/>

                            <Separator/>

                            <!-- 7. Xóa, Khôi phục, Đổi tên, Thùng rác -->
                            <MenuItem Header="❌  Xóa" Click="BtnXoaKho_Click"/>
                            <MenuItem Header="♻️  Khôi phục" Click="MiKhoiPhucTree_Click"/>
                            <MenuItem Header="Đổi tên" Click="MiDoiTen_Click"/>
                            <MenuItem Header="Thùng rác" Click="MiThungRac_Click"/>

                            <Separator/>

                            <!-- 8. Biểu tượng, Thuộc tính -->
                            <MenuItem Header="Biểu tượng" Click="MiBieuTuong_Click"/>
                            <MenuItem Header="Thuộc tính" Click="MiThuocTinh_Click"/>
                        </ContextMenu>
                    </TreeView.ContextMenu>

                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="2,1">
                                <TextBlock Text="{Binding Icon}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="#111111"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}">
                            <Setter Property="IsExpanded" Value="True"/>
                            <Setter Property="Padding" Value="2,2"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </Border>
        </Grid>

        <!-- SPLITTER -->
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#c4d8ed" Cursor="SizeWE"/>

        <!-- PANEL PHẢI: TAB PHIẾU NHẬP & CHI TIẾT -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="150"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="180" MinHeight="100"/>
            </Grid.RowDefinitions>

            <!-- Tab Header: Phiếu nhập -->
            <Border Grid.Row="0" Style="{StaticResource HeaderTabStyle}" Margin="0,5,5,0" HorizontalAlignment="Left" Width="130">
                <TextBlock Text="Phiếu nhập" FontWeight="Bold" FontSize="12.5" Foreground="#1e3f66" HorizontalAlignment="Center"/>
            </Border>

            <!-- Toolbar Phiếu nhập: chuẩn giống bên danh mục khách hàng -->
            <Border Grid.Row="1" Background="#eaf1fa" BorderBrush="#b6cadf" BorderThickness="1,1,1,0" Margin="0,0,5,0" Padding="5,4">
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="Lọc (F3):" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12"/>
                    <TextBox x:Name="TxtTimKiem" Width="130" Height="22" VerticalContentAlignment="Center" Margin="0,0,10,0" TextChanged="TxtTimKiem_TextChanged"/>

                    <Button x:Name="BtnThemMoi" Content="➕ Thêm mới (Insert)" Margin="2,0" Padding="6,2" Background="White" BorderBrush="#9cb2c8" Cursor="Hand" Click="BtnThemMoi_Click"/>
                    <Button x:Name="BtnChinhSua" Content="✏️ Chỉnh sửa (F4)" Margin="2,0" Padding="6,2" Background="White" BorderBrush="#9cb2c8" Cursor="Hand" Click="BtnChinhSua_Click"/>
                    <Button x:Name="BtnXoa" Content="❌ Xóa (Del)" Margin="2,0" Padding="6,2" Background="White" BorderBrush="#9cb2c8" Cursor="Hand" Click="BtnXoa_Click"/>
                    <Separator Margin="5,0"/>
                    <Button x:Name="BtnThemExcel" Content="📊 Thêm excel" Margin="2,0" Padding="6,2" Background="White" BorderBrush="#9cb2c8" Cursor="Hand" Click="BtnThemExcel_Click"/>
                    <Button x:Name="BtnXuatExcel" Content="📥 Xuất excel" Margin="2,0" Padding="6,2" Background="White" BorderBrush="#9cb2c8" Cursor="Hand" Click="BtnXuatExcel_Click"/>
                    <Button x:Name="BtnIn" Content="🖨️ In" Margin="2,0" Padding="6,2" Background="White" BorderBrush="#9cb2c8" Cursor="Hand" Click="BtnIn_Click"/>
                    <Button x:Name="BtnTong" Content="∑ Tổng" Margin="2,0" Padding="6,2" Background="White" BorderBrush="#9cb2c8" Cursor="Hand" Click="BtnTong_Click"/>
                    <Button x:Name="BtnPhanTich" Content="📊 P.tích" Margin="2,0" Padding="6,2" Background="White" BorderBrush="#9cb2c8" Cursor="Hand" Click="BtnPhanTich_Click"/>
                </WrapPanel>
            </Border>

            <!-- DataGrid Danh sách phiếu nhập kèm RowHeader STT và ContextMenu giống khách hàng -->
            <Border Grid.Row="2" Background="White" BorderBrush="#b6cadf" BorderThickness="1" Margin="0,0,5,0">
                <DataGrid x:Name="DgPhieuNhap" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          IsReadOnly="True" HeadersVisibility="All" GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#e2e8f0" VerticalGridLinesBrush="#e2e8f0"
                          RowHeight="24" SelectionMode="Single" SelectionUnit="FullRow"
                          Background="White" RowBackground="White" AlternatingRowBackground="#f9fbff"
                          SelectionChanged="DgPhieuNhap_SelectionChanged"
                          MouseDoubleClick="DgPhieuNhap_MouseDoubleClick">
                    
                    <DataGrid.RowStyle>
                        <Style TargetType="{x:Type DataGridRow}">
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="DataGridRow_PreviewMouseRightButtonDown"/>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.RowHeaderStyle>
                        <Style TargetType="{x:Type DataGridRowHeader}">
                            <Setter Property="Width" Value="32"/>
                            <Setter Property="Background" Value="#dfe9f5"/>
                            <Setter Property="BorderBrush" Value="#b6cadf"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="Content" Value="{Binding Stt}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="11"/>
                        </Style>
                    </DataGrid.RowHeaderStyle>

                    <DataGrid.ContextMenu>
                        <ContextMenu x:Name="GridContextMenu" Opened="GridContextMenu_Opened">
                            <!-- Chế độ thùng rác -->
                            <MenuItem x:Name="MenuKhoiPhuc" Header="Khôi phục" Click="MenuItem_KhoiPhuc_Click" Visibility="Collapsed">
                                <MenuItem.Icon>
                                    <TextBlock Text="↩️" Foreground="Green" FontWeight="Bold"/>
                                </MenuItem.Icon>
                            </MenuItem>

                            <!-- Chế độ bình thường -->
                            <MenuItem x:Name="MenuThemMoi" Header="Thêm Phiếu nhập" Click="BtnThemMoi_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="➕" Foreground="Green" FontWeight="Bold"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuThemNhanhExcel" Header="Thêm nhanh (excel)" Click="BtnThemExcel_Click"/>
                            <MenuItem x:Name="MenuCapNhatNhanhExcel" Header="Cập nhật nhanh (excel)" Click="BtnThemExcel_Click"/>
                            <MenuItem x:Name="MenuChinhSua" Header="Chỉnh sửa" Click="BtnChinhSua_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="✏️" Foreground="#c07000"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator x:Name="SepDatLoc"/>
                            <MenuItem x:Name="MenuLocCot" Header="Lọc Số phiếu" Click="MenuLocCot_Click"/>
                            <Separator x:Name="SepSapXep"/>
                            <MenuItem x:Name="MenuSapXep" Header="Sắp xếp theo">
                                <MenuItem Header="Sắp xếp tăng dần" Click="MenuItem_SortAsc_Click"/>
                                <MenuItem Header="Sắp xếp giảm dần" Click="MenuItem_SortDesc_Click"/>
                                <Separator/>
                                <MenuItem Header="Số phiếu" Click="MenuItem_SortBySoPhieu_Click"/>
                                <MenuItem Header="Ngày" Click="MenuItem_SortByNgay_Click"/>
                                <MenuItem Header="Nhà cung cấp" Click="MenuItem_SortByNcc_Click"/>
                                <MenuItem Header="Kho nhập" Click="MenuItem_SortByKho_Click"/>
                                <MenuItem Header="Nhân viên nhập" Click="MenuItem_SortByNv_Click"/>
                                <MenuItem Header="Tổng cộng" Click="MenuItem_SortByTongCong_Click"/>
                            </MenuItem>
                            <MenuItem x:Name="MenuRefresh" Header="Refresh" Click="BtnLamMoi_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="🔄" Foreground="Green" FontWeight="Bold"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuInDanhSach" Header="In danh sách" Click="BtnIn_Click"/>
                            <Separator x:Name="SepSaoChep"/>
                            <MenuItem x:Name="MenuSaoChepO" Header="Sao chép ô" Click="MenuItem_SaoChepO_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="📄" Foreground="Navy"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuSaoChepVungChon" Header="Sao chép vùng chọn" Click="MenuItem_SaoChepVungChon_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="📑" Foreground="Navy"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuXoa" Header="Xóa" Click="BtnXoa_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="❌" Foreground="Red"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator x:Name="SepKhac"/>
                            <MenuItem x:Name="MenuTuDongGianCot" Header="Tự động giãn cột" Click="MenuItem_TuDongGianCot_Click"/>
                            <MenuItem x:Name="MenuCotHienThi" Header="Cột hiển thị" Click="MenuCotHienThi_Click"/>
                            <MenuItem x:Name="MenuThuocTinh" Header="Thuộc tính" Click="MenuItem_ThuocTinh_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Số phiếu" Binding="{Binding SoPhieu}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,0"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Ngày" Binding="{Binding NgayHienThi}" Width="110"/>
                        <DataGridTextColumn Header="Nhà cung cấp" Binding="{Binding TenNhaCungCap}" Width="160"/>
                        <DataGridTextColumn Header="Kho nhập" Binding="{Binding TenKhoNhap}" Width="120"/>
                        
                        <!-- Cột Nhân viên nhập có icon -->
                        <DataGridTemplateColumn Header="Nhân viên nhập" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="3,0">
                                        <TextBlock Text="🧑" Margin="0,0,4,0" FontSize="11" Visibility="{Binding HasNhanVienNhap, Converter={StaticResource BoolToVisConverter}}"/>
                                        <TextBlock Text="{Binding TenNhanVienNhap}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Tiền hàng" Binding="{Binding TienHangFormatted}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,4,0"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Tiền giảm giá" Binding="{Binding TienGiamGiaFormatted}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,4,0"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Tỉ lệ giảm giá" Binding="{Binding TiLeGiamGiaFormatted}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,4,0"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Tài khoản ngân hàng" Binding="{Binding TenTaiKhoanNganHang}" Width="130"/>
                        <DataGridTextColumn Header="Tổng cộng" Binding="{Binding TongCongFormatted}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,4,0"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Cửa hàng" Binding="{Binding TenCuaHang}" Width="120"/>
                        <DataGridTextColumn Header="Thanh toán" Binding="{Binding ThanhToanFormatted}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,4,0"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Còn lại" Binding="{Binding ConLaiFormatted}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,4,0"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Mã voucher" Binding="{Binding MaVoucher}" Width="100"/>
                        <DataGridTextColumn Header="Thẻ tt" Binding="{Binding TheTtFormatted}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,4,0"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Thẻ trả trước" Binding="{Binding TheTraTruocFormatted}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,4,0"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Điểm giảm" Binding="{Binding DiemGiamFormatted}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,4,0"/></Style>
                            </DataGridTextColumn.ElementStyle>
