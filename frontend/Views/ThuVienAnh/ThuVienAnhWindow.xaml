<Window x:Class="QuanLyBar.Client.Views.ThuVienAnh.ThuVienAnhWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Thư viện ảnh" Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12"
        Background="#dce8f5">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Action Button Style matching screenshot -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#f4f8fc"/>
            <Setter Property="BorderBrush" Value="#a0b8d4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#112233"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Width" Value="85"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e0edfc"/>
                    <Setter Property="BorderBrush" Value="#0078d7"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#cfe2f8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Image Item Selection Style -->
        <Style x:Key="ImageItemBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Margin" Value="5,3"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#f0f7ff"/>
                    <Setter Property="BorderBrush" Value="#93c5fd"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#dbeafe"/>
                    <Setter Property="BorderBrush" Value="#0066cc"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/> <!-- Top Header Banner -->
            <RowDefinition Height="*"/>  <!-- Main Content Area -->
        </Grid.RowDefinitions>

        <!-- ==================== 1. TOP HEADER BANNER ==================== -->
        <Border Grid.Row="0" Background="White" BorderBrush="#b6cadf" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <!-- Gallery Sunset Picture Icon -->
                <Border Width="50" Height="42" Background="#fffdf7" BorderBrush="#a4bce3" BorderThickness="1" CornerRadius="2" Margin="0,0,14,0" Padding="3">
                    <Grid>
                        <!-- Sunset Gradient Representation -->
                        <Border CornerRadius="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#ffe082" Offset="0.0"/>
                                    <GradientStop Color="#ffb74d" Offset="0.5"/>
                                    <GradientStop Color="#ff7043" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <!-- Tree Silhouette and Sun -->
                        <Ellipse Width="10" Height="10" Fill="#ffffff" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,6"/>
                        <TextBlock Text="🌅" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Header Title -->
                <TextBlock Text="Quản lý thư viện ảnh" FontSize="15" FontWeight="Bold" Foreground="#112233" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ==================== 2. MAIN CONTENT AREA ==================== -->
        <Grid Grid.Row="1" Background="#dce8f5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>   <!-- Gallery Image Viewer -->
                <ColumnDefinition Width="105"/> <!-- Action Buttons Column -->
            </Grid.ColumnDefinitions>

            <!-- LEFT GALLERY BORDER -->
            <Border Grid.Column="0" Background="White" BorderBrush="#a4bce3" BorderThickness="1" Margin="12,12,8,12" CornerRadius="1">
                <ScrollViewer x:Name="SvGallery" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,4">
                    <ItemsControl x:Name="IcGroups">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <!-- Group Header with Separator Line -->
                                    <Grid Margin="2,6,4,4" Visibility="{Binding HasGroupHeader, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Line Grid.Column="0" Stretch="Fill" Stroke="#a4bce3" StrokeThickness="1" X2="1" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding GroupName}" FontWeight="SemiBold" FontSize="12" Foreground="#15428b" VerticalAlignment="Center" Margin="6,0,6,0"/>
                                        <Line Grid.Column="2" Stretch="Fill" Stroke="#a4bce3" StrokeThickness="1" X2="1" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Group Images WrapPanel -->
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ImageItemBorderStyle}"
                                                        MouseLeftButtonDown="ImageItem_MouseLeftButtonDown"
                                                        ToolTip="{Binding Name}">
                                                    <Image Source="{Binding ImageSource}" Stretch="Uniform" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- RIGHT ACTION BUTTONS -->
            <Grid Grid.Column="1" Margin="0,12,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top Buttons -->
                <StackPanel Grid.Row="0" Orientation="Vertical">
                    <!-- Thêm mới -->
                    <Button x:Name="BtnThemMoi" Content="Thêm mới" Style="{StaticResource ActionButtonStyle}" Click="BtnThemMoi_Click"/>

                    <!-- Thay thế -->
                    <Button x:Name="BtnThayThe" Content="Thay thế" Style="{StaticResource ActionButtonStyle}" Click="BtnThayThe_Click"/>

                    <!-- Xóa -->
                    <Button x:Name="BtnXoa" Content="Xóa" Style="{StaticResource ActionButtonStyle}" Click="BtnXoa_Click"/>
                </StackPanel>

                <!-- Bottom Exit Button -->
                <Button Grid.Row="2" x:Name="BtnThoat" Content="Thoát" Style="{StaticResource ActionButtonStyle}" Margin="0" Click="BtnThoat_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
