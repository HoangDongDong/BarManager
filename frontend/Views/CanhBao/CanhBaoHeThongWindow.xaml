<Window x:Class="QuanLyBar.Client.Views.CanhBao.CanhBaoHeThongWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CẢNH BÁO TOÀN HỆ THỐNG" Height="580" Width="880"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9"
        FontFamily="Segoe UI" FontSize="13"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FFF3CD" BorderBrush="#FFEEBA" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🔔" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="CẢNH BÁO TỰ ĐỘNG TOÀN HỆ THỐNG" FontWeight="Bold" FontSize="15" Foreground="#856404"/>
                    <TextBlock Text="Thông tin tổng hợp về hàng tồn dưới mức an toàn, khách hàng sinh nhật và các chương trình khuyến mại hôm nay." FontSize="12" Foreground="#856404" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tab Control for Categories -->
        <TabControl x:Name="TabCanhBao" Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
            <!-- TAB 1: HÀNG DƯỚI MỨC AN TOÀN -->
            <TabItem x:Name="TabHangTon" Header="📦 Hàng dưới mức an toàn">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Danh sách các mặt hàng có số lượng tồn thực tế thấp hơn tồn tối thiểu đã thiết lập:" FontStyle="Italic" Foreground="#64748B" Margin="0,0,0,8"/>
                    
                    <DataGrid x:Name="DgHangTon" Grid.Row="1"
                              AutoGenerateColumns="False" 
                              IsReadOnly="True" 
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0"
                              SelectionMode="Single"
                              Background="White"
                              BorderBrush="#CBD5E1"
                              BorderThickness="1"
                              AlternatingRowBackground="#F8FAFC"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT" Binding="{Binding Stt}" Width="45">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Mã hàng" Binding="{Binding MaHang}" Width="100"/>
                            <DataGridTextColumn Header="Tên mặt hàng" Binding="{Binding TenHang}" Width="*"/>
                            <DataGridTextColumn Header="ĐVT" Binding="{Binding DonViTinh}" Width="65">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Tồn hiện tại" Binding="{Binding TonHienTaiFormatted}" Width="95">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Foreground" Value="#DC2626"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Tồn tối thiểu" Binding="{Binding TonToiThieuFormatted}" Width="95">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Cần nhập thêm" Binding="{Binding SoLuongCanNhapFormatted}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Foreground" Value="#0284C7"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 2: KHÁCH HÀNG SINH NHẬT -->
            <TabItem x:Name="TabSinhNhat" Header="🎂 Khách sinh nhật hôm nay">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Danh sách khách hàng có ngày sinh nhật trùng với ngày hôm nay:" FontStyle="Italic" Foreground="#64748B" Margin="0,0,0,8"/>
                    
                    <DataGrid x:Name="DgSinhNhat" Grid.Row="1"
                              AutoGenerateColumns="False" 
                              IsReadOnly="True" 
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0"
                              SelectionMode="Single"
                              Background="White"
                              BorderBrush="#CBD5E1"
                              BorderThickness="1"
                              AlternatingRowBackground="#F8FAFC"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT" Binding="{Binding Stt}" Width="45">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Mã KH" Binding="{Binding MaKhach}" Width="90"/>
                            <DataGridTextColumn Header="Tên khách hàng" Binding="{Binding TenKhach}" Width="160" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Điện thoại" Binding="{Binding DienThoai}" Width="110"/>
                            <DataGridTextColumn Header="Ngày sinh" Binding="{Binding NgaySinhFormatted}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#EA580C"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Nhóm khách" Binding="{Binding TenNhomKhach}" Width="120"/>
                            <DataGridTextColumn Header="Địa chỉ" Binding="{Binding DiaChi}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 3: CHƯƠNG TRÌNH KHUYẾN MẠI -->
            <TabItem x:Name="TabKhuyenMai" Header="🎁 Khuyến mại đang áp dụng">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Các đợt chương trình khuyến mại đang có hiệu lực trong ngày hôm nay:" FontStyle="Italic" Foreground="#64748B" Margin="0,0,0,8"/>
                    
                    <DataGrid x:Name="DgKhuyenMai" Grid.Row="1"
                              AutoGenerateColumns="False" 
                              IsReadOnly="True" 
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0"
                              SelectionMode="Single"
                              Background="White"
                              BorderBrush="#CBD5E1"
                              BorderThickness="1"
                              AlternatingRowBackground="#F8FAFC"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT" Binding="{Binding Stt}" Width="45">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Tên chương trình khuyến mại" Binding="{Binding TenKm}" Width="240" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Từ ngày" Binding="{Binding TuNgayFormatted}" Width="95">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Đến ngày" Binding="{Binding DenNgayFormatted}" Width="95">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Giảm giá" Binding="{Binding GiamGiaFormatted}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#16A34A"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Ghi chú / Thể lệ" Binding="{Binding GhiChu}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1,0,1,1" CornerRadius="0,0,6,6" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtStatus" Grid.Column="0" Text="Đã sẵn sàng" VerticalAlignment="Center" Foreground="#64748B" FontStyle="Italic"/>
                
                <Button Grid.Column="1" Content="🔄 Tải lại dữ liệu (F5)" Width="150" Height="28" Margin="0,0,8,0" Background="#3B82F6" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnRefresh_Click"/>
                <Button Grid.Column="2" Content="Đóng (Esc)" Width="100" Height="28" Background="#64748B" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
