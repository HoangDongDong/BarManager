<Window x:Class="QuanLyBar.Client.Views.CauHinhSoPhieuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cấu hình cách sinh" 
        Height="430" Width="600" 
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize" 
        ShowInTaskbar="False"
        Background="#F0F4F8"
        FontFamily="Segoe UI" FontSize="12">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#E8F1FA" BorderBrush="#B8D0E8" BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="⚓" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#1E40AF"/>
                <TextBlock x:Name="TxtHeaderTitle" Text="Thiết lập cách sinh Phiếu" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Input Mẫu & Giải thích -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Mẫu:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
            <TextBox x:Name="TxtPattern" Grid.Column="1" Height="26" VerticalContentAlignment="Center" Padding="4,0" TextChanged="TxtPattern_TextChanged"/>
            <TextBlock x:Name="TxtExplanation" Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#1E293B" TextWrapping="Wrap"/>
        </Grid>

        <!-- Hướng dẫn quy tắc (Verbatim) -->
        <Border Grid.Row="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="12,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Sử dụng (*) dành cho phần số tự động tăng do hệ thống sinh ra, độ dài do số lượng dấu sao quy định, tối đa là 9." TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="Ví dụ:" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <TextBlock Text="HD(**) gồm 99 số chạy từ HD01, HD02 đến HD99" Margin="10,0,0,2"/>
                    <TextBlock Text="HD(***) gồm 999 số chạy từ HD001, HD002 đến HD999" Margin="10,0,0,10"/>

                    <TextBlock Text="Sử dụng (MM) để lấy tháng hiện tại" Margin="0,0,0,2"/>
                    <TextBlock Text="Sử dụng (yy) để lấy năm hiện tại (2 số cuối của năm)" Margin="0,0,0,2"/>
                    <TextBlock Text="Sử dụng (yyyy) để lấy năm hiện tại (cả 4 số)" Margin="0,0,0,2"/>
                    <TextBlock Text="Sử dụng (dd) để lấy ngày hiện tại" Margin="0,0,0,10"/>

                    <TextBlock Text="Nếu số có chứa năm, (*) sẽ chạy lại từ 01 ở đầu năm mới" Margin="0,0,0,2"/>
                    <TextBlock Text="Nếu số có chứa tháng, (*) sẽ chạy lại từ 01 ở đầu tháng mới" Margin="0,0,0,2"/>
                    <TextBlock Text="Nếu số có chứa ngày, (*) sẽ chạy lại từ 01 ở đầu ngày mới" Margin="0,0,0,2"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Nút Ghi dữ liệu / Thoát -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnGhiDuLieu" Content="Ghi dữ liệu" Width="95" Height="28" Background="#E2E8F0" BorderBrush="#94A3B8" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,10,0" Click="BtnGhiDuLieu_Click"/>
            <Button x:Name="BtnThoat" Content="Thoát" Width="80" Height="28" Background="#E2E8F0" BorderBrush="#94A3B8" Cursor="Hand" Click="BtnThoat_Click"/>
        </StackPanel>
    </Grid>
</Window>
