<Window x:Class="QuanLyBar.Client.Views.CauHinhHeThong.ThietLapMauNhanhWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="THIẾT LẬP MÀU NHANH" Width="440" Height="410"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#B7CCE6">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="Thiết lập màu" FontWeight="Bold" FontSize="16" Margin="4,0,4,8" Foreground="#111111"/>

        <!-- KHUNG THIẾT LẬP MÀU -->
        <GroupBox Grid.Row="1" Header="Thiết lập màu" Margin="0,0,0,8" Padding="10" Foreground="#222222" FontWeight="Bold">
            <StackPanel TextBlock.FontWeight="Normal">
                <RadioButton x:Name="RbTuDong" GroupName="ColorModeGroup" Content="Tự động" IsChecked="True" Margin="0,2,0,8" FontSize="13"/>
                <Grid Margin="0,2,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <RadioButton x:Name="RbThuCong" GroupName="ColorModeGroup" Grid.Column="0" Content="Thủ công" VerticalAlignment="Center" FontSize="13" Click="RbThuCong_Click"/>
                    
                    <!-- THẺ HIỂN THỊ MÀU ĐÃ CHỌN (TÔ MÀU VÀO ĐÂY, BỎ KÝ HIỆU CHỮ MÃ MÀU) -->
                    <Border x:Name="BtnColorPreview" Grid.Column="1" Height="26" Margin="15,0,8,0"
                            Background="#1976D2" BorderBrush="#888888" BorderThickness="1" CornerRadius="3"
                            Cursor="Hand" MouseDown="BtnColorPreview_MouseDown"/>
                    
                    <Button x:Name="BtnChooseColor" Grid.Column="2" Content="Chọn" Width="70" Height="26" Click="BtnChooseColor_Click" Cursor="Hand"/>

                    <!-- POPUP BẢNG MÀU -->
                    <Popup x:Name="PopupColorPicker" PlacementTarget="{Binding ElementName=BtnColorPreview}" Placement="Bottom"
                           StaysOpen="False" AllowsTransparency="True">
                        <Border Background="White" BorderBrush="#888888" BorderThickness="1" Padding="4" CornerRadius="2">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                            </Border.Effect>
                            <UniformGrid x:Name="UgColorMatrix" Columns="10" Width="240"/>
                        </Border>
                    </Popup>
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- KHUNG ĐỐI TƯỢNG ÁP DỤNG -->
        <GroupBox Grid.Row="2" Header="Đối tượng áp dụng" Margin="0,0,0,8" Padding="10" Foreground="#222222" FontWeight="Bold">
            <StackPanel TextBlock.FontWeight="Normal">
                <RadioButton x:Name="RbMatHang" Content="Tất cả mặt hàng" IsChecked="True" Margin="0,4" FontSize="13"/>
                <RadioButton x:Name="RbMatHangTrongNhom" Content="Mặt hàng trong nhóm đang chọn" Margin="0,4" FontSize="13"/>
                <RadioButton x:Name="RbNhomHang" Content="Tất cả nhóm hàng" Margin="0,4" FontSize="13"/>
                <RadioButton x:Name="RbKhuVuc" Content="Tất cả khu vực" Margin="0,4" FontSize="13"/>
            </StackPanel>
        </GroupBox>

        <!-- NÚT THAO TÁC HỦY / THỰC HIỆN -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Content="Hủy bỏ" Width="95" Height="28" Margin="0,0,8,0" Click="BtnCancel_Click"/>
            <Button Content="Thực hiện" Width="105" Height="28" Click="BtnApply_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
