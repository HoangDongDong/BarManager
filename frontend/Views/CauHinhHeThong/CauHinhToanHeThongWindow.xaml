<Window x:Class="QuanLyBar.Client.Views.CauHinhHeThong.CauHinhToanHeThongWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="CẤU HÌNH TOÀN HỆ THỐNG" Height="640" Width="820"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="12" Background="#ECEFF4"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#222222"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="BorderBrush" Value="#A0A0A0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Foreground" Value="#222222"/>
        </Style>
        <Style x:Key="CategoryItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="1,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0078D7"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#D9EBF9"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Banner -->
        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🛠️" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="Thông tin cấu hình toàn bộ hệ thống" FontWeight="Bold" FontSize="14" Foreground="#1E293B"/>
            </StackPanel>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Category Navigation -->
            <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Margin="0,0,6,0">
                <ListBox x:Name="CategoryListBox" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource CategoryItemStyle}" SelectionChanged="CategoryListBox_SelectionChanged">
                    <ListBoxItem Tag="0" IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏠" Margin="0,0,8,0"/>
                            <TextBlock Text="Thông tin chung"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨️" Margin="0,0,8,0"/>
                            <TextBlock Text="In HĐ và in chế biến"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📄" Margin="0,0,8,0"/>
                            <TextBlock Text="Mẫu hóa đơn"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔢" Margin="0,0,8,0"/>
                            <TextBlock Text="Số phiếu"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛒" Margin="0,0,8,0"/>
                            <TextBlock Text="Bán hàng"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💰" Margin="0,0,8,0"/>
                            <TextBlock Text="Thanh toán"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💳" Margin="0,0,8,0"/>
                            <TextBlock Text="Tích điểm"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📦" Margin="0,0,8,0"/>
                            <TextBlock Text="Kho hàng"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏷️" Margin="0,0,8,0"/>
                            <TextBlock Text="Mặt hàng"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="9">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨️" Margin="0,0,8,0"/>
                            <TextBlock Text="Thiết bị khác"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔔" Margin="0,0,8,0"/>
                            <TextBlock Text="Cảnh báo"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="11">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛡️" Margin="0,0,8,0"/>
                            <TextBlock Text="Quản trị"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📱" Margin="0,0,8,0"/>
                            <TextBlock Text="Cảm ứng"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="13">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔧" Margin="0,0,8,0"/>
                            <TextBlock Text="Tùy chọn khác"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Border>

            <!-- Right Detail Content Panel -->
            <Border Grid.Column="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <!-- TAB 0: THÔNG TIN CHUNG -->
                        <Grid x:Name="TabThongTinChung" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Tên công ty:" Margin="0,6"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,4,12,4">
                                <TextBox x:Name="TxtCompanyName" FontWeight="Bold"/>
                                <TextBlock Text="(Tên công ty sẽ hiển thị dưới báo cáo)" FontStyle="Italic" Foreground="#64748B" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Logo area -->
                            <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="Logo:" Margin="0,0,0,4"/>
                                <Border Width="90" Height="90" BorderBrush="#CBD5E1" BorderThickness="1" Background="#F8FAFC" CornerRadius="2">
                                    <Image x:Name="ImgLogo" Stretch="Uniform" Margin="2"/>
                                </Border>
                                <Button x:Name="BtnChonLogo" Content="Chọn" Width="80" Height="24" Margin="0,6,0,0" Click="BtnChonLogo_Click"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Địa chỉ:" VerticalAlignment="Top" Margin="0,8,0,0"/>
                            <TextBox x:Name="TxtCompanyAddress" Grid.Row="1" Grid.Column="1" Height="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,4,12,4"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Số điện thoại:" Margin="0,6"/>
                            <TextBox x:Name="TxtCompanyPhone" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Email:" Margin="0,6"/>
                            <TextBox x:Name="TxtCompanyEmail" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Lời cảm ơn:" Margin="0,6"/>
                            <TextBox x:Name="TxtLoiCamOn" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Fax:" Margin="0,6"/>
                            <TextBox x:Name="TxtCompanyFax" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"/>
                        </Grid>

                        <!-- TAB 1: IN HĐ VÀ IN CHẾ BIẾN -->
                        <StackPanel x:Name="TabInHoaDon" Visibility="Collapsed">
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ChkLuaChonMauKhiIn" Grid.Column="0" Content="Lựa chọn mẫu khi in"/>
                                <CheckBox x:Name="ChkHienThiTruocKhiIn" Grid.Column="1" Content="Hiển thị trước khi in"/>
                            </Grid>

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Mẫu hóa đơn:"/>
                                <ComboBox x:Name="CboMauHoaDon" Grid.Column="1" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="2" Text="Số lần in:"/>
                                <TextBox x:Name="TxtSoLanIn" Grid.Column="3" Text="1"/>
                            </Grid>

                            <CheckBox x:Name="ChkSuDungChucNangInXuongBep" Content="Sử dụng chức năng in xuống bếp" FontWeight="SemiBold" Margin="0,6,0,2"/>
                            <WrapPanel Margin="24,2,0,6">
                                <CheckBox x:Name="ChkInDoAn" Content="In đồ ăn" Margin="0,0,20,0"/>
                                <CheckBox x:Name="ChkInDoUong" Content="In đồ uống" Margin="0,0,20,0"/>
                                <CheckBox x:Name="ChkInDichVu" Content="In dịch vụ" Margin="0,0,20,0"/>
                                <CheckBox x:Name="ChkInDoKhac" Content="In đồ khác"/>
                            </WrapPanel>

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Mẫu in chế biến:"/>
                                <ComboBox x:Name="CboMauInCheBien" Grid.Column="1" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="2" Text="Số liên in chế biến:"/>
                                <TextBox x:Name="TxtSoLienInCheBien" Grid.Column="3" Text="1"/>
                            </Grid>

                            <CheckBox x:Name="ChkInThem1LienTaiQuay" Content="In thêm 1 liên tại quầy (ra máy in mặc định)"/>
                            <CheckBox x:Name="ChkInMoiDoRa1To" Content="In mỗi đồ ra 1 tờ (In xong từng món cắt giấy ngay)"/>
                            <CheckBox x:Name="ChkInRiengDoAnUong" Content="In riêng đồ ăn/đồ uống/đồ khác nếu chung máy in"/>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ChkTuDongInPhaCheSauKhiGoiMon" Grid.Column="0" Content="Tự động in pha chế sau khi gọi món"/>
                                <TextBlock Grid.Column="1" Text="Thời gian chờ tự động in (giây):" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtThoiGianTuDongIn" Grid.Column="2" Text="10"/>
                            </Grid>

                            <CheckBox x:Name="ChkInPhaCheTheoKhuVuc" Content="In pha chế theo khu vực"/>
                            <CheckBox x:Name="ChkInThongBaoKhiChuyenBan" Content="In thông báo khi chuyển bàn"/>

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Mẫu in chuyển bàn:"/>
                                <ComboBox x:Name="CboMauInChuyenBan" Grid.Column="1"/>
                            </Grid>

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="In hóa đơn theo khu vực:"/>
                                <ComboBox x:Name="CboInHoaDonTheoKhuVuc" Grid.Column="1"/>
                            </Grid>

                            <CheckBox x:Name="ChkInMatKhauWifiTrenBill" Content="In mật khẩu wifi trên bill"/>
                        </StackPanel>

                        <!-- TAB 2: MẪU HÓA ĐƠN (DEVELOPER UNLOCK) -->
                        <StackPanel x:Name="TabMauHoaDon" Visibility="Collapsed">
                            <TextBlock Text="Phần này dành cho nhà phát triển, mời bạn nhập mật khẩu:" Margin="0,10,0,10"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <PasswordBox x:Name="TxtDevPassword" Width="150" Height="24" Margin="0,0,8,0"/>
                                <Button x:Name="BtnUnlockDev" Content="Mở khóa" Width="80" Height="24" Click="BtnUnlockDev_Click"/>
                            </StackPanel>
                            <Border x:Name="PnlDevUnlocked" Visibility="Collapsed" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="4" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="🔓 Bạn đã mở khóa chế độ Nhà Phát Triển thành công!" FontWeight="Bold" Foreground="#15803D" Margin="0,0,0,8"/>
                                    <TextBlock Text="• Tùy chỉnh mẫu in hóa đơn FastReport / CrystalReports." Margin="0,2"/>
                                    <TextBlock Text="• Cấu hình các tham số hệ thống nội bộ." Margin="0,2"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- TAB 3: SỐ PHIẾU -->
                        <Grid x:Name="TabSoPhieu" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Báo giá:" Margin="0,4"/>
                            <TextBox x:Name="TxtFormatBaoGia" Grid.Row="0" Grid.Column="1" Margin="0,2"/>
                            <Button Grid.Row="0" Grid.Column="2" Content="..." Margin="4,2,0,2"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Hóa đơn nhà hàng:" Margin="0,4"/>
                            <TextBox x:Name="TxtFormatHoaDon" Grid.Row="1" Grid.Column="1" Margin="0,2"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="..." Margin="4,2,0,2"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Phiếu nhập kho:" Margin="0,4"/>
                            <TextBox x:Name="TxtFormatNhapKho" Grid.Row="2" Grid.Column="1" Margin="0,2"/>
                            <Button Grid.Row="2" Grid.Column="2" Content="..." Margin="4,2,0,2"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Phiếu xuất kho:" Margin="0,4"/>
                            <TextBox x:Name="TxtFormatXuatKho" Grid.Row="3" Grid.Column="1" Margin="0,2"/>
                            <Button Grid.Row="3" Grid.Column="2" Content="..." Margin="4,2,0,2"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Phiếu chuyển kho:" Margin="0,4"/>
                            <TextBox x:Name="TxtFormatChuyenKho" Grid.Row="4" Grid.Column="1" Margin="0,2"/>
                            <Button Grid.Row="4" Grid.Column="2" Content="..." Margin="4,2,0,2"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Phiếu kiểm kê:" Margin="0,4"/>
                            <TextBox x:Name="TxtFormatKiemKe" Grid.Row="5" Grid.Column="1" Margin="0,2"/>
                            <Button Grid.Row="5" Grid.Column="2" Content="..." Margin="4,2,0,2"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Đặt hàng:" Margin="0,4"/>
                            <TextBox x:Name="TxtFormatDatHang" Grid.Row="6" Grid.Column="1" Margin="0,2"/>
                            <Button Grid.Row="6" Grid.Column="2" Content="..." Margin="4,2,0,2"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Phiếu thu:" Margin="0,4"/>
                            <TextBox x:Name="TxtFormatPhieuThu" Grid.Row="7" Grid.Column="1" Margin="0,2"/>
                            <Button Grid.Row="7" Grid.Column="2" Content="..." Margin="4,2,0,2"/>

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Phiếu chi:" Margin="0,4"/>
                            <TextBox x:Name="TxtFormatPhieuChi" Grid.Row="8" Grid.Column="1" Margin="0,2"/>
                            <Button Grid.Row="8" Grid.Column="2" Content="..." Margin="4,2,0,2"/>

                            <TextBlock Grid.Row="9" Grid.Column="0" Text="Phiếu thu công nợ:" Margin="0,4"/>
                            <TextBox x:Name="TxtFormatThuCongNo" Grid.Row="9" Grid.Column="1" Margin="0,2"/>
                            <Button Grid.Row="9" Grid.Column="2" Content="..." Margin="4,2,0,2"/>

                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Bảng lương:" Margin="0,4"/>
                            <TextBox x:Name="TxtFormatBangLuong" Grid.Row="10" Grid.Column="1" Margin="0,2"/>
                            <Button Grid.Row="10" Grid.Column="2" Content="..." Margin="4,2,0,2"/>
                        </Grid>

                        <!-- TAB 4: BÁN HÀNG -->
                        <StackPanel x:Name="TabBanHang" Visibility="Collapsed">
                            <CheckBox x:Name="ChkChoPhepNhapGiamGia" Content="Cho phép nhập giảm giá" FontWeight="SemiBold"/>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Mặc định giảm giá đồ ăn (%):"/>
                                <TextBox x:Name="TxtMacDinhGiamGia" Grid.Column="1" Text="0"/>
                                <TextBlock Grid.Column="3" Text="Mặc định giảm giá tiền giờ (%):"/>
                                <TextBox x:Name="TxtMacDinhGiamGiaTienGio" Grid.Column="4" Text="0"/>
                            </Grid>

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ChkCoThueSuat" Grid.Column="0" Content="Có thuế suất"/>
                                <TextBox x:Name="TxtMacDinhThueSuat" Grid.Column="4" Text="0"/>
                                <TextBlock Grid.Column="3" Text="Mặc định thuế suất (%):"/>
                            </Grid>

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ChkCoPhiDichVu" Grid.Column="0" Content="Có phí dịch vụ"/>
                                <TextBox x:Name="TxtMacDinhPhiDichVu" Grid.Column="4" Text="0"/>
                                <TextBlock Grid.Column="3" Text="Mặc định phí dịch vụ (%):"/>
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ChkNhapSoLuongSauKhiChon" Grid.Column="0" Content="Nhập số lượng sau khi chọn"/>
                                <CheckBox x:Name="ChkChoPhepThayDoiNgayTrenHoaDon" Grid.Column="1" Content="Cho phép thay đổi ngày trên hóa đơn"/>
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ChkBatBuocNhapNhanVienBanHang" Grid.Column="0" Content="Bắt buộc nhập nhân viên bán hàng"/>
                                <CheckBox x:Name="ChkChoPhepInTamTinh" Grid.Column="1" Content="Cho phép in tạm tính"/>
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ChkKichHoatKhuyenMaiTuDong" Grid.Column="0" Content="Kích hoạt khuyến mại tự động"/>
                                <CheckBox x:Name="ChkChoPhepTrungTenKhachHang" Grid.Column="1" Content="Cho phép trùng tên khách hàng"/>
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ChkHienThi3NhomOGiaoDienBanHang" Grid.Column="0" Content="Hiển thị 3 nhóm ở giao diện bán hàng"/>
                                <CheckBox x:Name="ChkToiUuDungBanPhim" Grid.Column="1" Content="Tối ưu dùng bàn phím"/>
                            </Grid>

                            <Grid Margin="0,2">
