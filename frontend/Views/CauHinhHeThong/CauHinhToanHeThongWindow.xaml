                            <CheckBox x:Name="ChkLocDuLieuBoKhoangTrong" Content="Lọc dữ liệu bỏ khoảng trống" Margin="0,4,0,1"/>
                            <TextBlock Text="(Ví dụ bạn tìm &quot;cafe da&quot; sẽ ra cả &quot;cafe đá&quot; và &quot;cafeda&quot;)" FontStyle="Italic" Foreground="#64748B" FontSize="11" Margin="24,0,0,4"/>

                            <CheckBox x:Name="ChkHienThiXuongDongNeuDoRongCotNho" Content="Hiển thị xuống dòng nếu độ rộng cột nhỏ" Margin="0,4,0,1"/>
                            <TextBlock Text="(Tùy chọn này sẽ làm chương trình chạy chậm hơn một chút)" FontStyle="Italic" Foreground="#64748B" FontSize="11" Margin="24,0,0,4"/>

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Độ to chữ hiển thị"/>
                                <ComboBox x:Name="CboDoToChuHienThi" Grid.Column="1"/>
                            </Grid>
                            <TextBlock Text="(Bạn cần thoát chương trình ra vào lại để áp dụng)" FontStyle="Italic" Foreground="#64748B" FontSize="11" Margin="160,0,0,4"/>

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Giao diện chương trình"/>
                                <ComboBox x:Name="CboGiaoDienChuongTrinh" Grid.Column="1"/>
                            </Grid>

                            <CheckBox x:Name="ChkTuDongTaiLai" Content="Tự động tải lại dữ liệu khi chuyển tab ở giao diện chính" Margin="0,6,0,3"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Bottom Actions Bar -->
        <Border Grid.Row="2" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,6,0,0">
            <Grid>
                <!-- Left: Search Box -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="🔍" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtSearchConfig" Width="200" Height="26" VerticalContentAlignment="Center"
                             ToolTip="Tìm kiếm cấu hình (Ctrl + F)"
                             TextChanged="TxtSearchConfig_TextChanged"/>
                </StackPanel>

                <!-- Right: Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnGhiDuLieu" Content="Ghi dữ liệu" Width="100" Height="28" Margin="0,0,8,0" FontWeight="SemiBold" Background="#0284C7" Foreground="White" Click="BtnGhiDuLieu_Click"/>
                    <Button x:Name="BtnThoat" Content="Thoát" Width="80" Height="28" Background="#F1F5F9" Click="BtnThoat_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
