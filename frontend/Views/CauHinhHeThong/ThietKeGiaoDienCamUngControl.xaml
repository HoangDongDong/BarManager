<UserControl x:Class="QuanLyBar.Client.Views.CauHinhHeThong.ThietKeGiaoDienCamUngControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200"
             Loaded="UserControl_Loaded"
             SizeChanged="UserControl_SizeChanged">
    <UserControl.Resources>
        <Style x:Key="TouchGroupHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#145DA0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="#E8F2FB"/>
        </Style>
        <Style x:Key="TileButton" TargetType="Border">
            <Setter Property="Background" Value="#2F6F9F"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="#F29F05"/>
                    <Setter Property="BorderThickness" Value="3"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F2F6F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1769AA" Padding="12,8">
            <TextBlock Text="THIẾT KẾ GIAO DIỆN MÀN CẢM ỨNG" 
                       FontSize="15" FontWeight="Bold" Foreground="White"/>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <!-- Column 1: Khu Vực -->
            <Border Grid.Column="0" Margin="4" Background="#FFFFFF" BorderBrush="#C7D7E5" BorderThickness="1" CornerRadius="4">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="TxtHeaderKhuVuc" Text="KHU VỰC" Style="{StaticResource TouchGroupHeader}"/>
                    </StackPanel>
                    <DockPanel DockPanel.Dock="Bottom" Background="#F3F7FA" LastChildFill="False">
                        <Button x:Name="BtnSettingKhuVuc" DockPanel.Dock="Right" 
                                Content="⚙ Cài đặt" Click="BtnSettingKhuVuc_Click"
                                Margin="4" Padding="8,4" FontSize="12" Background="#E8F2FB" BorderBrush="#2F6F9F"/>
                    </DockPanel>
                    <ScrollViewer x:Name="SvKhuVuc" Background="#F3F8FC" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                        <ItemsControl x:Name="IcKhuVuc" Margin="4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                        <Border Style="{StaticResource TileButton}" Height="50"
                                            Background="{Binding MauNenBrush}"
                                                Tag="KhuVuc"
                                            MouseDown="Item_MouseDown">
                                        <TextBlock Text="{Binding Name}" 
                                                   Foreground="White" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" TextAlignment="Center" Margin="4"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Column 2: Nhóm Hàng -->
            <Border Grid.Column="1" Margin="4" Background="#FFFFFF" BorderBrush="#C7D7E5" BorderThickness="1" CornerRadius="4">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="TxtHeaderNhomHang" Text="NHÓM MÓN" Style="{StaticResource TouchGroupHeader}"/>
                    </StackPanel>
                    <DockPanel DockPanel.Dock="Bottom" Background="#F3F7FA" LastChildFill="False">
                        <Button x:Name="BtnSettingNhomHang" DockPanel.Dock="Right"
                                Content="⚙ Cài đặt" Click="BtnSettingNhomHang_Click"
                                Margin="4" Padding="8,4" FontSize="12" Background="#E8F2FB" BorderBrush="#2F6F9F"/>
                    </DockPanel>
                    <ScrollViewer x:Name="SvNhomHang" Background="#F5F8FC" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                        <ItemsControl x:Name="IcNhomHang" Margin="4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                        <Border CornerRadius="6" Margin="4" Height="70" Tag="NhomHang"
                                            Background="{Binding MauNenBrush}"
                                            MouseDown="Item_MouseDown" Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#F29F05"/>
                                                        <Setter Property="BorderThickness" Value="3"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" 
                                                       Foreground="White" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" TextWrapping="Wrap" 
                                                       TextAlignment="Center" Margin="4,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Column 3: Mặt Hàng (main area) -->
            <Border Grid.Column="2" Margin="4" Background="#FFFFFF" BorderBrush="#C7D7E5" BorderThickness="1" CornerRadius="4">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="TxtHeaderMatHang" Text="MẶT HÀNG" Style="{StaticResource TouchGroupHeader}"/>
                    </StackPanel>
                    <DockPanel DockPanel.Dock="Bottom" Background="#F3F7FA" LastChildFill="False">
                        <Button x:Name="BtnSettingMatHang" DockPanel.Dock="Right"
                                Content="⚙ Cài đặt" Click="BtnSettingMatHang_Click"
                                Margin="4" Padding="8,4" FontSize="12" Background="#E8F2FB" BorderBrush="#2F6F9F"/>
                    </DockPanel>
                    <ScrollViewer x:Name="SvMatHang" Background="#F7FAFC" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                        <ItemsControl x:Name="IcMatHang" Margin="4">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="145" CornerRadius="6" Margin="4" Tag="MatHang"
                                            MouseDown="Item_MouseDown" Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#F29F05"/>
                                                        <Setter Property="BorderThickness" Value="3"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.Background>
                                            <Binding Path="MauNenBrush"/>
                                        </Border.Background>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image Source="{Binding Anh}" Width="40" Height="40" Margin="0,4,0,4"
                                                   Stretch="Uniform"/>
                                            <TextBlock Text="{Binding Name}" 
                                                       Foreground="White" FontSize="11" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" TextWrapping="Wrap" 
                                                       TextAlignment="Center" Margin="4,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Column 4: Thuộc tính / Preview -->
            <Border Grid.Column="3" Margin="4" Background="#FFFFFF" BorderBrush="#C7D7E5" BorderThickness="1" CornerRadius="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="THUỘC TÍNH" Style="{StaticResource TouchGroupHeader}"/>
                    <StackPanel Margin="8" VerticalAlignment="Top">
                        <!-- Image Preview -->
                        <TextBlock Text="Ảnh đại diện:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Border BorderBrush="#C7D7E5" BorderThickness="1" Width="160" Height="120" Margin="0,0,0,8" HorizontalAlignment="Left" Background="#F8FBFD">
                            <Image x:Name="ImgItemPreview" Stretch="Uniform" Margin="4"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button x:Name="BtnBrowseImage" Content="📷 Chọn ảnh" Click="BtnBrowseImage_Click"
                                    Padding="8,4" FontSize="12" Background="#E8F2FB" BorderBrush="#2F6F9F" Margin="0,0,4,0"/>
                            <Button x:Name="BtnDeleteImage" Content="🗑 Xóa ảnh" Click="BtnDeleteImage_Click"
                                    Padding="8,4" FontSize="12" Background="#FFEBEE" BorderBrush="#E53935"/>
                        </StackPanel>

                        <!-- Màu sắc -->
                        <TextBlock Text="Màu nền:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Button x:Name="BtnMauSac" Content="🎨 Chọn màu" Click="BtnMauSac_Click"
                                HorizontalAlignment="Left" Padding="8,4" FontSize="12" 
                            Background="#E8F2FB" BorderBrush="#2F6F9F" Margin="0,0,0,8"/>
                        
                        <!-- Color Palette (hidden by default) -->
                        <Border x:Name="BorderColorPalette" Visibility="Collapsed" 
                                BorderBrush="#C7D7E5" BorderThickness="1" CornerRadius="4" Padding="4" Margin="0,0,0,8" Background="#F8FBFD">
                            <ItemsControl x:Name="IcColorMatrix">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="28" Height="28" CornerRadius="3" Margin="2"
                                                Background="{Binding}" Cursor="Hand"
                                                MouseDown="ColorTile_MouseDown"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <Separator Margin="0,8"/>

                        <!-- Thiết kế vị trí -->
                        <Button x:Name="BtnThietKeViTri" Content="📐 Thiết kế vị trí" Click="BtnThietKeViTri_Click"
                                HorizontalAlignment="Stretch" Padding="8,6" FontSize="12" Margin="0,0,0,4"
                                Background="#E8F5F1" BorderBrush="#2C8A72"/>
                        <Button x:Name="BtnThietLapMauNhanh" Content="⚡ THIẾT LẬP MÀU NHANH" Click="BtnThietLapMauNhanh_Click"
                                HorizontalAlignment="Stretch" Padding="8,6" FontSize="12" Margin="0,0,0,4"
                                Background="#FFF4DE" BorderBrush="#D98900"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Background="#E8F0F5" Padding="8,6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnRefreshLayout" Content="🔄 Tải lại" Click="BtnRefreshLayout_Click"
                        Padding="16,6" FontSize="13" Margin="0,0,8,0"
                        Background="#E8F2FB" BorderBrush="#2F6F9F" Foreground="#145DA0"/>
                <Button x:Name="BtnSaveLayout" Content="💾 Lưu bố cục" Click="BtnSaveLayout_Click"
                        Padding="16,6" FontSize="13" FontWeight="SemiBold"
                        Background="#1769AA" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
