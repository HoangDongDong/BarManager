<UserControl x:Class="QuanLyBar.Client.Views.CauHinhHeThong.ThietKeGiaoDienCamUngControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200"
             Loaded="UserControl_Loaded"
             SizeChanged="UserControl_SizeChanged">
    <UserControl.Resources>
        <Style x:Key="TouchGroupHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="4,4,4,4"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style x:Key="SettingGearButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Cài đặt thuộc tính &amp; vị trí"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12">
                            <TextBlock Text="⚙" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3A7080"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RightSideButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#659BB0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Custom ScrollBar & ScrollViewer Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true">
                            <!-- Track Track Container -->
                            <Track x:Name="PART_Track" IsDirectionReversed="true" HorizontalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{x:Null}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Rectangle Fill="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#1C5E73" BorderBrush="#659BB0" BorderThickness="1.5" CornerRadius="12" Width="22"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{x:Null}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Rectangle Fill="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid x:Name="Grid" Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Column="0" CanContentScroll="{TemplateBinding CanContentScroll}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" AutomationProperties.AutomationId="VerticalScrollBar" 
                                       Cursor="Hand" Maximum="{TemplateBinding ScrollableHeight}" Minimum="0" 
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                       ViewportSize="{TemplateBinding ViewportHeight}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#004052">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Main Content Layout -->
        <Grid Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT 1: KHU VỰC -->
            <Grid Grid.Column="0" Margin="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <TextBlock Text="KHU VỰC" Style="{StaticResource TouchGroupHeader}" HorizontalAlignment="Left"/>
                    <Button x:Name="BtnSettingKhuVuc" Style="{StaticResource SettingGearButton}" HorizontalAlignment="Right" Click="BtnSettingKhuVuc_Click"/>
                </Grid>

                <ScrollViewer Grid.Row="1" x:Name="SvKhuVuc" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="ScrollViewer_SizeChanged">
                    <ItemsControl x:Name="IcKhuVuc">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="{Binding ItemHeight, FallbackValue=75}" CornerRadius="12" Margin="0,0,0,6" Tag="KhuVuc"
                                        Background="{Binding MauNenBrush}" MouseDown="Item_MouseDown" Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="#A0D0E0"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#FFDF00"/>
                                                    <Setter Property="BorderThickness" Value="3"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="13"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextWrapping="Wrap" TextAlignment="Center" Margin="6"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- CỘT 2: NHÓM HÀNG -->
            <Grid Grid.Column="1" Margin="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <TextBlock Text="NHÓM HÀNG" Style="{StaticResource TouchGroupHeader}" HorizontalAlignment="Left"/>
                    <Button x:Name="BtnSettingNhomHang" Style="{StaticResource SettingGearButton}" HorizontalAlignment="Right" Click="BtnSettingNhomHang_Click"/>
                </Grid>

                <ScrollViewer Grid.Row="1" x:Name="SvNhomHang" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="ScrollViewer_SizeChanged">
                    <ItemsControl x:Name="IcNhomHang">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="{Binding ItemHeight, FallbackValue=68}" CornerRadius="12" Margin="0,0,0,6" Tag="NhomHang"
                                        Background="{Binding MauNenBrush}" MouseDown="Item_MouseDown" Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="#A0D0E0"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#FFDF00"/>
                                                    <Setter Property="BorderThickness" Value="3"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextWrapping="Wrap" TextAlignment="Center" Margin="6"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- CỘT 3: MẶT HÀNG -->
            <Grid Grid.Column="2" Margin="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <TextBlock Text="MẶT HÀNG" Style="{StaticResource TouchGroupHeader}" HorizontalAlignment="Left"/>
                    <Button x:Name="BtnSettingMatHang" Style="{StaticResource SettingGearButton}" HorizontalAlignment="Right" Click="BtnSettingMatHang_Click"/>
                </Grid>

                <ScrollViewer Grid.Row="1" x:Name="SvMatHang" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="ScrollViewer_SizeChanged">
                    <ItemsControl x:Name="IcMatHang">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="{Binding ItemHeight, FallbackValue=62}" CornerRadius="10" Margin="3" Tag="MatHang"
                                        Background="{Binding MauNenBrush}" MouseDown="Item_MouseDown" Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="#B0E0F0"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#FFDF00"/>
                                                    <Setter Property="BorderThickness" Value="3"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid Margin="4">
                                        <DockPanel LastChildFill="True" Visibility="{Binding HasImageVisibility}">
                                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Name}" Foreground="White" FontSize="11" FontWeight="Bold"
                                                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,2,0,0"/>
                                            <Image Source="{Binding AnhImageSource}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <TextBlock Visibility="{Binding NoImageVisibility}" Text="{Binding Name}" Foreground="White" FontSize="12" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="4"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- CỘT 4: THUỘC TÍNH & NÚT THAO TÁC PHẢI -->
            <Grid Grid.Column="3" Margin="6,3,3,3">
                <DockPanel LastChildFill="True">
                    <!-- Ảnh đại diện Box ở trên cùng -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Ảnh:" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="34"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderBrush="#659BB0" BorderThickness="1" Height="140" Background="#002D3A" CornerRadius="4">
                                <Image x:Name="ImgItemPreview" Stretch="Uniform" Margin="4"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Top">
                                <Button x:Name="BtnBrowseImage" Width="28" Height="28" Margin="0,0,0,4" 
                                        Background="#1C5E73" BorderBrush="#659BB0" ToolTip="Chọn ảnh" Click="BtnBrowseImage_Click" Cursor="Hand">
                                    <TextBlock Text="🖼" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Button x:Name="BtnDeleteImage" Width="28" Height="28" Margin="0,0,0,4"
                                        Background="#8B2626" BorderBrush="#D32F2F" ToolTip="Xóa ảnh" Click="BtnDeleteImage_Click" Cursor="Hand">
                                    <TextBlock Text="✖" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Màu sắc Palette Popover nếu mở -->
                    <StackPanel DockPanel.Dock="Top">
                        <Button x:Name="BtnMauSac" Content="Màu sắc" Style="{StaticResource RightSideButton}" Background="#1C5E73" Click="BtnMauSac_Click"/>
                        
                        <Border x:Name="BorderColorPalette" Visibility="Collapsed" 
                                BorderBrush="#659BB0" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,0,0,8" Background="#002D3A">
                            <ItemsControl x:Name="IcColorMatrix">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="26" Height="26" CornerRadius="3" Margin="2"
                                                Background="{Binding}" Cursor="Hand"
                                                MouseDown="ColorTile_MouseDown"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <Button x:Name="BtnThietKeViTri" Content="THIẾT KẾ VỊ TRÍ" Style="{StaticResource RightSideButton}" Background="#C95B16" Click="BtnThietKeViTri_Click"/>
                        <Button x:Name="BtnThietLapMauNhanh" Content="THIẾT LẬP MÀU NHANH" Style="{StaticResource RightSideButton}" Background="#005A44" Click="BtnThietLapMauNhanh_Click"/>
                    </StackPanel>

                    <Grid/>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
