<Window x:Class="QuanLyBar.Client.Views.CauHinhHeThong.ThietLapDinhDangThanhPhanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thiết lập cột hiển thị" WindowStyle="None" WindowState="Maximized"
        WindowStartupLocation="CenterScreen" Background="#0D4B5B">
    <Window.Resources>
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="16,4"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#777777"/>
            <Setter Property="BorderBrush" Value="#B6D1DC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Metallic Silver Button Style for THÊM, XÓA, Lên, Xuống -->
        <Style x:Key="SilverMetallicButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="3,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" BorderBrush="#D0D0D0" BorderThickness="1.5" CornerRadius="10" Padding="12,4">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#9E9E9E" Offset="0"/>
                                    <GradientStop Color="#757575" Offset="0.5"/>
                                    <GradientStop Color="#5A5A5A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#B5B5B5" Offset="0"/>
                                            <GradientStop Color="#8A8A8A" Offset="0.5"/>
                                            <GradientStop Color="#6E6E6E" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Green Metallic Button Style for XÓA HẾT -->
        <Style x:Key="GreenMetallicButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="3,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" BorderBrush="#4ADE80" BorderThickness="1.5" CornerRadius="10" Padding="12,4">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#1E7A34" Offset="0"/>
                                    <GradientStop Color="#125422" Offset="0.5"/>
                                    <GradientStop Color="#0B3916" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#86EFAC"/>
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#279442" Offset="0"/>
                                            <GradientStop Color="#176B2D" Offset="0.5"/>
                                            <GradientStop Color="#0F4C1F" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColumnTileStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="2,3"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="#004D40"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#36B5B0" BorderThickness="1.5" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="#0A3340"/>
            <Setter Property="BorderBrush" Value="#1C4B6B"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ColumnTileStyle}"/>
        </Style>

        <!-- Custom Metallic ScrollBar & ScrollViewer Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- SCROLL UP BUTTON -->
                            <RepeatButton Grid.Row="0" Command="{x:Static ScrollBar.LineUpCommand}" Height="30" Margin="0,0,0,3" Cursor="Hand">
                                <RepeatButton.Template>
                                    <ControlTemplate TargetType="RepeatButton">
                                        <Border BorderBrush="#D0D0D0" BorderThickness="1.5" CornerRadius="8">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#9E9E9E" Offset="0"/>
                                                    <GradientStop Color="#686868" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="▲" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>

                            <!-- SCROLL TRACK & THUMB -->
                            <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="true" HorizontalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{x:Null}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Rectangle Fill="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border BorderBrush="#659BB0" BorderThickness="1.5" CornerRadius="12" Width="22">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#1C5E73" Offset="0"/>
                                                            <GradientStop Color="#2C809B" Offset="0.5"/>
                                                            <GradientStop Color="#1C5E73" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{x:Null}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Rectangle Fill="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>

                            <!-- SCROLL DOWN BUTTON -->
                            <RepeatButton Grid.Row="2" Command="{x:Static ScrollBar.LineDownCommand}" Height="30" Margin="0,3,0,0" Cursor="Hand">
                                <RepeatButton.Template>
                                    <ControlTemplate TargetType="RepeatButton">
                                        <Border BorderBrush="#D0D0D0" BorderThickness="1.5" CornerRadius="8">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#9E9E9E" Offset="0"/>
                                                    <GradientStop Color="#686868" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="▼" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid x:Name="Grid" Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Column="0" CanContentScroll="{TemplateBinding CanContentScroll}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" AutomationProperties.AutomationId="VerticalScrollBar" 
                                       Cursor="Hand" Maximum="{TemplateBinding ScrollableHeight}" Minimum="0" 
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                       ViewportSize="{TemplateBinding ViewportHeight}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="LayoutRoot" Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER BANNER -->
        <Border Grid.Row="0" Background="#0C3D4B" BorderBrush="#1C5E73" BorderThickness="1" CornerRadius="4" Margin="0,0,0,6">
            <TextBlock Text="THIẾT LẬP CỘT HIỂN THỊ" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- COLUMNS SELECTION GRID -->
        <Grid Grid.Row="2" Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="135"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT UNUSED LISTBOX + PREVIEW CARD -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="CÁC CỘT KHÔNG SỬ DỤNG" Foreground="White" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                <ListBox x:Name="LstUnused" Grid.Row="1" Style="{StaticResource ListBoxStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding SelectedColumnCount, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Top"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Viewbox StretchDirection="DownOnly" MaxHeight="24" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Viewbox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="2,3"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="Background" Value="{Binding SelectedColorBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="#36B5B0" BorderThickness="1.5" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#D35400"/>
                                                <Setter TargetName="border" Property="BorderBrush" Value="#F39C12"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- LIVE CARD PREVIEW (Matches outside screen exactly) -->
                <Border x:Name="CardPreviewBorder" Grid.Row="2" Height="110" Margin="0,6,0,0"
                        Background="{Binding SelectedColorBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                        BorderBrush="#5F8F93" BorderThickness="1.5" CornerRadius="6" Padding="12,8" Visibility="Collapsed">
                    <Grid x:Name="GridCardPreview">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT STACK: BAN, NGAY, NHAN VIEN, KHACH HANG, SO PHIEU -->
                        <StackPanel x:Name="StkPreviewLeft" Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtPreviewBan" Text="Bàn 01" Foreground="White" FontSize="15" FontWeight="Bold" Margin="0,0,0,2"/>
                            <TextBlock x:Name="TxtPreviewNgay" Text="30/08/2026" Foreground="#E0E0E0" FontSize="13" Margin="0,0,0,2"/>
                            <TextBlock x:Name="TxtPreviewNhanVien" Text="Nhân viên A" Foreground="#E0E0E0" FontSize="13" Margin="0,0,0,2"/>
                            <TextBlock x:Name="TxtPreviewKhachHang" Text="Khách hàng B" Foreground="#E0E0E0" FontSize="13" Margin="0,0,0,2"/>
                            <TextBlock x:Name="TxtPreviewSoPhieu" Text="HD26/00001" Foreground="#E0E0E0" FontSize="13"/>
                        </StackPanel>

                        <!-- RIGHT: TONG CONG -->
                        <TextBlock x:Name="TxtPreviewTongCong" Grid.Column="1" Text="450,000" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- MIDDLE ACTION BUTTONS -->
            <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="6,30,6,0">
                <Button Content="THÊM  >>" Click="BtnAdd_Click" Style="{StaticResource SilverMetallicButton}"/>
                <Button Content="&lt;&lt; XÓA" Click="BtnRemove_Click" Style="{StaticResource SilverMetallicButton}"/>
                <Button Content="&lt;&lt; XÓA HẾT" Click="BtnRemoveAll_Click" Style="{StaticResource GreenMetallicButton}"/>
            </StackPanel>

            <!-- RIGHT USED LISTBOX -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="CÁC CỘT SỬ DỤNG" Foreground="White" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                <ListBox x:Name="LstUsed" Grid.Row="1" Style="{StaticResource ListBoxStyle}" SelectionChanged="LstUsed_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding SelectedColumnCount, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Top"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Viewbox StretchDirection="DownOnly" MaxHeight="24" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Viewbox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="2,3"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="Background" Value="{Binding SelectedColorBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="#36B5B0" BorderThickness="1.5" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#D35400"/>
                                                <Setter TargetName="border" Property="BorderBrush" Value="#F39C12"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>

            <!-- FAR RIGHT MOVE BUTTONS -->
            <StackPanel x:Name="MoveButtonsPanel" Grid.Column="3" VerticalAlignment="Top" Margin="6,30,0,0">
                <Button Content="Lên" Click="BtnMoveUp_Click" Style="{StaticResource SilverMetallicButton}"/>
                <Button Content="Xuống" Click="BtnMoveDown_Click" Style="{StaticResource SilverMetallicButton}"/>
            </StackPanel>
        </Grid>

        <!-- FORMAT SUB OPTIONS (PREVIEW + ALIGN + BOLD/ITALIC + SHORT TITLE) -->
        <Grid x:Name="PanelFormatSubOptions" Grid.Row="3" Margin="0,8,0,4" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PREVIEW BOX -->
            <Border Grid.Column="0" Height="80" Background="#004D40" BorderBrush="#36B5B0" BorderThickness="1.5" CornerRadius="6" Padding="8">
                <TextBlock x:Name="TxtPreviewItemName" Text="Bàn" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- MIDDLE FORMAT BUTTONS -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Content="CĂN TRÁI" Style="{StaticResource DarkButton}" Height="34" Width="90" Background="#6C757D"/>
                    <Button Content="CĂN PHẢI" Style="{StaticResource DarkButton}" Height="34" Width="90" Background="#6C757D"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="ĐẬM" Style="{StaticResource DarkButton}" Height="34" Width="60" Background="#6C757D"/>
                    <Button Content="NGHIÊNG" Style="{StaticResource DarkButton}" Height="34" Width="75" Background="#6C757D"/>
                    <Button Content="CỠ CHỮ" Style="{StaticResource DarkButton}" Height="34" Width="70" Background="#6C757D"/>
                    <Button Content="MÀU CHỮ" Style="{StaticResource DarkButton}" Height="34" Width="75" Background="#6C757D"/>
                </StackPanel>
            </StackPanel>

            <!-- RIGHT SHORT TITLE INPUT -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock Text="Tiêu đề viết tắt" Foreground="White" FontWeight="Bold" FontSize="12" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="TxtShortTitle" Width="100" Height="36" FontSize="14" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                    <Button Content="⌨" Style="{StaticResource DarkButton}" Width="38" Height="36" Margin="4,0,0,0" Background="#18566A" FontSize="16"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="BtnFormatToggle" Content="ĐỊNH DẠNG" Click="BtnFormat_Click" Style="{StaticResource DarkButton}" Background="#C95B16"/>
            <StackPanel x:Name="PanelFormatOptions" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0,0,0" Visibility="Collapsed">
                <Button x:Name="BtnColumnCount" Content="SỐ CỘT: 3" Click="BtnColumnCount_Click" Style="{StaticResource DarkButton}" Background="#5C5C00" Width="130"/>
                <Button x:Name="BtnRowCount" Content="SỐ DÒNG: 8" Click="BtnRowCount_Click" Style="{StaticResource DarkButton}" Background="#5C5C00" Width="140"/>
                <Button x:Name="BtnCellColor" Content="MÀU Ô" Click="BtnCellColor_Click" Style="{StaticResource DarkButton}" Background="#5C5C00" Width="120"/>
                <Button x:Name="BtnShowTitle" Content="HIỆN TIÊU ĐỀ" Click="BtnShowTitle_Click" Style="{StaticResource DarkButton}" Background="#5C5C00" Width="150"/>
            </StackPanel>
            <Button Grid.Column="2" Content="CẬP NHẬT" Click="BtnApply_Click" Style="{StaticResource DarkButton}" Background="#126B1A" Width="120"/>
            <Button Grid.Column="3" Content="THOÁT" Click="BtnCancel_Click" Style="{StaticResource DarkButton}" Background="#A91515" Width="110"/>
        </Grid>

        <Border x:Name="NumericPadOverlay" Grid.RowSpan="4" Width="420" Height="530"
                HorizontalAlignment="Center" VerticalAlignment="Center" Background="#0D4B5B"
                BorderBrush="#B6D1DC" BorderThickness="1" Visibility="Collapsed">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/><RowDefinition Height="72"/>
                    <RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/>
                    <RowDefinition Height="*"/><RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#994B00" CornerRadius="8" Padding="8">
                    <TextBlock x:Name="TxtNumericPadTitle" Text="NHẬP GIÁ TRỊ" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Grid Grid.Row="1" Margin="0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtNumericValue" Grid.Column="0" Text="0" FontSize="40" FontWeight="Bold" TextAlignment="Center" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1" Content="⌫" Click="BtnNumericBackspace_Click" Style="{StaticResource DarkButton}" Background="#D95B16" FontSize="28"/>
                </Grid>
                <UniformGrid Grid.Row="2" Columns="3">
                    <Button Content="1" Click="NumericKey_Click" Tag="1" Style="{StaticResource DarkButton}" FontSize="28" Background="#18566A"/>
                    <Button Content="2" Click="NumericKey_Click" Tag="2" Style="{StaticResource DarkButton}" FontSize="28" Background="#18566A"/>
                    <Button Content="3" Click="NumericKey_Click" Tag="3" Style="{StaticResource DarkButton}" FontSize="28" Background="#18566A"/>
                </UniformGrid>
                <UniformGrid Grid.Row="3" Columns="3">
                    <Button Content="4" Click="NumericKey_Click" Tag="4" Style="{StaticResource DarkButton}" FontSize="28" Background="#18566A"/>
                    <Button Content="5" Click="NumericKey_Click" Tag="5" Style="{StaticResource DarkButton}" FontSize="28" Background="#18566A"/>
                    <Button Content="6" Click="NumericKey_Click" Tag="6" Style="{StaticResource DarkButton}" FontSize="28" Background="#18566A"/>
                </UniformGrid>
                <UniformGrid Grid.Row="4" Columns="3">
                    <Button Content="7" Click="NumericKey_Click" Tag="7" Style="{StaticResource DarkButton}" FontSize="28" Background="#18566A"/>
                    <Button Content="8" Click="NumericKey_Click" Tag="8" Style="{StaticResource DarkButton}" FontSize="28" Background="#18566A"/>
                    <Button Content="9" Click="NumericKey_Click" Tag="9" Style="{StaticResource DarkButton}" FontSize="28" Background="#18566A"/>
                </UniformGrid>
                <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="0" Click="NumericKey_Click" Tag="0" Style="{StaticResource DarkButton}" FontSize="28" Background="#18566A"/>
                    <Button Grid.Column="1" Content="▶" Click="BtnNumericConfirm_Click" Style="{StaticResource DarkButton}" FontSize="28" Background="#126B1A"/>
                </Grid>
                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="000" Click="NumericKey_Click" Tag="000" Style="{StaticResource DarkButton}" FontSize="24" Background="#18566A"/>
                    <Button Grid.Column="1" Content="HỦY BỎ" Click="BtnNumericCancel_Click" Style="{StaticResource DarkButton}" FontSize="20" Background="#A91515"/>
                </Grid>
            </Grid>
