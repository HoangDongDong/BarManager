<Window x:Class="QuanLyBar.Client.Views.DanhMucDonViTinhWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đơn vị tính" Height="450" Width="400"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header info -->
        <StackPanel Orientation="Horizontal" Margin="10">
            <TextBlock Text="📝" FontSize="32" Margin="0,0,10,0"/>
            <TextBlock Text="Cho phép bạn quản lý và chỉnh sửa danh mục đơn vị tính" VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>

        <!-- ToolBar -->
        <ToolBar Grid.Row="1" Background="#dfe7f5" Padding="5">
            <Button x:Name="BtnThemMoi" Content="➕ Thêm mới" Margin="0,0,5,0" Click="BtnThemMoi_Click"/>
            <Button x:Name="BtnXoa" Content="❌ Xóa" Margin="0,0,5,0" Click="BtnXoa_Click"/>
            <Button x:Name="BtnChinhSua" Content="✏️ Chỉnh sửa" Margin="0,0,5,0" Click="BtnChinhSua_Click"/>
            <Separator/>
            <Button Content="🔄 Tải lại" Margin="0,0,5,0" Click="BtnTaiLai_Click"/>
        </ToolBar>

        <!-- Main List -->
        <ListView x:Name="LvDonViTinh" Grid.Row="2" Margin="10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Tên đơn vị tính" DisplayMemberBinding="{Binding Name}" Width="300"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10" Background="#f0f0f0" Height="40">
            <Button Content="Thoát" Width="80" Click="BtnThoat_Click"/>
        </StackPanel>
    </Grid>
</Window>
