<UserControl x:Class="QuanLyBar.Client.Views.DanhMucMatHangControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:models="clr-namespace:QuanLyBar.Client.Models"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             Loaded="UserControl_Loaded">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ToolBar -->
        <ToolBar Grid.Row="0" Background="#f0f0f0">
            <Label Content="Lọc (F3):" VerticalAlignment="Center"/>
            <TextBox Width="150" Margin="0,0,10,0"/>
            <Separator/>
            <Button Content="➕ Thêm mới (Insert)" Padding="5" Click="BtnThemMoi_Click"/>
            <Button Content="✏️ Chỉnh sửa (F4)" Padding="5" Click="BtnChinhSua_Click"/>
            <Button x:Name="BtnXoa" Content="❌ Xóa (Del)" Padding="5" Click="BtnXoa_Click"/>
            <Separator/>
            <Button x:Name="BtnThemExcel" Content="Thêm excel" Padding="5" Click="BtnThemExcel_Click"/>
            <Button x:Name="BtnXuatExcel" Content="Xuất excel" Padding="5" Click="BtnXuatExcel_Click"/>
            <Button Content="Import định lượng" Padding="5" Click="BtnImportDinhLuong_Click"/>
            <Button x:Name="BtnIn" Content="In" Padding="5" Click="BtnIn_Click"/>
            <Button x:Name="BtnInMaVach" Content="In mã vạch" Padding="5" Click="BtnInMaVach_Click"/>
        </ToolBar>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" x:Name="ColMatHang"/>
                <ColumnDefinition Width="Auto" x:Name="ColSplitterInMaVach"/>
                <ColumnDefinition Width="0" x:Name="ColInMaVach"/>
            </Grid.ColumnDefinitions>

            <!-- TreeView: Nhóm mặt hàng -->
            <Border Grid.Column="0" BorderBrush="LightGray" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Background="#dfe7f5" Padding="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Nhóm mặt hàng" FontWeight="Bold" VerticalAlignment="Center"/>
                            <ToolBar Grid.Column="1" Background="Transparent" Padding="0" Margin="0,-3,0,-3">
                                <Button ToolTip="Thêm mới Nhóm mặt hàng" Padding="2" Click="BtnThemNhom_Click">
                                    <TextBlock Text="➕" Foreground="Green"/>
                                </Button>
                                <Button ToolTip="Chỉnh sửa" Padding="2">
                                    <TextBlock Text="✏️"/>
                                </Button>
                                <Button ToolTip="Tạo mới thư mục" Padding="2" Click="BtnThemThuMuc_Click">
                                    <TextBlock Text="📁"/>
                                </Button>
                                <Button ToolTip="Hiển thị tất cả dữ liệu theo thư mục" Padding="2">
                                    <TextBlock Text="🗂️"/>
                                </Button>
                                <Button ToolTip="Tải lại" Padding="2" Click="BtnTaiLaiNhom_Click">
                                    <TextBlock Text="🔄"/>
                                </Button>
                            </ToolBar>
                        </Grid>
                    </Border>
                    
                    <TreeView Grid.Row="1" x:Name="TvNhomMatHang" SelectedItemChanged="TvNhomMatHang_SelectedItemChanged">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type models:NhomMatHangViewModel}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="📁 " Foreground="Goldenrod" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <!-- Bind IsExpanded via style -->
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="{x:Type TreeViewItem}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="LightGray"/>

            <!-- DataGrid: Mặt hàng -->
            <Border Grid.Column="2" BorderBrush="LightGray" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Background="#dfe7f5" Padding="5">
                        <TextBlock Text="Mặt hàng" FontWeight="Bold"/>
                    </Border>

                    <DataGrid Grid.Row="1" x:Name="DgMatHang" AutoGenerateColumns="False" 
                              CanUserAddRows="False" IsReadOnly="True" 
                              AlternatingRowBackground="#f9f9f9" GridLinesVisibility="All">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT" Binding="{Binding Stt}" Width="50"/>
                            <DataGridTextColumn Header="Tên mặt hàng" Binding="{Binding Name}" Width="200" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Nhóm mặt hàng" Binding="{Binding NhomMatHangName}" Width="150"/>
                            <DataGridTextColumn Header="Loại mặt hàng" Binding="{Binding LoaiMatHangName}" Width="120"/>
                            <DataGridTextColumn Header="Đơn vị tính" Binding="{Binding DonViTinhName}" Width="80"/>
                            <DataGridTextColumn Header="Giá bán" Binding="{Binding Giaban, StringFormat={}{0:N0}}" Width="100"/>
                            <DataGridTextColumn Header="Giá nhập" Binding="{Binding Gianhap, StringFormat={}{0:N0}}" Width="100"/>
                            <DataGridTextColumn Header="ĐVT chẵn" Binding="{Binding DonViTinhChanName}" Width="80"/>
                            <DataGridTextColumn Header="Quy đổi" Binding="{Binding Quydoi}" Width="80"/>
                            <DataGridTextColumn Header="Giá bán chẵn" Binding="{Binding Giabanchan, StringFormat={}{0:N0}}" Width="100"/>
                            <DataGridTextColumn Header="Mã hàng" Binding="{Binding Code}" Width="100"/>
                            <DataGridTextColumn Header="Tạm khóa" Binding="{Binding Tamkhoa}" Width="80"/>
                            <DataGridTextColumn Header="Giá theo thời giá" Binding="{Binding Giatheothoigia, StringFormat={}{0:N0}}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- GridSplitter cho In mã vạch -->
            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="LightGray" Visibility="Collapsed" x:Name="GsInMaVach"/>

            <!-- Khung In mã vạch -->
            <Border Grid.Column="4" BorderBrush="LightGray" BorderThickness="1" x:Name="PanelInMaVach" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="#dfe7f5" Padding="5">
                        <TextBlock Text="IN MÃ VẠCH" FontWeight="Bold"/>
                    </Border>

                    <ToolBar Grid.Row="1" Background="Transparent" Padding="0">
                        <Button x:Name="BtnThemMaVach" Padding="5" Click="BtnThemMaVach_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="➡️" Foreground="Blue" Margin="0,0,5,0"/>
                                <TextBlock Text="Thêm"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnXoaMaVach" Padding="5" Click="BtnXoaMaVach_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="❌" Foreground="Red" Margin="0,0,5,0"/>
                                <TextBlock Text="Xóa"/>
                            </StackPanel>
                        </Button>
                        <Separator/>
                        <Button x:Name="BtnXuatExcelMaVach" Content="Xuất excel" Padding="5" Click="BtnXuatExcelMaVach_Click"/>
                        <Button x:Name="BtnInBarcode" Content="In" Padding="5" Click="BtnInBarcode_Click"/>
                        <Button x:Name="BtnBartender" Content="Bartender" Padding="5" Click="BtnBartender_Click"/>
                    </ToolBar>

                    <DataGrid Grid.Row="2" x:Name="DgInMaVach" AutoGenerateColumns="False" 
                              CanUserAddRows="False" IsReadOnly="False" 
                              AlternatingRowBackground="#f9f9f9" GridLinesVisibility="All">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="200" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- StatusBar -->
        <StatusBar Grid.Row="2" Background="#f0f0f0">
            <StatusBarItem>
                <TextBlock Text="Khởi tạo: "/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="Khởi tạo bởi: "/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
