<UserControl x:Class="QuanLyBar.Client.Views.DanhMucMatHangControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:models="clr-namespace:QuanLyBar.Client.Models"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             Loaded="UserControl_Loaded">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ToolBar -->
        <ToolBar Grid.Row="0" Background="#f0f0f0">
            <Label Content="Lọc (F3):" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtLocMatHang" Width="150" Margin="0,0,10,0" TextChanged="TxtLocMatHang_TextChanged"/>
            <Separator/>
            <Button x:Name="BtnThemMoi" Content="➕ Thêm mới (Insert)" Padding="5" Click="BtnThemMoi_Click"/>
            <Button x:Name="BtnChinhSua" Content="✏️ Chỉnh sửa (F4)" Padding="5" Click="BtnChinhSua_Click"/>
            <Button x:Name="BtnXoa" Content="❌ Xóa (Del)" Padding="5" Click="BtnXoa_Click"/>
            <Separator/>
            <Button x:Name="BtnThemExcel" Content="Thêm excel" Padding="5" Click="BtnThemExcel_Click"/>
            <Button x:Name="BtnXuatExcel" Content="Xuất excel" Padding="5" Click="BtnXuatExcel_Click"/>
            <Button x:Name="BtnImportDinhLuong" Content="Import định lượng" Padding="5" Click="BtnImportDinhLuong_Click"/>
            <Button x:Name="BtnIn" Content="In" Padding="5" Click="BtnIn_Click"/>
            <Button x:Name="BtnInMaVach" Content="In mã vạch" Padding="5" Click="BtnInMaVach_Click"/>
        </ToolBar>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" x:Name="ColMatHang"/>
                <ColumnDefinition Width="Auto" x:Name="ColSplitterInMaVach"/>
                <ColumnDefinition Width="0" x:Name="ColInMaVach"/>
            </Grid.ColumnDefinitions>

            <!-- TreeView: Nhóm mặt hàng -->
            <Border Grid.Column="0" BorderBrush="LightGray" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Background="#dfe7f5" Padding="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Nhóm mặt hàng" FontWeight="Bold" VerticalAlignment="Center"/>
                            <ToolBar Grid.Column="1" Background="Transparent" Padding="0" Margin="0,-3,0,-3">
                                <Button ToolTip="Thêm mới Nhóm mặt hàng" Padding="2" Click="BtnThemNhom_Click">
                                    <TextBlock Text="➕" Foreground="Green"/>
                                </Button>
                                <Button ToolTip="Chỉnh sửa" Padding="2">
                                    <TextBlock Text="✏️"/>
                                </Button>
                                <Button ToolTip="Tạo mới thư mục" Padding="2" Click="BtnThemThuMuc_Click">
                                    <TextBlock Text="📁"/>
                                </Button>
                                <Button ToolTip="Hiển thị tất cả dữ liệu theo thư mục" Padding="2">
                                    <TextBlock Text="🗂️"/>
                                </Button>
                                <Button ToolTip="Tải lại" Padding="2" Click="BtnTaiLaiNhom_Click">
                                    <TextBlock Text="🔄"/>
                                </Button>
                            </ToolBar>
                        </Grid>
                    </Border>
                    
                    <TreeView Grid.Row="1" x:Name="TvNhomMatHang" SelectedItemChanged="TvNhomMatHang_SelectedItemChanged">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type models:NhomMatHangViewModel}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Thêm mới" Click="MenuItem_ThemMoi_Click" />
                                            <MenuItem Header="Thêm mới con" Click="MenuItem_ThemMoiCon_Click" />
                                            <Separator />
                                            <MenuItem Header="Sửa đổi" Click="MenuItem_SuaDoi_Click" />
                                            <MenuItem Header="Xóa" Click="MenuItem_Xoa_Click" />
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                    <TextBlock Text="📁 " Foreground="Goldenrod" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                             VerticalAlignment="Center" 
                                             Loaded="InlineEditTextBox_Loaded"
                                             IsVisibleChanged="InlineEditTextBox_IsVisibleChanged" 
                                             LostFocus="InlineEditTextBox_LostFocus" 
                                             KeyDown="InlineEditTextBox_KeyDown"
                                             Tag="{Binding Id}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <!-- Bind IsExpanded via style -->
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="{x:Type TreeViewItem}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="LightGray"/>

            <!-- DataGrid: Mặt hàng -->
            <!-- DataGrid & Detail Tabs: Mặt hàng -->
            <Border Grid.Column="2" BorderBrush="LightGray" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="120" MinHeight="80"/>
                    </Grid.RowDefinitions>
                    
                    <Border Background="#dfe7f5" Padding="5">
                        <TextBlock Text="Mặt hàng" FontWeight="Bold"/>
                    </Border>

                    <DataGrid Grid.Row="1" x:Name="DgMatHang" AutoGenerateColumns="False" 
                              CanUserAddRows="False" IsReadOnly="True" 
                              SelectionChanged="DgMatHang_SelectionChanged"
                              AlternatingRowBackground="#f2f7fc" GridLinesVisibility="All"
                              HorizontalGridLinesBrush="#e0e0e0" VerticalGridLinesBrush="#e0e0e0">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="DataGridRow_PreviewMouseRightButtonDown"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.ContextMenu>
                            <ContextMenu x:Name="GridContextMenu" Opened="GridContextMenu_Opened">
                                <!-- Trash mode -->
                                <MenuItem x:Name="MenuKhoiPhuc" Header="Khôi phục" Click="MenuItem_KhoiPhuc_Click" Visibility="Collapsed">
                                    <MenuItem.Icon>
                                        <TextBlock Text="↩️" Foreground="Green" FontWeight="Bold"/>
                                    </MenuItem.Icon>
                                </MenuItem>

                                <!-- Normal mode -->
                                <MenuItem x:Name="MenuThemMoi" Header="Thêm Mặt hàng" Click="BtnThemMoi_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="➕" Foreground="Green" FontWeight="Bold"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="MenuThemNhanhExcel" Header="Thêm nhanh (excel)" Click="BtnThemExcel_Click"/>
                                <MenuItem x:Name="MenuCapNhatNhanhExcel" Header="Cập nhật nhanh (excel)" Click="BtnThemExcel_Click"/>
                                <MenuItem x:Name="MenuChinhSua" Header="Chỉnh sửa" Click="BtnChinhSua_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="✏️" Foreground="#c07000"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator x:Name="Sep1"/>
                                <MenuItem x:Name="MenuDanhLaiMaHang" Header="Đánh lại mã hàng" Click="MenuDanhLaiMaHang_Click"/>
                                <MenuItem x:Name="MenuDatCot" Header="Đặt Tên mặt hàng"/>
                                <MenuItem x:Name="MenuLocCot" Header="Lọc Tên mặt hàng"/>
                                <Separator x:Name="Sep2"/>
                                
                                <MenuItem x:Name="MenuSapXep" Header="Sắp xếp theo">
                                    <MenuItem Header="Sắp xếp tăng dần" Click="MenuItem_SortAsc_Click"/>
                                    <MenuItem Header="Sắp xếp giảm dần" Click="MenuItem_SortDesc_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Tên mặt hàng" Click="MenuItem_SortByName_Click"/>
                                    <MenuItem Header="Nhóm mặt hàng" Click="MenuItem_SortByNhom_Click"/>
                                    <MenuItem Header="Loại mặt hàng" Click="MenuItem_SortByLoai_Click"/>
                                    <MenuItem Header="Đơn vị tính" Click="MenuItem_SortByDvt_Click"/>
                                    <MenuItem Header="Giá bán" Click="MenuItem_SortByGiaBan_Click"/>
                                    <MenuItem Header="Giá nhập" Click="MenuItem_SortByGiaNhap_Click"/>
                                    <MenuItem Header="Đơn vị tính chẵn" Click="MenuItem_SortByDvtChan_Click"/>
                                    <MenuItem Header="Quy đổi" Click="MenuItem_SortByQuyDoi_Click"/>
                                    <MenuItem Header="Giá bán chẵn" Click="MenuItem_SortByGiaBanChan_Click"/>
                                    <MenuItem Header="Mã hàng" Click="MenuItem_SortByCode_Click"/>
                                </MenuItem>
                                
                                <MenuItem x:Name="MenuRefresh" Header="Refresh" Click="BtnTaiLaiNhom_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="🔄" Foreground="Green" FontWeight="Bold"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="MenuInDanhSach" Header="In danh sách" Click="BtnIn_Click"/>
                                <Separator x:Name="Sep3"/>
                                <MenuItem x:Name="MenuSaoChepO" Header="Sao chép ô" Click="MenuItem_SaoChep_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="📄" Foreground="Navy"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="MenuSaoChepVungChon" Header="Sao chép vùng chọn" Click="MenuItem_SaoChepVungChon_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="📑" Foreground="Navy"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator x:Name="Sep4"/>
                                <MenuItem x:Name="MenuXoa" Header="Xóa" Click="BtnXoa_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="❌" Foreground="Red"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator x:Name="Sep5"/>
                                <MenuItem x:Name="MenuTuDongGianCot" Header="Tự động giãn cột" Click="MenuItem_TuDongGianCot_Click"/>
                                <MenuItem x:Name="MenuCotHienThi" Header="Cột hiển thị" Click="MenuCotHienThi_Click"/>
                                <MenuItem x:Name="MenuThuocTinh" Header="Thuộc tính" Click="MenuItem_ThuocTinh_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT" Binding="{Binding Stt}" Width="40"/>
                            <DataGridTextColumn Header="Tên mặt hàng" Binding="{Binding Name}" Width="180" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Nhóm mặt hàng" Binding="{Binding NhomMatHangName}" Width="140"/>
                            <DataGridTextColumn Header="Loại mặt hàng" Binding="{Binding LoaiMatHangName}" Width="130"/>
                            <DataGridTextColumn Header="Đơn vị&#x0a;tính" Binding="{Binding DonViTinhName}" Width="70"/>
                            <DataGridTextColumn Header="Giá&#x0a;bán" Binding="{Binding Giaban, StringFormat={}{0:N0}}" Width="90"/>
                            <DataGridTextColumn Header="Giá nhập" Binding="{Binding Gianhap, StringFormat={}{0:N0}}" Width="90"/>
                            <DataGridTextColumn Header="Đơn vị&#x0a;tính chẵn" Binding="{Binding DonViTinhChanName}" Width="80"/>
                            <DataGridTextColumn Header="Quy đổi" Binding="{Binding Quydoi}" Width="60"/>
                            <DataGridTextColumn Header="Giá bán&#x0a;chẵn" Binding="{Binding Giabanchan, StringFormat={}{0:N0}}" Width="90"/>
                            <DataGridTextColumn Header="Mã hàng" Binding="{Binding Code}" Width="90"/>
                            <DataGridCheckBoxColumn Header="Tạm khóa" Binding="{Binding IsTamKhoa, Mode=OneWay}" Width="70"/>
                            <DataGridCheckBoxColumn Header="Giá theo thời&#x0a;giá" Binding="{Binding IsGiaTheoThoiGia, Mode=OneWay}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#b0c4de" ShowsPreview="True"/>

                    <!-- Tab chi tiết dưới -->
                    <TabControl Grid.Row="3" Background="#ffffff" BorderBrush="#7f9db9" BorderThickness="1">
                        <TabItem Header="Thông tin">
                            <Grid Margin="12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0" Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="Khởi tạo: " Foreground="Gray" Width="100"/>
                                        <TextBlock x:Name="TxtInfoKhoiTao" Text="--/--/---- --:--:--" Margin="0,0,30,0" FontWeight="SemiBold"/>
                                        <TextBlock Text="Khởi tạo bởi: " Foreground="Gray" Width="100"/>
                                        <TextBlock x:Name="TxtInfoNguoiTao" Text="Administrator" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Sửa đổi gần nhất: " Foreground="Gray" Width="100"/>
                                        <TextBlock x:Name="TxtInfoSuaDoi" Text="--/--/---- --:--:--" Margin="0,0,30,0" FontWeight="SemiBold"/>
                                        <TextBlock Text="Sửa đổi bởi: " Foreground="Gray" Width="100"/>
                                        <TextBlock x:Name="TxtInfoNguoiSua" Text="Administrator" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="1" Content="Thuộc tính" Padding="10,4" Margin="5,0,0,0" VerticalAlignment="Center" Click="MenuItem_ThuocTinh_Click"/>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Khu vực">
                            <DataGrid x:Name="DgMatHangKhuVuc" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" AlternatingRowBackground="#f9f9f9">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã khu vực" Binding="{Binding Code}" Width="120"/>
                                    <DataGridTextColumn Header="Tên khu vực" Binding="{Binding Name}" Width="200"/>
                                    <DataGridTextColumn Header="Giá bán theo khu vực" Binding="{Binding Giaban, StringFormat={}{0:N0}}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <!-- GridSplitter cho In mã vạch -->
            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="LightGray" Visibility="Collapsed" x:Name="GsInMaVach"/>

            <!-- Khung In mã vạch -->
            <Border Grid.Column="4" BorderBrush="LightGray" BorderThickness="1" x:Name="PanelInMaVach" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="#dfe7f5" Padding="5">
                        <TextBlock Text="IN MÃ VẠCH" FontWeight="Bold"/>
                    </Border>

                    <ToolBar Grid.Row="1" Background="Transparent" Padding="0">
                        <Button x:Name="BtnThemMaVach" Padding="5" Click="BtnThemMaVach_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="➡️" Foreground="Blue" Margin="0,0,5,0"/>
                                <TextBlock Text="Thêm"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnXoaMaVach" Padding="5" Click="BtnXoaMaVach_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="❌" Foreground="Red" Margin="0,0,5,0"/>
                                <TextBlock Text="Xóa"/>
                            </StackPanel>
                        </Button>
                        <Separator/>
                        <Button x:Name="BtnXuatExcelMaVach" Content="Xuất excel" Padding="5" Click="BtnXuatExcelMaVach_Click"/>
                        <Button x:Name="BtnInBarcode" Content="In" Padding="5" Click="BtnInBarcode_Click"/>
                        <Button x:Name="BtnBartender" Content="Bartender" Padding="5" Click="BtnBartender_Click"/>
                    </ToolBar>

                    <DataGrid Grid.Row="2" x:Name="DgInMaVach" AutoGenerateColumns="False" 
                              CanUserAddRows="False" IsReadOnly="False" 
                              AlternatingRowBackground="#f9f9f9" GridLinesVisibility="All">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="200" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- StatusBar -->
        <StatusBar Grid.Row="2" Background="#f0f0f0">
            <StatusBarItem>
                <TextBlock Text="Khởi tạo: "/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="Khởi tạo bởi: "/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
