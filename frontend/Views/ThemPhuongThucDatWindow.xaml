<Window x:Class="QuanLyBar.Client.Views.ThemPhuongThucDatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phương thức đặt" Height="250" Width="450"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#b9d1ea" Loaded="Window_Loaded">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="💬✏️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtTitle" Text="Thêm mới phương thức đặt" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Form fields -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Tên phương thức đặt" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="TxtName" Grid.Column="1" Height="24" VerticalContentAlignment="Center" BorderBrush="#0078D7" BorderThickness="1,1,1,2"/>

            <TextBlock Text="Ảnh:" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0"/>
            <ComboBox x:Name="CmbImage" Grid.Column="3" Height="24" VerticalContentAlignment="Center" DisplayMemberPath="Id">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <Image Source="{Binding ImageSource}" Width="16" Height="16"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="Ghi chú:" Grid.Row="1" VerticalAlignment="Top" Margin="0,5,5,0"/>
            <TextBox x:Name="TxtNote" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,5,0,0" TextWrapping="Wrap" AcceptsReturn="True"/>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="BtnSave" Content="Ghi dữ liệu" Width="80" Height="26" Margin="0,0,10,0" Click="BtnSave_Click" Background="White"/>
            <Button x:Name="BtnCancel" Content="Thoát" Width="80" Height="26" Click="BtnCancel_Click" Background="White"/>
        </StackPanel>
    </Grid>
</Window>
