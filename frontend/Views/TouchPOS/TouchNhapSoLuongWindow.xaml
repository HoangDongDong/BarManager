<Window x:Class="QuanLyBar.Client.Views.TouchPOS.TouchNhapSoLuongWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NHẬP SỐ LƯỢNG MÓN"
        Width="400" Height="480"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#0C3445" KeyDown="Window_KeyDown" Loaded="Window_Loaded">

    <Border BorderBrush="#1C5E73" BorderThickness="2" CornerRadius="8">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <!-- TOP HEADER -->
                <RowDefinition Height="Auto"/>
                <!-- ITEM NAME & INPUT DISPLAY -->
                <RowDefinition Height="Auto"/>
                <!-- NUMPAD GRID -->
                <RowDefinition Height="*"/>
                <!-- BOTTOM ACTION BUTTONS -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TOP HEADER -->
            <Border Grid.Row="0" Background="#16394C" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                <TextBlock Text="NHẬP SỐ LƯỢNG MÓN" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
            </Border>

            <!-- ITEM NAME & INPUT DISPLAY -->
            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <TextBlock x:Name="TxtItemName" Text="Bắp bò xào dưa" Foreground="#FFFF33" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8"/>

                <Border Background="#092533" BorderBrush="#008000" BorderThickness="2" CornerRadius="4" Padding="8,6">
                    <TextBox x:Name="TxtSoLuong" Text="1" Foreground="#00FFCC" FontSize="26" FontWeight="Bold" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" CaretBrush="White"/>
                </Border>
            </StackPanel>

            <!-- NUMPAD GRID -->
            <UniformGrid Grid.Row="2" Columns="3" Rows="4" Margin="0,0,0,10">
                <!-- ROW 1: 7, 8, 9 -->
                <Button Content="7" Click="BtnNumpadDigit_Click" Tag="7" Margin="3" FontSize="22" FontWeight="Bold" Foreground="White" Background="#16394C" BorderBrush="#2B7B8E" BorderThickness="1.5"/>
                <Button Content="8" Click="BtnNumpadDigit_Click" Tag="8" Margin="3" FontSize="22" FontWeight="Bold" Foreground="White" Background="#16394C" BorderBrush="#2B7B8E" BorderThickness="1.5"/>
                <Button Content="9" Click="BtnNumpadDigit_Click" Tag="9" Margin="3" FontSize="22" FontWeight="Bold" Foreground="White" Background="#16394C" BorderBrush="#2B7B8E" BorderThickness="1.5"/>

                <!-- ROW 2: 4, 5, 6 -->
                <Button Content="4" Click="BtnNumpadDigit_Click" Tag="4" Margin="3" FontSize="22" FontWeight="Bold" Foreground="White" Background="#16394C" BorderBrush="#2B7B8E" BorderThickness="1.5"/>
                <Button Content="5" Click="BtnNumpadDigit_Click" Tag="5" Margin="3" FontSize="22" FontWeight="Bold" Foreground="White" Background="#16394C" BorderBrush="#2B7B8E" BorderThickness="1.5"/>
                <Button Content="6" Click="BtnNumpadDigit_Click" Tag="6" Margin="3" FontSize="22" FontWeight="Bold" Foreground="White" Background="#16394C" BorderBrush="#2B7B8E" BorderThickness="1.5"/>

                <!-- ROW 3: 1, 2, 3 -->
                <Button Content="1" Click="BtnNumpadDigit_Click" Tag="1" Margin="3" FontSize="22" FontWeight="Bold" Foreground="White" Background="#16394C" BorderBrush="#2B7B8E" BorderThickness="1.5"/>
                <Button Content="2" Click="BtnNumpadDigit_Click" Tag="2" Margin="3" FontSize="22" FontWeight="Bold" Foreground="White" Background="#16394C" BorderBrush="#2B7B8E" BorderThickness="1.5"/>
                <Button Content="3" Click="BtnNumpadDigit_Click" Tag="3" Margin="3" FontSize="22" FontWeight="Bold" Foreground="White" Background="#16394C" BorderBrush="#2B7B8E" BorderThickness="1.5"/>

                <!-- ROW 4: C, 0, BACKSPACE -->
                <Button Content="C" Click="BtnNumpadClear_Click" Margin="3" FontSize="20" FontWeight="Bold" Foreground="White" Background="#B91C1C" BorderBrush="#991B1B" BorderThickness="1.5"/>
                <Button Content="0" Click="BtnNumpadDigit_Click" Tag="0" Margin="3" FontSize="22" FontWeight="Bold" Foreground="White" Background="#16394C" BorderBrush="#2B7B8E" BorderThickness="1.5"/>
                <Button Content="⌫" Click="BtnNumpadBackspace_Click" Margin="3" FontSize="20" FontWeight="Bold" Foreground="White" Background="#475569" BorderBrush="#334155" BorderThickness="1.5"/>
            </UniformGrid>

            <!-- BOTTOM ACTION BUTTONS -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnDongY" Grid.Column="0" Content="ĐỒNG Ý" Height="42" Foreground="White" FontSize="14" FontWeight="Bold" Background="#008000" BorderBrush="#006400" Cursor="Hand" Click="BtnDongY_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="BtnDong" Grid.Column="2" Content="ĐÓNG" Height="42" Foreground="White" FontSize="14" FontWeight="Bold" Background="#8B0000" BorderBrush="#6B0000" Cursor="Hand" Click="BtnDong_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
