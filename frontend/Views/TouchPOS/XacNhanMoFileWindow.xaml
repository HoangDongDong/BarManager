<Window x:Class="QuanLyBar.Client.Views.TouchPOS.XacNhanMoFileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XÁC NHẬN" Height="240" Width="480"
        WindowStyle="None" WindowStartupLocation="CenterOwner" Background="#2B5B88">

    <Border Background="#3B74A7" BorderBrush="#B0D0E8" BorderThickness="2" CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="56"/>
            </Grid.RowDefinitions>

            <!-- 1. HEADER BANNER -->
            <Border Grid.Row="0" Background="#4B7DAF" BorderBrush="#5B86B7" BorderThickness="0,0,0,1">
                <TextBlock Text="XÁC NHẬN" Foreground="#FFFF00" FontWeight="Bold" FontSize="15"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- 2. CONTENT AREA WITH QUESTION ICON AND TEXT -->
            <Border Grid.Row="1" Background="#3470A3" Padding="20">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- DIAMOND ICON WITH QUESTION MARK -->
                    <Border Width="42" Height="42" Background="#4A88BE" BorderBrush="White" BorderThickness="2" CornerRadius="4" Margin="0,0,16,0">
                        <Border.LayoutTransform>
                            <RotateTransform Angle="45"/>
                        </Border.LayoutTransform>
                        <TextBlock Text="?" Foreground="White" FontSize="22" FontWeight="Bold" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="-45"/>
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </Border>

                    <TextBlock Text="Bạn có muốn mở file đã xuất không?" Foreground="White" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 3. FOOTER BUTTONS (YES / NO) -->
            <Border Grid.Row="2" Background="#3470A3" Padding="0,0,20,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- YES BUTTON -->
                    <Button Content="YES" Width="100" Height="36" Margin="0,0,12,0" Cursor="Hand" Click="BtnYes_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#1E7333" BorderBrush="#2E8B46" BorderThickness="1.5" CornerRadius="16">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Foreground>White</Button.Foreground>
                        <Button.FontWeight>Bold</Button.FontWeight>
                        <Button.FontSize>13</Button.FontSize>
                    </Button>

                    <!-- NO BUTTON -->
                    <Button Content="NO" Width="100" Height="36" Cursor="Hand" Click="BtnNo_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#8B0000" BorderBrush="#ef4444" BorderThickness="1.5" CornerRadius="16">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Foreground>White</Button.Foreground>
                        <Button.FontWeight>Bold</Button.FontWeight>
                        <Button.FontSize>13</Button.FontSize>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
