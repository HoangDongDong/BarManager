<Window x:Class="QuanLyBar.Client.Views.TouchPOS.ThemKhachHangTouchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm/Sửa Khách Hàng" Width="600" Height="700"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A2E"
        Loaded="Window_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="BtnTruoc" Content="◀" Width="44" Height="44" Margin="0,0,4,0"
                    Background="#16213E" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Click="BtnTruoc_Click"/>
            <Button x:Name="BtnSau" Content="▶" Width="44" Height="44" Margin="0,0,4,0"
                    Background="#16213E" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Click="BtnSau_Click"/>
            <Button x:Name="BtnTaoMoi" Content="+ Tạo mới" Height="44" Padding="16,0" Margin="0,0,4,0"
                    Background="#1976D2" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Click="BtnTaoMoi_Click"/>
            <Button x:Name="BtnSaoChep" Content="📋 Sao chép" Height="44" Padding="16,0" Margin="0,0,4,0"
                    Background="#388E3C" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Click="BtnSaoChep_Click"/>
            <Button x:Name="BtnXoa" Content="🗑 Xóa" Height="44" Padding="16,0"
                    Background="#D32F2F" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Click="BtnXoa_Click"/>
        </StackPanel>

        <!-- Form Fields -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Mã khách -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Mã khách:" Foreground="#90CAF9" FontSize="13" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtMaKhach" Grid.Column="1" Background="#16213E" Foreground="White"
                             BorderBrush="#1976D2" Height="38" Padding="8,0" FontSize="13" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="2" Content="⌨" Width="40" Height="38" Margin="4,0,0,0"
                            Background="#0F3460" Foreground="White" BorderThickness="0" Cursor="Hand"
                            Click="BtnTouchKb_Click"/>
                </Grid>
                <!-- Tên khách -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Tên khách:" Foreground="#90CAF9" FontSize="13" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtTenKhach" Grid.Column="1" Background="#16213E" Foreground="White"
                             BorderBrush="#1976D2" Height="38" Padding="8,0" FontSize="13" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="2" Content="⌨" Width="40" Height="38" Margin="4,0,0,0"
                            Background="#0F3460" Foreground="White" BorderThickness="0" Cursor="Hand"
                            Click="BtnTouchKb_Click"/>
                </Grid>
                <!-- Nhóm khách -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Nhóm khách:" Foreground="#90CAF9" FontSize="13" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CboNhomKhach" Grid.Column="1" Background="#16213E" Foreground="White"
                              Height="38" FontSize="13"/>
                    <Button Grid.Column="2" Content="🔍" Width="40" Height="38" Margin="4,0,0,0"
                            Background="#0F3460" Foreground="White" BorderThickness="0" Cursor="Hand"
                            Click="BtnSearchNhomKhach_Click"/>
                </Grid>
                <!-- Địa chỉ -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Địa chỉ:" Foreground="#90CAF9" FontSize="13" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtDiaChi" Grid.Column="1" Background="#16213E" Foreground="White"
                             BorderBrush="#1976D2" Height="38" Padding="8,0" FontSize="13" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="2" Content="⌨" Width="40" Height="38" Margin="4,0,0,0"
                            Background="#0F3460" Foreground="White" BorderThickness="0" Cursor="Hand"
                            Click="BtnTouchKb_Click"/>
                </Grid>
                <!-- Điện thoại -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Điện thoại:" Foreground="#90CAF9" FontSize="13" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtDienThoai" Grid.Column="1" Background="#16213E" Foreground="White"
                             BorderBrush="#1976D2" Height="38" Padding="8,0" FontSize="13" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="2" Content="⌨" Width="40" Height="38" Margin="4,0,0,0"
                            Background="#0F3460" Foreground="White" BorderThickness="0" Cursor="Hand"
                            Click="BtnTouchKb_Click"/>
                </Grid>
                <!-- Email -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Email:" Foreground="#90CAF9" FontSize="13" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtEmail" Grid.Column="1" Background="#16213E" Foreground="White"
                             BorderBrush="#1976D2" Height="38" Padding="8,0" FontSize="13" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="2" Content="⌨" Width="40" Height="38" Margin="4,0,0,0"
                            Background="#0F3460" Foreground="White" BorderThickness="0" Cursor="Hand"
                            Click="BtnTouchKb_Click"/>
                </Grid>
                <!-- Mã số thuế -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Mã số thuế:" Foreground="#90CAF9" FontSize="13" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtMaSoThue" Grid.Column="1" Background="#16213E" Foreground="White"
                             BorderBrush="#1976D2" Height="38" Padding="8,0" FontSize="13" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="2" Content="⌨" Width="40" Height="38" Margin="4,0,0,0"
                            Background="#0F3460" Foreground="White" BorderThickness="0" Cursor="Hand"
                            Click="BtnTouchKb_Click"/>
                </Grid>
                <!-- Nhân viên -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Nhân viên QT:" Foreground="#90CAF9" FontSize="13" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CboNhanVien" Grid.Column="1" Background="#16213E" Foreground="White" Height="38" FontSize="13"/>
                    <Button Grid.Column="2" Content="🔍" Width="40" Height="38" Margin="4,0,0,0"
                            Background="#0F3460" Foreground="White" BorderThickness="0" Cursor="Hand"
                            Click="BtnSearchNhanVien_Click"/>
                </Grid>
                <!-- Điểm tích lũy -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Điểm tích lũy:" Foreground="#90CAF9" FontSize="13" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtDiemTichLuy" Grid.Column="1" Background="#16213E" Foreground="White"
                             BorderBrush="#1976D2" Height="38" Padding="8,0" FontSize="13" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="2" Content="🔢" Width="40" Height="38" Margin="4,0,0,0"
                            Background="#0F3460" Foreground="White" BorderThickness="0" Cursor="Hand"
                            Click="BtnCalcDiem_Click"/>
                </Grid>
                <!-- Ngày sinh -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Ngày sinh:" Foreground="#90CAF9" FontSize="13" VerticalAlignment="Center"/>
                    <DatePicker x:Name="DpNgaySinh" Grid.Column="1" Background="#16213E" Foreground="White"
                                Height="38" FontSize="13"/>
                    <Button Grid.Column="2" Content="📅" Width="40" Height="38" Margin="4,0,0,0"
                            Background="#0F3460" Foreground="White" BorderThickness="0" Cursor="Hand"
                            Click="BtnDatePicker_Click"/>
                </Grid>
                <!-- Tỉnh thành -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Tỉnh/Thành:" Foreground="#90CAF9" FontSize="13" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CboTinhThanh" Grid.Column="1" Background="#16213E" Foreground="White" Height="38" FontSize="13"/>
                    <Button Grid.Column="2" Content="🔍" Width="40" Height="38" Margin="4,0,0,0"
                            Background="#0F3460" Foreground="White" BorderThickness="0" Cursor="Hand"
                            Click="BtnSearchTinhThanh_Click"/>
                </Grid>
                <!-- Facebook -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Facebook:" Foreground="#90CAF9" FontSize="13" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtFacebook" Grid.Column="1" Background="#16213E" Foreground="White"
                             BorderBrush="#1976D2" Height="38" Padding="8,0" FontSize="13" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="2" Content="⌨" Width="40" Height="38" Margin="4,0,0,0"
                            Background="#0F3460" Foreground="White" BorderThickness="0" Cursor="Hand"
                            Click="BtnTouchKb_Click"/>
                </Grid>
                <!-- Ghi chú -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Ghi chú:" Foreground="#90CAF9" FontSize="13" VerticalAlignment="Top" Margin="0,4"/>
                    <TextBox x:Name="TxtGhiChu" Grid.Column="1" Background="#16213E" Foreground="White"
                             BorderBrush="#1976D2" Height="70" Padding="8,4" FontSize="13"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                    <Button Grid.Column="2" Content="⌨" Width="40" Height="38" Margin="4,0,0,0"
                            Background="#0F3460" Foreground="White" BorderThickness="0" Cursor="Hand"
                            VerticalAlignment="Top" Click="BtnTouchKb_Click"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnLuu" Content="💾 Lưu" Click="BtnLuu_Click"
                    Background="#1976D2" Foreground="White" BorderThickness="0"
                    Padding="20,10" FontSize="14" Margin="0,0,4,0"/>
            <Button x:Name="BtnLuuVaMoi" Content="💾 Lưu &amp; Mới" Click="BtnLuuVaMoi_Click"
                    Background="#388E3C" Foreground="White" BorderThickness="0"
                    Padding="20,10" FontSize="14" Margin="0,0,4,0"/>
            <Button x:Name="BtnLuuVaThoat" Content="💾 Lưu &amp; Thoát" Click="BtnLuuVaThoat_Click"
                    Background="#7B1FA2" Foreground="White" BorderThickness="0"
                    Padding="20,10" FontSize="14" Margin="0,0,4,0"/>
            <Button x:Name="BtnThoat" Content="✖ Thoát" Click="BtnThoat_Click"
                    Background="#455A64" Foreground="White" BorderThickness="0"
                    Padding="20,10" FontSize="14"/>
        </StackPanel>
    </Grid>
</Window>
