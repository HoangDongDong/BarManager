<Window x:Class="QuanLyBar.Client.Views.TouchPOS.ThemSuaNhanVienTouchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm/Sửa Nhân Viên"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#1A1A2E">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Button x:Name="BtnPrevious" Content="◀ Trước" Height="44" Padding="16,0" Margin="0,0,6,0"
                    Background="#16213E" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Click="BtnPrevious_Click"/>
            <Button x:Name="BtnNext" Content="▶ Sau" Height="44" Padding="16,0" Margin="0,0,6,0"
                    Background="#16213E" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Click="BtnNext_Click"/>
            <Button x:Name="BtnTaoMoi" Content="+ Tạo mới" Height="44" Padding="16,0" Margin="0,0,6,0"
                    Background="#1976D2" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Click="BtnTaoMoi_Click"/>
            <TextBlock x:Name="TxtHeaderTitle" Text="👩 THÊM / SỬA NHÂN VIÊN" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0,0,0"/>
        </StackPanel>

        <!-- Form Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,16,0">
                <!-- Tên nhân viên -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Tên nhân viên:" Foreground="#90CAF9" FontSize="15" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtName" Grid.Column="1" Background="#16213E" Foreground="White"
                             BorderBrush="#1976D2" Height="44" Padding="10,0" FontSize="15" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="2" Content="⌨" Width="44" Height="44" Margin="6,0,0,0"
                            Background="#0F3460" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="18"
                            Click="BtnTouchKb_Click"/>
                </Grid>

                <!-- Địa chỉ -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Địa chỉ:" Foreground="#90CAF9" FontSize="15" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtDiaChi" Grid.Column="1" Background="#16213E" Foreground="White"
                             BorderBrush="#1976D2" Height="44" Padding="10,0" FontSize="15" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="2" Content="⌨" Width="44" Height="44" Margin="6,0,0,0"
                            Background="#0F3460" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="18"
                            Click="BtnTouchKb_Click"/>
                </Grid>

                <!-- Điện thoại -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Điện thoại:" Foreground="#90CAF9" FontSize="15" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtDienThoai" Grid.Column="1" Background="#16213E" Foreground="White"
                             BorderBrush="#1976D2" Height="44" Padding="10,0" FontSize="15" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="2" Content="⌨" Width="44" Height="44" Margin="6,0,0,0"
                            Background="#0F3460" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="18"
                            Click="BtnTouchKb_Click"/>
                </Grid>

                <!-- Cách tính lương -->
                <Border Background="#16213E" BorderBrush="#0F3460" BorderThickness="1.5" CornerRadius="8" Padding="16" Margin="0,4,0,12">
                    <StackPanel>
                        <TextBlock Text="💰 CÁCH TÍNH LƯƠNG" Foreground="#FFD54F" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                        
                        <!-- 1. Lương theo ca -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="RbLuongTheoCa" Content="Lương theo ca" IsChecked="True" Foreground="White" FontSize="15" VerticalAlignment="Center" GroupName="CachTinhLuong"/>
                            <TextBlock Text="Lương ca:" Grid.Column="1" Foreground="#90CAF9" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtLuongCa" Grid.Column="2" Text="60,000" Background="#0F3460" Foreground="White" BorderBrush="#1976D2" Height="40" Padding="8,0" FontSize="15" VerticalContentAlignment="Center" HorizontalContentAlignment="Right"/>
                            <Button Grid.Column="3" Content="🔢" Width="44" Height="40" Margin="6,0,0,0" Background="#1976D2" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="18" Click="BtnTouchNum_Click"/>
                        </Grid>
                        <TextBlock Text="(Cách tính: Lương = Tổng ca làm việc x Lương ca)" FontStyle="Italic" Foreground="#B0BEC5" Margin="30,0,0,12" FontSize="13"/>

                        <!-- 2. Lương tháng theo ca -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="RbLuongThangTheoCa" Content="Lương tháng theo ca" Foreground="White" FontSize="15" VerticalAlignment="Center" GroupName="CachTinhLuong"/>
                            <TextBlock Text="Lương tháng:" Grid.Column="1" Foreground="#90CAF9" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtLuongThang" Grid.Column="2" Text="0" Background="#0F3460" Foreground="White" BorderBrush="#1976D2" Height="40" Padding="8,0" FontSize="15" VerticalContentAlignment="Center" HorizontalContentAlignment="Right"/>
                            <Button Grid.Column="3" Content="🔢" Width="44" Height="40" Margin="6,0,0,0" Background="#1976D2" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="18" Click="BtnTouchNum_Click"/>
                        </Grid>
                        <TextBlock Text="(Cách tính: Lương = Tổng ca làm việc x Lương tháng / số ngày tháng)" FontStyle="Italic" Foreground="#B0BEC5" Margin="30,0,0,12" FontSize="13"/>

                        <!-- 3. Lương tháng theo ngày -->
                        <RadioButton x:Name="RbLuongThangTheoNgay" Content="Lương tháng theo ngày" Foreground="White" FontSize="15" Margin="0,0,0,8" GroupName="CachTinhLuong"/>
                        <StackPanel Orientation="Horizontal" Margin="30,0,0,4">
                            <CheckBox x:Name="ChkNghiThu7" Content="Nghỉ thứ 7" Foreground="White" FontSize="14" Margin="0,0,30,0" IsChecked="True"/>
                            <CheckBox x:Name="ChkNghiChuNhat" Content="Nghỉ chủ nhật" Foreground="White" FontSize="14"/>
                        </StackPanel>
                        <TextBlock Text="(Cách tính: Lương = Tổng ngày làm việc x Lương tháng / số ngày tháng)" FontStyle="Italic" Foreground="#B0BEC5" Margin="30,2,0,0" FontSize="13"/>
                    </StackPanel>
                </Border>

                <!-- Ghi chú -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Ghi chú:" Foreground="#90CAF9" FontSize="15" VerticalAlignment="Top" Margin="0,8,0,0" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtNote" Grid.Column="1" Background="#16213E" Foreground="White"
                             BorderBrush="#1976D2" Height="70" Padding="10,6" FontSize="15" VerticalContentAlignment="Top" TextWrapping="Wrap" AcceptsReturn="True"/>
                    <Button Grid.Column="2" Content="⌨" Width="44" Height="44" Margin="6,0,0,0" VerticalAlignment="Top"
                            Background="#0F3460" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="18"
                            Click="BtnTouchKb_Click"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Toolbar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnLuu" Content="💾 Lưu" Height="48" Padding="24,0" Margin="0,0,8,0"
                    Background="#1976D2" Foreground="White" BorderThickness="0" FontSize="15" FontWeight="Bold" Cursor="Hand"
                    Click="BtnLuu_Click"/>
            <Button x:Name="BtnLuuVaMoi" Content="💾 Lưu &amp; Mới" Height="48" Padding="24,0" Margin="0,0,8,0"
                    Background="#388E3C" Foreground="White" BorderThickness="0" FontSize="15" FontWeight="Bold" Cursor="Hand"
                    Click="BtnLuuVaMoi_Click"/>
            <Button x:Name="BtnLuuVaThoat" Content="💾 Lưu &amp; Thoát" Height="48" Padding="24,0" Margin="0,0,8,0"
                    Background="#7B1FA2" Foreground="White" BorderThickness="0" FontSize="15" FontWeight="Bold" Cursor="Hand"
                    Click="BtnLuuVaThoat_Click"/>
            <Button x:Name="BtnThoat" Content="✖ Thoát" Height="48" Padding="24,0"
                    Background="#455A64" Foreground="White" BorderThickness="0" FontSize="15" FontWeight="Bold" Cursor="Hand"
                    Click="BtnThoat_Click"/>
        </StackPanel>
    </Grid>
</Window>
