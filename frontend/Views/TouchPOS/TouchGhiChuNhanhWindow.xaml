<Window x:Class="QuanLyBar.Client.Views.TouchPOS.TouchGhiChuNhanhWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GHI CHÚ NHANH"
        WindowState="Maximized" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#16394C" KeyDown="Window_KeyDown" Loaded="Window_Loaded">

    <Border BorderBrush="#1C5E73" BorderThickness="2">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <!-- 1. HEADER BANNER -->
                <RowDefinition Height="44"/>
                <!-- 2. TEXT NOTE CONTENT DISPLAY AREA -->
                <RowDefinition Height="*"/>
                <!-- 3. ON-SCREEN TOUCH KEYBOARD -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. HEADER BANNER -->
            <Border Grid.Row="0" Background="#185163" CornerRadius="4" Margin="0,0,0,8">
                <TextBlock Text="GHI CHÚ NHANH" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- 2. TEXT NOTE CONTENT DISPLAY AREA -->
            <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="4" Margin="0,0,0,10" Padding="4">
                <TextBox x:Name="TxtNoteContent"
                         Foreground="#000000" FontSize="22" FontWeight="SemiBold"
                         BorderThickness="0" Background="Transparent"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
            </Border>

            <!-- 3. ON-SCREEN TOUCH KEYBOARD -->
            <Border Grid.Row="2" Background="#1D4B59" CornerRadius="6" Padding="8">
                <StackPanel Orientation="Vertical">
                    <!-- ROW 1: NUMBERS & BACKSPACE -->
                    <Grid Height="52" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="1" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="1" Content="2" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="2" Content="3" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="3" Content="4" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="4" Content="5" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="5" Content="6" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="6" Content="7" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="7" Content="8" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="8" Content="9" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="9" Content="0" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="10" Content="-" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="11" Content="=" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="12" x:Name="BtnBackspace" Style="{DynamicResource SpecialKeyBtnStyle}" Click="BtnBackspace_Click">
                            <TextBlock Text="◄" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- ROW 2: Q W E R T Y U I O P \ @ -->
                    <Grid Height="52" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="q" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="1" Content="w" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="2" Content="e" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="3" Content="r" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="4" Content="t" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="5" Content="y" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="6" Content="u" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="7" Content="i" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="8" Content="o" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="9" Content="p" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="10" Content="\" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="11" Content="@" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                    </Grid>

                    <!-- ROW 3: A S D F G H J K L ; ' -->
                    <Grid Height="52" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="a" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="1" Content="s" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="2" Content="d" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="3" Content="f" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="4" Content="g" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="5" Content="h" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="6" Content="j" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="7" Content="k" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="8" Content="l" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="9" Content=";" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="10" Content="'" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                    </Grid>

                    <!-- ROW 4: Z X C V B N M , . SHIFT -->
                    <Grid Height="52" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="z" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="1" Content="x" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="2" Content="c" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="3" Content="v" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="4" Content="b" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="5" Content="n" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="6" Content="m" Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="7" Content="," Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="8" Content="." Style="{DynamicResource KeyBtnStyle}" Click="KeyBtn_Click"/>
                        <Button Grid.Column="9" x:Name="BtnShift" Style="{DynamicResource SpecialKeyBtnStyle}" Click="BtnShift_Click">
                            <TextBlock x:Name="TxtShiftIcon" Text="▲" FontSize="18" Foreground="#FFD54F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- ROW 5: CANCEL, SPACE, CONFIRM/SAVE -->
                    <Grid Height="54">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>

                        <!-- HỦY BỎ (RED) -->
                        <Button Grid.Column="0" x:Name="BtnCancel" Content="Hủy bỏ" Foreground="White" FontSize="16" FontWeight="Bold" Background="#C62828" BorderBrush="#D32F2F" Cursor="Hand" Click="BtnCancel_Click" Margin="3">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- SPACEBAR -->
                        <Button Grid.Column="1" x:Name="BtnSpace" Style="{DynamicResource SpecialKeyBtnStyle}" Click="BtnSpace_Click"/>

                        <!-- CHẤP NHẬN / LƯU (GREEN ➔) -->
                        <Button Grid.Column="2" x:Name="BtnConfirm" Background="#008800" BorderBrush="#2E7D32" Cursor="Hand" Click="BtnConfirm_Click" Margin="3">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="6">
                                        <TextBlock Text="➔" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>

    <!-- KEY BUTTON STYLES -->
    <Window.Resources>
        <Style x:Key="KeyBtnStyle" TargetType="Button">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#1B5B6E" BorderBrush="#2B7B8E" BorderThickness="1.5" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SpecialKeyBtnStyle" TargetType="Button">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#4A4A4A" BorderBrush="#666666" BorderThickness="1.5" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
</Window>
