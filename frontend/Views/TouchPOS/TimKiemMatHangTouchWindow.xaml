<Window x:Class="QuanLyBar.Client.Views.TouchPOS.TimKiemMatHangTouchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tìm kiếm mặt hàng"
        WindowState="Maximized" WindowStyle="None" ResizeMode="NoResize"
        Background="#367588" Topmost="True" KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="TouchKbKeyBtn" TargetType="Button">
            <Setter Property="Background" Value="#17596B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2A7B91"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#124A5C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0A303C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <!-- 1. TOP ITEMS GRID -->
            <RowDefinition Height="*"/>
            <!-- 2. MIDDLE SEARCH INPUT BAR -->
            <RowDefinition Height="Auto"/>
            <!-- 3. BOTTOM TOUCH KEYBOARD (SYNCHRONIZED WITH STOCK SEARCH WINDOW) -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= 1. TOP MATCHING ITEMS GRID ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <ScrollViewer x:Name="SvSearchMatHang" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="SvSearchMatHang_SizeChanged">
                <ItemsControl x:Name="IcSearchMatHang" VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding MatHangColumns, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Top"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Height="{Binding MatHangTileHeight, RelativeSource={RelativeSource AncestorType=Window}}" Margin="3" CornerRadius="8" Background="{Binding TileColorBrush, FallbackValue='#0D4B5B'}" BorderBrush="#26A69A" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="MatHangTile_MouseLeftButtonDown">
                                <Grid Margin="0">
                                     <!-- LAYOUT WHEN ITEM HAS IMAGE -->
                                     <Grid Visibility="{Binding HasImageVisibility}">
                                         <!-- PRODUCT IMAGE FILLING ENTIRE TILE -->
                                         <Border Margin="0" CornerRadius="7" ClipToBounds="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                             <Image Source="{Binding ImageSource}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                         </Border>

                                         <!-- ITEM NAME & PRICE OVERLAID AT BOTTOM OF IMAGE -->
                                         <Border VerticalAlignment="Bottom" Background="#A0000000" CornerRadius="0,0,7,7" Padding="4,3">
                                             <ItemsControl ItemsSource="{Binding DisplayLines}" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                                 <ItemsControl.ItemTemplate>
                                                     <DataTemplate>
                                                         <Grid HorizontalAlignment="Stretch">
                                                             <Grid.ColumnDefinitions>
                                                                 <ColumnDefinition Width="*"/>
                                                                 <ColumnDefinition Width="Auto"/>
                                                             </Grid.ColumnDefinitions>
                                                             <TextBlock Grid.Column="0" Text="{Binding Text}" 
                                                                        HorizontalAlignment="{Binding Alignment}" 
                                                                        FontSize="{Binding FontSize}" 
                                                                        FontWeight="{Binding FontWeight}" 
                                                                        FontStyle="{Binding FontStyle}" 
                                                                        Foreground="{Binding ForegroundBrush}" 
                                                                        TextWrapping="Wrap"/>
                                                             <TextBlock Grid.Column="1" Text="{Binding RightText}" 
                                                                        HorizontalAlignment="Right" 
                                                                        FontSize="{Binding RightFontSize}" 
                                                                        FontWeight="{Binding RightFontWeight}" 
                                                                        FontStyle="{Binding RightFontStyle}" 
                                                                        Foreground="{Binding RightForegroundBrush}" 
                                                                        Visibility="{Binding RightVisibility}" 
                                                                        Margin="4,0,0,0" 
                                                                        TextWrapping="Wrap"/>
                                                         </Grid>
                                                     </DataTemplate>
                                                 </ItemsControl.ItemTemplate>
                                             </ItemsControl>
                                         </Border>
                                     </Grid>
                                    <!-- LAYOUT WHEN ITEM HAS NO IMAGE -->
                                    <Grid Visibility="{Binding NoImageVisibility}" Margin="4" VerticalAlignment="Center">
                                        <ItemsControl ItemsSource="{Binding DisplayLines}" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Text}" 
                                                               HorizontalAlignment="{Binding Alignment}" 
                                                               FontSize="{Binding FontSize}" 
                                                               FontWeight="{Binding FontWeight}" 
                                                               FontStyle="{Binding FontStyle}" 
                                                               Foreground="{Binding ForegroundBrush}" 
                                                               TextWrapping="Wrap"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- GEAR BUTTON AT BOTTOM RIGHT OF ITEMS PANEL (CÀI ĐẶT CẤU HÌNH TÌM KIẾM) -->
            <Button x:Name="BtnConfigSearchMatHang" Width="50" Height="48" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4" Cursor="Hand" Click="BtnConfigSearchMatHang_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#E0E0E0" BorderBrush="#B0B0B0" BorderThickness="1.5" CornerRadius="8">
                            <TextBlock Text="⚙" Foreground="#1B4D5C" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- ================= 2. MIDDLE SEARCH INPUT BAR ================= -->
        <Border Grid.Row="1" Background="White" BorderBrush="#1C4B6B" BorderThickness="2" Margin="0,2,0,6" CornerRadius="4" Height="46">
            <TextBox x:Name="TxtSearchQuery" FontSize="22" FontWeight="Bold" Foreground="#800000"
                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                     BorderThickness="0" Background="Transparent" TextChanged="TxtSearchQuery_TextChanged"/>
        </Border>

        <!-- ================= 3. BOTTOM TOUCH KEYBOARD (MATCHES KHO HÀNG SEARCH) ================= -->
        <Grid Grid.Row="2" Margin="0,2,0,2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ROW 1: 1..0, -, =, Backspace ◄ -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="1" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="1" Content="2" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="2" Content="3" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="3" Content="4" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="4" Content="5" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="5" Content="6" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="6" Content="7" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="7" Content="8" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="8" Content="9" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="9" Content="0" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="10" Content="-" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="11" Content="=" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="12" Content="◄" Style="{StaticResource TouchKbKeyBtn}" Background="#0C3444" Click="BtnBackspace_Click"/>
            </Grid>

            <!-- ROW 2: QWERTYUIOP\@ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Q" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="1" Content="W" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="2" Content="E" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="3" Content="R" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="4" Content="T" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="5" Content="Y" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="6" Content="U" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="7" Content="I" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="8" Content="O" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="9" Content="P" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="10" Content="\" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="11" Content="@" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
            </Grid>

            <!-- ROW 3: ASDFGHJKL;' -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="A" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="1" Content="S" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="2" Content="D" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="3" Content="F" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="4" Content="G" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="5" Content="H" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="6" Content="J" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="7" Content="K" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="8" Content="L" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="9" Content=";" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="10" Content="'" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
            </Grid>

            <!-- ROW 4: ZXCVBNM,. XÓA -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Z" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="1" Content="X" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="2" Content="C" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="3" Content="V" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="4" Content="B" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="5" Content="N" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="6" Content="M" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="7" Content="," Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="8" Content="." Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="9" Content="XÓA" Style="{StaticResource TouchKbKeyBtn}" Background="#0C3444" Foreground="#FFFF00" Click="BtnClear_Click"/>
            </Grid>

            <!-- ROW 5: Hủy bỏ (Red) + Spacebar -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Hủy bỏ" Style="{StaticResource TouchKbKeyBtn}" Background="#D32F2F" BorderBrush="#E57373" Click="BtnCancel_Click"/>
                <Button Grid.Column="1" Content="" Style="{StaticResource TouchKbKeyBtn}" Background="#3A3A3A" BorderBrush="#555555" Click="BtnSpace_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
