<Window x:Class="QuanLyBar.Views.TouchPOS.TouchReportViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BÁO CÁO POS" Height="720" Width="1150"
        WindowStyle="None" WindowState="Maximized" WindowStartupLocation="CenterOwner" Background="#002533">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER TITLE BAR WITH TOUCH POS STYLING & THOÁT BUTTON -->
        <Border Grid.Row="0" Background="#1B4D5C" BorderBrush="#2C6B7C" BorderThickness="0,0,0,2">
            <Grid Margin="12,0">
                <TextBlock x:Name="TxtTitle" Text="DANH SÁCH PHIẾU NHẬP KHO THEO NHÂN VIÊN NHẬP" 
                           Foreground="White" FontWeight="Bold" FontSize="15"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <Button x:Name="BtnClose" Content="THOÁT" Width="90" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" Click="BtnClose_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#8B0000" BorderBrush="#ef4444" BorderThickness="1" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Foreground>White</Button.Foreground>
                    <Button.FontWeight>Bold</Button.FontWeight>
                    <Button.FontSize>13</Button.FontSize>
                </Button>
            </Grid>
        </Border>

        <!-- MAIN REPORT CONTAINER HOSTING WPF REPORT CONTROL -->
        <Grid Grid.Row="1">
            <ContentControl x:Name="ReportHost"/>
        </Grid>
    </Grid>
</Window>
