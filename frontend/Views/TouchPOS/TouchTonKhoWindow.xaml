<Window x:Class="QuanLyBar.Client.Views.TouchPOS.TouchTonKhoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="ThisWindow"
        Title="TỒN KHO" Height="720" Width="1150"
        WindowStyle="None" WindowState="Maximized" WindowStartupLocation="CenterOwner" Background="#002533"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="TouchSideBtnStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="#36B5B0" BorderThickness="1.5" CornerRadius="5" Padding="6,4">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom ScrollBar & ScrollViewer Style matching ThietKeGiaoDienCamUng -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" HorizontalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{x:Null}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Rectangle Fill="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#1C5E73" BorderBrush="#659BB0" BorderThickness="1.5" CornerRadius="12" Width="22"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{x:Null}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Rectangle Fill="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid x:Name="Grid" Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Column="0" CanContentScroll="{TemplateBinding CanContentScroll}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" AutomationProperties.AutomationId="VerticalScrollBar" 
                                       Cursor="Hand" Maximum="{TemplateBinding ScrollableHeight}" Minimum="0" 
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                       ViewportSize="{TemplateBinding ViewportHeight}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- 1. HEADER BANNER -->
        <Border Grid.Row="0" Background="#1B4D5C" BorderBrush="#2C6B7C" BorderThickness="0,0,0,2">
            <TextBlock Text="TỒN KHO" Foreground="White" FontWeight="Bold" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- 2. MAIN BODY (LEFT PANELS FOR KHO HÀNG & NHÓM HÀNG, RIGHT GRID FOR TILES) -->
        <Grid Grid.Row="1" Margin="6">
            <Grid.ColumnDefinitions>
                <!-- LEFT COLUMN: KHO HÀNG & NHÓM HÀNG BUTTONS -->
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="6"/>
                <!-- RIGHT COLUMN: ITEM TILES -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="1.2*"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="38"/>
                </Grid.RowDefinitions>

                <!-- HEADER KHO HÀNG -->
                <Border Grid.Row="0" Background="#1A4A58" CornerRadius="3" Margin="0,0,0,2">
                    <TextBlock Text="KHO HÀNG" Foreground="#FFF" FontWeight="Bold" FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,4">
                    <StackPanel x:Name="PanelKhoButtons"/>
                </ScrollViewer>

                <!-- HEADER NHÓM HÀNG -->
                <Border Grid.Row="2" Background="#1A4A58" CornerRadius="3" Margin="0,0,0,2">
                    <TextBlock Text="NHÓM HÀNG" Foreground="#FFF" FontWeight="Bold" FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PanelNhomButtons"/>
                </ScrollViewer>

                <!-- CHECKBOX TỒN <> 0 -->
                <Button Grid.Row="4" x:Name="BtnToggleTonKhac0" Margin="0,4,0,0" Cursor="Hand" Click="BtnToggleTonKhac0_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bdr" Background="#0C3444" BorderBrush="#1C4B6B" BorderThickness="1.5" CornerRadius="4">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtCheckIcon" Text="☒" Foreground="White" FontSize="15" FontWeight="Bold" Margin="0,0,6,0"/>
                                    <TextBlock Text="TỒN &lt;&gt; 0" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- RIGHT ITEM TILES CONTAINER -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TILES AREA -->
                <Grid Grid.Row="0">
                    <ScrollViewer x:Name="TileScrollViewer" VerticalScrollBarVisibility="Auto" SizeChanged="TileScrollViewer_SizeChanged">
                        <ItemsControl x:Name="ItemsTileControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding ColumnCount, ElementName=ThisWindow}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="4" Background="{Binding TileBackground}" BorderBrush="{Binding TileBorderBrush}" BorderThickness="1.5" CornerRadius="6" Height="{Binding TileHeight, ElementName=ThisWindow}" Padding="14,8" Cursor="Hand" MouseLeftButtonDown="ItemTile_MouseLeftButtonDown">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- LEFT STACK: Description columns -->
                                            <Viewbox Grid.Column="0" StretchDirection="DownOnly" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <ItemsControl ItemsSource="{Binding LeftColumns}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding TextToDisplay}" Foreground="White" FontSize="13" FontWeight="Bold" Margin="0,1"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Viewbox>

                                            <!-- RIGHT STACK: Numeric columns -->
                                            <Viewbox Grid.Column="1" StretchDirection="DownOnly" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <ItemsControl ItemsSource="{Binding RightColumns}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding TextToDisplay}" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,1"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Viewbox>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- YELLOW SEARCH BADGE BADGE (e.g., "Q") AT BOTTOM RIGHT -->
                    <Border x:Name="BdrSearchBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                            Margin="0,0,52,6" Background="#FFFF00" BorderBrush="#FFD700" BorderThickness="1" CornerRadius="2" Padding="6,2"
                            Visibility="Collapsed">
                        <TextBlock x:Name="TxtSearchBadge" Text="" Foreground="#000" FontWeight="Bold" FontSize="15"/>
                    </Border>

                    <!-- GEAR SETTINGS BUTTON AT BOTTOM RIGHT -->
                    <Button Width="40" Height="36" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6" Cursor="Hand" Click="BtnGearSettings_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#E0E0E0" BorderBrush="#B0B0B0" BorderThickness="1" CornerRadius="3">
                                    <TextBlock Text="⚙" Foreground="#1B4D5C" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- TOUCH KEYBOARD PANEL -->
                <Border x:Name="KeyboardPanel" Grid.Row="1" Background="#123B4A" BorderBrush="#1C5E73" BorderThickness="0,2,0,0" Padding="6,8" Visibility="Collapsed">
                    <Border.Resources>
                        <Style x:Key="KbKeyStyle" TargetType="Button">
                            <Setter Property="Background" Value="#17596B"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderBrush" Value="#2A7B91"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="FontSize" Value="15"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Margin" Value="2"/>
                            <Setter Property="Height" Value="42"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Border.Resources>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ROW 1: 1..0, -, =, Backspace ◄ -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.4*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="1" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="1" Content="2" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="2" Content="3" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="3" Content="4" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="4" Content="5" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="5" Content="6" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="6" Content="7" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="7" Content="8" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="8" Content="9" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="9" Content="0" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="10" Content="-" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="11" Content="=" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="12" Content="◄" Style="{StaticResource KbKeyStyle}" Background="#0C3444" Click="KbBackspace_Click"/>
                        </Grid>

                        <!-- ROW 2: QWERTYUIOP\@ -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Q" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="1" Content="W" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="2" Content="E" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="3" Content="R" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="4" Content="T" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="5" Content="Y" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="6" Content="U" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="7" Content="I" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="8" Content="O" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="9" Content="P" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="10" Content="\" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="11" Content="@" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                        </Grid>

                        <!-- ROW 3: ASDFGHJKL;' -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="A" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="1" Content="S" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="2" Content="D" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="3" Content="F" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="4" Content="G" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="5" Content="H" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="6" Content="J" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="7" Content="K" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="8" Content="L" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="9" Content=";" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="10" Content="'" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                        </Grid>

                        <!-- ROW 4: ZXCVBNM,. ▲ -->
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Z" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="1" Content="X" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="2" Content="C" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="3" Content="V" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="4" Content="B" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="5" Content="N" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="6" Content="M" Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="7" Content="," Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="8" Content="." Style="{StaticResource KbKeyStyle}" Click="KbKey_Click"/>
                            <Button Grid.Column="9" Content="▲" Style="{StaticResource KbKeyStyle}" Background="#0C3444" Foreground="#FFFF00" Click="KbShift_Click"/>
                        </Grid>

                        <!-- ROW 5: Hủy bỏ (Red) + Spacebar -->
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="Hủy bỏ" Style="{StaticResource KbKeyStyle}" 
                                    Background="#D32F2F" BorderBrush="#E57373" Click="KbCancel_Click"/>
                            <Button Grid.Column="1" Content="" Style="{StaticResource KbKeyStyle}" 
                                    Background="#3A3A3A" BorderBrush="#555555" Click="KbSpace_Click"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 3. FOOTER CONTROL BUTTONS (REFRESH, CHI TIẾT, XUẤT EXCEL, TÌM, THOÁT) -->
        <Border Grid.Row="2" Background="#001F2B" BorderBrush="#1B4D5C" BorderThickness="0,1.5,0,0">
            <DockPanel LastChildFill="False" Margin="10,0">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- REFRESH -->
                    <Button Content="REFRESH" Width="100" Height="36" Margin="0,0,8,0" Cursor="Hand" Click="BtnRefresh_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#1E7333" BorderBrush="#2E8B46" BorderThickness="1.5" CornerRadius="18">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Foreground>White</Button.Foreground>
                        <Button.FontWeight>Bold</Button.FontWeight>
                    </Button>

                    <!-- CHI TIẾT -->
                    <Button Content="CHI TIẾT" Width="100" Height="36" Margin="0,0,8,0" Cursor="Hand" Click="BtnChiTiet_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#6C757D" BorderBrush="#868E96" BorderThickness="1.5" CornerRadius="18">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Foreground>White</Button.Foreground>
                        <Button.FontWeight>Bold</Button.FontWeight>
                    </Button>

                    <!-- XUẤT EXCEL -->
                    <Button Content="XUẤT EXCEL" Width="110" Height="36" Margin="0,0,8,0" Cursor="Hand" Click="BtnExportExcel_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#1E7333" BorderBrush="#2E8B46" BorderThickness="1.5" CornerRadius="18">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Foreground>White</Button.Foreground>
                        <Button.FontWeight>Bold</Button.FontWeight>
                    </Button>

                    <!-- TÌM -->
                    <Button Content="TÌM" Width="90" Height="36" Cursor="Hand" Click="BtnTim_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#1E7333" BorderBrush="#2E8B46" BorderThickness="1.5" CornerRadius="18">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Foreground>White</Button.Foreground>
                        <Button.FontWeight>Bold</Button.FontWeight>
                    </Button>
                </StackPanel>

                <!-- THOÁT BUTTON -->
                <Button DockPanel.Dock="Right" Content="THOÁT" Width="100" Height="36" VerticalAlignment="Center" Cursor="Hand" Click="BtnExit_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#8B0000" BorderBrush="#ef4444" BorderThickness="1.5" CornerRadius="18">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Foreground>White</Button.Foreground>
                    <Button.FontWeight>Bold</Button.FontWeight>
                </Button>
            </DockPanel>
        </Border>
    </Grid>
</Window>
