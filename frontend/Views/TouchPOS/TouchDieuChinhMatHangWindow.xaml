<Window x:Class="QuanLyBar.Client.Views.TouchPOS.TouchDieuChinhMatHangWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ĐIỀU CHỈNH MẶT HÀNG"
        WindowState="Maximized"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#367588" Loaded="Window_Loaded">

    <Border BorderBrush="#1C5E73" BorderThickness="3" CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <!-- TITLE BAR -->
                <RowDefinition Height="54"/>
                <!-- MAIN CONTENT AREA -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TITLE BAR -->
            <Border Grid.Row="0" Background="#8B0000" Padding="12,0">
                <TextBlock x:Name="TxtTitle" Text="ĐIỀU CHỈNH MẶT HÀNG: LẦU GÀ H'MÔNG LỚN" 
                           Foreground="White" FontSize="20" FontWeight="Bold" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- MAIN CONTENT AREA: 2 COLUMNS -->
            <Grid Grid.Row="1" Margin="10">
                <Grid.ColumnDefinitions>
                    <!-- LEFT COLUMN: THAY ĐỔI SỐ LƯỢNG -->
                    <ColumnDefinition Width="1.35*"/>
                    <ColumnDefinition Width="12"/>
                    <!-- RIGHT COLUMN: CHỨC NĂNG NÚT THAO TÁC -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT PANEL: THAY ĐỔI SỐ LƯỢNG -->
                <Border Grid.Column="0" Background="#2B5F6F" BorderBrush="#1C5E73" BorderThickness="2" CornerRadius="6" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- HEADER -->
                        <TextBlock Grid.Row="0" Text="THAY ĐỔI SỐ LƯỢNG" Foreground="White" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                        <!-- ORIGINAL QTY DISPLAY -->
                        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                            <TextBlock x:Name="TxtBanDau" Text="Số lượng ban đầu: 0" Foreground="#111111" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Border>

                        <!-- 2 COLUMNS OF LARGE TOUCH BUTTONS -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- LEFT GREEN COLUMN (+1, +2, +3, +4, +Số khác) -->
                            <UniformGrid Grid.Column="0" Columns="1" Rows="5">
                                <Button Content="+1" Margin="0,3" FontSize="22" FontWeight="Bold" Foreground="White" Background="#145220" BorderBrush="#1E6C2B" BorderThickness="1.5" Cursor="Hand" Click="BtnPlusNumber_Click" Tag="1">
                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                </Button>
                                <Button Content="+2" Margin="0,3" FontSize="22" FontWeight="Bold" Foreground="White" Background="#145220" BorderBrush="#1E6C2B" BorderThickness="1.5" Cursor="Hand" Click="BtnPlusNumber_Click" Tag="2">
                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                </Button>
                                <Button Content="+3" Margin="0,3" FontSize="22" FontWeight="Bold" Foreground="White" Background="#145220" BorderBrush="#1E6C2B" BorderThickness="1.5" Cursor="Hand" Click="BtnPlusNumber_Click" Tag="3">
                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                </Button>
                                <Button Content="+4" Margin="0,3" FontSize="22" FontWeight="Bold" Foreground="White" Background="#145220" BorderBrush="#1E6C2B" BorderThickness="1.5" Cursor="Hand" Click="BtnPlusNumber_Click" Tag="4">
                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                </Button>
                                <Button Content="+ Số khác" Margin="0,3" FontSize="19" FontWeight="Bold" Foreground="White" Background="#145220" BorderBrush="#1E6C2B" BorderThickness="1.5" Cursor="Hand" Click="BtnPlusKhac_Click">
                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                </Button>
                            </UniformGrid>

                            <!-- RIGHT GREY COLUMN (-1, -2, -3, -4, -Số khác) -->
                            <UniformGrid Grid.Column="2" Columns="1" Rows="5">
                                <Button Content="-1" Margin="0,3" FontSize="22" FontWeight="Bold" Foreground="White" Background="#808080" BorderBrush="#9E9E9E" BorderThickness="1.5" Cursor="Hand" Click="BtnMinusNumber_Click" Tag="1">
                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                </Button>
                                <Button Content="-2" Margin="0,3" FontSize="22" FontWeight="Bold" Foreground="White" Background="#808080" BorderBrush="#9E9E9E" BorderThickness="1.5" Cursor="Hand" Click="BtnMinusNumber_Click" Tag="2">
                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                </Button>
                                <Button Content="-3" Margin="0,3" FontSize="22" FontWeight="Bold" Foreground="White" Background="#808080" BorderBrush="#9E9E9E" BorderThickness="1.5" Cursor="Hand" Click="BtnMinusNumber_Click" Tag="3">
                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                </Button>
                                <Button Content="-4" Margin="0,3" FontSize="22" FontWeight="Bold" Foreground="White" Background="#808080" BorderBrush="#9E9E9E" BorderThickness="1.5" Cursor="Hand" Click="BtnMinusNumber_Click" Tag="4">
                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                </Button>
                                <Button Content="-Số khác" Margin="0,3" FontSize="19" FontWeight="Bold" Foreground="White" Background="#808080" BorderBrush="#9E9E9E" BorderThickness="1.5" Cursor="Hand" Click="BtnMinusKhac_Click">
                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                </Button>
                            </UniformGrid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- RIGHT PANEL: 6 STACKED ACTION BUTTONS -->
                <UniformGrid Grid.Column="2" Columns="1" Rows="6">
                    <!-- 1. ĐỔI GIÁ (Teal) -->
                    <Button Margin="0,3" Cursor="Hand" Click="BtnDoiGia_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#0F4C5C" BorderBrush="#1C6E83" BorderThickness="1.5" CornerRadius="8">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="🧮 " Foreground="White" FontSize="22" FontWeight="Bold"/>
                                        <TextBlock Text="ĐỔI GIÁ" Foreground="White" FontSize="18" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 2. CHUYỂN HÓA ĐƠN (Purple) -->
                    <Button Margin="0,3" Cursor="Hand" Click="BtnChuyenHoaDon_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#4D1B5D" BorderBrush="#712889" BorderThickness="1.5" CornerRadius="8">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="🧩 " Foreground="White" FontSize="22" FontWeight="Bold"/>
                                        <TextBlock Text="CHUYỂN HÓA ĐƠN" Foreground="White" FontSize="18" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 3. ĐẶT SỐ LƯỢNG (Dark Green) -->
                    <Button Margin="0,3" Cursor="Hand" Click="BtnDatSoLuong_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#145220" BorderBrush="#1E6C2B" BorderThickness="1.5" CornerRadius="8">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="🔢 " Foreground="White" FontSize="22" FontWeight="Bold"/>
                                        <TextBlock Text="ĐẶT SỐ LƯỢNG" Foreground="White" FontSize="18" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 4. SỬA GHI CHÚ (Yellow/Olive) -->
                    <Button Margin="0,3" Cursor="Hand" Click="BtnSuaGhiChu_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#8B8000" BorderBrush="#AFA200" BorderThickness="1.5" CornerRadius="8">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="📝 " Foreground="White" FontSize="22" FontWeight="Bold"/>
                                        <TextBlock Text="SỬA GHI CHÚ" Foreground="White" FontSize="18" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 5. GIẢM GIÁ (Dark Blue) -->
                    <Button Margin="0,3" Cursor="Hand" Click="BtnGiamGia_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#0F2C59" BorderBrush="#164387" BorderThickness="1.5" CornerRadius="8">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="🏷 " Foreground="White" FontSize="22" FontWeight="Bold"/>
                                        <TextBlock Text="GIẢM GIÁ" Foreground="White" FontSize="18" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 6. HỦY BỎ (Red) -->
                    <Button Margin="0,3" Cursor="Hand" Click="BtnHuyBo_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#CC0000" BorderBrush="#FF1A1A" BorderThickness="1.5" CornerRadius="8">
                                    <TextBlock Text="HỦY BỎ" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </UniformGrid>
            </Grid>
        </Grid>
    </Border>
</Window>
