<Window x:Class="QuanLyBar.Client.Views.TouchPOS.ChonKhachHangTouchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chọn Khách Hàng" Width="900" Height="650"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A2E"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="KbBtn" TargetType="Button">
            <Setter Property="Background" Value="#16213E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Width" Value="58"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search Display -->
        <Border Grid.Row="0" Background="#16213E" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
            <TextBlock x:Name="TxtSearchDisplay" Text="Nhập tên khách hàng..." 
                       FontSize="18" Foreground="White" MinHeight="32"/>
        </Border>

        <!-- Customer Tiles -->
        <Border Grid.Row="2" Background="#16213E" CornerRadius="8" Margin="0,0,0,8">
            <ScrollViewer x:Name="SvCustomers" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="IcCustomers" Margin="8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="160" Height="80" Background="#0F3460" CornerRadius="8" 
                                    Margin="6" Cursor="Hand" MouseDown="CustomerCard_MouseDown">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TENKHACH}" Foreground="White" 
                                               FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" 
                                               TextAlignment="Center" Margin="8,0"/>
                                    <TextBlock Text="{Binding DIENTHOAI}" Foreground="#90CAF9" FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Touch Keyboard Row 1 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4">
            <Button Content="1" Style="{StaticResource KbBtn}" Click="Key_Click"/>
            <Button Content="2" Style="{StaticResource KbBtn}" Click="Key_Click"/>
            <Button Content="3" Style="{StaticResource KbBtn}" Click="Key_Click"/>
            <Button Content="4" Style="{StaticResource KbBtn}" Click="Key_Click"/>
            <Button Content="5" Style="{StaticResource KbBtn}" Click="Key_Click"/>
            <Button Content="6" Style="{StaticResource KbBtn}" Click="Key_Click"/>
            <Button Content="7" Style="{StaticResource KbBtn}" Click="Key_Click"/>
            <Button Content="8" Style="{StaticResource KbBtn}" Click="Key_Click"/>
            <Button Content="9" Style="{StaticResource KbBtn}" Click="Key_Click"/>
            <Button Content="0" Style="{StaticResource KbBtn}" Click="Key_Click"/>
            <Button Content="⌫" Width="80" Height="52" Margin="2" Background="#D32F2F" Foreground="White" 
                    BorderThickness="0" FontSize="18" Cursor="Hand" Click="KeyBackspace_Click"/>
        </StackPanel>

        <!-- Letter Rows -->
        <StackPanel Grid.Row="3">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2">
                <Button Content="Q" Style="{StaticResource KbBtn}" Click="Key_Click"/>
                <Button Content="W" Style="{StaticResource KbBtn}" Click="Key_Click"/>
                <Button Content="E" Style="{StaticResource KbBtn}" Click="Key_Click"/>
                <Button Content="R" Style="{StaticResource KbBtn}" Click="Key_Click"/>
                <Button Content="T" Style="{StaticResource KbBtn}" Click="Key_Click"/>
                <Button Content="Y" Style="{StaticResource KbBtn}" Click="Key_Click"/>
                <Button Content="U" Style="{StaticResource KbBtn}" Click="Key_Click"/>
                <Button Content="I" Style="{StaticResource KbBtn}" Click="Key_Click"/>
                <Button Content="O" Style="{StaticResource KbBtn}" Click="Key_Click"/>
                <Button Content="P" Style="{StaticResource KbBtn}" Click="Key_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2">
                <Button Content="A" Style="{StaticResource KbBtn}" Click="Key_Click"/>
                <Button Content="S" Style="{StaticResource KbBtn}" Click="Key_Click"/>
                <Button Content="D" Style="{StaticResource KbBtn}" Click="Key_Click"/>
                <Button Content="F" Style="{StaticResource KbBtn}" Click="Key_Click"/>
                <Button Content="G" Style="{StaticResource KbBtn}" Click="Key_Click"/>
                <Button Content="H" Style="{StaticResource KbBtn}" Click="Key_Click"/>
                <Button Content="J" Style="{StaticResource KbBtn}" Click="Key_Click"/>
                <Button Content="K" Style="{StaticResource KbBtn}" Click="Key_Click"/>
                <Button Content="L" Style="{StaticResource KbBtn}" Click="Key_Click"/>
                <Button x:Name="BtnCaps" Content="⇧" Width="80" Height="52" Margin="2"
                        Background="#37474F" Foreground="White" BorderThickness="0" FontSize="18"
                        Cursor="Hand" Click="KeyCaps_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2">
                <Button Content="Z" Style="{StaticResource KbBtn}" Click="Key_Click"/>
                <Button Content="X" Style="{StaticResource KbBtn}" Click="Key_Click"/>
                <Button Content="C" Style="{StaticResource KbBtn}" Click="Key_Click"/>
                <Button Content="V" Style="{StaticResource KbBtn}" Click="Key_Click"/>
                <Button Content="B" Style="{StaticResource KbBtn}" Click="Key_Click"/>
                <Button Content="N" Style="{StaticResource KbBtn}" Click="Key_Click"/>
                <Button Content="M" Style="{StaticResource KbBtn}" Click="Key_Click"/>
                <Button Width="200" Height="52" Margin="2" Background="#16213E" 
                        Foreground="White" BorderBrush="#1976D2" BorderThickness="1" 
                        FontSize="13" Content="SPACE" Cursor="Hand" Click="KeySpace_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="BtnThemMoi" Content="➕ Thêm mới" Click="BtnThemMoi_Click"
                    Background="#1976D2" Foreground="White" BorderThickness="0"
                    Padding="20,10" FontSize="14" Margin="0,0,8,0"/>
            <Button x:Name="BtnChinhSua" Content="✏ Chỉnh sửa" Click="BtnChinhSua_Click"
                    Background="#388E3C" Foreground="White" BorderThickness="0"
                    Padding="20,10" FontSize="14" Margin="0,0,8,0"/>
            <Button x:Name="BtnXoaTrong" Content="🗑 Xóa trống" Click="BtnXoaTrong_Click"
                    Background="#F57C00" Foreground="White" BorderThickness="0"
                    Padding="20,10" FontSize="14" Margin="0,0,8,0"/>
            <Button x:Name="BtnThoat" Content="✖ Thoát" Click="BtnThoat_Click"
                    Background="#455A64" Foreground="White" BorderThickness="0"
                    Padding="20,10" FontSize="14"/>
        </StackPanel>
    </Grid>
</Window>
