<Window x:Class="QuanLyBar.Client.Views.TouchPOS.TouchCauHinhHeThongWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="THIẾT LẬP CẤU HÌNH HỆ THỐNG"
        WindowState="Maximized" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#0C3445" KeyDown="Window_KeyDown" Loaded="Window_Loaded">

    <Window.Resources>
        <!-- CUSTOM CHECKBOX STYLE MATCHING POS SCREENSHOTS -->
        <Style x:Key="TouchCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="22" Height="22" Margin="0,0,8,0">
                                <Border Background="#1C4B5E" BorderBrush="White" BorderThickness="1.5" CornerRadius="2"/>
                                <TextBlock x:Name="CheckMark" Text="✖" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TOUCH INPUT STYLES -->
        <Style x:Key="TouchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#888888"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="TouchComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <!-- ICON BUTTON BESIDE INPUTS -->
        <Style x:Key="InputBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#0F5A47"/>
            <Setter Property="BorderBrush" Value="#008037"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- TOP TITLE BAR -->
            <RowDefinition Height="40"/>
            <!-- MAIN CONTENT AREA -->
            <RowDefinition Height="*"/>
            <!-- BOTTOM ACTION BAR -->
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- TOP TITLE BAR -->
        <Border Grid.Row="0" Background="#16394C" BorderBrush="#1C5E73" BorderThickness="0,0,0,1.5">
            <TextBlock Text="THIẾT LẬP CẤU HÌNH HỆ THỐNG" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <!-- LEFT CATEGORY SIDEBAR -->
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="8"/>
                <!-- RIGHT CONFIG PANEL -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT CATEGORY SIDEBAR -->
            <Border Grid.Column="0" Background="#0C3445" BorderBrush="#1C5E73" BorderThickness="1" CornerRadius="4" Padding="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="IcCategories">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}" Height="38" Margin="0,0,0,5" Cursor="Hand" Click="BtnCategory_Click" Tag="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{Binding BtnBrush}" BorderBrush="#004D25" BorderThickness="1" CornerRadius="4" Padding="10,0">
                                                <TextBlock Text="{TemplateBinding Content}" Foreground="White" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- RIGHT CONFIG PANEL -->
            <Border Grid.Column="2" Background="#4D7D93" BorderBrush="#2C5B70" BorderThickness="1.5" CornerRadius="4" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="GridConfigContent">

                        <!-- TAB 1: THÔNG TIN CHUNG -->
                        <StackPanel x:Name="PanelTab1" Visibility="Visible">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Tên công ty:" Foreground="White" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBox x:Name="TxtCompanyName" Style="{StaticResource TouchTextBoxStyle}"/>
                                    <TextBlock Text="(Tên công ty sẽ hiển thị dưới báo cáo)" Foreground="#E0E0E0" FontSize="11" FontStyle="Italic" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource InputBtnStyle}" Click="BtnVirtualKey_Click">
                                    <TextBlock Text="⌨" Foreground="White" FontSize="16"/>
                                </Button>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Địa chỉ:" Foreground="White" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtCompanyAddress" Grid.Column="1" Style="{StaticResource TouchTextBoxStyle}"/>
                                <Button Grid.Column="2" Style="{StaticResource InputBtnStyle}" Click="BtnVirtualKey_Click">
                                    <TextBlock Text="⌨" Foreground="White" FontSize="16"/>
                                </Button>

                                <!-- LOGO PREVIEW BOX ON THE RIGHT -->
                                <StackPanel Grid.Column="3" Margin="20,0,0,0" Grid.RowSpan="5">
                                    <TextBlock Text="Logo:" Foreground="White" FontSize="13" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <Border Width="100" Height="80" Background="White" BorderBrush="#888888" BorderThickness="1" CornerRadius="2">
                                        <Image x:Name="ImgLogo" Stretch="Uniform"/>
                                    </Border>
                                    <Button x:Name="BtnChonLogo" Content="CHỌN" Width="100" Height="32" Margin="0,8,0,0" Foreground="White" FontSize="12" FontWeight="Bold" Background="#0F5A47" BorderBrush="#008037" Cursor="Hand" Click="BtnChonLogo_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="400"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Số điện thoại:" Foreground="White" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtCompanyPhone" Grid.Column="1" Style="{StaticResource TouchTextBoxStyle}"/>
                                <Button Grid.Column="2" Style="{StaticResource InputBtnStyle}" Click="BtnVirtualKey_Click">
                                    <TextBlock Text="⌨" Foreground="White" FontSize="16"/>
                                </Button>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="400"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Email:" Foreground="White" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtCompanyEmail" Grid.Column="1" Style="{StaticResource TouchTextBoxStyle}"/>
                                <Button Grid.Column="2" Style="{StaticResource InputBtnStyle}" Click="BtnVirtualKey_Click">
                                    <TextBlock Text="⌨" Foreground="White" FontSize="16"/>
                                </Button>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="400"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Lời cảm ơn:" Foreground="White" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtLoiCamOn" Grid.Column="1" Style="{StaticResource TouchTextBoxStyle}"/>
                                <Button Grid.Column="2" Style="{StaticResource InputBtnStyle}" Click="BtnVirtualKey_Click">
                                    <TextBlock Text="⌨" Foreground="White" FontSize="16"/>
                                </Button>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="400"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Fax:" Foreground="White" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtCompanyFax" Grid.Column="1" Style="{StaticResource TouchTextBoxStyle}"/>
                                <Button Grid.Column="2" Style="{StaticResource InputBtnStyle}" Click="BtnVirtualKey_Click">
                                    <TextBlock Text="⌨" Foreground="White" FontSize="16"/>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- TAB 2: IN HĐ VÀ IN CHẾ BIẾN -->
                        <StackPanel x:Name="PanelTab2" Visibility="Collapsed">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="300"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ChkLuaChonMauKhiIn" Content="Lựa chọn mẫu khi in" Style="{StaticResource TouchCheckBoxStyle}"/>
                                <CheckBox x:Name="ChkHienThiTruocKhiIn" Grid.Column="1" Content="Hiển thị trước khi in" Style="{StaticResource TouchCheckBoxStyle}"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Mẫu hóa đơn" Foreground="White" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                <ComboBox x:Name="CboMauHoaDon" Grid.Column="1" Style="{StaticResource TouchComboBoxStyle}"/>
                                <Button Grid.Column="2" Style="{StaticResource InputBtnStyle}">
                                    <TextBlock Text="🔍" Foreground="White" FontSize="14"/>
                                </Button>

                                <TextBlock Grid.Column="4" Text="Số lần in" Foreground="White" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <TextBox x:Name="TxtSoLanIn" Grid.Column="5" Style="{StaticResource TouchTextBoxStyle}" Text="1"/>
                                <Button Grid.Column="6" Style="{StaticResource InputBtnStyle}">
                                    <TextBlock Text="🧮" Foreground="White" FontSize="14"/>
                                </Button>
                            </Grid>

                            <CheckBox x:Name="ChkSuDungChucNangInXuongBep" Content="Sử dụng chức năng in xuống bếp" Style="{StaticResource TouchCheckBoxStyle}"/>

                            <StackPanel Orientation="Horizontal" Margin="24,0,0,10">
                                <CheckBox x:Name="ChkInDoAn" Content="In đồ ăn" Style="{StaticResource TouchCheckBoxStyle}" Margin="0,0,150,0"/>
                                <CheckBox x:Name="ChkInDoUong" Content="In đồ uống" Style="{StaticResource TouchCheckBoxStyle}" Margin="0,0,150,0"/>
                                <CheckBox x:Name="ChkInDichVu" Content="In dịch vụ" Style="{StaticResource TouchCheckBoxStyle}"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Mẫu in chế biến" Foreground="White" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                <ComboBox x:Name="CboMauInCheBien" Grid.Column="1" Style="{StaticResource TouchComboBoxStyle}"/>
                                <Button Grid.Column="2" Style="{StaticResource InputBtnStyle}">
                                    <TextBlock Text="🔍" Foreground="White" FontSize="14"/>
                                </Button>

                                <TextBlock Grid.Column="4" Text="Số liên in chế biến" Foreground="White" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <TextBox x:Name="TxtSoLienInCheBien" Grid.Column="5" Style="{StaticResource TouchTextBoxStyle}" Text="1"/>
                                <Button Grid.Column="6" Style="{StaticResource InputBtnStyle}">
                                    <TextBlock Text="🧮" Foreground="White" FontSize="14"/>
                                </Button>
                            </Grid>

                            <CheckBox x:Name="ChkInThem1LienTaiQuay" Content="In thêm 1 liên tại quầy (ra máy in mặc định)" Style="{StaticResource TouchCheckBoxStyle}"/>
                            <CheckBox x:Name="ChkInMoiDoRa1To" Content="In mỗi đồ ra 1 tờ (In xong từng món cắt giấy ngay)" Style="{StaticResource TouchCheckBoxStyle}"/>
                            <CheckBox x:Name="ChkInRiengDoAnUong" Content="In riêng đồ ăn/đồ uống/đồ khác nếu chung máy in" Style="{StaticResource TouchCheckBoxStyle}"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="350"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ChkTuDongInPhaCheSauKhiGoiMon" Content="Tự động in pha chế sau khi gọi món" Style="{StaticResource TouchCheckBoxStyle}" Margin="0"/>
                                <TextBlock Grid.Column="1" Text="Thời gian chờ tự động in (giây)" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtThoiGianTuDongIn" Grid.Column="2" Style="{StaticResource TouchTextBoxStyle}" Text="10"/>
                                <Button Grid.Column="3" Style="{StaticResource InputBtnStyle}">
                                    <TextBlock Text="🧮" Foreground="White" FontSize="14"/>
                                </Button>
                            </Grid>

                            <CheckBox x:Name="ChkInPhaCheTheoKhuVuc" Content="In pha chế theo khu vực" Style="{StaticResource TouchCheckBoxStyle}"/>
                            <CheckBox x:Name="ChkInThongBaoKhiChuyenBan" Content="In thông báo khi chuyển bàn" Style="{StaticResource TouchCheckBoxStyle}"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="380"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Mẫu in chuyển bàn" Foreground="White" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                <ComboBox x:Name="CboMauInChuyenBan" Grid.Column="1" Style="{StaticResource TouchComboBoxStyle}"/>
                                <Button Grid.Column="2" Style="{StaticResource InputBtnStyle}">
                                    <TextBlock Text="🔍" Foreground="White" FontSize="14"/>
                                </Button>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="380"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="In hóa đơn theo khu vực" Foreground="White" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                <ComboBox x:Name="CboInHoaDonTheoKhuVuc" Grid.Column="1" Style="{StaticResource TouchComboBoxStyle}"/>
                                <Button Grid.Column="2" Style="{StaticResource InputBtnStyle}">
                                    <TextBlock Text="▼" Foreground="White" FontSize="12"/>
                                </Button>
                            </Grid>

                            <CheckBox x:Name="ChkInMatKhauWifiTrenBill" Content="In mật khẩu wifi trên bill" Style="{StaticResource TouchCheckBoxStyle}"/>
                        </StackPanel>

                        <!-- TAB 3: BÁN HÀNG -->
                        <StackPanel x:Name="PanelTab3" Visibility="Collapsed">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- LEFT COLUMN -->
                                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                    <CheckBox x:Name="ChkChoPhepNhapGiamGia" Content="Cho phép nhập giảm giá" Style="{StaticResource TouchCheckBoxStyle}"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Mặc định giảm giá đồ ăn (%)" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtMacDinhGiamGia" Grid.Column="1" Style="{StaticResource TouchTextBoxStyle}" Text="0"/>
                                        <Button Grid.Column="2" Style="{StaticResource InputBtnStyle}">
                                            <TextBlock Text="🧮" Foreground="White" FontSize="14"/>
                                        </Button>
                                    </Grid>

                                    <CheckBox x:Name="ChkCoThueSuat" Content="Có thuế suất" Style="{StaticResource TouchCheckBoxStyle}"/>
                                    <CheckBox x:Name="ChkCoPhiDichVu" Content="Có phí dịch vụ" Style="{StaticResource TouchCheckBoxStyle}"/>
                                    <CheckBox x:Name="ChkNhapSoLuongSauKhiChon" Content="Nhập số lượng sau khi chọn" Style="{StaticResource TouchCheckBoxStyle}"/>
                                    <CheckBox x:Name="ChkBatBuocNhapNhanVienBanHang" Content="Bắt buộc nhập nhân viên bán hàng" Style="{StaticResource TouchCheckBoxStyle}"/>
                                    <CheckBox x:Name="ChkKichHoatKhuyenMaiTuDong" Content="Kích hoạt khuyến mại tự động" Style="{StaticResource TouchCheckBoxStyle}"/>
                                    <CheckBox x:Name="ChkHienThi3NhomOGiaoDienBanHang" Content="Hiển thị 3 nhóm ở giao diện bán hàng" Style="{StaticResource TouchCheckBoxStyle}"/>
                                    <CheckBox x:Name="ChkSuDungMatHangMacDinh" Content="Sử dụng mặt hàng mặc định" Style="{StaticResource TouchCheckBoxStyle}"/>
                                    <CheckBox x:Name="ChkMatHangGiaTheoGioTheoKhuVuc" Content="Mặt hàng giá theo giờ theo khu vực" Style="{StaticResource TouchCheckBoxStyle}"/>
                                </StackPanel>

                                <!-- RIGHT COLUMN -->
                                <StackPanel Grid.Column="1">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Mặc định giảm giá tiền giờ (%)" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtMacDinhGiamGiaTienGio" Grid.Column="1" Style="{StaticResource TouchTextBoxStyle}" Text="0"/>
                                        <Button Grid.Column="2" Style="{StaticResource InputBtnStyle}">
                                            <TextBlock Text="🧮" Foreground="White" FontSize="14"/>
                                        </Button>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Mặc định thuế suất (%)" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtMacDinhThueSuat" Grid.Column="1" Style="{StaticResource TouchTextBoxStyle}" Text="10"/>
                                        <Button Grid.Column="2" Style="{StaticResource InputBtnStyle}">
                                            <TextBlock Text="🧮" Foreground="White" FontSize="14"/>
                                        </Button>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Mặc định phí dịch vụ (%)" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtMacDinhPhiDichVu" Grid.Column="1" Style="{StaticResource TouchTextBoxStyle}" Text="10"/>
                                        <Button Grid.Column="2" Style="{StaticResource InputBtnStyle}">
                                            <TextBlock Text="🧮" Foreground="White" FontSize="14"/>
                                        </Button>
                                    </Grid>

                                    <CheckBox x:Name="ChkChoPhepThayDoiNgayTrenHoaDon" Content="Cho phép thay đổi ngày trên hóa đơn" Style="{StaticResource TouchCheckBoxStyle}"/>
                                    <CheckBox x:Name="ChkChoPhepInTamTinh" Content="Cho phép in tạm tính" Style="{StaticResource TouchCheckBoxStyle}"/>
                                    <CheckBox x:Name="ChkChoPhepTrungTenKhachHang" Content="Cho phép trùng tên khách hàng" Style="{StaticResource TouchCheckBoxStyle}"/>
                                    <CheckBox x:Name="ChkToiUuDungBanPhim" Content="Tối ưu dùng bàn phím" Style="{StaticResource TouchCheckBoxStyle}"/>
                                    <CheckBox x:Name="ChkHienThiGhiChuTrenGiaoDienBan" Content="Hiển thị ghi chú trên giao diện bàn" Style="{StaticResource TouchCheckBoxStyle}"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Cách chọn giờ tính giá" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CboCachChonGioTinhGia" Grid.Column="1" Style="{StaticResource TouchComboBoxStyle}"/>
                                        <Button Grid.Column="2" Style="{StaticResource InputBtnStyle}">
                                            <TextBlock Text="▼" Foreground="White" FontSize="12"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="380"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Cách chọn khách hàng" Foreground="White" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                <ComboBox x:Name="CboCachChonKhachHang" Grid.Column="1" Style="{StaticResource TouchComboBoxStyle}"/>
                                <Button Grid.Column="2" Style="{StaticResource InputBtnStyle}">
                                    <TextBlock Text="▼" Foreground="White" FontSize="12"/>
                                </Button>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="380"/>
                                    <ColumnDefinition Width="Auto"/>
