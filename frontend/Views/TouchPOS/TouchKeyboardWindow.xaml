<Window x:Class="QuanLyBar.Client.Views.TouchPOS.TouchKeyboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bàn phím cảm ứng" Height="420" Width="800"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        Background="#4F7A96" Topmost="True">
    <Window.Resources>
        <Style x:Key="KbKeyBtn" TargetType="Button">
            <Setter Property="Background" Value="#25647C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#42849E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- DISPLAY TEXT INPUT BOX -->
        <Border Grid.Row="0" Background="White" BorderBrush="#1C4B6B" BorderThickness="2" CornerRadius="4" Padding="10,0">
            <Grid>
                <TextBox x:Name="TxtResult" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"
                         BorderThickness="0" Background="Transparent" Foreground="#111111"/>
                <PasswordBox x:Name="TxtPasswordResult" FontSize="22" VerticalAlignment="Center"
                             BorderThickness="0" Background="Transparent" Foreground="#111111" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- KEYBOARD BUTTONS MATRIX -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ROW 1: Numbers & Symbols -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="1" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="1" Content="2" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="2" Content="3" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="3" Content="4" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="4" Content="5" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="5" Content="6" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="6" Content="7" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="7" Content="8" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="8" Content="9" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="9" Content="0" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="10" Content="-" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="11" Content="=" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="12" Content="◄" Style="{StaticResource KbKeyBtn}" Background="#555555" Click="BtnBackspace_Click"/>
            </Grid>

            <!-- ROW 2: QWERTYUIOP\@ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="KeyQ" Content="Q" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="1" x:Name="KeyW" Content="W" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="2" x:Name="KeyE" Content="E" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="3" x:Name="KeyR" Content="R" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="4" x:Name="KeyT" Content="T" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="5" x:Name="KeyY" Content="Y" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="6" x:Name="KeyU" Content="U" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="7" x:Name="KeyI" Content="I" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="8" x:Name="KeyO" Content="O" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="9" x:Name="KeyP" Content="P" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="10" Content="\" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="11" Content="@" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
            </Grid>

            <!-- ROW 3: ASDFGHJKL;' -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="KeyA" Content="A" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="1" x:Name="KeyS" Content="S" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="2" x:Name="KeyD" Content="D" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="3" x:Name="KeyF" Content="F" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="4" x:Name="KeyG" Content="G" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="5" x:Name="KeyH" Content="H" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="6" x:Name="KeyJ" Content="J" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="7" x:Name="KeyK" Content="K" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="8" x:Name="KeyL" Content="L" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="9" Content=";" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="10" Content="'" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
            </Grid>

            <!-- ROW 4: ZXCVBNM,. & Shift -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="KeyZ" Content="Z" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="1" x:Name="KeyX" Content="X" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="2" x:Name="KeyC" Content="C" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="3" x:Name="KeyV" Content="V" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="4" x:Name="KeyB" Content="B" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="5" x:Name="KeyN" Content="N" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="6" x:Name="KeyM" Content="M" Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="7" Content="," Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="8" Content="." Style="{StaticResource KbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="9" Content="▲" Style="{StaticResource KbKeyBtn}" Background="#555555" Foreground="#FFD700" Click="BtnShift_Click"/>
            </Grid>

            <!-- ROW 5: Cancel, Space, OK -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Hủy bỏ" Style="{StaticResource KbKeyBtn}" Background="#CC0000" Click="BtnCancel_Click"/>
                <Button Grid.Column="1" Content="" Style="{StaticResource KbKeyBtn}" Background="#3A3A3A" Click="BtnSpace_Click"/>
                <Button Grid.Column="2" Content="➔" Style="{StaticResource KbKeyBtn}" Background="#008822" FontSize="24" Click="BtnOk_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
