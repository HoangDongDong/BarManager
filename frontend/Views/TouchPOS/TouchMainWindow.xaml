<Window x:Class="QuanLyBar.Client.Views.TouchPOS.TouchMainWindow" x:Name="ThisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Quản Lý Bar - POS Cảm Ứng"
        Icon="pack://application:,,,/img/Icon.ico"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#1A1A2E"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="TouchBtn" TargetType="Button">
            <Setter Property="Background" Value="#16213E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0F3460"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#533483"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TableTileStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Custom Metallic ScrollBar & ScrollViewer Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- SCROLL UP BUTTON -->
                            <RepeatButton Grid.Row="0" Command="{x:Static ScrollBar.LineUpCommand}" Height="30" Margin="0,0,0,3" Cursor="Hand">
                                <RepeatButton.Template>
                                    <ControlTemplate TargetType="RepeatButton">
                                        <Border BorderBrush="#D0D0D0" BorderThickness="1.5" CornerRadius="8">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#9E9E9E" Offset="0"/>
                                                    <GradientStop Color="#686868" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="▲" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>
                            <!-- SCROLL TRACK & THUMB -->
                            <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="true" HorizontalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{x:Null}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Rectangle Fill="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border BorderBrush="#659BB0" BorderThickness="1.5" CornerRadius="12" Width="22">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#1C5E73" Offset="0"/>
                                                            <GradientStop Color="#2C809B" Offset="0.5"/>
                                                            <GradientStop Color="#1C5E73" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{x:Null}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Rectangle Fill="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                            <!-- SCROLL DOWN BUTTON -->
                            <RepeatButton Grid.Row="2" Command="{x:Static ScrollBar.LineDownCommand}" Height="30" Margin="0,3,0,0" Cursor="Hand">
                                <RepeatButton.Template>
                                    <ControlTemplate TargetType="RepeatButton">
                                        <Border BorderBrush="#D0D0D0" BorderThickness="1.5" CornerRadius="8">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#9E9E9E" Offset="0"/>
                                                    <GradientStop Color="#686868" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="▼" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid x:Name="Grid" Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Column="0" CanContentScroll="{TemplateBinding CanContentScroll}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" AutomationProperties.AutomationId="VerticalScrollBar" 
                                       Cursor="Hand" Maximum="{TemplateBinding ScrollableHeight}" Minimum="0" 
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                       ViewportSize="{TemplateBinding ViewportHeight}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="KeypadBtnStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#174351" BorderBrush="#286275" BorderThickness="2" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="44"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>
    <Grid>
        <!-- LOGIN SCREEN (GIAO DIỆN ĐĂNG NHẬP MÁY POS FULL MAN HINH KIOSK) -->
        <Grid x:Name="GridTouchLogin" Background="#3D0A0A" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- 1. BANNER TRÊN CÙNG SPAN 100% CHIỀU RỘNG MÀN HÌNH -->
            <Border Grid.Row="0" Background="#A80000" BorderBrush="#D91616" BorderThickness="0,0,0,2" Padding="24,14">
                <Grid>
                    <TextBlock Text="PHẦN MỀM QUẢN LÝ BAR, NHÀ HÀNG - ĐĂNG NHẬP POS" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <TextBlock Text="MỜI BẠN NHẬP THÔNG TIN ĐỂ ĐĂNG NHẬP" Foreground="#FFE6E6" FontWeight="Bold" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <!-- 2. KHUNG TRUNG TÂM PHỦ RỘNG & THOÁNG TOÀN MÀN HÌNH -->
            <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="1280">
                <Border Background="#2B0505" BorderBrush="#5C0D0D" BorderThickness="2" CornerRadius="20" Padding="54,44">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="6" Opacity="0.7"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- Cột 1: 3 Nút icon tính năng bên trái -->
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="48"/>
                            <!-- Cột 2: Form đăng nhập chính -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- 3 NÚT ICON TÍNH NĂNG BÊN TRÁI -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <!-- Mode 1: Bàn phím số # -->
                            <Button x:Name="BtnModeKeypad" Height="110" Margin="0,0,0,24" Cursor="Hand" Click="BtnModeKeypad_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="BdModeKeypad" Background="#5A0F0F" BorderBrush="#8A2525" BorderThickness="2" CornerRadius="14">
                                            <TextBlock Text="#" Foreground="White" FontSize="56" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <!-- Mode 2: Nhập tài khoản mật khẩu **| -->
                            <Button x:Name="BtnModeForm" Height="110" Margin="0,0,0,24" Cursor="Hand" Click="BtnModeForm_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="BdModeForm" Background="#D97706" BorderBrush="#F59E0B" BorderThickness="2" CornerRadius="14">
                                            <Border BorderBrush="White" BorderThickness="2" CornerRadius="8" Width="64" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="**|" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <!-- Mode 3: Quét thẻ từ -->
                            <Button x:Name="BtnModeCard" Height="110" Cursor="Hand" Click="BtnModeCard_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="BdModeCard" Background="#5A0F0F" BorderBrush="#8A2525" BorderThickness="2" CornerRadius="14">
                                            <Border Background="White" CornerRadius="8" Width="56" Height="38" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border Background="#5A0F0F" Height="10" Margin="0,6,0,0" VerticalAlignment="Top"/>
                                            </Border>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                        <!-- CONTAINER CÁC PANEL ĐĂNG NHẬP -->
                        <Grid Grid.Column="2" VerticalAlignment="Center">
                            <!-- PANEL 1: ĐĂNG NHẬP BẰNG BÀN PHÍM SỐ / MÃ ID (MODE #) -->
                            <StackPanel x:Name="PanelLoginKeypad" Visibility="Collapsed" HorizontalAlignment="Center">
                                <Grid Width="420" Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="82"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="82"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="82"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="82"/>
                                    </Grid.RowDefinitions>
                                    <!-- HÀNG 1: 1, 2, 3 -->
                                    <Button Grid.Row="0" Grid.Column="0" Content="1" Style="{StaticResource KeypadBtnStyle}" Click="BtnKeypadNum_Click" Tag="1"/>
                                    <Button Grid.Row="0" Grid.Column="2" Content="2" Style="{StaticResource KeypadBtnStyle}" Click="BtnKeypadNum_Click" Tag="2"/>
                                    <Button Grid.Row="0" Grid.Column="4" Content="3" Style="{StaticResource KeypadBtnStyle}" Click="BtnKeypadNum_Click" Tag="3"/>
                                    <!-- HÀNG 2: 4, 5, 6 -->
                                    <Button Grid.Row="2" Grid.Column="0" Content="4" Style="{StaticResource KeypadBtnStyle}" Click="BtnKeypadNum_Click" Tag="4"/>
                                    <Button Grid.Row="2" Grid.Column="2" Content="5" Style="{StaticResource KeypadBtnStyle}" Click="BtnKeypadNum_Click" Tag="5"/>
                                    <Button Grid.Row="2" Grid.Column="4" Content="6" Style="{StaticResource KeypadBtnStyle}" Click="BtnKeypadNum_Click" Tag="6"/>
                                    <!-- HÀNG 3: 7, 8, 9 -->
                                    <Button Grid.Row="4" Grid.Column="0" Content="7" Style="{StaticResource KeypadBtnStyle}" Click="BtnKeypadNum_Click" Tag="7"/>
                                    <Button Grid.Row="4" Grid.Column="2" Content="8" Style="{StaticResource KeypadBtnStyle}" Click="BtnKeypadNum_Click" Tag="8"/>
                                    <Button Grid.Row="4" Grid.Column="4" Content="9" Style="{StaticResource KeypadBtnStyle}" Click="BtnKeypadNum_Click" Tag="9"/>
                                    <!-- HÀNG 4: ◄ (Xóa), 0, ► (Đăng nhập) -->
                                    <Button Grid.Row="6" Grid.Column="0" Cursor="Hand" Click="BtnKeypadBackspace_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#D96414" BorderBrush="#F57C00" BorderThickness="2" CornerRadius="12">
                                                    <TextBlock Text="◄" Foreground="White" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Grid.Row="6" Grid.Column="2" Content="0" Style="{StaticResource KeypadBtnStyle}" Click="BtnKeypadNum_Click" Tag="0"/>
                                    <Button Grid.Row="6" Grid.Column="4" Cursor="Hand" Click="BtnKeypadSubmit_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#0E5C23" BorderBrush="#1B8034" BorderThickness="2" CornerRadius="12">
                                                    <TextBlock Text="►" Foreground="White" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                                <!-- HIỂN THỊ MÃ ID / PIN ĐÃ NHẬP DƯỚI BÀN PHÍM SỐ -->
                                <TextBlock x:Name="TxtKeypadDisplay" Text="*" Foreground="White" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                            <!-- PANEL 2: FORM ĐĂNG NHẬP CHÍNH (MODE **|) -->
                            <StackPanel x:Name="PanelLoginForm" Visibility="Visible" VerticalAlignment="Center">
                                <!-- TÀI KHOẢN -->
                                <Grid Margin="0,0,0,24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="TÀI KHOẢN:" Foreground="White" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtLoginUser" Grid.Column="1" Text="admin" Height="56" Padding="14,0"
                                             Background="White" Foreground="#111111" BorderBrush="#CCCCCC" BorderThickness="1.5"
                                             FontSize="22" FontWeight="SemiBold" VerticalContentAlignment="Center"
                                             KeyDown="TxtLoginInput_KeyDown"/>
                                    <Button x:Name="BtnTouchKbUser" Grid.Column="2" Width="68" Height="56" Margin="12,0,0,0"
                                            Background="#500A0A" BorderBrush="#9E1F1F" BorderThickness="1.5" Cursor="Hand" Click="BtnTouchKbUser_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                                    <TextBlock Text="⌨" Foreground="White" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                                <!-- MẬT KHẨU -->
                                <Grid Margin="0,0,0,26">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="MẬT KHẨU:" Foreground="White" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/>
                                    <PasswordBox x:Name="TxtLoginPass" Grid.Column="1" Height="56" Padding="14,0"
                                                 Background="White" Foreground="#111111" BorderBrush="#CCCCCC" BorderThickness="1.5"
                                                 FontSize="22" VerticalContentAlignment="Center"/>
                                    <Button x:Name="BtnTouchKbPass" Grid.Column="2" Width="68" Height="56" Margin="12,0,0,0"
                                            Background="#500A0A" BorderBrush="#9E1F1F" BorderThickness="1.5" Cursor="Hand" Click="BtnTouchKbPass_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                                    <TextBlock Text="⌨" Foreground="White" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                                <!-- GHI NHỚ MẬT KHẨU & TỰ ĐỘNG ĐĂNG NHẬP -->
                                <StackPanel Margin="150,0,0,20">
                                    <CheckBox x:Name="ChkRememberPass" Content="Ghi nhớ mật khẩu" IsChecked="True"
                                              Foreground="White" FontWeight="Bold" FontSize="17" Margin="0,0,0,12"/>
                                    <CheckBox x:Name="ChkAutoLogin" Content="Tự động đăng nhập" IsChecked="True"
                                              Foreground="White" FontWeight="Bold" FontSize="17" Margin="0,0,0,10"/>
                                    <TextBlock Text="(Mật khẩu mặc định: để trống)" Foreground="#DDDDDD" FontSize="15" Margin="0,0,0,20"/>
                                </StackPanel>
                                <!-- NÚT ĐĂNG NHẬP & NHẬP LẠI -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <!-- NÚT ĐĂNG NHẬP (Xanh lá) -->
                                    <Button x:Name="BtnSubmitLogin" Content="Đăng nhập" Width="240" Height="66" Margin="0,0,20,0" Cursor="Hand" Click="BtnSubmitLogin_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#1E7333" BorderBrush="#2E8B46" BorderThickness="2" CornerRadius="33">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Foreground>White</Button.Foreground>
                                        <Button.FontWeight>Bold</Button.FontWeight>
                                        <Button.FontSize>22</Button.FontSize>
                                    </Button>
                                    <!-- NÚT NHẬP LẠI (Tím đậm) -->
                                    <Button x:Name="BtnResetLogin" Content="Nhập lại" Width="240" Height="66" Cursor="Hand" Click="BtnResetLogin_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#581845" BorderBrush="#7D2363" BorderThickness="2" CornerRadius="33">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Foreground>White</Button.Foreground>
                                        <Button.FontWeight>Bold</Button.FontWeight>
                                        <Button.FontSize>22</Button.FontSize>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            <!-- PANEL 3: QUÉT THẺ TỪ (MODE CARD) -->
                            <StackPanel x:Name="PanelLoginCard" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- THẺ TỪ ĐỒ HỌA CHUẨN GIỐNG ẢNH 3 -->
                                <Border Background="White" CornerRadius="32" Width="560" Height="380" Padding="0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="6" Opacity="0.5"/>
                                    </Border.Effect>
                                    <Grid>
                                        <!-- CHIP THẺ ĐỒ HỌA TRÊN GÓC TRÁI -->
                                        <Border Width="64" Height="54" Background="#2B0505" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="44,36,0,0"/>
                                        <!-- HƯỚNG DẪN QUÉT THẺ -->
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,30,0,50">
                                            <TextBlock Text="VUI LÒNG QUÉT THẺ TỪ" Foreground="#2B0505" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                            <TextBlock Text="Hoặc đặt thẻ lên thiết bị đọc thẻ POS..." Foreground="#555555" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                            <!-- TEXTBOX ĐỌC MÃ THẺ NHẬP/SCANNED -->
                                            <TextBox x:Name="TxtCardCodeInput" Width="320" Height="48" Background="#F0F0F0" Foreground="#111111" FontSize="20" FontWeight="Bold"
                                                     TextAlignment="Center" VerticalContentAlignment="Center" BorderBrush="#CCCCCC" BorderThickness="1.5"
                                                     KeyDown="TxtCardCodeInput_KeyDown"/>
                                        </StackPanel>
                                        <!-- DẢI TỪ ĐEN BẢN RỘNG BÊN DƯỚI DÁNG CHUẨN ẢNH 3 -->
                                        <Border Height="76" Background="#2B0505" CornerRadius="0,0,32,32" VerticalAlignment="Bottom"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            <!-- 3. THANH TRẠNG THÁI DƯỚI CÙNG SPAN 100% CHIỀU RỘNG MÀN HÌNH -->
            <Border Grid.Row="2" Background="#210303" BorderBrush="#4A0808" BorderThickness="0,1.5,0,0" Padding="20,10">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border Background="#3B0707" Padding="12,6" CornerRadius="6" Margin="0,0,12,0">
                            <TextBlock Text="PHIÊN BẢN 6.0.0.0" Foreground="White" FontWeight="Bold" FontSize="13"/>
                        </Border>
                        <Border Background="#3B0707" Padding="12,6" CornerRadius="6">
                            <TextBlock x:Name="TxtDbInfo" Text="CƠ SỞ DỮ LIỆU: DEMO" Foreground="White" FontWeight="Bold" FontSize="13"/>
                        </Border>
                    </StackPanel>
                    <!-- Nút Nguồn Tắt Máy ở góc dưới bên phải -->
                    <Button x:Name="BtnPowerOff" HorizontalAlignment="Right" VerticalAlignment="Center" Width="44" Height="44" Cursor="Hand" Click="BtnPowerOff_Click" ToolTip="Tắt ứng dụng">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#4D0A0A" BorderBrush="#941919" BorderThickness="2" CornerRadius="8">
                                    <TextBlock Text="⏻" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
        <!-- MAIN MENU SCREEN (GIAO DIỆN CHÍNH MÁY POS THEO 5 ẢNH MẪU THAM KHẢO) -->
        <Grid x:Name="GridTouchMenu" Visibility="Collapsed" Background="#002533">
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="36"/>
            </Grid.RowDefinitions>
            <!-- 1. HEADER THANH TIÊU ĐỀ TRÊN CÙNG -->
            <Border Grid.Row="0" Background="#1B4D5C" BorderBrush="#2C6B7C" BorderThickness="0,0,0,1.5">
                <TextBlock x:Name="TxtMenuHeaderTitle" Text="PHẦN MỀM QUẢN LÝ BAR, NHÀ HÀNG V6.0 TÂN AN PHÁT - HOTLINE: 0967041111" 
                           Foreground="White" FontWeight="Bold" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
