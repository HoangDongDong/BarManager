                    <TextBlock Text="Đăng ký bản quyền: TTS TEST" Foreground="White" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="#2C6B7C" Padding="12,2" CornerRadius="3" Margin="0,0,6,0">
                            <TextBlock x:Name="TxtFooterUser" Text="Administrator" Foreground="White" FontSize="12" FontWeight="Bold"/>
                        </Border>
                        <Border Background="#2C6B7C" Padding="12,2" CornerRadius="3">
                            <TextBlock x:Name="TxtFooterDb" Text="DEMO" Foreground="White" FontSize="12" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- TABLE SELECTION SCREEN (SỬ DỤNG DỊCH VỤ - CHỌN BÀN CHUẨN GIAO DIỆN ẢNH MẪU) -->
        <Grid x:Name="GridTouchTables" Visibility="Collapsed" Background="#3A75A4">

            <Grid.ColumnDefinitions>
                <!-- LEFT/CENTER: TABLE TILES GRID -->
                <ColumnDefinition Width="*"/>
                <!-- RIGHT SIDEBAR: USER BADGE, AREA BUTTONS & ACTION BUTTONS -->
                <ColumnDefinition Width="170"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT AREA: TABLE TILES LIST WITH SCROLLVIEWER & TABLE CONFIG GEAR BUTTON AT BOTTOM RIGHT -->
            <Grid Grid.Column="0" Margin="6,6,4,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" x:Name="SvTableTiles" 
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="IcTableTiles">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding ColumnCount, ElementName=ThisWindow, FallbackValue=1}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="4" CornerRadius="4" Height="{Binding TileHeight, ElementName=ThisWindow, FallbackValue=85}" 
                                        BorderBrush="#FFFFFF" BorderThickness="1.5" Cursor="Hand" MouseLeftButtonDown="TableTile_MouseLeftButtonDown">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#808080"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOpened}" Value="True">
                                                    <Setter Property="Background" Value="#FF0000"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsOpened}" Value="False">
                                                    <Setter Property="Background" Value="#808080"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding TENBAN}" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- NÚT CAI ĐẶT BÁNH RĂNG ⚙ Ở BÊN DƯỚI PHẦN GIỚI HẠN THANH TRUỘT BÀN -->
                <Button Grid.Row="1" x:Name="BtnConfigTables" Width="36" Height="36" HorizontalAlignment="Right" Margin="0,4,0,0" Cursor="Hand" Click="BtnConfigTables_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#E0E0E0" BorderBrush="#B0B0B0" BorderThickness="1" CornerRadius="3">
                                <TextBlock Text="⚙" Foreground="#1B4D5C" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- RIGHT SIDEBAR (Column 1) -->
            <Grid Grid.Column="1" Margin="2,6,6,6">
                <Grid.RowDefinitions>
                    <!-- 1. USER BADGE AT TOP -->
                    <RowDefinition Height="Auto"/>
                    <!-- 2. AREA LIST (KHU VỰC) + GEAR BUTTON -->
                    <RowDefinition Height="*"/>
                    <!-- 3. ACTION BUTTONS STACK (ĐANG MỞ, THỐNG KÊ, ĐÓNG, ĐĂNG XUẤT) -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. USER BADGE (Administrator) -->
                <Border Grid.Row="0" Background="#006400" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                    <TextBlock x:Name="TxtCurrentPOSUser" Text="Administrator" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- 2. AREA BUTTONS LIST -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl x:Name="IcAreaButtons">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding TenKhuVuc}" Height="44" Margin="0,3" Cursor="Hand" Tag="{Binding}" Click="BtnAreaSelect_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{Binding ColorBrush, FallbackValue='#D96414'}" BorderBrush="#36B5B0" BorderThickness="1.5" CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Foreground>White</Button.Foreground>
                                        <Button.FontWeight>Bold</Button.FontWeight>
                                        <Button.FontSize>13</Button.FontSize>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- GEAR BUTTON FOR AREA CONFIG -->
                        <Button x:Name="BtnConfigAreas" Width="36" Height="32" HorizontalAlignment="Right" Margin="0,6,0,6" Cursor="Hand" Click="BtnConfigAreas_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#E0E0E0" BorderBrush="#B0B0B0" BorderThickness="1" CornerRadius="3">
                                        <TextBlock Text="⚙" Foreground="#1B4D5C" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- 3. BOTTOM RIGHT ACTION BUTTONS -->
                <StackPanel Grid.Row="2" Margin="0,6,0,0">
                    <!-- ĐANG MỞ -->
                    <Button x:Name="BtnFilterDangMo" Height="42" Margin="0,0,0,6" Cursor="Hand" Click="BtnFilterDangMo_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#948B00" BorderBrush="#B5AE00" BorderThickness="1.5" CornerRadius="6" Padding="6,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="🔍 " Foreground="White" FontSize="14" FontWeight="Bold"/>
                                        <TextBlock Text="ĐANG MỞ" Foreground="White" FontSize="12.5" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- THỐNG KÊ -->
                    <Button x:Name="BtnShiftStats" Height="42" Margin="0,0,0,6" Cursor="Hand" Click="BtnShiftStats_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#0B1B47" BorderBrush="#1E3575" BorderThickness="1.5" CornerRadius="6" Padding="6,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="📋 " Foreground="White" FontSize="14" FontWeight="Bold"/>
                                        <TextBlock Text="THỐNG KÊ" Foreground="White" FontSize="12.5" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- ĐÓNG -->
                    <Button x:Name="BtnClosePOS" Height="42" Margin="0,0,0,6" Cursor="Hand" Click="BtnClosePOS_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#4A0A0A" BorderBrush="#7A1212" BorderThickness="1.5" CornerRadius="6" Padding="6,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="🛈 " Foreground="White" FontSize="14" FontWeight="Bold"/>
                                        <TextBlock Text="ĐÓNG" Foreground="White" FontSize="12.5" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- ĐĂNG XUẤT -->
                    <Button x:Name="BtnLogoutPOS" Height="42" Cursor="Hand" Click="BtnLogoutPOS_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#0A4A17" BorderBrush="#127A27" BorderThickness="1.5" CornerRadius="6" Padding="6,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="🔒 " Foreground="White" FontSize="14" FontWeight="Bold"/>
                                        <TextBlock Text="ĐĂNG XUẤT" Foreground="White" FontSize="12.5" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ORDER SCREEN MATCHING REFERENCE SCREENSHOT -->
        <Grid x:Name="GridTouchOrder" Visibility="Collapsed" Background="#367588">
            <Grid.ColumnDefinitions>
                <!-- LEFT: INVOICE HEADER, ORDER ITEMS DATAGRID, ACTIONS & TOTALS -->
                <ColumnDefinition Width="385"/>
                <!-- MIDDLE: CATEGORIES COLUMN + SEARCH -->
                <ColumnDefinition Width="180"/>
                <!-- RIGHT: ITEMS GRID + GEAR -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= CỘT TRÁI: HÓA ĐƠN & GIỎ HÀNG ================= -->
            <Grid Grid.Column="0" Margin="3,4,2,4" Background="#2B5F6F">
                <Grid.RowDefinitions>
                    <RowDefinition Height="95"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="185"/>
                </Grid.RowDefinitions>

                <!-- TOP WHITE HEADER INFO CARD -->
                <Border Grid.Row="0" Background="White" Padding="4" CornerRadius="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="75"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- BIG RED CANCEL / DELETE ORDER BUTTON -->
                        <Button Grid.Column="0" x:Name="BtnCancelOrder" Cursor="Hand" Click="BtnCancelOrder_Click" Margin="0,0,4,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#CC0000" BorderBrush="#990000" BorderThickness="1" CornerRadius="4">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="✖" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-2,0,-2"/>
                                            <TextBlock Text="Hủy hóa đơn" Foreground="White" FontSize="10.5" FontWeight="Bold" TextAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- INVOICE DETAILS GRID -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="NGÀY " Foreground="Black" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtOrderDate" Text="31/08/2026" Foreground="Black" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            
                            <TextBlock Grid.Row="0" Grid.Column="2" Text=" SỐ " Foreground="Black" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" x:Name="TxtOrderNo" Text="082600010" Foreground="Black" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="BÀN " Foreground="Black" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtOrderTableName" Text="Bàn 02" Foreground="Black" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="1" Grid.Column="2" Text=" SỐ KHÁCH " Foreground="Black" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border Grid.Row="1" Grid.Column="3" Background="#2E6C99" CornerRadius="10" Padding="8,1" Margin="2,1">
                                <TextBlock x:Name="TxtOrderGuestCount" Text="1" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Border>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="KHÁCH HÀNG" Foreground="Black" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Background="#2E6C99" CornerRadius="10" Padding="8,2" Margin="2,1" Cursor="Hand" PreviewMouseDown="BtnSelectCustomer_Click">
                                <TextBlock x:Name="TxtOrderCustomer" Text="KHÁCH LẺ" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- CENTER CART LIST DATAGRID -->
                <DataGrid x:Name="DgOrderItems" Grid.Row="1" 
                          Background="White" Foreground="#1E293B"
                          RowBackground="White" AlternatingRowBackground="#F8FAFC"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                          AutoGenerateColumns="False" IsReadOnly="True" Margin="0,2"
                          HeadersVisibility="Column" ColumnHeaderHeight="34"
                          RowHeight="44" SelectionMode="Single"
                          BorderBrush="#CBD5E1" BorderThickness="1">

                    <DataGrid.Resources>
                        <!-- Column Header Style -->
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#1C4B6B"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="4,0"/>
                            <Setter Property="Height" Value="34"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="BorderBrush" Value="#0F3460"/>
                            <Setter Property="BorderThickness" Value="0,0,1,0"/>
                        </Style>

                        <!-- Selected Row Style -->
                        <Style TargetType="DataGridRow">
                            <Setter Property="Margin" Value="0,1"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E0F2FE"/>
                                    <Setter Property="Foreground" Value="#0369A1"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <!-- 1. SỐ LƯỢNG -->
                        <DataGridTemplateColumn Header="SL" Width="42">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#1E40AF" CornerRadius="12" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SoLuong, StringFormat={}{0:0.#}}" Foreground="White" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 2. TÊN MÓN -->
                        <DataGridTemplateColumn Header="TÊN MÓN" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TenMatHang}" Foreground="#0F172A" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 3. THÀNH TIỀN -->
                        <DataGridTemplateColumn Header="THÀNH TIỀN" Width="82">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ThanhTien, StringFormat={}{0:N0}}" Foreground="#B91C1C" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 4. THAO TÁC (+ / - / XÓA) -->
                        <DataGridTemplateColumn Header="TÁC VỤ" Width="78">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Content="-" Width="21" Height="24" Margin="0,0,2,0" Background="#DC2626" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand" Click="BtnDecreaseQty_Click">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="3"/></Style></Button.Resources>
                                        </Button>
                                        <Button Content="+" Width="21" Height="24" Margin="0,0,2,0" Background="#16A34A" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand" Click="BtnIncreaseQty_Click">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="3"/></Style></Button.Resources>
                                        </Button>
                                        <Button Content="🗑" Width="21" Height="24" Background="#475569" Foreground="White" FontSize="10.5" BorderThickness="0" Cursor="Hand" Click="BtnRemoveCartItem_Click">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="3"/></Style></Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- BOTTOM ACTIONS & TOTALS -->
                <Grid Grid.Row="2" Margin="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT STACK OF ACTION BUTTONS -->
                    <StackPanel Grid.Column="0">
                        <Button x:Name="BtnOrderDiscount" Content="⛔ Giảm giá" Click="BtnOrderDiscount_Click" Height="27" Margin="0,0,0,2" Cursor="Hand" Background="#541416" Foreground="White" FontSize="10.5" FontWeight="Bold"/>
                        <Button x:Name="BtnOrderMoveTable" Content="🔄 Chuyển bàn" Click="BtnOrderMoveTable_Click" Height="27" Margin="0,0,0,2" Cursor="Hand" Background="#113C17" Foreground="White" FontSize="10.5" FontWeight="Bold"/>
                        <Button x:Name="BtnOrderMergeTable" Content="🔀 Gộp bàn" Click="BtnOrderMergeTable_Click" Height="27" Margin="0,0,0,2" Cursor="Hand" Background="#0C3D42" Foreground="White" FontSize="10.5" FontWeight="Bold"/>
                        <Button x:Name="BtnOrderPrintKitchen" Content="🖨 Chế biến" Click="BtnOrderPrintKitchen_Click" Height="27" Margin="0,0,0,2" Cursor="Hand" Background="#3B0C52" Foreground="White" FontSize="10.5" FontWeight="Bold"/>
                        <Button x:Name="BtnOrderPayment" Content="💵 Thanh toán" Click="BtnOrderPayment_Click" Height="27" Margin="0,0,0,2" Cursor="Hand" Background="#1E8638" Foreground="White" FontSize="10.5" FontWeight="Bold"/>
                        <Button x:Name="BtnOrderBack" Content="🚪 Đóng cửa sổ" Click="BtnOrderBack_Click" Height="27" Cursor="Hand" Background="#D85517" Foreground="White" FontSize="10.5" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- RIGHT TOTALS SUMMARY PANEL -->
                    <Grid Grid.Column="1" Margin="6,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- GEAR BUTTON AT TOP RIGHT ABOVE TIỀN HÀNG -->
                        <Button Grid.Row="0" x:Name="BtnConfigCart" Width="26" Height="24" HorizontalAlignment="Right" Margin="0,0,0,4" Cursor="Hand" Click="BtnConfigCart_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#E0E0E0" BorderBrush="#B0B0B0" BorderThickness="1" CornerRadius="3">
                                        <TextBlock Text="⚙" Foreground="#1B4D5C" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- TIỀN HÀNG -->
                        <Grid Grid.Row="2" Margin="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TIỀN HÀNG" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#808080" CornerRadius="10" Padding="8,3" Margin="6,0,0,0">
                                <TextBlock x:Name="TxtTotalSub" Text="0" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Border>
                        </Grid>

                        <!-- GIẢM GIÁ -->
                        <Grid Grid.Row="3" Margin="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="GIẢM GIÁ" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#2E6C99" CornerRadius="10" Padding="4,2" Margin="4,0,2,0">
                                <TextBlock Text="0" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="2" Background="#2E6C99" CornerRadius="10" Padding="8,3" Margin="2,0,0,0">
                                <TextBlock x:Name="TxtTotalDiscount" Text="0" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Border>
                        </Grid>

                        <!-- TỔNG CỘNG -->
                        <Grid Grid.Row="4" Margin="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TỔNG CỘNG" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#8B0000" CornerRadius="10" Padding="8,4" Margin="6,0,0,0">
                                <TextBlock x:Name="TxtTotalFinal" Text="0" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ================= CỘT GIỮA: NHÓM MÓN & TÌM KIẾM ================= -->
            <Grid Grid.Column="1" Margin="2,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" x:Name="SvTouchNhomHang" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="SvTouchNhomHang_SizeChanged">
                    <ItemsControl x:Name="IcTouchNhomHang" VerticalAlignment="Top">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding NhomColumns, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Top"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding TenNhom}" Margin="2" MinHeight="{Binding NhomTileMinHeight, RelativeSource={RelativeSource AncestorType=Window}}" Cursor="Hand" Tag="{Binding}" Click="BtnNhomHangSelect_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{Binding ColorBrushHex, FallbackValue='#D96414'}" BorderBrush="#FFA040" BorderThickness="1" CornerRadius="10" Padding="4,8">
                                                <TextBlock Text="{TemplateBinding Content}" Foreground="{Binding TextColorHex, FallbackValue='White'}" FontSize="12" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- GEAR BUTTON BELOW CATEGORIES -->
                <Button Grid.Row="1" x:Name="BtnConfigNhomHang" Width="26" Height="24" HorizontalAlignment="Right" Margin="0,4,0,4" Cursor="Hand" Click="BtnConfigNhomHang_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#E0E0E0" BorderBrush="#B0B0B0" BorderThickness="1" CornerRadius="3">
                                <TextBlock Text="⚙" Foreground="#1B4D5C" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- TÌM KIẾM BUTTON AT BOTTOM -->
                <Button Grid.Row="2" x:Name="BtnSearchItem" Click="BtnSearchItem_Click" Height="40" Margin="0,2" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#0B4B57" BorderBrush="#17A2B8" BorderThickness="1" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="🔍 " Foreground="White" FontSize="13" FontWeight="Bold"/>
                                    <TextBlock Text="TÌM KIẾM" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- ================= CỘT PHẢI: DANH SÁCH MẶT HÀNG ================= -->
            <Grid Grid.Column="2" Margin="2,4,4,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" x:Name="SvTouchMatHang" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="SvTouchMatHang_SizeChanged">
                    <ItemsControl x:Name="IcTouchMatHang" VerticalAlignment="Top">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding MatHangColumns, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Top"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="{Binding MatHangTileHeight, RelativeSource={RelativeSource AncestorType=Window}}" Margin="3" CornerRadius="8" Background="{Binding TileColorBrush, FallbackValue='#0D4B5B'}" BorderBrush="#26A69A" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="MatHangTile_MouseLeftButtonDown">
                                    <Grid Margin="5">
                                        <!-- LAYOUT WHEN ITEM HAS IMAGE -->
                                        <Grid Visibility="{Binding HasImageVisibility}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- ITEM NAME AT TOP -->
                                            <TextBlock Grid.Row="0" Text="{Binding TenMatHang}" Foreground="White" FontSize="12.5" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Top" MaxHeight="36"/>

                                            <!-- PRODUCT IMAGE IN MIDDLE -->
                                            <Border Grid.Row="1" Margin="2" CornerRadius="4" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Image Source="{Binding ImageSource}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- PRICE AT BOTTOM -->
                                            <Border Grid.Row="2" Background="#20000000" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                                <TextBlock Text="{Binding GiaBanFormatted, FallbackValue='0'}" Foreground="#FFFF66" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>

                                        <!-- LAYOUT WHEN ITEM HAS NO IMAGE (NAME CENTERED LIKE BEFORE) -->
                                        <Grid Visibility="{Binding NoImageVisibility}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- ITEM NAME CENTERED IN TILE -->
                                            <TextBlock Grid.Row="0" Text="{Binding TenMatHang}" Foreground="White" FontSize="13.5" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                            <!-- PRICE AT BOTTOM -->
                                            <Border Grid.Row="1" Background="#20000000" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                                <TextBlock Text="{Binding GiaBanFormatted, FallbackValue='0'}" Foreground="White" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- GEAR BUTTON AT BOTTOM RIGHT OF MENU ITEMS -->
                <Button Grid.Row="1" x:Name="BtnConfigMatHang" Width="26" Height="24" HorizontalAlignment="Right" Margin="0,4,0,0" Cursor="Hand" Click="BtnConfigMatHang_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#E0E0E0" BorderBrush="#B0B0B0" BorderThickness="1" CornerRadius="3">
                                <TextBlock Text="⚙" Foreground="#1B4D5C" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
