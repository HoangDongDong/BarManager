                                        <TextBlock Text="{Binding GiaBan, StringFormat={}{0:N0}đ}" FontSize="11"
                                                   Foreground="#FFB74D" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
