<Window x:Class="QuanLyBar.Client.Views.TouchPOS.TouchMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Quản Lý Bar - POS Cảm Ứng"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#1A1A2E"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="TouchBtn" TargetType="Button">
            <Setter Property="Background" Value="#16213E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0F3460"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#533483"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TableTileStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- LOGIN SCREEN -->
        <Grid x:Name="GridTouchLogin" Background="#1A1A2E" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Power Off button top right -->
            <Button Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Content="⏻" FontSize="22" Foreground="#E53935" Background="Transparent"
                    BorderThickness="0" Margin="16" Cursor="Hand"
                    Click="BtnPowerOff_Click"/>

            <!-- Login Form -->
            <Border Grid.Row="1" Background="#16213E" CornerRadius="16" Padding="40"
                    HorizontalAlignment="Center" MinWidth="400">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="🍸 QUẢN LÝ BAR" FontSize="28" FontWeight="Bold" 
                               Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Đăng nhập POS cảm ứng" FontSize="14" 
                               Foreground="#90CAF9" HorizontalAlignment="Center" Margin="0,0,0,32"/>

                    <!-- Username -->
                    <TextBlock Text="Tên đăng nhập" Foreground="#90CAF9" FontSize="13" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtLoginUser" Height="44" Padding="12,0"
                                 Background="#0F3460" Foreground="White" BorderBrush="#1976D2"
                                 FontSize="15" VerticalContentAlignment="Center"/>
                        <Button x:Name="BtnTouchKbUser" Grid.Column="1" Content="⌨" 
                                Width="44" Height="44" Margin="4,0,0,0"
                                Style="{StaticResource TouchBtn}"
                                Click="BtnTouchKbUser_Click"/>
                    </Grid>

                    <!-- Password -->
                    <TextBlock Text="Mật khẩu" Foreground="#90CAF9" FontSize="13" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="TxtLoginPass" Height="44" Padding="12,0"
                                     Background="#0F3460" Foreground="White" BorderBrush="#1976D2"
                                     FontSize="15" VerticalContentAlignment="Center"/>
                        <Button x:Name="BtnTouchKbPass" Grid.Column="1" Content="⌨"
                                Width="44" Height="44" Margin="4,0,0,0"
                                Style="{StaticResource TouchBtn}"
                                Click="BtnTouchKbPass_Click"/>
                    </Grid>

                    <!-- Options -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <CheckBox x:Name="ChkRememberPass" Content="Nhớ mật khẩu" 
                                  Foreground="#B0BEC5" FontSize="13" Margin="0,0,16,0"/>
                        <CheckBox x:Name="ChkAutoLogin" Content="Tự động đăng nhập"
                                  Foreground="#B0BEC5" FontSize="13"/>
                    </StackPanel>

                    <!-- Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnSubmitLogin" Grid.Column="0" Content="ĐĂNG NHẬP" 
                                Height="50" FontSize="15" FontWeight="Bold"
                                Background="#1976D2" Foreground="White" BorderThickness="0"
                                Click="BtnSubmitLogin_Click"/>
                        <Button x:Name="BtnResetLogin" Grid.Column="2" Content="Xóa" 
                                Height="50" Width="70" FontSize="14"
                                Background="#37474F" Foreground="White" BorderThickness="0"
                                Click="BtnResetLogin_Click"/>
                    </Grid>
                    
                    <!-- Power Off bottom -->
                    <Button Content="Tắt ứng dụng" Height="40" Margin="0,16,0,0"
                            Background="#B71C1C" Foreground="White" BorderThickness="0" FontSize="13"
                            Click="BtnPowerOff_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MAIN MENU SCREEN -->
        <Grid x:Name="GridTouchMenu" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#16213E">
                <Grid>
                    <TextBlock x:Name="TxtMenuCompanyName" Text="QUẢN LÝ BAR" 
                               FontSize="20" FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center" Margin="16,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0">
                        <TextBlock x:Name="TxtMenuStatusLeft" Foreground="#90CAF9" FontSize="13" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtMenuStatusRight" Foreground="#90CAF9" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Left Menu Panel -->
            <StackPanel x:Name="PanelMenuLeft" Grid.Row="1" Grid.Column="0" 
                        Background="#0F3460" Margin="0">
                <Button x:Name="BtnMenuHeThong" Content="🏠 Hệ Thống" Height="60"
                        Style="{StaticResource TouchBtn}" Margin="8,4"
                        Click="BtnMenuCategory_Click" Tag="HeThong"/>
                <Button x:Name="BtnMenuQuanTri" Content="⚙ Quản Trị" Height="60"
                        Style="{StaticResource TouchBtn}" Margin="8,4"
                        Click="BtnMenuCategory_Click" Tag="QuanTri"/>
                <Button x:Name="BtnMenuBaoCao" Content="📊 Báo Cáo" Height="60"
                        Style="{StaticResource TouchBtn}" Margin="8,4"
                        Click="BtnMenuCategory_Click" Tag="BaoCao"/>
                <Button x:Name="BtnMenuTroGiup" Content="❓ Trợ Giúp" Height="60"
                        Style="{StaticResource TouchBtn}" Margin="8,4"
                        Click="BtnMenuCategory_Click" Tag="TroGiup"/>
            </StackPanel>

            <!-- Center Menu -->
            <WrapPanel x:Name="PanelMenuCenter" Grid.Row="1" Grid.Column="1"
                       Orientation="Horizontal" Margin="16" VerticalAlignment="Top">
                <Button Content="🍽 Sử Dụng Dịch Vụ" Width="180" Height="100" Margin="8"
                        Style="{StaticResource TouchBtn}" Background="#1976D2"
                        Click="BtnMenuSuDungDichVu_Click"/>
                <Button Content="📦 Tồn Kho" Width="180" Height="100" Margin="8"
                        Style="{StaticResource TouchBtn}" Background="#388E3C"
                        Click="BtnMenuTonKho_Click"/>
                <Button Content="📝 Ghi Chú" Width="180" Height="100" Margin="8"
                        Style="{StaticResource TouchBtn}" Background="#7B1FA2"
                        Click="BtnMenuGhiChu_Click"/>
                <Button Content="🚪 Đăng Xuất" Width="180" Height="100" Margin="8"
                        Style="{StaticResource TouchBtn}" Background="#D32F2F"
                        Click="BtnMenuDangXuat_Click"/>
            </WrapPanel>

            <!-- Status Bar -->
            <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#16213E">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0"/>
            </Border>
        </Grid>

        <!-- TABLE SELECTION SCREEN -->
        <Grid x:Name="GridTouchTables" Visibility="Collapsed" Background="#1A1A2E">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#16213E" Padding="12,8">
                <Grid>
                    <TextBlock Text="CHỌN BÀN" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtCurrentPOSUser" HorizontalAlignment="Right" 
                               Foreground="#90CAF9" FontSize="13" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Area Filter Buttons -->
            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden">
                <StackPanel Orientation="Horizontal" Margin="8,4">
                    <ItemsControl x:Name="IcAreaButtons">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#16213E" CornerRadius="6" Margin="4,2" Cursor="Hand"
                                        Padding="16,8">
                                    <TextBlock Text="{Binding TenKhuVuc}" Foreground="White" FontSize="13"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="BtnConfigAreas" Content="⚙" Width="36" Height="36" 
                            Style="{StaticResource TouchBtn}" Margin="4,2"
                            Click="BtnConfigAreas_Click"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Table Tiles -->
            <Grid Grid.Row="1">
                <ScrollViewer x:Name="SvTableTiles" 
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Hidden"
                              ScrollChanged="SvTableTiles_ScrollChanged"
                              SizeChanged="SvTableTiles_SizeChanged">
                    <ItemsControl x:Name="IcTableTiles">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="160" Height="120" Style="{StaticResource TableTileStyle}">
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding MauNen, TargetNullValue='#16213E'}"/>
                                    </Border.Background>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TenBan}" FontSize="18" FontWeight="Bold"
                                                   Foreground="White" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding TrangThai}" FontSize="12"
                                                   Foreground="#90CAF9" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding ThoiGianMo, StringFormat=HH:mm}" FontSize="11"
                                                   Foreground="#FFB74D" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <ScrollBar x:Name="SbTableTiles" Orientation="Vertical" 
                           HorizontalAlignment="Right" Width="16"
                           ValueChanged="SbTableTiles_ValueChanged"/>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="3" Background="#16213E" Padding="12,8">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnConfigTables" Content="⚙ Cấu hình bàn" 
                            Style="{StaticResource TouchBtn}" Padding="16,8" Margin="0,0,8,0"
                            Click="BtnConfigTables_Click"/>
                    <Button Content="📋 Danh sách HĐ" Style="{StaticResource TouchBtn}" 
                            Padding="16,8" Margin="0,0,8,0"
                            Click="BtnOpenTablesList_Click"/>
                    <Button Content="📊 Thống kê ca" Style="{StaticResource TouchBtn}"
                            Padding="16,8" Margin="0,0,8,0"
                            Click="BtnShiftStats_Click"/>
                    <Button Content="🏁 Đóng ca" Style="{StaticResource TouchBtn}"
                            Padding="16,8" Margin="0,0,8,0" Background="#D32F2F"
                            Click="BtnClosePOS_Click"/>
                    <Button x:Name="BtnLogoutPOS" Content="🚪 Đăng xuất"
                            Style="{StaticResource TouchBtn}" Padding="16,8" Background="#455A64"
                            Click="BtnLogoutPOS_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ORDER SCREEN -->
        <Grid x:Name="GridTouchOrder" Visibility="Collapsed" Background="#1A1A2E">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#16213E" Padding="12,8">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnCancelOrder" Content="← Quay lại" 
                                Style="{StaticResource TouchBtn}" Padding="12,6" Margin="0,0,12,0"
                                Click="BtnCancelOrder_Click"/>
                        <TextBlock x:Name="TxtOrderTableName" FontSize="18" FontWeight="Bold" 
                                   Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtOrderDate" Foreground="#90CAF9" FontSize="13"
                                   VerticalAlignment="Center" Margin="12,0"/>
                        <TextBlock x:Name="TxtOrderNo" Foreground="#FFB74D" FontSize="13"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Khách: " Foreground="#90CAF9" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtOrderGuestCount" Foreground="White" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Menu Items (Left) -->
            <Grid Grid.Row="1" Grid.Column="0">
                <!-- Nhóm hàng buttons -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <ScrollViewer Grid.Row="0" x:Name="SvTouchNhomHang" HorizontalScrollBarVisibility="Auto" 
                              VerticalScrollBarVisibility="Hidden" Height="70">
                    <ItemsControl x:Name="IcTouchNhomHang">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#16213E" CornerRadius="6" Margin="4,8" Padding="16,8" Cursor="Hand">
                                    <TextBlock Text="{Binding TenNhom}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Mặt hàng tiles -->
                <ScrollViewer Grid.Row="1" x:Name="SvTouchMatHang" 
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Hidden">
                    <ItemsControl x:Name="IcTouchMatHang">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="130" Height="100" CornerRadius="10" Margin="6" Cursor="Hand">
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding MauNen, TargetNullValue='#1976D2'}"/>
                                    </Border.Background>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TenMatHang}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="White" TextWrapping="Wrap" TextAlignment="Center" Margin="4,0"/>
                                        <TextBlock Text="{Binding GiaBan, StringFormat={}{0:N0}đ}" FontSize="11"
                                                   Foreground="#FFB74D" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Order Info (Right) -->
            <Border Grid.Row="1" Grid.Column="1" Background="#16213E" Margin="4,0,0,0">
                <DockPanel>
                    <!-- Customer -->
                    <StackPanel DockPanel.Dock="Top" Margin="8,8,8,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Khách hàng:" Foreground="#90CAF9" 
                                       FontSize="12" VerticalAlignment="Center" Margin="0,0,0,4"
                                       MouseDown="BtnSelectCustomer_Click" Cursor="Hand"/>
                            <Button x:Name="BtnPickCustomer" Grid.Column="1" Content="🔍" 
                                    Width="30" Height="28" Style="{StaticResource TouchBtn}"
                                    Click="BtnSelectCustomer_Click"/>
                        </Grid>
                        <TextBox x:Name="TxtOrderCustomer" Background="#0F3460" Foreground="White"
                                 BorderBrush="#1976D2" Height="36" Padding="8,0" FontSize="13"
                                 VerticalContentAlignment="Center"
                                 PreviewMouseDown="TxtOrderCustomer_PreviewMouseDown"/>
                    </StackPanel>

                    <!-- Order Items DataGrid -->
                    <DataGrid x:Name="DgOrderItems" DockPanel.Dock="Top" 
                              Background="#0F3460" Foreground="White"
                              BorderBrush="#1976D2" BorderThickness="1"
                              RowBackground="#16213E" AlternatingRowBackground="#1A1A2E"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1976D2"
                              AutoGenerateColumns="False" IsReadOnly="False"
                              Height="300" Margin="8,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mặt hàng" Binding="{Binding TenMatHang}" Width="*"/>
                            <DataGridTextColumn Header="SL" Binding="{Binding SoLuong}" Width="45"/>
                            <DataGridTextColumn Header="Đơn giá" Binding="{Binding DonGia, StringFormat={}{0:N0}}" Width="80"/>
                            <DataGridTextColumn Header="T.Tiền" Binding="{Binding ThanhTien, StringFormat={}{0:N0}}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Totals -->
                    <StackPanel DockPanel.Dock="Top" Margin="8,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tạm tính:" Foreground="#B0BEC5" FontSize="13"/>
                            <TextBlock x:Name="TxtTotalSub" Grid.Column="1" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Giảm giá:" Foreground="#B0BEC5" FontSize="13"/>
                            <TextBlock x:Name="TxtTotalDiscount" Grid.Column="1" Foreground="#FF7043" FontSize="13"/>
                        </Grid>
                        <Separator Background="#1976D2" Margin="0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="TỔNG CỘNG:" Foreground="White" FontSize="15" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtTotalFinal" Grid.Column="1" Foreground="#4CAF50" FontSize="16" FontWeight="Bold"/>
                        </Grid>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="8">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnOrderDiscount" Grid.Column="0" Content="💰 Giảm giá"
                                    Style="{StaticResource TouchBtn}" Height="44" Background="#F57C00"
                                    Click="BtnOrderDiscount_Click"/>
                            <Button x:Name="BtnOrderMoveTable" Grid.Column="2" Content="↔ Chuyển bàn"
                                    Style="{StaticResource TouchBtn}" Height="44" Background="#7B1FA2"
                                    Click="BtnOrderMoveTable_Click"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnOrderMergeTable" Grid.Column="0" Content="🔗 Gộp bàn"
                                    Style="{StaticResource TouchBtn}" Height="44" Background="#0288D1"
                                    Click="BtnOrderMergeTable_Click"/>
                            <Button x:Name="BtnOrderPrintKitchen" Grid.Column="2" Content="🖨 In chế biến"
                                    Style="{StaticResource TouchBtn}" Height="44" Background="#388E3C"
                                    Click="BtnOrderPrintKitchen_Click"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnOrderBack" Grid.Column="0" Content="← Quay lại"
                                    Style="{StaticResource TouchBtn}" Height="54" Background="#455A64"
                                    Click="BtnCancelOrder_Click"/>
                            <Button x:Name="BtnOrderPayment" Grid.Column="2" Content="💳 THANH TOÁN"
                                    Style="{StaticResource TouchBtn}" Height="54" Background="#1B5E20"
                                    FontSize="15" Click="BtnOrderPayment_Click"/>
                        </Grid>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Search Button -->
            <Border Grid.Row="3" Grid.Column="0" Background="#16213E" Padding="8,6">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnSearchItem" Content="🔍 Tìm mặt hàng"
                            Style="{StaticResource TouchBtn}" Padding="16,8"
                            Click="BtnSearchItem_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
