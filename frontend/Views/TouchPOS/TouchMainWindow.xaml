                            <Button Content="ĐỐI CHIẾU CÔNG NỢ NHÀ CUNG CẤP" Style="{StaticResource PosSubFunctionBtn}" Height="36" Click="BtnOpenReport_Click" Tag="ĐỐI CHIẾU CÔNG NỢ NHÀ CUNG CẤP"/>
