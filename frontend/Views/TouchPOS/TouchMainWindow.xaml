                            <Button Content="DANH SÁCH MÓN XÓA, GIẢM, TRẢ LẠI" Style="{StaticResource PosSubFunctionBtn}" Height="36" Click="BtnOpenReport_Click" Tag="DANH SÁCH MÓN XÓA, GIẢM, TRẢ LẠI"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- 2.3.8 SUB BÁO CÁO BIỂU ĐỒ -->
                <Border x:Name="PanelSubBaoCaoBieuDo" Grid.Column="2" Background="#7293A9" CornerRadius="4" Padding="2" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Button Content="..." Style="{StaticResource PosSubFunctionBtn}" Height="36" Click="BtnBackBaoCaoMain_Click"/>
                            <Button Content="BIỂU ĐỒ DOANH SỐ THEO NHÓM" Style="{StaticResource PosSubFunctionBtn}" Height="36" Click="BtnOpenReport_Click" Tag="BIỂU ĐỒ DOANH SỐ THEO NHÓM"/>
                            <Button Content="BIỂU ĐỒ DOANH THU NGÀY TRONG THÁNG" Style="{StaticResource PosSubFunctionBtn}" Height="36" Click="BtnOpenReport_Click" Tag="BIỂU ĐỒ DOANH THU NGÀY TRONG THÁNG"/>
