                        <Button Grid.Row="0" x:Name="BtnMenuSuDungDichVu" Content="SỬ DỤNG DỊCH VỤ" Style="{StaticResource PosRightDirectBtn}" Background="#009688" Click="BtnMenuSuDungDichVu_Click"/>
                        <Button Grid.Row="1" x:Name="BtnMenuTonKho" Content="TỒN KHO" Style="{StaticResource PosRightDirectBtn}" Background="#009688" Click="BtnMenuTonKho_Click"/>
                        <Button Grid.Row="2" x:Name="BtnMenuGhiChu" Content="GHI CHÚ" Style="{StaticResource PosRightDirectBtn}" Background="#009688" Click="BtnMenuGhiChu_Click"/>
                        <Button Grid.Row="3" x:Name="BtnMenuDangXuat" Content="ĐĂNG XUẤT" Style="{StaticResource PosRightDirectBtn}" Background="#009688" Click="BtnMenuDangXuat_Click"/>
                    </Grid>
                </Border>
            </Grid>
            <!-- 3. FOOTER THANH TRẠNG THÁI DƯỚI CÙNG -->
            <Border Grid.Row="2" Background="#1B4D5C" BorderBrush="#2C6B7C" BorderThickness="0,1.5,0,0">
                <Grid Margin="12,0">
                    <TextBlock Text="Đăng ký bản quyền: TTS TEST" Foreground="White" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="#2C6B7C" Padding="12,2" CornerRadius="3" Margin="0,0,6,0">
                            <TextBlock x:Name="TxtFooterUser" Text="Administrator" Foreground="White" FontSize="12" FontWeight="Bold"/>
                        </Border>
                        <Border Background="#2C6B7C" Padding="12,2" CornerRadius="3">
                            <TextBlock x:Name="TxtFooterDb" Text="DEMO" Foreground="White" FontSize="12" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <!-- TABLE SELECTION SCREEN (SỬ DỤNG DỊCH VỤ - CHỌN BÀN CHUẨN GIAO DIỆN ẢNH MẪU) -->
        <Grid x:Name="GridTouchTables" Visibility="Collapsed" Background="#3A75A4">
            <Grid.ColumnDefinitions>
                <!-- LEFT/CENTER: TABLE TILES GRID -->
                <ColumnDefinition Width="*"/>
                <!-- RIGHT SIDEBAR: USER BADGE, AREA BUTTONS & ACTION BUTTONS -->
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>
            <!-- LEFT AREA: TABLE TILES LIST WITH SCROLLVIEWER & TABLE CONFIG GEAR BUTTON AT BOTTOM RIGHT -->
            <Grid Grid.Column="0" Margin="6,6,4,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" x:Name="SvTableTiles" 
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="IcTableTiles">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding ColumnCount, ElementName=ThisWindow, FallbackValue=1}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="4" CornerRadius="4" Height="{Binding TileHeight, ElementName=ThisWindow, FallbackValue=85}" 
                                        BorderBrush="#FFFFFF" BorderThickness="1.5" Cursor="Hand" MouseLeftButtonDown="TableTile_MouseLeftButtonDown">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#808080"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOpened}" Value="True">
                                                    <Setter Property="Background" Value="#FF0000"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsOpened}" Value="False">
                                                    <Setter Property="Background" Value="#808080"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                         <!-- LAYOUT KHI BÀN CÓ ẢNH -->
                                         <Grid Visibility="{Binding HasImageVisibility}">
                                             <!-- ẢNH BÀN PHỦ RỘNG TOÀN BỘ Ô -->
                                             <Border Margin="0" CornerRadius="4" ClipToBounds="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                 <Image Source="{Binding AnhSource}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                             </Border>
                                             <!-- THUỘC TÍNH BÀN NẰM ĐÈ LÊN PHÍA DƯỚI ẢNH -->
                                             <Border VerticalAlignment="Bottom" Background="#70000000" CornerRadius="0,0,4,4" Padding="4,2">
                                                 <ItemsControl ItemsSource="{Binding DisplayLines}" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                                     <ItemsControl.ItemTemplate>
                                                         <DataTemplate>
                                                             <Grid HorizontalAlignment="Stretch">
                                                                 <Grid.ColumnDefinitions>
                                                                     <ColumnDefinition Width="*"/>
                                                                     <ColumnDefinition Width="Auto"/>
                                                                 </Grid.ColumnDefinitions>
                                                                 <TextBlock Grid.Column="0" Text="{Binding Text}" 
                                                                            HorizontalAlignment="{Binding Alignment}" 
                                                                            FontSize="{Binding FontSize}" 
                                                                            FontWeight="{Binding FontWeight}" 
                                                                            FontStyle="{Binding FontStyle}" 
                                                                            Foreground="{Binding ForegroundBrush}" 
                                                                            TextWrapping="Wrap"/>
                                                                 <TextBlock Grid.Column="1" Text="{Binding RightText}" 
                                                                            HorizontalAlignment="Right" 
                                                                            FontSize="{Binding RightFontSize}" 
                                                                            FontWeight="{Binding RightFontWeight}" 
                                                                            FontStyle="{Binding RightFontStyle}" 
                                                                            Foreground="{Binding RightForegroundBrush}" 
                                                                            Visibility="{Binding RightVisibility}" 
                                                                            Margin="4,0,0,0" 
                                                                            TextWrapping="Wrap"/>
                                                             </Grid>
                                                         </DataTemplate>
                                                     </ItemsControl.ItemTemplate>
                                                 </ItemsControl>
                                             </Border>
                                         </Grid>

                                        <!-- LAYOUT KHI BÀN KHÔNG CÓ ẢNH -->
                                        <Grid Visibility="{Binding NoImageVisibility}">
                                            <ItemsControl ItemsSource="{Binding DisplayLines}" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="6,2">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Text}" 
                                                                   HorizontalAlignment="{Binding Alignment}" 
                                                                   FontSize="{Binding FontSize}" 
                                                                   FontWeight="{Binding FontWeight}" 
                                                                   FontStyle="{Binding FontStyle}" 
                                                                   Foreground="{Binding ForegroundBrush}" 
                                                                   TextWrapping="Wrap"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <!-- NÚT CAI ĐẶT BÁNH RĂNG ⚙ Ở BÊN DƯỚI PHẦN GIỚI HẠN THANH TRUỘT BÀN -->
                <Button Grid.Row="1" x:Name="BtnConfigTables" Width="40" Height="40" HorizontalAlignment="Right" Margin="0,4,0,0" Cursor="Hand" Click="BtnConfigTables_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#E0E0E0" BorderBrush="#B0B0B0" BorderThickness="1" CornerRadius="4">
                                <TextBlock Text="⚙" Foreground="#1B4D5C" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
            <!-- RIGHT SIDEBAR (Column 1) -->
            <Grid Grid.Column="1" Margin="4,6,6,6">
                <Grid.RowDefinitions>
                    <!-- 1. USER BADGE AT TOP -->
                    <RowDefinition Height="Auto"/>
                    <!-- 2. AREA LIST (KHU VỰC) + GEAR BUTTON -->
                    <RowDefinition Height="*"/>
                    <!-- 3. ACTION BUTTONS STACK (ĐANG MỞ, THỐNG KÊ, ĐÓNG, ĐĂNG XUẤT) -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- 1. USER BADGE (Administrator) -->
                <Border Grid.Row="0" Background="#006400" CornerRadius="6" Padding="10,10" Margin="0,0,0,8">
                    <TextBlock x:Name="TxtCurrentPOSUser" Text="Administrator" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <!-- 2. AREA BUTTONS LIST -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl x:Name="IcAreaButtons">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding TenKhuVuc}" Height="52" Margin="0,4" Cursor="Hand" Tag="{Binding}" Click="BtnAreaSelect_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{Binding ColorBrush, FallbackValue='#D96414'}" BorderBrush="#36B5B0" BorderThickness="1.5" CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Foreground>White</Button.Foreground>
                                        <Button.FontWeight>Bold</Button.FontWeight>
                                        <Button.FontSize>16</Button.FontSize>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- GEAR BUTTON FOR AREA CONFIG -->
                        <Button x:Name="BtnConfigAreas" Width="44" Height="40" HorizontalAlignment="Right" Margin="0,6,0,6" Cursor="Hand" Click="BtnConfigAreas_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#E0E0E0" BorderBrush="#B0B0B0" BorderThickness="1" CornerRadius="4">
                                        <TextBlock Text="⚙" Foreground="#1B4D5C" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- PANEL TỔNG QUAN (MATCHING IMAGE 1 & 2) -->
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="12" Padding="12" Margin="0,10,0,6">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="3" Opacity="0.15"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- HEADER TỔNG QUAN -->
                                <StackPanel Orientation="Horizontal" Margin="2,0,0,10">
                                    <TextBlock Text="◵ " Foreground="#1E293B" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="TỔNG QUAN" Foreground="#1E293B" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- TỔNG SỐ BÀN (Xanh dương nhạt) -->
                                <Border Background="#EBF3FB" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="⊞ " Foreground="#1E3A8A" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Tổng số bàn" Foreground="#1E3A8A" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        <TextBlock Grid.Column="2" x:Name="TxtOverviewTotalTables" Text="0" Foreground="#1E3A8A" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- ĐANG PHỤC VỤ (Đỏ nhạt) -->
                                <Border Background="#FCE8E8" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="👥 " Foreground="#B91C1C" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Đang phục vụ" Foreground="#B91C1C" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        <TextBlock Grid.Column="2" x:Name="TxtOverviewOccupiedTables" Text="0" Foreground="#B91C1C" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- BÀN TRỐNG (Xanh lá nhạt) -->
                                <Border Background="#E8FCE8" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🪑 " Foreground="#15803D" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Bàn trống" Foreground="#15803D" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        <TextBlock Grid.Column="2" x:Name="TxtOverviewEmptyTables" Text="0" Foreground="#15803D" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <!-- 3. BOTTOM RIGHT ACTION BUTTONS -->
                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <!-- ĐANG MỞ -->
                    <Button x:Name="BtnFilterDangMo" Height="62" Margin="0,0,0,8" Cursor="Hand" Click="BtnFilterDangMo_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#948B00" BorderBrush="#B5AE00" BorderThickness="1.5" CornerRadius="8" Padding="10,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="🔍 " Foreground="White" FontSize="18" FontWeight="Bold"/>
                                        <TextBlock Text="ĐANG MỞ" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!-- THỐNG KÊ -->
                    <Button x:Name="BtnShiftStats" Height="62" Margin="0,0,0,8" Cursor="Hand" Click="BtnShiftStats_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#0B1B47" BorderBrush="#1E3575" BorderThickness="1.5" CornerRadius="8" Padding="10,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="📋 " Foreground="White" FontSize="18" FontWeight="Bold"/>
                                        <TextBlock Text="THỐNG KÊ" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!-- ĐÓNG -->
                    <Button x:Name="BtnClosePOS" Height="62" Margin="0,0,0,8" Cursor="Hand" Click="BtnClosePOS_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#4A0A0A" BorderBrush="#7A1212" BorderThickness="1.5" CornerRadius="8" Padding="10,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="🛈 " Foreground="White" FontSize="18" FontWeight="Bold"/>
                                        <TextBlock Text="ĐÓNG" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!-- ĐĂNG XUẤT -->
                    <Button x:Name="BtnLogoutPOS" Height="62" Cursor="Hand" Click="BtnLogoutPOS_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#0A4A17" BorderBrush="#127A27" BorderThickness="1.5" CornerRadius="8" Padding="10,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="🔒 " Foreground="White" FontSize="18" FontWeight="Bold"/>
                                        <TextBlock Text="ĐĂNG XUẤT" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
        <!-- ORDER SCREEN MATCHING REFERENCE SCREENSHOT -->
        <Grid x:Name="GridTouchOrder" Visibility="Collapsed" Background="#367588">
            <Grid.ColumnDefinitions>
                <!-- LEFT: INVOICE HEADER, ORDER ITEMS DATAGRID, ACTIONS & TOTALS -->
                <ColumnDefinition Width="545"/>
                <!-- MIDDLE: CATEGORIES COLUMN + SEARCH -->
                <ColumnDefinition Width="180"/>
                <!-- RIGHT: ITEMS GRID + GEAR -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- ================= CỘT TRÁI: HÓA ĐƠN & GIỎ HÀNG ================= -->
            <Grid Grid.Column="0" Margin="3,4,2,4" Background="#2B5F6F">
                <Grid.ColumnDefinitions>
                    <!-- CỘT CON 0: DẢI THAO TÁC DỌC BÊN TRÁI (LEFT ACTION BAR) -->
                    <ColumnDefinition Width="128"/>
                    <!-- CỘT CON 1: THÔNG TIN HÓA ĐƠN, GIỎ HÀNG & TỔNG TIỀN -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 1. DẢI CỘT THAO TÁC DỌC SÁT MÉP TRÁI (Kéo dãn phồng to full chiều cao màn hình) -->
                <Grid Grid.Column="0" Margin="2,2,3,2">
                    <Grid.RowDefinitions>
                        <!-- 0. Hủy hóa đơn -->
                        <RowDefinition Height="1.1*"/>
                        <!-- 1. Giảm giá -->
                        <RowDefinition Height="*"/>
                        <!-- 2. Chuyển bàn -->
                        <RowDefinition Height="*"/>
                        <!-- 3. Gộp bàn -->
                        <RowDefinition Height="*"/>
                        <!-- 4. Chế biến -->
                        <RowDefinition Height="*"/>
                        <!-- 5. Thanh toán (Nổi bật nhất) -->
                        <RowDefinition Height="1.25*"/>
                        <!-- 6. Đóng cửa sổ -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- NÚT 0: HỦY HÓA ĐƠN TRÊN CÙNG -->
                    <Button Grid.Row="0" x:Name="BtnCancelOrder" Cursor="Hand" Click="BtnCancelOrder_Click" Margin="0,0,0,4">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#CC0000" BorderBrush="#990000" BorderThickness="1.5" CornerRadius="6">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="✖" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-2,0,2"/>
                                        <TextBlock Text="Hủy hóa đơn" Foreground="White" FontSize="13" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- NÚT 1: GIẢM GIÁ -->
                    <Button Grid.Row="1" x:Name="BtnOrderDiscount" Click="BtnOrderDiscount_Click" Margin="0,0,0,4" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#541416" BorderBrush="#8A2326" BorderThickness="1.5" CornerRadius="6" Padding="2">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="⛔" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                        <TextBlock Text="Giảm giá" Foreground="White" FontSize="13.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- NÚT 2: CHUYỂN BÀN -->
                    <Button Grid.Row="2" x:Name="BtnOrderMoveTable" Click="BtnOrderMoveTable_Click" Margin="0,0,0,4" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#113C17" BorderBrush="#1B5E24" BorderThickness="1.5" CornerRadius="6" Padding="2">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="🔄" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                        <TextBlock Text="Chuyển bàn" Foreground="White" FontSize="13.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- NÚT 3: GỘP BÀN -->
                    <Button Grid.Row="3" x:Name="BtnOrderMergeTable" Click="BtnOrderMergeTable_Click" Margin="0,0,0,4" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#0C3D42" BorderBrush="#145A61" BorderThickness="1.5" CornerRadius="6" Padding="2">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="🔀" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                        <TextBlock Text="Gộp bàn" Foreground="White" FontSize="13.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- NÚT 4: CHẾ BIẾN -->
                    <Button Grid.Row="4" x:Name="BtnOrderPrintKitchen" Click="BtnOrderPrintKitchen_Click" Margin="0,0,0,4" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#3B0C52" BorderBrush="#5C177F" BorderThickness="1.5" CornerRadius="6" Padding="2">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="🖨" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                        <TextBlock Text="Chế biến" Foreground="White" FontSize="13.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- NÚT 5: THANH TOÁN (NỔI BẬT NHẤT) -->
                    <Button Grid.Row="5" x:Name="BtnOrderPayment" Click="BtnOrderPayment_Click" Margin="0,0,0,4" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#1E8638" BorderBrush="#2BB54D" BorderThickness="1.5" CornerRadius="6" Padding="2">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="💵" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                        <TextBlock Text="Thanh toán" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- NÚT 6: ĐÓNG CỬA SỔ -->
                    <Button Grid.Row="6" x:Name="BtnOrderBack" Click="BtnOrderBack_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#D85517" BorderBrush="#F96C28" BorderThickness="1.5" CornerRadius="6" Padding="2">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="🚪" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                        <TextBlock Text="Đóng cửa sổ" Foreground="White" FontSize="13.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- 2. KHUNG THÔNG TIN HÓA ĐƠN, GIỎ HÀNG & TỔNG TIỀN BÊN PHẢI -->
                <Grid Grid.Column="1" Margin="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="90"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- TOP WHITE HEADER INFO CARD -->
                    <Border Grid.Row="0" Background="White" Padding="8,5" CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="NGÀY " Foreground="#1E293B" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtOrderDate" Text="31/08/2026" Foreground="#0F172A" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text=" SỐ " Foreground="#1E293B" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" x:Name="TxtOrderNo" Text="082600010" Foreground="#0F172A" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="BÀN " Foreground="#1E293B" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtOrderTableName" Text="Bàn 02" Foreground="#0F172A" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text=" SỐ KHÁCH " Foreground="#1E293B" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,4,0,0"/>
                            <Border Grid.Row="1" Grid.Column="3" Background="#2E6C99" CornerRadius="10" Padding="10,2" Margin="2,4,0,0">
                                <TextBlock x:Name="TxtOrderGuestCount" Text="1" Foreground="White" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Border>
                            
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="KHÁCH HÀNG" Foreground="#1E293B" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,4,0,0"/>
                            <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Background="#2E6C99" CornerRadius="10" Padding="10,3" Margin="2,4,0,0" Cursor="Hand" PreviewMouseDown="BtnSelectCustomer_Click">
                                <TextBlock x:Name="TxtOrderCustomer" Text="KHÁCH LẺ" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- CENTER CART LIST DATAGRID & ACTION TOOLBAR -->
                    <Grid Grid.Row="1" Margin="0,4">
                        <Grid.RowDefinitions>
                            <!-- 4 ACTION BUTTONS (+, -, Xóa, Khác) MATCHING IMAGE 1 -->
                            <RowDefinition Height="Auto"/>
                            <!-- DATAGRID CART LIST -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- TOP TOOLBAR: NÚT THAO TÁC MẶT HÀNG (+, -, Xóa, Khác) CHỈ HIỆN KHI CHỌN MÓN -->
                        <Grid x:Name="GridCartItemActions" Grid.Row="0" Margin="0,0,0,5" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- NÚT + (Tím) -->
                            <Button Grid.Column="0" x:Name="BtnCartPlus" Height="46" Cursor="Hand" Click="BtnCartPlus_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="#581845" BorderBrush="#7D2363" BorderThickness="1.5" CornerRadius="6">
                                            <TextBlock Text="+" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- NÚT - (Vàng ô liu / Nâu đất) -->
                            <Button Grid.Column="2" x:Name="BtnCartMinus" Height="46" Cursor="Hand" Click="BtnCartMinus_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="#4B4E1B" BorderBrush="#6A6E27" BorderThickness="1.5" CornerRadius="6">
                                            <TextBlock Text="-" Foreground="White" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- NÚT XÓA (Đỏ) -->
                            <Button Grid.Column="4" x:Name="BtnCartRemove" Height="46" Cursor="Hand" Click="BtnCartRemove_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="#8B0000" BorderBrush="#B30000" BorderThickness="1.5" CornerRadius="6">
                                            <TextBlock Text="Xóa" Foreground="White" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- NÚT KHÁC (Xanh ngọc/Teal) -->
                            <Button Grid.Column="6" x:Name="BtnCartKhac" Height="46" Cursor="Hand" Click="BtnCartKhac_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="#005C53" BorderBrush="#008073" BorderThickness="1.5" CornerRadius="6">
                                            <TextBlock Text="Khác" Foreground="White" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- DATAGRID SẢN PHẨM ĐÃ ORDER -->
                        <DataGrid x:Name="DgOrderItems" Grid.Row="1" 
                                  Background="White" Foreground="#1E293B"
                                  RowBackground="White" AlternatingRowBackground="#F8FAFC"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                                  AutoGenerateColumns="False" IsReadOnly="True" Margin="0"
                                  HeadersVisibility="Column" ColumnHeaderHeight="40"
                                  RowHeight="52" SelectionMode="Single"
                                  BorderBrush="#CBD5E1" BorderThickness="1"
                                  SelectionChanged="DgOrderItems_SelectionChanged"
                                  PreviewMouseLeftButtonDown="DgOrderItems_PreviewMouseLeftButtonDown"
                                  MouseDoubleClick="DgOrderItems_MouseDoubleClick">
                        <DataGrid.Resources>
                            <!-- Column Header Style -->
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#1C4B6B"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="13.5"/>
                                <Setter Property="Padding" Value="4,0"/>
                                <Setter Property="Height" Value="40"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="BorderBrush" Value="#0F3460"/>
                                <Setter Property="BorderThickness" Value="0,0,1,0"/>
                            </Style>
                            <!-- Selected Row Style -->
                            <Style TargetType="DataGridRow">
                                <Setter Property="Margin" Value="0,1"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E0F2FE"/>
                                        <Setter Property="Foreground" Value="#0369A1"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <!-- 1. SỐ LƯỢNG -->
                            <DataGridTemplateColumn Header="SL" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#1E40AF" CornerRadius="16" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SoLuong, StringFormat={}{0:0.#}}" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- 2. TÊN MÓN -->
                            <DataGridTemplateColumn Header="TÊN MÓN" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TenMatHang}" Foreground="#0F172A" FontSize="14.5" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- 3. THÀNH TIỀN -->
                            <DataGridTemplateColumn Header="THÀNH TIỀN" Width="115">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ThanhTien, StringFormat={}{0:N0}}" Foreground="#B91C1C" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    </Grid>

                    <!-- RIGHT TOTALS SUMMARY PANEL -->
                    <Grid Grid.Row="2" Margin="0,3,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- GEAR BUTTON AT TOP RIGHT ABOVE TIỀN HÀNG -->
                        <Button Grid.Row="0" x:Name="BtnConfigCart" Width="52" Height="44" HorizontalAlignment="Right" Margin="0,0,0,4" Cursor="Hand" Click="BtnConfigCart_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#E0E0E0" BorderBrush="#B0B0B0" BorderThickness="1.5" CornerRadius="6">
                                        <TextBlock Text="⚙" Foreground="#1B4D5C" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- TIỀN HÀNG -->
                        <Grid Grid.Row="2" Margin="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TIỀN HÀNG" Foreground="White" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#808080" CornerRadius="10" Padding="12,5" Margin="6,0,0,0">
                                <TextBlock x:Name="TxtTotalSub" Text="0" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Border>
                        </Grid>
                        <!-- GIẢM GIÁ -->
                        <Grid Grid.Row="3" Margin="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="GIẢM GIÁ" Foreground="White" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#2E6C99" CornerRadius="10" Padding="4,2" Margin="4,0,2,0">
                                <TextBlock x:Name="TxtTotalDiscountPt" Text="0" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="2" Background="#2E6C99" CornerRadius="10" Padding="12,5" Margin="2,0,0,0">
                                <TextBlock x:Name="TxtTotalDiscount" Text="0" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Border>
                        </Grid>
                        <!-- PHÍ DỊCH VỤ -->
                        <Grid x:Name="RowTotalServiceFee" Grid.Row="4" Margin="0,2" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="PHÍ DỊCH VỤ" Foreground="White" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#1B4D5C" CornerRadius="10" Padding="4,2" Margin="4,0,2,0">
                                <TextBlock x:Name="TxtTotalServiceFeePt" Text="0%" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="2" Background="#1B4D5C" CornerRadius="10" Padding="12,5" Margin="2,0,0,0">
                                <TextBlock x:Name="TxtTotalServiceFee" Text="0" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Border>
                        </Grid>
                        <!-- THUẾ VAT -->
                        <Grid x:Name="RowTotalVAT" Grid.Row="5" Margin="0,2" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="THUẾ VAT" Foreground="White" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#1B4D5C" CornerRadius="10" Padding="4,2" Margin="4,0,2,0">
                                <TextBlock x:Name="TxtTotalVatPt" Text="0%" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="2" Background="#1B4D5C" CornerRadius="10" Padding="12,5" Margin="2,0,0,0">
                                <TextBlock x:Name="TxtTotalVat" Text="0" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Border>
                        </Grid>
                        <!-- TỔNG CỘNG -->
                        <Grid Grid.Row="6" Margin="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TỔNG CỘNG" Foreground="White" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#8B0000" CornerRadius="10" Padding="12,6" Margin="6,0,0,0">
                                <TextBlock x:Name="TxtTotalFinal" Text="0" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
            <!-- ================= CỘT GIỮA: NHÓM MÓN & TÌM KIẾM ================= -->
            <Grid Grid.Column="1" Margin="2,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" x:Name="SvTouchNhomHang" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="SvTouchNhomHang_SizeChanged">
                    <ItemsControl x:Name="IcTouchNhomHang" VerticalAlignment="Top">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding NhomColumns, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Top"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding TenNhom}" Margin="2" MinHeight="{Binding NhomTileMinHeight, RelativeSource={RelativeSource AncestorType=Window}}" Cursor="Hand" Tag="{Binding}" Click="BtnNhomHangSelect_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{Binding ColorBrushHex, FallbackValue='#D96414'}" BorderBrush="#FFA040" BorderThickness="1" CornerRadius="10" Padding="4,8">
                                                <TextBlock Text="{TemplateBinding Content}" Foreground="{Binding TextColorHex, FallbackValue='White'}" FontSize="12" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <!-- GEAR BUTTON BELOW CATEGORIES -->
                <Button Grid.Row="1" x:Name="BtnConfigNhomHang" Width="26" Height="24" HorizontalAlignment="Right" Margin="0,4,0,4" Cursor="Hand" Click="BtnConfigNhomHang_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#E0E0E0" BorderBrush="#B0B0B0" BorderThickness="1" CornerRadius="3">
                                <TextBlock Text="⚙" Foreground="#1B4D5C" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <!-- TÌM KIẾM BUTTON AT BOTTOM -->
                <Button Grid.Row="2" x:Name="BtnSearchItem" Click="BtnSearchItem_Click" Height="40" Margin="0,2" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#0B4B57" BorderBrush="#17A2B8" BorderThickness="1" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="🔍 " Foreground="White" FontSize="13" FontWeight="Bold"/>
                                    <TextBlock Text="TÌM KIẾM" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
            <!-- ================= CỘT PHẢI: DANH SÁCH MẶT HÀNG ================= -->
            <Grid Grid.Column="2" Margin="2,4,4,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" x:Name="SvTouchMatHang" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="SvTouchMatHang_SizeChanged">
                    <ItemsControl x:Name="IcTouchMatHang" VerticalAlignment="Top">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding MatHangColumns, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Top"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="{Binding MatHangTileHeight, RelativeSource={RelativeSource AncestorType=Window}}" Margin="3" CornerRadius="8" Background="{Binding TileColorBrush, FallbackValue='#0D4B5B'}" BorderBrush="#26A69A" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="MatHangTile_MouseLeftButtonDown">
                                    <Grid Margin="0">
                                         <!-- LAYOUT WHEN ITEM HAS IMAGE -->
                                         <Grid Visibility="{Binding HasImageVisibility}">
                                             <!-- PRODUCT IMAGE FILLING ENTIRE TILE -->
                                             <Border Margin="0" CornerRadius="7" ClipToBounds="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                 <Image Source="{Binding ImageSource}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                             </Border>

                                             <!-- ITEM NAME & PRICE OVERLAID AT BOTTOM OF IMAGE -->
                                             <Border VerticalAlignment="Bottom" Background="#A0000000" CornerRadius="0,0,7,7" Padding="4,3">
                                                 <ItemsControl ItemsSource="{Binding DisplayLines}" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                                     <ItemsControl.ItemTemplate>
                                                         <DataTemplate>
                                                             <Grid HorizontalAlignment="Stretch">
                                                                 <Grid.ColumnDefinitions>
                                                                     <ColumnDefinition Width="*"/>
                                                                     <ColumnDefinition Width="Auto"/>
                                                                 </Grid.ColumnDefinitions>
                                                                 <TextBlock Grid.Column="0" Text="{Binding Text}" 
                                                                            HorizontalAlignment="{Binding Alignment}" 
                                                                            FontSize="{Binding FontSize}" 
                                                                            FontWeight="{Binding FontWeight}" 
                                                                            FontStyle="{Binding FontStyle}" 
                                                                            Foreground="{Binding ForegroundBrush}" 
                                                                            TextWrapping="Wrap"/>
                                                                 <TextBlock Grid.Column="1" Text="{Binding RightText}" 
                                                                            HorizontalAlignment="Right" 
                                                                            FontSize="{Binding RightFontSize}" 
                                                                            FontWeight="{Binding RightFontWeight}" 
                                                                            FontStyle="{Binding RightFontStyle}" 
                                                                            Foreground="{Binding RightForegroundBrush}" 
                                                                            Visibility="{Binding RightVisibility}" 
                                                                            Margin="4,0,0,0" 
                                                                            TextWrapping="Wrap"/>
                                                             </Grid>
                                                         </DataTemplate>
                                                     </ItemsControl.ItemTemplate>
                                                 </ItemsControl>
                                             </Border>
                                         </Grid>
                                        <!-- LAYOUT WHEN ITEM HAS NO IMAGE -->
                                        <Grid Visibility="{Binding NoImageVisibility}" Margin="4" VerticalAlignment="Center">
                                            <ItemsControl ItemsSource="{Binding DisplayLines}" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Text}" 
                                                                   HorizontalAlignment="{Binding Alignment}" 
                                                                   FontSize="{Binding FontSize}" 
                                                                   FontWeight="{Binding FontWeight}" 
                                                                   FontStyle="{Binding FontStyle}" 
                                                                   Foreground="{Binding ForegroundBrush}" 
                                                                   TextWrapping="Wrap"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <!-- GEAR BUTTON AT BOTTOM RIGHT OF MENU ITEMS -->
                <Button Grid.Row="1" x:Name="BtnConfigMatHang" Width="52" Height="44" HorizontalAlignment="Right" Margin="0,4,0,0" Cursor="Hand" Click="BtnConfigMatHang_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#E0E0E0" BorderBrush="#B0B0B0" BorderThickness="1.5" CornerRadius="6">
                                <TextBlock Text="⚙" Foreground="#1B4D5C" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>