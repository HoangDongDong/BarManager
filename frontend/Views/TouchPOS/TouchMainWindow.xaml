                            <Button Content="BIỂU ĐỒ THEO NHÂN VIÊN KINH DOANH" Style="{StaticResource PosSubFunctionBtn}" Height="36" Click="BtnOpenReport_Click" Tag="BIỂU ĐỒ THEO NHÂN VIÊN KINH DOANH"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- 2.4 TRỢ GIÚP -->
                <Border x:Name="PanelCenterTroGiup" Grid.Column="2" Background="#7293A9" CornerRadius="4" Padding="2" Visibility="Collapsed">
