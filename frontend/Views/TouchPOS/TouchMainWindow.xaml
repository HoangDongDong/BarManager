                            <Button Content="BÁO CÁO 20 MẶT HÀNG BÁN CHẠY NHẤT" Style="{StaticResource PosSubFunctionBtn}" Height="36" Click="BtnOpenReport_Click" Tag="BÁO CÁO 20 MẶT HÀNG BÁN CHẠY NHẤT"/>
