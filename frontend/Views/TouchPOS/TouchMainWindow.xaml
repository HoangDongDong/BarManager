<Window x:Class="QuanLyBar.Client.Views.TouchPOS.TouchMainWindow" x:Name="ThisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Quản Lý Bar - POS Cảm Ứng"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#1A1A2E"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="TouchBtn" TargetType="Button">
            <Setter Property="Background" Value="#16213E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0F3460"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#533483"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TableTileStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Metallic ScrollBar & ScrollViewer Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- SCROLL UP BUTTON -->
                            <RepeatButton Grid.Row="0" Command="{x:Static ScrollBar.LineUpCommand}" Height="30" Margin="0,0,0,3" Cursor="Hand">
                                <RepeatButton.Template>
                                    <ControlTemplate TargetType="RepeatButton">
                                        <Border BorderBrush="#D0D0D0" BorderThickness="1.5" CornerRadius="8">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#9E9E9E" Offset="0"/>
                                                    <GradientStop Color="#686868" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="▲" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>

                            <!-- SCROLL TRACK & THUMB -->
                            <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="true" HorizontalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{x:Null}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Rectangle Fill="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border BorderBrush="#659BB0" BorderThickness="1.5" CornerRadius="12" Width="22">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#1C5E73" Offset="0"/>
                                                            <GradientStop Color="#2C809B" Offset="0.5"/>
                                                            <GradientStop Color="#1C5E73" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{x:Null}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Rectangle Fill="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>

                            <!-- SCROLL DOWN BUTTON -->
                            <RepeatButton Grid.Row="2" Command="{x:Static ScrollBar.LineDownCommand}" Height="30" Margin="0,3,0,0" Cursor="Hand">
                                <RepeatButton.Template>
                                    <ControlTemplate TargetType="RepeatButton">
                                        <Border BorderBrush="#D0D0D0" BorderThickness="1.5" CornerRadius="8">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#9E9E9E" Offset="0"/>
                                                    <GradientStop Color="#686868" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="▼" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid x:Name="Grid" Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Column="0" CanContentScroll="{TemplateBinding CanContentScroll}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" AutomationProperties.AutomationId="VerticalScrollBar" 
                                       Cursor="Hand" Maximum="{TemplateBinding ScrollableHeight}" Minimum="0" 
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                       ViewportSize="{TemplateBinding ViewportHeight}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- LOGIN SCREEN (GIAO DIỆN ĐĂNG NHẬP MÁY POS TẬN DỤNG HÌNH ẢNH MẪU) -->
        <Grid x:Name="GridTouchLogin" Background="#3D0A0A" Visibility="Visible">
            <!-- Nút Nguồn Tắt Máy ở góc dưới cùng bên phải -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24">
                <Button x:Name="BtnPowerOff" Width="50" Height="50" Cursor="Hand" Click="BtnPowerOff_Click" ToolTip="Tắt ứng dụng">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#2B0505" BorderBrush="#801010" BorderThickness="2" CornerRadius="8">
                                <TextBlock Text="⏻" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>

            <!-- Thông tin phiên bản & Cơ sở dữ liệu ở góc dưới cùng bên phải -->
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,84,24">
                <Border Background="#2B0505" Padding="12,4" CornerRadius="4,4,0,0" Margin="0,0,0,2">
                    <TextBlock Text="PHIÊN BẢN 6.0.0.0" Foreground="White" FontWeight="Bold" FontSize="12"/>
                </Border>
                <Border Background="#2B0505" Padding="12,4" CornerRadius="0,0,4,4">
                    <TextBlock x:Name="TxtDbInfo" Text="CƠ SỞ DỮ LIỆU: DEMO" Foreground="White" FontWeight="Bold" FontSize="12"/>
                </Border>
            </StackPanel>

            <!-- KHUNG TRUNG TÂM ĐĂNG NHẬP (Bên Phải) -->
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,120,0" Width="600">
                <!-- BANNER ĐỎ TRÊN CÙNG -->
                <Border Background="#CC0000" CornerRadius="6" Padding="16,8" Margin="0,0,0,24">
                    <TextBlock Text="MỜI BẠN NHẬP THÔNG TIN ĐỂ ĐĂNG NHẬP" Foreground="White" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center"/>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Cột 1: 3 Nút icon tính năng bên trái -->
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="20"/>
                        <!-- Cột 2: Form đăng nhập chính -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 3 NÚT ICON TÍNH NĂNG BÊN TRÁI -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <!-- Nút 1: Thẻ Hash # -->
                        <Border Background="#681515" BorderBrush="#8A2525" BorderThickness="1.5" CornerRadius="10" Height="70" Margin="0,0,0,14">
                            <TextBlock Text="#" Foreground="White" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Nút 2: Thẻ Mật Mã ** -->
                        <Border Background="#D97706" BorderBrush="#F59E0B" BorderThickness="1.5" CornerRadius="10" Height="70" Margin="0,0,0,14">
                            <Border BorderBrush="White" BorderThickness="2" CornerRadius="4" Width="42" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="**|" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <!-- Nút 3: Thẻ Từ -->
                        <Border Background="#681515" BorderBrush="#8A2525" BorderThickness="1.5" CornerRadius="10" Height="70">
                            <Border Background="White" CornerRadius="4" Width="38" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Background="#681515" Height="6" Margin="0,4,0,0" VerticalAlignment="Top"/>
                            </Border>
                        </Border>
                    </StackPanel>

                    <!-- FORM ĐĂNG NHẬP CHÍNH -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <!-- TÀI KHOẢN -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="TÀI KHOẢN:" Foreground="White" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtLoginUser" Grid.Column="1" Text="admin" Height="36" Padding="8,0"
                                     Background="White" Foreground="#111111" BorderBrush="#CCCCCC" BorderThickness="1"
                                     FontSize="15" FontWeight="SemiBold" VerticalContentAlignment="Center"
                                     KeyDown="TxtLoginInput_KeyDown"/>
                            <Button x:Name="BtnTouchKbUser" Grid.Column="2" Width="42" Height="36" Margin="6,0,0,0"
                                    Background="#500A0A" BorderBrush="#801515" BorderThickness="1.5" Cursor="Hand" Click="BtnTouchKbUser_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                            <TextBlock Text="⌨" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- MẬT KHẨU -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="MẬT KHẨU:" Foreground="White" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                            <PasswordBox x:Name="TxtLoginPass" Grid.Column="1" Height="36" Padding="8,0"
                                         Background="White" Foreground="#111111" BorderBrush="#CCCCCC" BorderThickness="1"
                                         FontSize="15" VerticalContentAlignment="Center"/>
                            <Button x:Name="BtnTouchKbPass" Grid.Column="2" Width="42" Height="36" Margin="6,0,0,0"
                                    Background="#500A0A" BorderBrush="#801515" BorderThickness="1.5" Cursor="Hand" Click="BtnTouchKbPass_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                            <TextBlock Text="⌨" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- GHI NHỚ MẬT KHẨU & TỰ ĐỘNG ĐĂNG NHẬP -->
                        <StackPanel Margin="110,0,0,8">
                            <CheckBox x:Name="ChkRememberPass" Content="Ghi nhớ mật khẩu" IsChecked="True"
                                      Foreground="White" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ChkAutoLogin" Content="Tự động đăng nhập" IsChecked="True"
                                      Foreground="White" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                            <TextBlock Text="(Mật khẩu mặc định: để trống)" Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,16"/>
                        </StackPanel>

                        <!-- NÚT ĐĂNG NHẬP & NHẬP LẠI -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <!-- NÚT ĐĂNG NHẬP (Xanh lá) -->
                            <Button x:Name="BtnSubmitLogin" Content="Đăng nhập" Width="120" Height="36" Margin="0,0,12,0" Cursor="Hand" Click="BtnSubmitLogin_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="#1E7333" BorderBrush="#2E8B46" BorderThickness="1.5" CornerRadius="18">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Foreground>White</Button.Foreground>
                                <Button.FontWeight>Bold</Button.FontWeight>
                                <Button.FontSize>13</Button.FontSize>
                            </Button>

                            <!-- NÚT NHẬP LẠI (Tím đậm) -->
                            <Button x:Name="BtnResetLogin" Content="Nhập lại" Width="120" Height="36" Cursor="Hand" Click="BtnResetLogin_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="#581845" BorderBrush="#7D2363" BorderThickness="1.5" CornerRadius="18">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Foreground>White</Button.Foreground>
                                <Button.FontWeight>Bold</Button.FontWeight>
                                <Button.FontSize>13</Button.FontSize>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- MAIN MENU SCREEN (GIAO DIỆN CHÍNH MÁY POS THEO 5 ẢNH MẪU THAM KHẢO) -->
        <Grid x:Name="GridTouchMenu" Visibility="Collapsed" Background="#002533">
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <!-- 1. HEADER THANH TIÊU ĐỀ TRÊN CÙNG -->
            <Border Grid.Row="0" Background="#1B4D5C" BorderBrush="#2C6B7C" BorderThickness="0,0,0,1.5">
                <TextBlock x:Name="TxtMenuHeaderTitle" Text="PHẦN MỀM QUẢN LÝ BAR, NHÀ HÀNG V6.0 TÂN AN PHÁT - HOTLINE: 0967041111" 
                           Foreground="White" FontWeight="Bold" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- 2. NỘI DUNG CHÍNH (3 CỘT NÚT THAO TÁC) -->
            <Grid Grid.Row="1" Margin="4">
                <Grid.ColumnDefinitions>
                    <!-- Cột 1: Danh mục chính (HỆ THỐNG, QUẢN TRỊ, BÁO CÁO, TRỢ GIÚP) -->
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="4"/>
                    <!-- Cột 2: Các nút tính năng con của danh mục đang chọn -->
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                    <!-- Cột 3: Nút chức năng trực tiếp bên phải (SỬ DỤNG DỊCH VỤ, TỒN KHO, GHI CHÚ, ĐĂNG XUẤT) -->
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <!-- STYLE NÚT CHỨC NĂNG CHUẨN MẪU -->
                <Grid.Resources>
                    <Style x:Key="PosMainCategoryBtn" TargetType="Button">
                        <Setter Property="Margin" Value="4,3"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="#36B5B0" BorderThickness="1.5" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style x:Key="PosSubFunctionBtn" TargetType="Button">
                        <Setter Property="Margin" Value="4,3"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#009688" BorderBrush="#36B5B0" BorderThickness="1.5" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style x:Key="PosRightDirectBtn" TargetType="Button">
                        <Setter Property="Margin" Value="4,3"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#009688" BorderBrush="#36B5B0" BorderThickness="1.5" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Grid.Resources>

                <!-- CỘT 1: CONTAINER XÁM XANH BÊN TRÁI PHỦ 100% CHIỀU CAO, 4 NÚT CHIẾM 50% CHIỀU CAO (4 HÀNG TRÊN 8 HÀNG) -->
                <Border Grid.Column="0" Background="#7293A9" CornerRadius="4" Padding="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" x:Name="BtnMenuHeThong" Content="HỆ THỐNG" Style="{StaticResource PosMainCategoryBtn}" Background="#009688" Click="BtnMenuCategory_Click" Tag="HeThong"/>
                        <Button Grid.Row="1" x:Name="BtnMenuQuanTri" Content="QUẢN TRỊ" Style="{StaticResource PosMainCategoryBtn}" Background="#009688" Click="BtnMenuCategory_Click" Tag="QuanTri"/>
                        <Button Grid.Row="2" x:Name="BtnMenuBaoCao" Content="BÁO CÁO" Style="{StaticResource PosMainCategoryBtn}" Background="#009688" Click="BtnMenuCategory_Click" Tag="BaoCao"/>
                        <Button Grid.Row="3" x:Name="BtnMenuTroGiup" Content="TRỢ GIÚP" Style="{StaticResource PosMainCategoryBtn}" Background="#009688" Click="BtnMenuCategory_Click" Tag="TroGiup"/>
                    </Grid>
                </Border>

                <!-- CỘT 2: CÁC NÚT CON TƯƠNG ỨNG KHI CHỌN DANH MỤC -->
                <!-- 2.1 HỆ THỐNG -->
                <Border x:Name="PanelCenterHeThong" Grid.Column="2" Background="#7293A9" CornerRadius="4" Padding="2" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Content="CƠ SỞ DỮ LIỆU..." Style="{StaticResource PosSubFunctionBtn}" Click="BtnMenuCoSoDuLieuSub_Click"/>
                        <Button Grid.Row="1" Content="ĐỔI MẬT KHẨU ĐĂNG NHẬP" Style="{StaticResource PosSubFunctionBtn}" Click="BtnMenuDoiMatKhau_Click"/>
                        <Button Grid.Row="2" Content="ĐĂNG XUẤT KHỎI HỆ THỐNG" Style="{StaticResource PosSubFunctionBtn}" Click="BtnLogoutPOS_Click"/>
                        <Button Grid.Row="3" Content="THOÁT KHỎI HỆ THỐNG" Style="{StaticResource PosSubFunctionBtn}" Click="BtnPowerOff_Click"/>
                    </Grid>
                </Border>

                <!-- 2.1.1 SUB-MENU CƠ SỞ DỮ LIỆU -->
                <Border x:Name="PanelCenterCoSoDuLieu" Grid.Column="2" Background="#7293A9" CornerRadius="4" Padding="2" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Content="..." Style="{StaticResource PosSubFunctionBtn}" Click="BtnMenuBackHeThong_Click"/>
                        <Button Grid.Row="1" Content="TẠO MỚI CƠ SỞ DỮ LIỆU" Style="{StaticResource PosSubFunctionBtn}" Click="BtnMenuTaoMoiCsdl_Click"/>
                        <Button Grid.Row="2" Content="SAO LƯU CƠ SỞ DỮ LIỆU" Style="{StaticResource PosSubFunctionBtn}" Click="BtnMenuSaoLuuCsdl_Click"/>
                        <Button Grid.Row="3" Content="PHỤC HỒI CƠ SỞ DỮ LIỆU" Style="{StaticResource PosSubFunctionBtn}" Click="BtnMenuPhucHoiCsdl_Click"/>
                    </Grid>
                </Border>

                <!-- 2.2 QUẢN TRỊ -->
                <Border x:Name="PanelCenterQuanTri" Grid.Column="2" Background="#7293A9" CornerRadius="4" Padding="2" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Content="XÓA DỮ LIỆU" Style="{StaticResource PosSubFunctionBtn}" Click="BtnMenuXoaDuLieu_Click"/>
                        <Button Grid.Row="1" Content="CÔNG CỤ NHÀ PHÁT TRIỂN" Style="{StaticResource PosSubFunctionBtn}" Click="BtnMenuCongCuDeveloper_Click"/>
                        <Button Grid.Row="2" Content="NGƯỜI DÙNG VÀ PHÂN QUYỀN" Style="{StaticResource PosSubFunctionBtn}" Click="BtnMenuNguoiDungPhanQuyen_Click"/>
                        <Button Grid.Row="3" Content="CẤU HÌNH TOÀN HỆ THỐNG" Style="{StaticResource PosSubFunctionBtn}" Click="BtnMenuCauHinhHeThong_Click"/>
                    </Grid>
                </Border>

                <!-- 2.3 BÁO CÁO MAIN MENU -->
