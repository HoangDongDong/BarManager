                <Border Grid.Column="4" Background="#7293A9" CornerRadius="4" Padding="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" x:Name="BtnMenuSuDungDichVu" Content="SỬ DỤNG DỊCH VỤ" Style="{StaticResource PosRightDirectBtn}" Click="BtnMenuSuDungDichVu_Click"/>
