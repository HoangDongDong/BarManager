                <Grid Margin="12,0">
                    <TextBlock Text="Đăng ký bản quyền: TTS TEST" Foreground="White" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="#2C6B7C" Padding="12,2" CornerRadius="3" Margin="0,0,6,0">
                            <TextBlock x:Name="TxtFooterUser" Text="Administrator" Foreground="White" FontSize="12" FontWeight="Bold"/>
                        </Border>
                        <Border Background="#2C6B7C" Padding="12,2" CornerRadius="3">
                            <TextBlock x:Name="TxtFooterDb" Text="DEMO" Foreground="White" FontSize="12" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- TABLE SELECTION SCREEN -->
        <Grid x:Name="GridTouchTables" Visibility="Collapsed" Background="#1A1A2E">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#16213E" Padding="12,8">
                <Grid>
                    <TextBlock Text="CHỌN BÀN" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtCurrentPOSUser" HorizontalAlignment="Right" 
                               Foreground="#90CAF9" FontSize="13" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Area Filter Buttons -->
            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden">
                <StackPanel Orientation="Horizontal" Margin="8,4">
                    <ItemsControl x:Name="IcAreaButtons">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#16213E" CornerRadius="6" Margin="4,2" Cursor="Hand"
                                        Padding="16,8">
                                    <TextBlock Text="{Binding TenKhuVuc}" Foreground="White" FontSize="13"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="BtnConfigAreas" Content="⚙" Width="36" Height="36" 
                            Style="{StaticResource TouchBtn}" Margin="4,2"
                            Click="BtnConfigAreas_Click"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Table Tiles -->
            <Grid Grid.Row="1">
                <ScrollViewer x:Name="SvTableTiles" 
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Hidden"
                              ScrollChanged="SvTableTiles_ScrollChanged"
                              SizeChanged="SvTableTiles_SizeChanged">
                    <ItemsControl x:Name="IcTableTiles">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="160" Height="120" Style="{StaticResource TableTileStyle}">
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding MauNen, TargetNullValue='#16213E'}"/>
                                    </Border.Background>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TenBan}" FontSize="18" FontWeight="Bold"
                                                   Foreground="White" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding TrangThai}" FontSize="12"
                                                   Foreground="#90CAF9" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding ThoiGianMo, StringFormat=HH:mm}" FontSize="11"
                                                   Foreground="#FFB74D" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <ScrollBar x:Name="SbTableTiles" Orientation="Vertical" 
                           HorizontalAlignment="Right" Width="16"
                           ValueChanged="SbTableTiles_ValueChanged"/>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="3" Background="#16213E" Padding="12,8">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnConfigTables" Content="⚙ Cấu hình bàn" 
                            Style="{StaticResource TouchBtn}" Padding="16,8" Margin="0,0,8,0"
                            Click="BtnConfigTables_Click"/>
                    <Button Content="📋 Danh sách HĐ" Style="{StaticResource TouchBtn}" 
                            Padding="16,8" Margin="0,0,8,0"
                            Click="BtnOpenTablesList_Click"/>
                    <Button Content="📊 Thống kê ca" Style="{StaticResource TouchBtn}"
                            Padding="16,8" Margin="0,0,8,0"
                            Click="BtnShiftStats_Click"/>
                    <Button Content="🏁 Đóng ca" Style="{StaticResource TouchBtn}"
                            Padding="16,8" Margin="0,0,8,0" Background="#D32F2F"
                            Click="BtnClosePOS_Click"/>
                    <Button x:Name="BtnLogoutPOS" Content="🚪 Đăng xuất"
                            Style="{StaticResource TouchBtn}" Padding="16,8" Background="#455A64"
                            Click="BtnLogoutPOS_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ORDER SCREEN -->
        <Grid x:Name="GridTouchOrder" Visibility="Collapsed" Background="#1A1A2E">
