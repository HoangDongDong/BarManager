                        <Button Grid.Row="2" Content="ĐĂNG KÝ BẢN QUYỀN..." Style="{StaticResource PosSubFunctionBtn}" Click="BtnMenuDangKyBanQuyen_Click"/>
                        <Button Grid.Row="3" Content="THÔNG TIN PHẦN MỀM" Style="{StaticResource PosSubFunctionBtn}" Click="BtnMenuThongTinPhanMem_Click"/>
                    </Grid>
                </Border>

                <!-- CỘT 3: CONTAINER XÁM XANH BÊN PHẢI PHỦ 100% CHIỀU CAO, 4 NÚT CHIẾM 50% CHIỀU CAO -->
                <Border Grid.Column="4" Background="#7293A9" CornerRadius="4" Padding="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" x:Name="BtnMenuSuDungDichVu" Content="SỬ DỤNG DỊCH VỤ" Style="{StaticResource PosRightDirectBtn}" Click="BtnMenuSuDungDichVu_Click"/>
                        <Button Grid.Row="1" x:Name="BtnMenuTonKho" Content="TỒN KHO" Style="{StaticResource PosRightDirectBtn}" Click="BtnMenuTonKho_Click"/>
                        <Button Grid.Row="2" x:Name="BtnMenuGhiChu" Content="GHI CHÚ" Style="{StaticResource PosRightDirectBtn}" Click="BtnMenuGhiChu_Click"/>
                        <Button Grid.Row="3" x:Name="BtnMenuDangXuat" Content="ĐĂNG XUẤT" Style="{StaticResource PosRightDirectBtn}" Click="BtnMenuDangXuat_Click"/>
                    </Grid>
                </Border>
