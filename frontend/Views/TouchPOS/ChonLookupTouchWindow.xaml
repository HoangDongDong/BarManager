<Window x:Class="QuanLyBar.Client.Views.TouchPOS.ChonLookupTouchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chọn Dữ Liệu"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#0A3648"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="TouchKbKeyBtn" TargetType="Button">
            <Setter Property="Background" Value="#17596B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2A7B91"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#124A5C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0A303C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GreenItemButtonStyle" TargetType="Border">
            <Setter Property="Background" Value="#006000"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="#2E7D32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <!-- 0. HEADER TITLE -->
            <RowDefinition Height="Auto"/>
            <!-- 1. SEARCH BAR -->
            <RowDefinition Height="Auto"/>
            <!-- 2. ITEMS LIST -->
            <RowDefinition Height="*"/>
            <!-- 3. TOUCH KEYBOARD -->
            <RowDefinition Height="Auto"/>
            <!-- 4. BOTTOM ACTION BAR -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. HEADER TITLE -->
        <Border Grid.Row="0" Background="#255B6E" Padding="12,10" Margin="0,0,0,6" CornerRadius="4">
            <TextBlock x:Name="TxtTitle" Text="CHỌN NHÂN VIÊN" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Border>

        <!-- 1. SEARCH INPUT BAR -->
        <Border Grid.Row="1" Background="White" BorderBrush="#1C4B6B" BorderThickness="2" Margin="0,0,0,6" CornerRadius="4" Height="40">
            <Grid>
                <TextBox x:Name="TxtSearchQuery" FontSize="18" FontWeight="Bold" Foreground="#800000"
                         HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Padding="8,0"
                         BorderThickness="0" Background="Transparent" TextChanged="TxtSearchQuery_TextChanged"/>
                <TextBlock Text="🔍 Gõ tên tìm kiếm..." Foreground="#888888" FontSize="14" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=TxtSearchQuery}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- 2. ITEMS LIST (WIDE GREEN BUTTONS) -->
        <Grid Grid.Row="2" Margin="0,0,0,6">
            <Border Background="#1C4B6B" CornerRadius="6" Padding="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="IcItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GreenItemButtonStyle}" MouseDown="ItemTile_MouseDown">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Foreground="White" 
                                                   FontSize="16" FontWeight="Bold" 
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SubTitle}" Foreground="#C8E6C9" 
                                                   FontSize="13" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 3. TOUCH KEYBOARD -->
        <Grid Grid.Row="3" Margin="0,2,0,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ROW 1 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="1" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="1" Content="2" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="2" Content="3" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="3" Content="4" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="4" Content="5" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="5" Content="6" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="6" Content="7" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="7" Content="8" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="8" Content="9" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="9" Content="0" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="10" Content="-" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="11" Content="=" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="12" Content="◄" Style="{StaticResource TouchKbKeyBtn}" Background="#0C3444" Click="BtnBackspace_Click"/>
            </Grid>

            <!-- ROW 2 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Q" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="1" Content="W" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="2" Content="E" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="3" Content="R" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="4" Content="T" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="5" Content="Y" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="6" Content="U" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="7" Content="I" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="8" Content="O" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="9" Content="P" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="10" Content="\" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="11" Content="@" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
            </Grid>

            <!-- ROW 3 -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="A" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="1" Content="S" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="2" Content="D" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="3" Content="F" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="4" Content="G" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="5" Content="H" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="6" Content="J" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="7" Content="K" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="8" Content="L" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="9" Content=";" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="10" Content="'" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
            </Grid>

            <!-- ROW 4 -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Z" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="1" Content="X" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="2" Content="C" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="3" Content="V" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="4" Content="B" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="5" Content="N" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="6" Content="M" Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="7" Content="," Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="8" Content="." Style="{StaticResource TouchKbKeyBtn}" Click="Key_Click"/>
                <Button Grid.Column="9" Content="XÓA" Style="{StaticResource TouchKbKeyBtn}" Background="#0C3444" Foreground="#FFFF00" Click="BtnClear_Click"/>
            </Grid>

            <!-- ROW 5: SPACE BAR -->
            <Grid Grid.Row="4">
                <Button Content="" Style="{StaticResource TouchKbKeyBtn}" Background="#3A3A3A" BorderBrush="#555555" Click="BtnSpace_Click"/>
            </Grid>
        </Grid>

        <!-- 4. BOTTOM ACTION BAR -->
        <Grid Grid.Row="4" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left: THÊM & SỬA -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="BtnThem" Content="THÊM" Height="44" Width="120" Margin="0,0,8,0"
                        Background="#008000" Foreground="White" BorderBrush="#4CAF50" BorderThickness="1.5"
                        FontSize="15" FontWeight="Bold" Cursor="Hand" Click="BtnThem_Click">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                    </Button.Resources>
                </Button>
                <Button x:Name="BtnSua" Content="SỬA" Height="44" Width="120"
                        Background="#008000" Foreground="White" BorderBrush="#4CAF50" BorderThickness="1.5"
                        FontSize="15" FontWeight="Bold" Cursor="Hand" Click="BtnSua_Click">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                    </Button.Resources>
                </Button>
            </StackPanel>

            <!-- Right: XÓA TRỐNG & THOÁT -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="BtnXoaTrong" Content="XÓA TRỐNG" Height="44" Padding="20,0" Margin="0,0,8,0"
                        Background="#8E24AA" Foreground="White" BorderBrush="#BA68C8" BorderThickness="1.5"
                        FontSize="15" FontWeight="Bold" Cursor="Hand" Click="BtnXoaTrong_Click">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                    </Button.Resources>
                </Button>
                <Button x:Name="BtnThoat" Content="THOÁT" Height="44" Width="120"
                        Background="#B71C1C" Foreground="White" BorderBrush="#EF5350" BorderThickness="1.5"
                        FontSize="15" FontWeight="Bold" Cursor="Hand" Click="BtnThoat_Click">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
