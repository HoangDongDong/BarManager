<Window x:Class="QuanLyBar.Client.Views.ChonBanChuyenGopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chọn bàn" Height="450" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#dbe7f2" Loaded="Window_Loaded">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="42"/>
        </Grid.RowDefinitions>

        <!-- Thông tin bàn nguồn -->
        <Border Grid.Row="0" Background="#fdf3d8" BorderBrush="#d8cbb0" BorderThickness="1" Padding="10,8" Margin="0,0,0,8" CornerRadius="3">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TxtTitleInfo" Text="Chuyển từ bàn: " FontWeight="Bold" Foreground="#003366" FontSize="13"/>
                <TextBlock x:Name="TxtCurrentBanName" Text="Bàn 01" FontWeight="Bold" Foreground="#c0392b" FontSize="13"/>
            </StackPanel>
        </Border>

        <!-- Khung tìm kiếm / lọc -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Tìm kiếm:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
            <TextBox x:Name="TxtTimKiem" Grid.Column="1" Height="26" VerticalContentAlignment="Center" TextChanged="TxtTimKiem_TextChanged"/>
        </Grid>

        <!-- Danh sách bàn đích để chọn -->
        <DataGrid x:Name="DgBanDich" Grid.Row="2" AutoGenerateColumns="False" 
                  CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="All"
                  Background="White" HorizontalGridLinesBrush="#e0e0e0" VerticalGridLinesBrush="#e0e0e0"
                  SelectionMode="Single" AlternatingRowBackground="#f9f9f9"
                  MouseDoubleClick="DgBanDich_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="STT" Binding="{Binding STT}" Width="40">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Tên bàn / phòng" Binding="{Binding Name}" Width="*" FontWeight="Bold"/>
                <DataGridTextColumn Header="Khu vực" Binding="{Binding KhuVucName}" Width="110"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThaiText}" Width="95">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="{Binding TrangThaiColor}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Nút điều khiển -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Chấp nhận" Width="95" Height="28" Margin="0,0,10,0"
                    FontWeight="Bold" Background="#0078d7" Foreground="White" BorderThickness="0" 
                    IsDefault="True" Cursor="Hand" Click="BtnChapNhan_Click"/>
            <Button Content="Thoát" Width="80" Height="28" 
                    Background="#eaf2f8" BorderBrush="#a4bce3" IsCancel="True" Cursor="Hand" Click="BtnThoat_Click"/>
        </StackPanel>
    </Grid>
</Window>
