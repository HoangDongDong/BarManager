<Window x:Class="QuanLyBar.Client.Views.ThemNhanhWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm nhanh" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#f0f4f9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Margin="10,5">
            <TextBlock Text="📁" FontSize="20" Margin="0,0,10,0"/>
            <TextBlock Text="Mời bạn điền danh sách Mặt hàng vào lưới phía dưới." VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: DataGrid and Toolbar -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ToolBar Grid.Row="0" Background="#dfe7f5" Padding="2">
                    <TextBlock Text="Số dòng" VerticalAlignment="Center" Margin="5,0"/>
                    <TextBox x:Name="TxtSoDong" Text="1" Width="40" Margin="0,0,5,0" TextAlignment="Center" VerticalContentAlignment="Center"/>
                    <Button x:Name="BtnThemDuLieu" Padding="5,2" Click="BtnThemDuLieu_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕" Foreground="Green" Margin="0,0,5,0"/>
                            <TextBlock Text="Thêm dữ liệu"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnXoaDuLieu" Padding="5,2" Click="BtnXoaDuLieu_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="❌" Foreground="Red" Margin="0,0,5,0"/>
                            <TextBlock Text="Xóa dữ liệu"/>
                        </StackPanel>
                    </Button>
                    <Separator/>
                    <Button x:Name="BtnDanDuLieu" Padding="5,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" Margin="0,0,5,0"/>
                            <TextBlock Text="Dán dữ liệu"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnChonFileExcel" Padding="5,2" Click="BtnChonFileExcel_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" Foreground="Green" Margin="0,0,5,0"/>
                            <TextBlock Text="Chọn file Excel"/>
                        </StackPanel>
                    </Button>
                </ToolBar>

                <DataGrid x:Name="DgThemNhanh" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" Background="White" RowHeaderWidth="25">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tên mặt hàng" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Mã hàng" Binding="{Binding Code}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Right Panel: Common Properties -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Border Background="#dfe7f5" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Fields -->
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Các thuộc tính chung" Foreground="Red" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>

                        <!-- Tên mặt hàng -->
                        <CheckBox Grid.Row="1" Grid.Column="0" IsEnabled="False" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Tên mặt hàng:" VerticalAlignment="Center" Foreground="Gray"/>
                        <TextBox Grid.Row="1" Grid.Column="2" IsEnabled="False" Margin="5,2" Background="#f0f0f0"/>

                        <!-- Nhóm mặt hàng -->
                        <CheckBox x:Name="ChkNhomMatHang" Grid.Row="2" Grid.Column="0" IsChecked="True" VerticalAlignment="Center" Margin="0,0,5,0" Checked="ChkColumn_CheckedChanged" Unchecked="ChkColumn_CheckedChanged"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Nhóm mặt hàng:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CboNhomMatHang" Grid.Row="2" Grid.Column="2" Margin="5,2" Background="#ffffcc" DisplayMemberPath="Name" SelectedValuePath="Id"/>

                        <!-- Loại mặt hàng -->
                        <CheckBox x:Name="ChkLoaiMatHang" Grid.Row="3" Grid.Column="0" IsChecked="True" VerticalAlignment="Center" Margin="0,0,5,0" Checked="ChkColumn_CheckedChanged" Unchecked="ChkColumn_CheckedChanged"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Loại mặt hàng:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CboLoaiMatHang" Grid.Row="3" Grid.Column="2" Margin="5,2"/>

                        <!-- Đơn vị tính -->
                        <CheckBox x:Name="ChkDonViTinh" Grid.Row="4" Grid.Column="0" IsChecked="True" VerticalAlignment="Center" Margin="0,0,5,0" Checked="ChkColumn_CheckedChanged" Unchecked="ChkColumn_CheckedChanged"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="Đơn vị tính:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CboDonViTinh" Grid.Row="4" Grid.Column="2" Margin="5,2" DisplayMemberPath="Name" SelectedValuePath="Id"/>

                        <!-- Giá bán -->
                        <CheckBox x:Name="ChkGiaBan" Grid.Row="5" Grid.Column="0" IsChecked="True" VerticalAlignment="Center" Margin="0,0,5,0" Checked="ChkColumn_CheckedChanged" Unchecked="ChkColumn_CheckedChanged"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="Giá bán:" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtGiaBan" Grid.Row="5" Grid.Column="2" Margin="5,2" Text="0"/>

                        <!-- Giá nhập -->
                        <CheckBox x:Name="ChkGiaNhap" Grid.Row="6" Grid.Column="0" IsChecked="True" VerticalAlignment="Center" Margin="0,0,5,0" Checked="ChkColumn_CheckedChanged" Unchecked="ChkColumn_CheckedChanged"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="Giá nhập:" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtGiaNhap" Grid.Row="6" Grid.Column="2" Margin="5,2" Text="0"/>

                        <!-- Đơn vị tính chẵn -->
                        <CheckBox x:Name="ChkDonViTinhChan" Grid.Row="7" Grid.Column="0" IsChecked="True" VerticalAlignment="Center" Margin="0,0,5,0" Checked="ChkColumn_CheckedChanged" Unchecked="ChkColumn_CheckedChanged"/>
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="Đơn vị tính chẵn:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CboDonViTinhChan" Grid.Row="7" Grid.Column="2" Margin="5,2"/>

                        <!-- Quy đổi -->
                        <CheckBox x:Name="ChkQuyDoi" Grid.Row="8" Grid.Column="0" IsChecked="True" VerticalAlignment="Center" Margin="0,0,5,0" Checked="ChkColumn_CheckedChanged" Unchecked="ChkColumn_CheckedChanged"/>
                        <TextBlock Grid.Row="8" Grid.Column="1" Text="Quy đổi:" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtQuyDoi" Grid.Row="8" Grid.Column="2" Margin="5,2" Text="0"/>

                        <!-- Giá bán chẵn -->
                        <CheckBox x:Name="ChkGiaBanChan" Grid.Row="9" Grid.Column="0" IsChecked="True" VerticalAlignment="Center" Margin="0,0,5,0" Checked="ChkColumn_CheckedChanged" Unchecked="ChkColumn_CheckedChanged"/>
                        <TextBlock Grid.Row="9" Grid.Column="1" Text="Giá bán chẵn:" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtGiaBanChan" Grid.Row="9" Grid.Column="2" Margin="5,2" Text="0"/>

                        <!-- Mã hàng -->
                        <CheckBox Grid.Row="10" Grid.Column="0" IsEnabled="False" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Grid.Row="10" Grid.Column="1" Text="Mã hàng:" VerticalAlignment="Center" Foreground="Gray"/>
                        <TextBox Grid.Row="10" Grid.Column="2" IsEnabled="False" Margin="5,2" Background="#f0f0f0"/>

                        <!-- Tạm khóa -->
                        <CheckBox x:Name="ChkTmKhoa" Grid.Row="11" Grid.Column="0" IsChecked="True" VerticalAlignment="Center" Margin="0,0,5,0" Checked="ChkColumn_CheckedChanged" Unchecked="ChkColumn_CheckedChanged"/>
                        <TextBlock Grid.Row="11" Grid.Column="1" Text="Tạm khóa:" VerticalAlignment="Center"/>
                        <CheckBox x:Name="ChkTamKhoaVal" Grid.Row="11" Grid.Column="2" Margin="5,2" VerticalAlignment="Center"/>

                        <!-- Giá theo thời giá -->
                        <CheckBox x:Name="ChkGiaTheoThoi" Grid.Row="12" Grid.Column="0" IsChecked="True" VerticalAlignment="Center" Margin="0,0,5,0" Checked="ChkColumn_CheckedChanged" Unchecked="ChkColumn_CheckedChanged"/>
                        <TextBlock Grid.Row="12" Grid.Column="1" Text="Giá theo thời giá:" VerticalAlignment="Center"/>
                        <CheckBox x:Name="ChkGiaTheoThoiGiaVal" Grid.Row="12" Grid.Column="2" Margin="5,2" VerticalAlignment="Center"/>

                        <!-- Ghi chú -->
                        <CheckBox x:Name="ChkGhiChu" Grid.Row="13" Grid.Column="0" IsChecked="True" VerticalAlignment="Center" Margin="0,0,5,0" Checked="ChkColumn_CheckedChanged" Unchecked="ChkColumn_CheckedChanged"/>
                        <TextBlock Grid.Row="13" Grid.Column="1" Text="Ghi chú:" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtGhiChu" Grid.Row="13" Grid.Column="2" Margin="5,2"/>

                        <!-- Tồn tối thiểu -->
                        <CheckBox x:Name="ChkTToiThieu" Grid.Row="14" Grid.Column="0" IsChecked="True" VerticalAlignment="Center" Margin="0,0,5,0" Checked="ChkColumn_CheckedChanged" Unchecked="ChkColumn_CheckedChanged"/>
                        <TextBlock Grid.Row="14" Grid.Column="1" Text="Tồn tối thiểu:" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtTonToiThieu" Grid.Row="14" Grid.Column="2" Margin="5,2" Text="0"/>

                        <!-- Tồn tối đa -->
                        <CheckBox x:Name="ChkTToiDa" Grid.Row="15" Grid.Column="0" IsChecked="True" VerticalAlignment="Center" Margin="0,0,5,0" Checked="ChkColumn_CheckedChanged" Unchecked="ChkColumn_CheckedChanged"/>
                        <TextBlock Grid.Row="15" Grid.Column="1" Text="Tồn tối đa:" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtTonToiDa" Grid.Row="15" Grid.Column="2" Margin="5,2" Text="0"/>

                        <!-- Ảnh -->
                        <CheckBox x:Name="ChkAnh" Grid.Row="16" Grid.Column="0" IsChecked="True" VerticalAlignment="Center" Margin="0,0,5,0" Checked="ChkColumn_CheckedChanged" Unchecked="ChkColumn_CheckedChanged"/>
                        <TextBlock Grid.Row="16" Grid.Column="1" Text="Ảnh:" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtAnh" Grid.Row="16" Grid.Column="2" Margin="5,2"/>

                        <!-- Hoa hồng -->
                        <CheckBox x:Name="ChkHoaHong" Grid.Row="17" Grid.Column="0" IsChecked="True" VerticalAlignment="Center" Margin="0,0,5,0" Checked="ChkColumn_CheckedChanged" Unchecked="ChkColumn_CheckedChanged"/>
                        <TextBlock Grid.Row="17" Grid.Column="1" Text="Hoa hồng:" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtHoaHong" Grid.Row="17" Grid.Column="2" Margin="5,2" Text="0"/>

                        <!-- Giá vốn -->
                        <CheckBox x:Name="ChkGiaVon" Grid.Row="18" Grid.Column="0" IsChecked="True" VerticalAlignment="Center" Margin="0,0,5,0" Checked="ChkColumn_CheckedChanged" Unchecked="ChkColumn_CheckedChanged"/>
                        <TextBlock Grid.Row="18" Grid.Column="1" Text="Giá vốn:" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtGiaVon" Grid.Row="18" Grid.Column="2" Margin="5,2" Text="0"/>
                    </Grid>
                </Border>
            </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#f0f0f0" Padding="10,5" BorderBrush="LightGray" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="Xóa mặt hàng lỗi" Padding="10,5" Background="White"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Chấp nhận" Padding="15,5" Margin="0,0,10,0" FontWeight="Bold" Click="BtnChapNhan_Click"/>
                    <Button Content="Hủy bỏ" Padding="15,5" Click="BtnHuyBo_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
