<Window x:Class="QuanLyBar.Client.Views.ChonFileExcelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chọn file excel hoặc xuất file mẫu" Height="250" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#dfe7f5">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Nếu bạn chưa có file excel, click vào 'Xuất file mẫu'" Foreground="#404040" Margin="0,5,0,5"/>
        
        <Button Grid.Row="1" Content="Xuất file mẫu các cột đang hiển thị trong danh sách" Margin="30,5,30,5" Padding="5" Click="BtnXuatHienThi_Click" Background="White"/>
        <Button Grid.Row="2" Content="Xuất file mẫu tất cả các cột (bao gồm cả cột ẩn)" Margin="30,5,30,15" Padding="5" Click="BtnXuatTatCa_Click" Background="White"/>

        <TextBlock Grid.Row="3" Text="Nếu đã có mẫu, click 'Chọn file excel'" Foreground="#404040" Margin="0,5,0,5"/>

        <Button Grid.Row="4" Content="Chọn file excel" Margin="30,5,30,5" Padding="5" Click="BtnChonFile_Click" Background="White"/>
        <Button Grid.Row="5" Content="Hủy bỏ" Margin="30,5,30,5" Padding="5" Click="BtnHuyBo_Click" Background="White"/>
    </Grid>
</Window>
