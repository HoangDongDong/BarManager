<Window x:Class="QuanLyBar.Client.Views.QuanLyXuatKho.ThemPhieuXuatKhoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuanLyBar.Client.Views.QuanLyXuatKho"
        mc:Ignorable="d"
        Title="PHIẾU XUẤT KHO - THÊM MỚI"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="12"
        Background="#dbe5f1"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <LinearGradientBrush x:Key="TopHeaderGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#eef5fc" Offset="0"/>
            <GradientStop Color="#d7e6f6" Offset="0.5"/>
            <GradientStop Color="#c2d9f0" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SubToolbarGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#dbe9f6" Offset="0"/>
            <GradientStop Color="#c9ddf0" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="ToolbarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#d0e2f5"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#86a9d1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#9bb2c9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#e3eefc"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3172b7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- 1. TIÊU ĐỀ TRÊN CÙNG -->
        <Border Grid.Row="0" Background="{StaticResource TopHeaderGradient}" BorderBrush="#9ab5cf" BorderThickness="0,0,0,1" Padding="8,4">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button Width="26" Height="24" Background="#1788bc" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand" Click="BtnBack_Click" ToolTip="Quay lại">
                        <TextBlock Text="⬅" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <TextBlock Text="Phiếu xuất kho" FontWeight="Bold" FontSize="15" Foreground="#0f3b6c" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Right" Text="(Ctrl+S: Lưu&amp;Mới, Ctrl+L: Lưu, Ctrl+N: Mới, Ctrl+P: In, ESC: Thoát)" 
                           Foreground="#444444" FontSize="11.5" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
            </DockPanel>
        </Border>

        <!-- 2. THANH CÔNG CỤ SUB-TOOLBAR -->
        <Border Grid.Row="1" Background="{StaticResource SubToolbarGradient}" BorderBrush="#b2cbe4" BorderThickness="0,0,0,1" Padding="6,2">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarBtn}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌨ Phím tắt ▾" Foreground="#1e3f66"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnTruoc" Style="{StaticResource ToolbarBtn}" Click="BtnTruoc_Click" ToolTip="Phiếu trước (F10)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⬅ Trước (F10)" Foreground="#205081"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnSau" Style="{StaticResource ToolbarBtn}" Click="BtnSau_Click" ToolTip="Phiếu sau (F11)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➡ Sau (F11)" Foreground="#205081"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnTaoMoi" Style="{StaticResource ToolbarBtn}" Click="BtnTaoMoi_Click" ToolTip="Tạo mới (Ctrl+N)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁 Tạo mới" Foreground="#1e7e34" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnSaoChep" Style="{StaticResource ToolbarBtn}" Click="BtnSaoChep_Click" ToolTip="Sao chép">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📑 Sao chép" Foreground="#555555"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button x:Name="BtnXoaPhieu" DockPanel.Dock="Right" Style="{StaticResource ToolbarBtn}" Click="BtnXoaPhieu_Click" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="❌ Xóa" Foreground="#d9534f" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <!-- 3. PHẦN THÔNG TIN NHẬP LIỆU & TỔNG CỘNG -->
        <Border Grid.Row="2" Background="#dbe5f1" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="310"/>
                </Grid.ColumnDefinitions>

                <!-- CỘT TRÁI: CÁC TRƯỜNG THÔNG TIN PHIẾU XUẤT -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Dòng 1: Ngày + Số phiếu -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Ngày" VerticalAlignment="Center" Margin="0,3" Foreground="#222222"/>
                    <Grid Grid.Row="0" Grid.Column="1" Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <DatePicker Grid.Column="0" x:Name="DpNgay" Height="23"/>
                        <TextBlock Grid.Column="1" Text="Số phiếu" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" Foreground="#222222"/>
                        <TextBox Grid.Column="2" x:Name="TxtSoPhieu" Height="23" Background="#e0f7fa" FontWeight="Bold" Foreground="#0f3b6c" VerticalContentAlignment="Center" Padding="4,0"/>
                    </Grid>

                    <!-- Dòng 2: Kho xuất + Nhân viên xuất -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Kho xuất" VerticalAlignment="Center" Margin="0,3" Foreground="#222222"/>
                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Kho xuất -->
                        <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="22"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtSelectedKho" Grid.Column="0" Height="23" VerticalContentAlignment="Center"
                                     Padding="4,0" Background="#ffffcc" BorderBrush="#9ab5cf" IsReadOnly="True"
                                     Cursor="Hand" PreviewMouseDown="TxtSelectedKho_PreviewMouseDown"/>
                            <ToggleButton x:Name="BtnToggleKho" Grid.Column="1" Height="23" Background="#ffffcc"
                                          BorderBrush="#9ab5cf" BorderThickness="0,1,1,1" Cursor="Hand">
                                <TextBlock Text="▾" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#444"/>
                            </ToggleButton>

                            <!-- Popup Kho xuất -->
                            <Popup x:Name="PopupKho" PlacementTarget="{Binding ElementName=TxtSelectedKho}"
                                   Placement="Bottom" StaysOpen="False"
                                   IsOpen="{Binding ElementName=BtnToggleKho, Path=IsChecked, Mode=TwoWay}"
                                   AllowsTransparency="True">
                                <Border Width="240" Background="White" BorderBrush="#7192b8" BorderThickness="1" Margin="0,2,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBox x:Name="TxtTimKhoPopup" Grid.Row="0" Height="22" Background="#fff9c4" BorderBrush="#dcdcdc"
                                                 VerticalContentAlignment="Center" Padding="4,0" TextChanged="TxtTimKhoPopup_TextChanged"/>

                                        <ListBox x:Name="LstKhoPopup" Grid.Row="1" MaxHeight="180" SelectionChanged="LstKhoPopup_SelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="2,1">
                                                        <TextBlock Text="🏢" FontSize="12" Margin="0,0,4,0"/>
                                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <Border Grid.Row="2" Background="#f0f4f9" BorderBrush="#d0dbe5" BorderThickness="0,1,0,0" Padding="4,3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="BtnThemKho" Grid.Column="0" Margin="1" Height="23" Background="White" BorderBrush="#b8c8d8" Cursor="Hand" Click="BtnThemKho_Click">
                                                    <TextBlock Text="➕ Thêm" FontSize="11"/>
                                                </Button>
                                                <Button x:Name="BtnSuaKho" Grid.Column="1" Margin="1" Height="23" Background="White" BorderBrush="#b8c8d8" Cursor="Hand" Click="BtnSuaKho_Click">
                                                    <TextBlock Text="✏️ Sửa" FontSize="11"/>
                                                </Button>
                                                <Button x:Name="BtnTaiKho" Grid.Column="2" Margin="1" Height="23" Background="White" BorderBrush="#b8c8d8" Cursor="Hand" Click="BtnTaiKho_Click">
                                                    <TextBlock Text="🔄 Tải" FontSize="11"/>
                                                </Button>
                                                <Button x:Name="BtnDanhMucKho" Grid.Column="3" Margin="1" Height="23" Background="White" BorderBrush="#b8c8d8" Cursor="Hand" Click="BtnDanhMucKho_Click">
                                                    <TextBlock Text="📑 Danh mục" FontSize="11"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>

                        <TextBlock Grid.Column="1" Text="Nhân viên xuất" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" Foreground="#222222"/>

                        <!-- Nhân viên xuất -->
                        <Grid Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="22"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtSelectedNhanVien" Grid.Column="0" Height="23" VerticalContentAlignment="Center"
                                     Padding="4,0" Background="White" BorderBrush="#9ab5cf" IsReadOnly="True"
                                     Cursor="Hand" PreviewMouseDown="TxtSelectedNhanVien_PreviewMouseDown"/>
                            <ToggleButton x:Name="BtnToggleNhanVien" Grid.Column="1" Height="23" Background="#f0f4f9"
                                          BorderBrush="#9ab5cf" BorderThickness="0,1,1,1" Cursor="Hand">
                                <TextBlock Text="▾" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#444"/>
                            </ToggleButton>

                            <!-- Popup Nhân viên -->
                            <Popup x:Name="PopupNhanVien" PlacementTarget="{Binding ElementName=TxtSelectedNhanVien}"
                                   Placement="Bottom" StaysOpen="False"
                                   IsOpen="{Binding ElementName=BtnToggleNhanVien, Path=IsChecked, Mode=TwoWay}"
                                   AllowsTransparency="True">
                                <Border Width="260" Background="White" BorderBrush="#7192b8" BorderThickness="1" Margin="0,2,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBox x:Name="TxtTimNvPopup" Grid.Row="0" Height="22" Background="#fff9c4" BorderBrush="#dcdcdc"
                                                 VerticalContentAlignment="Center" Padding="4,0" TextChanged="TxtTimNvPopup_TextChanged"/>

                                        <ListBox x:Name="LstNvPopup" Grid.Row="1" MaxHeight="180" SelectionChanged="LstNvPopup_SelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="2,1">
                                                        <TextBlock Text="👤" FontSize="12" Margin="0,0,4,0"/>
                                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <Border Grid.Row="2" Background="#f0f4f9" BorderBrush="#d0dbe5" BorderThickness="0,1,0,0" Padding="4,3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="BtnThemNv" Grid.Column="0" Margin="1" Height="23" Background="White" BorderBrush="#b8c8d8" Cursor="Hand" Click="BtnThemNv_Click">
                                                    <TextBlock Text="➕ Thêm" FontSize="11"/>
                                                </Button>
                                                <Button x:Name="BtnSuaNv" Grid.Column="1" Margin="1" Height="23" Background="White" BorderBrush="#b8c8d8" Cursor="Hand" Click="BtnSuaNv_Click">
                                                    <TextBlock Text="✏️ Sửa" FontSize="11"/>
                                                </Button>
                                                <Button x:Name="BtnTaiNv" Grid.Column="2" Margin="1" Height="23" Background="White" BorderBrush="#b8c8d8" Cursor="Hand" Click="BtnTaiNv_Click">
                                                    <TextBlock Text="🔄 Tải" FontSize="11"/>
                                                </Button>
                                                <Button x:Name="BtnDanhMucNv" Grid.Column="3" Margin="1" Height="23" Background="White" BorderBrush="#b8c8d8" Cursor="Hand" Click="BtnDanhMucNv_Click">
                                                    <TextBlock Text="📑 Danh mục" FontSize="11"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>
                    </Grid>

                    <!-- Dòng 3: Nhà cung cấp (hoặc Khách hàng) -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Nhà cung cấp" VerticalAlignment="Center" Margin="0,3" Foreground="#222222"/>
                    <Grid Grid.Row="2" Grid.Column="1" Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="22"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TxtSelectedNhaCungCap" Grid.Column="0" Height="23" VerticalContentAlignment="Center"
                                 Padding="4,0" Background="White" BorderBrush="#9ab5cf" IsReadOnly="True"
                                 Cursor="Hand" PreviewMouseDown="TxtSelectedNhaCungCap_PreviewMouseDown"/>
                        
                        <ToggleButton x:Name="BtnToggleNhaCungCap" Grid.Column="1" Height="23" Background="#f0f4f9"
                                      BorderBrush="#9ab5cf" BorderThickness="0,1,1,1" Cursor="Hand">
                            <TextBlock Text="▾" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#444"/>
                        </ToggleButton>

                        <!-- Popup Nhà cung cấp -->
                        <Popup x:Name="PopupNhaCungCap" PlacementTarget="{Binding ElementName=TxtSelectedNhaCungCap}"
                               Placement="Bottom" StaysOpen="False"
                               IsOpen="{Binding ElementName=BtnToggleNhaCungCap, Path=IsChecked, Mode=TwoWay}"
                               AllowsTransparency="True">
                            <Border Width="450" MaxHeight="260" Background="White" BorderBrush="#7192b8" BorderThickness="1" Margin="0,2,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBox x:Name="TxtTimNccPopup" Grid.Row="0" Height="22" Background="#fff9c4" BorderBrush="#dcdcdc"
                                             VerticalContentAlignment="Center" Padding="4,0" TextChanged="TxtTimNccPopup_TextChanged"/>

                                    <DataGrid x:Name="DgNccPopup" Grid.Row="1" MaxHeight="160" AutoGenerateColumns="False" CanUserAddRows="False"
                                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="All"
                                              HorizontalGridLinesBrush="#e2e8f0" VerticalGridLinesBrush="#e2e8f0"
                                              RowHeight="22" SelectionMode="Single" SelectionUnit="FullRow"
                                              Background="White" RowBackground="White" AlternatingRowBackground="#f0f7ff"
                                              MouseLeftButtonUp="DgNccPopup_MouseLeftButtonUp">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Tên nhà cung cấp" Binding="{Binding Name}" Width="160"/>
                                            <DataGridTextColumn Header="Điện thoại" Binding="{Binding DienThoai}" Width="110"/>
                                            <DataGridTextColumn Header="Địa chỉ" Binding="{Binding DiaChi}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Border Grid.Row="2" Background="#f0f4f9" BorderBrush="#d0dbe5" BorderThickness="0,1,0,0" Padding="4,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="BtnThemNcc" Grid.Column="0" Margin="1" Height="23" Background="White" BorderBrush="#b8c8d8" Cursor="Hand" Click="BtnThemNcc_Click">
                                                <TextBlock Text="➕ Thêm" FontSize="11"/>
                                            </Button>
                                            <Button x:Name="BtnSuaNcc" Grid.Column="1" Margin="1" Height="23" Background="White" BorderBrush="#b8c8d8" Cursor="Hand" Click="BtnSuaNcc_Click">
                                                <TextBlock Text="✏️ Sửa" FontSize="11"/>
                                            </Button>
                                            <Button x:Name="BtnTaiNcc" Grid.Column="2" Margin="1" Height="23" Background="White" BorderBrush="#b8c8d8" Cursor="Hand" Click="BtnTaiNcc_Click">
                                                <TextBlock Text="🔄 Tải" FontSize="11"/>
                                            </Button>
                                            <Button x:Name="BtnDanhMucNcc" Grid.Column="3" Margin="1" Height="23" Background="White" BorderBrush="#b8c8d8" Cursor="Hand" Click="BtnDanhMucNcc_Click">
                                                <TextBlock Text="📑 Danh mục" FontSize="11"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Dòng 4: Diễn giải -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Diễn giải" VerticalAlignment="Center" Margin="0,3" Foreground="#222222"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtDienGiai" Height="23" Text="Xuất khác" Background="#ffffcc" VerticalContentAlignment="Center" Margin="0,2" Padding="4,0"/>

                    <!-- Dòng 5: Ghi chú -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Ghi chú" VerticalAlignment="Center" Margin="0,3" Foreground="#222222"/>
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtGhiChu" Height="23" VerticalContentAlignment="Center" Margin="0,2" Padding="4,0"/>

                    <!-- Dòng 6: Tìm (F3) + Số lượng + Nút Thêm -->
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Tìm (F3):" VerticalAlignment="Center" Margin="0,3" Foreground="#222222" FontWeight="SemiBold"/>
                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                        <TextBox x:Name="TxtTimMatHang" Width="180" Height="23" VerticalContentAlignment="Center" Padding="4,0" KeyDown="TxtTimMatHang_KeyDown" TextChanged="TxtTimMatHang_TextChanged"/>
                        <TextBlock Text="Số lượng:" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="#222222"/>
                        <TextBox x:Name="TxtSoLuongNhap" Width="60" Height="23" Text="1" TextAlignment="Right" VerticalContentAlignment="Center" Padding="4,0" KeyDown="TxtSoLuongNhap_KeyDown"/>
                        <Button x:Name="BtnThemMatHang" Content="Thêm" Width="65" Height="23" Margin="8,0,0,0" Style="{StaticResource ActionBtn}" Click="BtnThemMatHang_Click"/>
                    </StackPanel>
                </Grid>

                <!-- CỘT PHẢI: BẢNG TỔNG CỘNG -->
                <Border Grid.Column="2" Background="#e2ebf4" BorderBrush="#a6c0db" BorderThickness="1" CornerRadius="3" Padding="8,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="95"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Header Tổng cộng -->
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Tổng cộng" FontWeight="Bold" Foreground="#1e3f66" FontSize="12.5" Margin="0,0,0,6"/>

                        <!-- Tiền hàng -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Tiền hàng" VerticalAlignment="Center" Margin="0,3" Foreground="#222222"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtTiengHang" Height="23" Text="0" IsReadOnly="True" 
                                 Background="#ffffcc" FontWeight="Bold" TextAlignment="Right" VerticalContentAlignment="Center" Margin="0,2" Padding="4,0"/>

                        <!-- Tỉ lệ giảm giá -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Tỉ lệ giảm giá" VerticalAlignment="Center" Margin="0,3" Foreground="#222222"/>
                        <Grid Grid.Row="2" Grid.Column="1" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="TxtTiLeGiamGia" Height="23" Text="0" TextAlignment="Right" VerticalContentAlignment="Center" Padding="2,0" TextChanged="TxtTiLeGiamGia_TextChanged"/>
                            <TextBox Grid.Column="1" x:Name="TxtTienGiamGia" Height="23" Text="0" Margin="4,0,0,0" Background="#ffffcc" TextAlignment="Right" VerticalContentAlignment="Center" Padding="4,0" TextChanged="TxtTienGiamGia_TextChanged"/>
                        </Grid>

                        <!-- Tổng cộng -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Tổng cộng" VerticalAlignment="Center" Margin="0,3" FontWeight="Bold" Foreground="#1e3f66"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtTongCong" Height="24" Text="0" IsReadOnly="True" 
                                 Background="#ffffcc" FontWeight="Bold" FontSize="13" Foreground="#c00000" TextAlignment="Right" VerticalContentAlignment="Center" Margin="0,2" Padding="4,0"/>

                        <!-- Tiền thanh toán -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Tiền thanh toán" VerticalAlignment="Center" Margin="0,3" Foreground="#222222"/>
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtTienThanhToan" Height="23" Text="0" TextAlignment="Right" VerticalContentAlignment="Center" Margin="0,2" Padding="4,0" TextChanged="TxtTienThanhToan_TextChanged"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 4. THANH TOOLBAR TRÊN BẢNG CHI TIẾT -->
        <Border Grid.Row="3" Background="#e2ecf7" BorderBrush="#b6cadf" BorderThickness="0,1,0,1" Padding="4,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Tool trái -->
                <TextBlock Grid.Column="0" Text="Danh mục mặt hàng" FontWeight="Bold" Foreground="#1e3f66" VerticalAlignment="Center" Margin="8,0,0,0"/>

                <!-- Tool phải -->
                <DockPanel Grid.Column="2" LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button x:Name="BtnXoaDong" Style="{StaticResource ToolbarBtn}" Click="BtnXoaDong_Click" ToolTip="Xóa dòng (F8)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="❌ Xóa dòng (F8)" Foreground="#d9534f"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnNhapExcel" Style="{StaticResource ToolbarBtn}" Click="BtnNhapExcel_Click" ToolTip="Nhập từ excel">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📥 Nhập từ excel" Foreground="#1e7e34"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnXuatExcel" Style="{StaticResource ToolbarBtn}" Click="BtnXuatExcel_Click" ToolTip="Xuất excel">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📤 Xuất excel" Foreground="#0055aa"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="0,0,6,0">
                        <TextBox x:Name="TxtLocChiTiet" Width="120" Height="21" VerticalContentAlignment="Center" Padding="3,0" TextChanged="TxtLocChiTiet_TextChanged"/>
                        <TextBlock Text="🔍 Lọc" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="#555"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <!-- 5. PHẦN 2 BẢNG: TRÁI (DANH MỤC MẶT HÀNG) - PHẢI (CHI TIẾT PHIẾU XUẤT) -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="250" MaxWidth="550"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- BẢNG TRÁI: DANH MỤC MẶT HÀNG -->
            <DataGrid x:Name="DgMatHangCatalog" Grid.Column="0" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      IsReadOnly="True" HeadersVisibility="All" GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#e2e8f0" VerticalGridLinesBrush="#e2e8f0"
                      RowHeight="22" SelectionMode="Single" SelectionUnit="FullRow"
                      Background="White" RowBackground="White" AlternatingRowBackground="#f5f9ff"
                      MouseDoubleClick="DgMatHangCatalog_MouseDoubleClick"
                      Margin="0,0,4,0">
                <DataGrid.RowHeaderStyle>
                    <Style TargetType="{x:Type DataGridRowHeader}">
                        <Setter Property="Width" Value="32"/>
                        <Setter Property="Background" Value="#dfe9f5"/>
                        <Setter Property="BorderBrush" Value="#b6cadf"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Content" Value="{Binding SttHienThi}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="FontSize" Value="11"/>
                    </Style>
                </DataGrid.RowHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tên hàng" Binding="{Binding Name}" Width="150"/>
                    <DataGridTextColumn Header="Giá bán" Binding="{Binding GiaBanFormatted}" Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,4,0"/></Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Quy đổi" Binding="{Binding QuyDoiFormatted}" Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,4,0"/></Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="ĐVT" Binding="{Binding TenDonViTinh}" Width="50"/>
                    <DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- THANH KÉO CO GIÃN GIỮA 2 BẢNG -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#c2d5e8" Cursor="SizeWE"/>

            <!-- BẢNG PHẢI: CHI TIẾT PHIẾU XUẤT -->
            <DataGrid x:Name="DgPhieuXuatChiTiet" Grid.Column="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="All" GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#e2e8f0" VerticalGridLinesBrush="#e2e8f0"
                      RowHeight="23" SelectionMode="Single" SelectionUnit="FullRow"
                      Background="White" RowBackground="White" AlternatingRowBackground="#f8fbff"
                      CellEditEnding="DgPhieuXuatChiTiet_CellEditEnding">
                <DataGrid.RowHeaderStyle>
                    <Style TargetType="{x:Type DataGridRowHeader}">
                        <Setter Property="Width" Value="32"/>
                        <Setter Property="Background" Value="#dfe9f5"/>
                        <Setter Property="BorderBrush" Value="#b6cadf"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Content" Value="{Binding Stt}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="11"/>
                    </Style>
                </DataGrid.RowHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tên mặt hàng" Binding="{Binding TenHang}" IsReadOnly="True" Width="220"/>
                    <DataGridTextColumn Header="ĐVT" Binding="{Binding TenDonViTinh}" IsReadOnly="True" Width="60"/>
                    <DataGridTextColumn Header="Mã hàng" Binding="{Binding MaHang}" IsReadOnly="True" Width="80"/>
                    
                    <!-- Số lượng (Edit) -->
                    <DataGridTextColumn Header="Số lượng" Binding="{Binding SlXuat, StringFormat={}{0:N2}, UpdateSourceTrigger=LostFocus}" Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,4,0"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox"><Setter Property="TextAlignment" Value="Right"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>

                    <!-- Đơn giá (Edit) -->
                    <DataGridTextColumn Header="Đơn giá" Binding="{Binding DonGia, StringFormat={}{0:N0}, UpdateSourceTrigger=LostFocus}" Width="95">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,4,0"/></Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox"><Setter Property="TextAlignment" Value="Right"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>

                    <!-- Giảm giá % (Edit) -->
                    <DataGridTextColumn Header="Giảm giá %" Binding="{Binding TiLeGiamGia, StringFormat={}{0:N1}, UpdateSourceTrigger=LostFocus}" Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,4,0"/></Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox"><Setter Property="TextAlignment" Value="Right"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>

                    <!-- Thành tiền (Read-only) -->
                    <DataGridTextColumn Header="Thành tiền" Binding="{Binding ThanhTien, StringFormat={}{0:N0}}" IsReadOnly="True" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,4,0"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#0f3b6c"/></Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Ghi chú (Edit) -->
                    <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu, UpdateSourceTrigger=LostFocus}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- 6. THANH NÚT CHỨC NĂNG DƯỚI CÙNG -->
        <Border Grid.Row="5" Background="{StaticResource TopHeaderGradient}" BorderBrush="#9ab5cf" BorderThickness="0,1,0,0" Padding="8,4">
            <DockPanel LastChildFill="True">
                <!-- Nút in bên trái -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button x:Name="BtnLuuVaIn" Style="{StaticResource ActionBtn}" Click="BtnLuuVaIn_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨️" Margin="0,0,4,0"/>
                            <TextBlock Text="Lưu &amp; In"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnLuuVaXemIn" Style="{StaticResource ActionBtn}" Click="BtnLuuVaXemIn_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👁️" Margin="0,0,4,0"/>
                            <TextBlock Text="Lưu &amp; Xem in"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Nút lưu bên phải -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnLuu" Style="{StaticResource ActionBtn}" Click="BtnLuu_Click" FontWeight="Bold">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" Margin="0,0,4,0"/>
                            <TextBlock Text="Lưu"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnLuuVaMoi" Style="{StaticResource ActionBtn}" Click="BtnLuuVaMoi_Click">
                        <TextBlock Text="Lưu &amp; Mới"/>
                    </Button>
                    <Button x:Name="BtnLuuVaThoat" Style="{StaticResource ActionBtn}" Click="BtnLuuVaThoat_Click">
                        <TextBlock Text="Lưu &amp; thoát"/>
                    </Button>
                    <Button x:Name="BtnThoat" Style="{StaticResource ActionBtn}" Click="BtnThoat_Click">
                        <TextBlock Text="Thoát"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
