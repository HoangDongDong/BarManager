<UserControl x:Class="QuanLyBar.Client.Views.ChiTietHoatDongControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="1200" d:DesignWidth="1400">
             
    <Grid Background="#759dc9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Toolbar Lọc dữ liệu -->
        <Border Grid.Row="0" Background="#e3eaf5" Padding="6,4" BorderBrush="#b6c1cd" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Từ ngày" VerticalAlignment="Center" Margin="5,0,5,0" FontWeight="SemiBold"/>
                <DatePicker x:Name="dpTuNgay" Width="105" Height="24" SelectedDateChanged="DpNgay_SelectedDateChanged"/>
                <TextBlock Text="Đến ngày" VerticalAlignment="Center" Margin="10,0,5,0" FontWeight="SemiBold"/>
                <DatePicker x:Name="dpDenNgay" Width="105" Height="24" SelectedDateChanged="DpNgay_SelectedDateChanged"/>
                
                <TextBlock Text="Thu ngân:" VerticalAlignment="Center" Margin="15,0,5,0" FontWeight="SemiBold"/>
                <ComboBox x:Name="CboThuNgan" Width="110" Height="24" Margin="0,0,10,0" SelectedIndex="0" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="Tất cả"/>
                    <ComboBoxItem Content="Administrator"/>
                </ComboBox>

                <TextBlock Text="Cửa hàng:" VerticalAlignment="Center" Margin="10,0,5,0" FontWeight="SemiBold"/>
                
                <!-- Cửa hàng Selector với Dropdown & Nút Thêm / Tải / Danh mục -->
                <Grid Margin="0,0,15,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBox x:Name="TxtSelectedCuaHang" Grid.Column="0" Height="24" VerticalContentAlignment="Center" 
                             Text="TRỤ SỞ CHÍNH" Padding="4,0" Background="White" BorderBrush="#a4b8cc" IsReadOnly="True"
                             PreviewMouseDown="TxtSelectedCuaHang_PreviewMouseDown"/>
                    
                    <ToggleButton x:Name="BtnToggleCuaHang" Grid.Column="1" Height="24" Background="#e8eff7" 
                                  BorderBrush="#a4b8cc" BorderThickness="0,1,1,1" Cursor="Hand">
                        <TextBlock Text="▼" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#555"/>
                    </ToggleButton>

                    <!-- Popup Cửa hàng -->
                    <Popup x:Name="PopupCuaHang" PlacementTarget="{Binding ElementName=TxtSelectedCuaHang}" 
                           Placement="Bottom" StaysOpen="False" IsOpen="{Binding ElementName=BtnToggleCuaHang, Path=IsChecked, Mode=TwoWay}"
                           AllowsTransparency="True">
                        <Border Width="220" Background="White" BorderBrush="#7192b8" BorderThickness="1" Margin="0,2,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" MaxHeight="180"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <ListBox x:Name="LstCuaHang" Grid.Row="0" BorderThickness="0" Background="White"
                                         SelectionChanged="LstCuaHang_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="2,3">
                                                <TextBlock Text="🖥️" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Border Grid.Row="1" Background="#f0f4f9" BorderBrush="#d0dbe5" BorderThickness="0,1,0,0" Padding="4,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnThemCuaHang" Grid.Column="0" Margin="1" Height="24" Background="White" 
                                                BorderBrush="#b8c8d8" Cursor="Hand" Click="BtnThemCuaHang_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="➕" Foreground="Green" FontSize="10" Margin="0,0,3,0"/>
                                                <TextBlock Text="Thêm" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnTaiCuaHang" Grid.Column="1" Margin="1" Height="24" Background="White" 
                                                BorderBrush="#b8c8d8" Cursor="Hand" Click="BtnTaiCuaHang_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🔄" Foreground="#0055aa" FontSize="10" Margin="0,0,3,0"/>
                                                <TextBlock Text="Tải" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnDanhMucCuaHang" Grid.Column="2" Margin="1" Height="24" Background="White" 
                                                BorderBrush="#b8c8d8" Cursor="Hand" Click="BtnDanhMucCuaHang_Click">
                                            <TextBlock Text="Danh mục" FontSize="11"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>

                <Button Content="🔄 Tải dữ liệu (F5)" Margin="0,0,5,0" Padding="12,2" Height="24" Background="White" BorderBrush="#a4b8cc" Cursor="Hand" Click="BtnTaiDuLieu_Click"/>
            </StackPanel>
        </Border>

        <!-- Thanh Toolbar In ấn & Xem trước kiểu Ribbon -->
        <Border Grid.Row="1" Background="#e3edf7" Padding="4,3" BorderBrush="#a4bcd5" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button x:Name="BtnPrint" Margin="2,0" Padding="6,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnPrint_Click" ToolTip="In tài liệu">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨️" FontSize="14" Margin="0,0,4,0"/>
                            <TextBlock Text="Print" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnSave" Margin="2,0" Padding="6,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnSave_Click" ToolTip="Lưu ra Excel">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" FontSize="14" Margin="0,0,4,0"/>
                            <TextBlock Text="Save" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Separator Width="1" Margin="6,2" Background="#b0c4de"/>
                    <Button Margin="2,0" Padding="4,2" Background="Transparent" BorderThickness="0" ToolTip="Gửi Email">
                        <TextBlock Text="✉️" FontSize="14"/>
                    </Button>
                    <Button Margin="2,0" Padding="4,2" Background="Transparent" BorderThickness="0" ToolTip="Tìm kiếm">
                        <TextBlock Text="🔍" FontSize="14"/>
                    </Button>
                    <Button Margin="2,0" Padding="4,2" Background="Transparent" BorderThickness="0" ToolTip="Sao chép">
                        <TextBlock Text="📑" FontSize="14"/>
                    </Button>
                    <Button Margin="2,0" Padding="4,2" Background="Transparent" BorderThickness="0" ToolTip="Cài đặt trang">
                        <TextBlock Text="📄" FontSize="14"/>
                    </Button>
                </StackPanel>

                <!-- Phân trang ở giữa -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="20,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="BtnFirstPage" Content="|◄◄" Width="26" Height="20" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnFirstPage_Click"/>
                    <Button x:Name="BtnPrevPage" Content="◄" Width="20" Height="20" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnPrevPage_Click"/>
                    <Border Background="White" BorderBrush="#a4bcd5" BorderThickness="1" Margin="4,0" Padding="6,1">
                        <TextBlock x:Name="TxtPageInfo" Text="1 of 2" FontWeight="Bold"/>
                    </Border>
                    <Button x:Name="BtnNextPage" Content="►" Width="20" Height="20" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnNextPage_Click"/>
                    <Button x:Name="BtnLastPage" Content="►►|" Width="26" Height="20" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnLastPage_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Vùng hiển thị Các Trang Báo Cáo Tự Động Phân Trang Chuẩn Khổ A4 -->
        <ScrollViewer x:Name="ReportScrollViewer" Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#96bee7" Offset="0"/>
                    <GradientStop Color="#709ecd" Offset="1"/>
                </LinearGradientBrush>
            </ScrollViewer.Background>

            <!-- Container chứa các trang A4 -->
            <StackPanel x:Name="PagesStackPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="25"/>
        </ScrollViewer>
    </Grid>
</UserControl>
