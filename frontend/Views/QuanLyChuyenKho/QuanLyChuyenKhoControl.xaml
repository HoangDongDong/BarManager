<UserControl x:Class="QuanLyBar.Client.Views.QuanLyChuyenKho.QuanLyChuyenKhoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuanLyBar.Client.Views.QuanLyChuyenKho"
             xmlns:services="clr-namespace:QuanLyBar.Client.Services"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200"
             FontFamily="Segoe UI" FontSize="12" Background="#f0f4f9">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#dbe9f6" Offset="0"/>
            <GradientStop Color="#c9ddf0" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="ToolbarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#d0e2f5"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#86a9d1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#b8d4f0"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#5588bb"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#f4f8fc"/>
            <Setter Property="BorderBrush" Value="#b6c9dc"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#e1effe"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#629dd4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="200" MaxWidth="400"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= BẢNG TRÁI: BỘ LỌC & CÂY KHO HÀNG ================= -->
        <Border Grid.Column="0" Background="#dbe5f1" BorderBrush="#9ab5cf" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. Header Cột Trái -->
                <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" BorderBrush="#9ab5cf" BorderThickness="0,0,0,1" Padding="4,2">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Width="24" Height="22" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Tùy chọn">
                            <TextBlock Text="⚙️" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Border Background="#f0f4f9" BorderBrush="#9ab5cf" BorderThickness="1" CornerRadius="2" Padding="6,2" Margin="0,0,4,0">
                            <TextBlock x:Name="TxtHeaderPhanNhom" Text="Kho xuất" FontWeight="SemiBold" Foreground="#1e3f66"/>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- 2. Form Lọc (Ngày, Kho nhập, Kho xuất, NV nhập, NV xuất) -->
                <Border Grid.Row="1" Background="#dbe5f1" BorderBrush="#b6cadf" BorderThickness="0,0,0,1" Padding="6,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Ngày: Từ -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Ngày" FontWeight="Normal" VerticalAlignment="Center" Margin="0,2"/>
                        <Grid Grid.Row="0" Grid.Column="1" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Từ:" VerticalAlignment="Center" Foreground="#333"/>
                            <DatePicker Grid.Column="1" x:Name="DpTuNgay" Height="22" SelectedDateChanged="DpDate_SelectedDateChanged"/>
                        </Grid>

                        <!-- Ngày: Đến -->
                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Đến:" VerticalAlignment="Center" Foreground="#333"/>
                            <DatePicker Grid.Column="1" x:Name="DpDenNgay" Height="22" SelectedDateChanged="DpDate_SelectedDateChanged"/>
                        </Grid>

                        <!-- Kho nhập -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Kho nhập" VerticalAlignment="Center" Margin="0,2"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CboKhoNhap" Height="22" Margin="0,2" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="CboFilter_SelectionChanged"/>

                        <!-- Kho xuất -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Kho xuất" VerticalAlignment="Center" Margin="0,2"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="CboKhoXuat" Height="22" Margin="0,2" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="CboFilter_SelectionChanged"/>

                        <!-- Nhân viên nhập -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Nhân viên nhập" VerticalAlignment="Center" Margin="0,2" TextWrapping="Wrap"/>
                        <ComboBox Grid.Row="4" Grid.Column="1" x:Name="CboNhanVienNhap" Height="22" Margin="0,2" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="CboFilter_SelectionChanged"/>

                        <!-- Nhân viên xuất -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Nhân viên xuất" VerticalAlignment="Center" Margin="0,2" TextWrapping="Wrap"/>
                        <ComboBox Grid.Row="5" Grid.Column="1" x:Name="CboNhanVienXuat" Height="22" Margin="0,2" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="CboFilter_SelectionChanged"/>
                    </Grid>
                </Border>

                <!-- 3. Thanh tác vụ dưới Form Lọc (Thêm, Sửa, Thêm thư mục, Xem theo thư mục, Tải lại, Chế độ phân nhóm) -->
                <Border Grid.Row="2" Background="#eaf1fa" BorderBrush="#b6cadf" BorderThickness="0,0,0,1" Padding="2,2">
                    <DockPanel LastChildFill="False">
                        <Button x:Name="BtnThemKho" ToolTip="Thêm" Margin="1,0" Padding="3,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnThemKho_Click">
                            <TextBlock Text="➕" Foreground="Green" FontSize="13"/>
                        </Button>
                        <Button x:Name="BtnSuaKho" ToolTip="Sửa" Margin="1,0" Padding="3,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnSuaKho_Click">
                            <TextBlock Text="✏️" FontSize="13"/>
                        </Button>
                        <Button x:Name="BtnThemThuMuc" ToolTip="Tạo mới thư mục" Margin="1,0" Padding="3,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnThemThuMuc_Click">
                            <TextBlock Text="📁" Foreground="#d4a017" FontSize="13"/>
                        </Button>
                        <Button x:Name="BtnXemTheoThuMuc" ToolTip="Hiển thị tất cả dữ liệu theo thư mục" Margin="1,0" Padding="3,2" 
                                Background="#fff9e6" BorderBrush="#e6a800" BorderThickness="1" Cursor="Hand" Click="BtnDanhMucKho_Click">
                            <TextBlock Text="🗂️" FontSize="13"/>
                        </Button>
                        <Button x:Name="BtnTaiLaiKho" ToolTip="Tải lại" Margin="1,0" Padding="3,2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnRefreshTree_Click">
                            <TextBlock Text="🔄" FontSize="13"/>
                        </Button>

                        <Button x:Name="BtnMenuCheDo" DockPanel.Dock="Right" ToolTip="Chế độ phân nhóm" Margin="2,0" Padding="4,2" 
                                Background="#e2ecf8" BorderBrush="#a4bce3" Cursor="Hand" Click="BtnMenuCheDo_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗂️" FontSize="12" Margin="0,0,2,0"/>
                                <TextBlock Text="▾" FontSize="10" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu x:Name="CmCheDoPhanNhom">
                                    <MenuItem Header="🏠  Kho xuất" Click="MiCheDoKhoXuat_Click"/>
                                    <MenuItem Header="🏠  Kho nhập" Click="MiCheDoKhoNhap_Click"/>
                                    <MenuItem Header="👩  Nhân viên xuất" Click="MiCheDoNhanVienXuat_Click"/>
                                    <MenuItem Header="👩  Nhân viên nhập" Click="MiCheDoNhanVienNhap_Click"/>
                                    <MenuItem Header="🏪  Cửa hàng" Click="MiCheDoCuaHang_Click"/>
                                    <MenuItem Header="🏛️  Tài khoản ngân hàng" Click="MiCheDoTaiKhoanNganHang_Click"/>
                                    <MenuItem Header="🗓️  Bảng giá" Click="MiCheDoBangGia_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </DockPanel>
                </Border>

                <!-- 4. Cây danh mục phân nhóm -->
                <TreeView Grid.Row="3" x:Name="TvKhoHang" Background="White" BorderThickness="0"
                          SelectedItemChanged="TvKhoHang_SelectedItemChanged">
                    <TreeView.ContextMenu>
                        <ContextMenu x:Name="CmTreeView" Opened="CmTreeView_Opened">
                            <!-- 1. Thêm mới -->
                            <MenuItem Header="Thêm mới">
                                <MenuItem Header="➕  Thêm kho hàng" Click="MiThemMoiItem_Click"/>
                                <MenuItem Header="Thêm nhanh" Click="MiThemNhanhGoc_Click"/>
                                <MenuItem Header="📁  Thêm thư mục" Click="MiThemThuMucGoc_Click"/>
                            </MenuItem>

                            <!-- 2. Thêm con -->
                            <MenuItem Header="Thêm con">
                                <MenuItem Header="➕  Thêm kho hàng" Click="MiThemConItem_Click"/>
                                <MenuItem Header="Thêm nhanh" Click="MiThemNhanhCon_Click"/>
                                <MenuItem Header="📁  Thêm thư mục" Click="MiThemThuMucCon_Click"/>
                            </MenuItem>

                            <!-- 3. Chỉnh sửa -->
                            <MenuItem Header="✏️  Chỉnh sửa" Click="MiChinhSua_Click"/>

                            <!-- 4. Sắp xếp theo -->
                            <MenuItem Header="Sắp xếp theo">
                                <MenuItem Header="Tên" IsCheckable="True" IsChecked="True" Click="MiSapXepTen_Click"/>
                                <MenuItem Header="Thứ tự tùy chọn" IsCheckable="True" Click="MiSapXepTuyChon_Click"/>
                            </MenuItem>

                            <!-- 5. Refresh -->
                            <MenuItem Header="🔄  Refresh" Click="BtnLamMoiKho_Click"/>

                            <Separator/>

                            <!-- 6. Sao chép, Mở rộng, Thu gọn -->
                            <MenuItem Header="📑  Sao chép" Click="MiSaoChep_Click"/>
                            <MenuItem Header="Mở rộng" Click="MiMoRong_Click"/>
                            <MenuItem Header="Thu gọn" Click="MiThuGon_Click"/>

                            <Separator/>

                            <!-- 7. Xóa, Khôi phục, Đổi tên, Thùng rác -->
                            <MenuItem Header="❌  Xóa" Click="BtnXoaKho_Click"/>
                            <MenuItem Header="♻️  Khôi phục" Click="MiKhoiPhucTree_Click"/>
                            <MenuItem Header="Đổi tên" Click="MiDoiTen_Click"/>
                            <MenuItem Header="Thùng rác" Click="MiThungRac_Click"/>

                            <Separator/>

                            <!-- 8. Biểu tượng, Thuộc tính -->
                            <MenuItem Header="Biểu tượng" Click="MiBieuTuong_Click"/>
                            <MenuItem Header="Thuộc tính" Click="MiThuocTinh_Click"/>
                        </ContextMenu>
                    </TreeView.ContextMenu>

                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="{Binding Icon}" Margin="0,0,5,0" VerticalAlignment="Center" FontSize="12"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" Foreground="#111111"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}">
                            <Setter Property="IsExpanded" Value="True"/>
                            <Setter Property="Padding" Value="2,2"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#fff2b3"/>
                                    <Setter Property="BorderBrush" Value="#f1a93b"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </Grid>
        </Border>

        <!-- THANH KÉO CO GIÃN CỘT TRÁI / PHẢI -->
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#c2d5e8" Cursor="SizeWE"/>

        <!-- ================= PHẦN PHẢI: BẢNG DỮ LIỆU & TAB CHI TIẾT ================= -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="140" MinHeight="100" MaxHeight="280"/>
            </Grid.RowDefinitions>

            <!-- 1. Thanh Công Cụ Trên Cùng -->
            <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" BorderBrush="#9ab5cf" BorderThickness="0,0,0,1" Padding="4,2">
                <DockPanel LastChildFill="False">
                    <!-- Tab Label -->
                    <Border DockPanel.Dock="Left" Background="#f0f4f9" BorderBrush="#9ab5cf" BorderThickness="1,1,1,0" CornerRadius="2,2,0,0" Padding="8,4" Margin="2,0,8,-2">
                        <TextBlock Text="Chuyển kho" FontWeight="Bold" Foreground="#0f3b6c"/>
                    </Border>

                    <!-- Lọc F3 -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="Lọc (F3):" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#333"/>
                        <TextBox x:Name="TxtSearch" Width="130" Height="22" VerticalContentAlignment="Center" Padding="3,0" TextChanged="TxtSearch_TextChanged"/>
                    </StackPanel>

                    <!-- Các nút chức năng chính -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnThemMoi" Style="{StaticResource ToolbarBtn}" Click="BtnThemMoi_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="➕" Foreground="Green" Margin="0,0,3,0"/>
                                <TextBlock Text="Thêm mới (Insert)"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnChinhSua" Style="{StaticResource ToolbarBtn}" Click="BtnChinhSua_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✏️" Foreground="#0066cc" Margin="0,0,3,0"/>
                                <TextBlock Text="Chỉnh sửa (F4)"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnXoa" Style="{StaticResource ToolbarBtn}" Click="BtnXoa_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="❌" Foreground="Red" Margin="0,0,3,0"/>
                                <TextBlock Text="Xóa (Del)"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnThemExcel" Style="{StaticResource ToolbarBtn}" Click="BtnThemExcel_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" Foreground="Green" Margin="0,0,3,0"/>
                                <TextBlock Text="Thêm excel"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnXuatExcel" Style="{StaticResource ToolbarBtn}" Click="BtnXuatExcel_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📗" Foreground="DarkGreen" Margin="0,0,3,0"/>
                                <TextBlock Text="Xuất excel"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnIn" Style="{StaticResource ToolbarBtn}" Click="BtnIn_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖨️" Foreground="#333" Margin="0,0,3,0"/>
                                <TextBlock Text="In"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnTong" Style="{StaticResource ToolbarBtn}" Click="BtnTong_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="∑" FontWeight="Bold" Foreground="#333" Margin="0,0,3,0"/>
                                <TextBlock Text="Tổng"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnPhanTich" Style="{StaticResource ToolbarBtn}" Click="BtnPhanTich_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" Foreground="#555" Margin="0,0,3,0"/>
                                <TextBlock Text="P.tích"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 2. DataGrid Quản Lý Chuyển Kho (Toàn bộ 44 Cột chuẩn) -->
            <DataGrid Grid.Row="1" x:Name="DgPhieuChuyen" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      IsReadOnly="True" HeadersVisibility="All" GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#e0e8f0" VerticalGridLinesBrush="#e0e8f0"
                      RowHeight="23" SelectionMode="Single" SelectionUnit="FullRow"
                      Background="White" RowBackground="White" AlternatingRowBackground="#f8fbff"
                      SelectionChanged="DgPhieuChuyen_SelectionChanged"
                      MouseDoubleClick="DgPhieuChuyen_MouseDoubleClick">
                <DataGrid.RowStyle>
                    <Style TargetType="{x:Type DataGridRow}">
                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="DataGridRow_PreviewMouseRightButtonDown"/>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.RowHeaderStyle>
                    <Style TargetType="{x:Type DataGridRowHeader}">
                        <Setter Property="Width" Value="28"/>
                        <Setter Property="Background" Value="#dfe9f5"/>
                        <Setter Property="BorderBrush" Value="#b6cadf"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Content" Value="{Binding Stt}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="FontSize" Value="11"/>
                    </Style>
                </DataGrid.RowHeaderStyle>

                <DataGrid.ContextMenu>
                    <ContextMenu x:Name="GridContextMenu" Opened="GridContextMenu_Opened">
                        <!-- Chế độ thùng rác -->
                        <MenuItem x:Name="MenuKhoiPhuc" Header="Khôi phục" Click="MenuItem_KhoiPhuc_Click" Visibility="Collapsed">
                            <MenuItem.Icon>
                                <TextBlock Text="↩️" Foreground="Green" FontWeight="Bold"/>
                            </MenuItem.Icon>
                        </MenuItem>

                        <!-- Chế độ bình thường -->
                        <MenuItem x:Name="MenuThemMoi" Header="Thêm Phiếu chuyển kho" Click="BtnThemMoi_Click">
                            <MenuItem.Icon>
                                <TextBlock Text="➕" Foreground="Green" FontWeight="Bold"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="MenuThemNhanhExcel" Header="Thêm nhanh (excel)" Click="BtnThemExcel_Click"/>
                        <MenuItem x:Name="MenuCapNhatNhanhExcel" Header="Cập nhật nhanh (excel)" Click="BtnThemExcel_Click"/>
                        <MenuItem x:Name="MenuChinhSua" Header="Chỉnh sửa" Click="BtnChinhSua_Click">
                            <MenuItem.Icon>
                                <TextBlock Text="✏️" Foreground="#c07000"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator x:Name="SepDatLoc"/>
                        <MenuItem x:Name="MenuLocCot" Header="Lọc Số phiếu" Click="MenuLocCot_Click"/>
                        <Separator x:Name="SepSapXep"/>
                        <MenuItem x:Name="MenuSapXep" Header="Sắp xếp theo">
                            <MenuItem Header="Sắp xếp tăng dần" Click="MenuItem_SortAsc_Click"/>
                            <MenuItem Header="Sắp xếp giảm dần" Click="MenuItem_SortDesc_Click"/>
                            <Separator/>
                            <MenuItem Header="Số phiếu" Click="MenuItem_SortBySoPhieu_Click"/>
                            <MenuItem Header="Ngày" Click="MenuItem_SortByNgay_Click"/>
                            <MenuItem Header="Kho xuất" Click="MenuItem_SortByKhoXuat_Click"/>
                            <MenuItem Header="Kho nhập" Click="MenuItem_SortByKhoNhap_Click"/>
                            <MenuItem Header="Nhân viên" Click="MenuItem_SortByNv_Click"/>
                            <MenuItem Header="Tổng cộng" Click="MenuItem_SortByTongCong_Click"/>
                        </MenuItem>
                        <MenuItem x:Name="MenuRefresh" Header="Refresh" Click="BtnLamMoi_Click">
                            <MenuItem.Icon>
                                <TextBlock Text="🔄" Foreground="Green" FontWeight="Bold"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="MenuInDanhSach" Header="In danh sách" Click="BtnIn_Click"/>
                        <Separator x:Name="SepSaoChep"/>
                        <MenuItem x:Name="MenuSaoChepO" Header="Sao chép ô" Click="MenuItem_SaoChepO_Click">
                            <MenuItem.Icon>
                                <TextBlock Text="📄" Foreground="Navy"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="MenuSaoChepVungChon" Header="Sao chép vùng chọn" Click="MenuItem_SaoChepVungChon_Click">
                            <MenuItem.Icon>
                                <TextBlock Text="📑" Foreground="Navy"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="MenuXoa" Header="Xóa" Click="BtnXoa_Click">
                            <MenuItem.Icon>
                                <TextBlock Text="❌" Foreground="Red"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator x:Name="SepKhac"/>
                        <MenuItem x:Name="MenuTuDongGianCot" Header="Tự động giãn cột" Click="MenuItem_TuDongGianCot_Click"/>
                        <MenuItem x:Name="MenuCotHienThi" Header="Cột hiển thị" Click="MenuCotHienThi_Click"/>
                        <MenuItem x:Name="MenuThuocTinh" Header="Thuộc tính" Click="MenuItem_ThuocTinh_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.Columns>
                    <!-- Cột 1: Số phiếu -->
                    <DataGridTextColumn Header="Số phiếu" Binding="{Binding SoPhieu}" Width="100"/>
                    
                    <!-- Cột 2: Ngày -->
                    <DataGridTextColumn Header="Ngày" Binding="{Binding NgayHienThi}" Width="90"/>

