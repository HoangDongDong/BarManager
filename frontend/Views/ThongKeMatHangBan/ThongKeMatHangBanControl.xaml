<UserControl x:Class="QuanLyBar.Client.Views.ThongKeMatHangBanControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1280" Background="#d1def0" Loaded="UserControl_Loaded">
             
    <Grid Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#e3eaf5" Padding="6,4" BorderBrush="#b6c1cd" BorderThickness="1" Margin="0,0,0,3">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Từ:" VerticalAlignment="Center" Margin="2,0,5,0" FontWeight="SemiBold"/>
                <DatePicker x:Name="dpTuNgay" Width="105" Height="24" SelectedDateChanged="DpNgay_SelectedDateChanged"/>
                <TextBlock Text="Đến" VerticalAlignment="Center" Margin="8,0,5,0" FontWeight="SemiBold"/>
                <DatePicker x:Name="dpDenNgay" Width="105" Height="24" SelectedDateChanged="DpNgay_SelectedDateChanged"/>
                
                <TextBlock Text="Cửa hàng:" VerticalAlignment="Center" Margin="15,0,5,0" FontWeight="SemiBold"/>
                
                <!-- Cửa hàng Selector với Dropdown & Nút Thêm / Tải / Danh mục -->
                <Grid Margin="0,0,15,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBox x:Name="TxtSelectedCuaHang" Grid.Column="0" Height="24" VerticalContentAlignment="Center" 
                             Text="TRỤ SỞ CHÍNH" Padding="4,0" Background="White" BorderBrush="#a4b8cc" IsReadOnly="True"
                             PreviewMouseDown="TxtSelectedCuaHang_PreviewMouseDown"/>
                    
                    <ToggleButton x:Name="BtnToggleCuaHang" Grid.Column="1" Height="24" Background="#e8eff7" 
                                  BorderBrush="#a4b8cc" BorderThickness="0,1,1,1" Cursor="Hand">
                        <TextBlock Text="▼" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#555"/>
                    </ToggleButton>

                    <!-- Popup Cửa hàng -->
                    <Popup x:Name="PopupCuaHang" PlacementTarget="{Binding ElementName=TxtSelectedCuaHang}" 
                           Placement="Bottom" StaysOpen="False" IsOpen="{Binding ElementName=BtnToggleCuaHang, Path=IsChecked, Mode=TwoWay}"
                           AllowsTransparency="True">
                        <Border Width="220" Background="White" BorderBrush="#7192b8" BorderThickness="1" Margin="0,2,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" MaxHeight="180"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Danh sách trụ sở/cửa hàng -->
                                <ListBox x:Name="LstCuaHang" Grid.Row="0" BorderThickness="0" Background="White"
                                         SelectionChanged="LstCuaHang_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="2,3">
                                                <TextBlock Text="🖥️" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Thanh công cụ dưới Popup: Thêm, Tải, Danh mục -->
                                <Border Grid.Row="1" Background="#f0f4f9" BorderBrush="#d0dbe5" BorderThickness="0,1,0,0" Padding="4,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnThemCuaHang" Grid.Column="0" Margin="1" Height="24" Background="White" 
                                                BorderBrush="#b8c8d8" Cursor="Hand" Click="BtnThemCuaHang_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="➕" Foreground="Green" FontSize="10" Margin="0,0,3,0"/>
                                                <TextBlock Text="Thêm" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnTaiCuaHang" Grid.Column="1" Margin="1" Height="24" Background="White" 
                                                BorderBrush="#b8c8d8" Cursor="Hand" Click="BtnTaiCuaHang_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🔄" Foreground="#0055aa" FontSize="10" Margin="0,0,3,0"/>
                                                <TextBlock Text="Tải" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnDanhMucCuaHang" Grid.Column="2" Margin="1" Height="24" Background="White" 
                                                BorderBrush="#b8c8d8" Cursor="Hand" Click="BtnDanhMucCuaHang_Click">
                                            <TextBlock Text="Danh mục" FontSize="11"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>

                <!-- Tùy chọn Giá vốn / Giá nhập -->
                <RadioButton x:Name="RbTheoGiaVon" Content="Theo giá vốn" IsChecked="True" VerticalAlignment="Center" Margin="5,0,10,0" Checked="RbGia_Checked"/>
                <RadioButton x:Name="RbTheoGiaNhap" Content="Theo giá nhập" VerticalAlignment="Center" Margin="0,0,15,0" Checked="RbGia_Checked"/>
                
                <Button x:Name="btnRefresh" Content="🔄 Refresh (F5)" Margin="0,0,8,0" Padding="12,2" Height="24" Background="White" BorderBrush="#a4b8cc" Cursor="Hand" Click="BtnRefresh_Click"/>
                <Button x:Name="btnInBaoCao" Content="🖨️ In báo cáo" Padding="12,2" Height="24" Background="White" BorderBrush="#a4b8cc" Cursor="Hand" Click="BtnInBaoCao_Click"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="160"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Cột Trái: Cây nhóm mặt hàng với ContextMenu đầy đủ như Danh mục mặt hàng -->
            <Border Grid.Column="0" Background="White" BorderBrush="#b6c1cd" BorderThickness="1">
                <TreeView x:Name="TvNhomMatHang" BorderThickness="0" Background="Transparent" 
                          SelectedItemChanged="TvNhomMatHang_SelectedItemChanged">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <StackPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Thêm mới">
                                            <MenuItem Header="Thêm nhóm cùng cấp" Click="MenuTree_ThemMoiCungCap_Click"/>
                                            <MenuItem Header="Thêm nhóm cha" Click="MenuTree_ThemMoiCha_Click"/>
                                        </MenuItem>
                                        <MenuItem Header="Thêm con" Click="MenuTree_ThemCon_Click"/>
                                        <MenuItem Header="✏️ Chỉnh sửa" Click="MenuTree_ChinhSua_Click"/>
                                        <MenuItem Header="Sắp xếp theo">
                                            <MenuItem Header="Theo tên (A - Z)" Click="MenuTree_SortAZ_Click"/>
                                            <MenuItem Header="Theo tên (Z - A)" Click="MenuTree_SortZA_Click"/>
                                            <MenuItem Header="Mặc định" Click="MenuTree_Refresh_Click"/>
                                        </MenuItem>
                                        <MenuItem Header="🔄 Refresh" Click="MenuTree_Refresh_Click"/>
                                        <Separator/>
                                        <MenuItem Header="📑 Sao chép" Click="MenuTree_SaoChep_Click"/>
                                        <MenuItem Header="Mở rộng" Click="MenuTree_MoRong_Click"/>
                                        <MenuItem Header="Thu gọn" Click="MenuTree_ThuGon_Click"/>
                                        <Separator/>
                                        <MenuItem Header="❌ Xóa" Click="MenuTree_Xoa_Click"/>
                                        <MenuItem Header="Đổi tên" Click="MenuTree_DoiTen_Click"/>
                                        <MenuItem Header="Thùng rác" Click="MenuTree_ThungRac_Click"/>
                                        <Separator/>
                                        <MenuItem Header="🖼️ Biểu tượng" Click="MenuTree_BieuTuong_Click"/>
                                        <MenuItem Header="⚙️ Thuộc tính" Click="MenuTree_ThuocTinh_Click"/>
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <TextBlock Text="{Binding Icon}" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#b2cbe4" ResizeBehavior="PreviousAndNext"/>

            <!-- Cột Phải: Bảng danh sách mặt hàng bán -->
            <Border Grid.Column="2" Background="White" BorderBrush="#b6c1cd" BorderThickness="1">
                <DataGrid x:Name="DgMatHangBan" AutoGenerateColumns="False" IsReadOnly="True" 
                          SelectionMode="Single" HeadersVisibility="Column" RowHeight="22" FontSize="11"
                          GridLinesVisibility="All" AlternatingRowBackground="#f0f5fb" Background="White"
                          HorizontalGridLinesBrush="#e2e8f0" VerticalGridLinesBrush="#e2e8f0">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="📑 Sao chép ô" Click="MnuMatHangBan_SaoChepO_Click"/>
                            <MenuItem Header="📄 Sao chép dòng" Click="MnuMatHangBan_SaoChepDong_Click"/>
                            <Separator/>
                            <MenuItem Header="↔️ Tự động dãn cột" Click="MnuMatHangBan_TuDongDanCot_Click"/>
                            <MenuItem Header="📊 Cột hiển thị" Click="MnuMatHangBan_CotHienThi_Click"/>
                            <Separator/>
                            <MenuItem Header="📥 Xuất dữ liệu Excel" Click="MnuMatHangBan_XuatExcel_Click"/>
                            <MenuItem Header="🖨️ In danh sách" Click="MnuMatHangBan_InDanhSach_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <!-- Cột STT dạng 01, 02 -->
                        <DataGridTextColumn Header="" Binding="{Binding SttStr}" Width="30">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#003366"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Mặt hàng" Binding="{Binding TenHang}" Width="160">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong, StringFormat={}{0:0.##}}" Width="65">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="ĐVT" Binding="{Binding Dvt}" Width="45">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Đơn giá" Binding="{Binding DonGia, StringFormat={}{0:N0}}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Tiền giảm" Binding="{Binding TienGiam, StringFormat={}{0:N0}}" Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Thành tiền bán" Binding="{Binding ThanhTienBan, StringFormat={}{0:N0}}" Width="95">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="0,0,4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Giá vốn" Binding="{Binding GiaVon, StringFormat={}{0:N0}}" Width="75">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Giảm giá %" Binding="{Binding GiamGiaPhanTram, StringFormat={}{0:0.##}}" Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Thành tiền nhập" Binding="{Binding ThanhTienNhap, StringFormat={}{0:N0}}" Width="95">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Lãi" Binding="{Binding Lai, StringFormat={}{0:N0}}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#aa0000"/>
                                    <Setter Property="Padding" Value="0,0,4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Tỉ lệ lãi" Binding="{Binding TiLeLai, StringFormat={}{0:0.##}}" Width="65">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Mã hàng" Binding="{Binding MaHang}" Width="75"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Bảng Tổng Kết Dưới Cùng (Summary Footer) -->
        <Border Grid.Row="2" Background="#cce0f5" BorderThickness="1" BorderBrush="#a4c2e0" Margin="0,3,0,0" Padding="15,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>

                <!-- Tổng tiền bán & Tổng tiền nhập -->
                <TextBlock Grid.Column="0" Text="Tổng tiền bán:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtTongTienBan" Grid.Column="1" Text="0" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="5,0,0,0"/>

                <TextBlock Grid.Column="3" Text="Tổng tiền nhập:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtTongTienNhap" Grid.Column="4" Text="0" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="5,0,0,0"/>

                <!-- Cột tóm tắt lãi và các khoản thu chi bên phải -->
                <StackPanel Grid.Column="6" HorizontalAlignment="Right">
                    <Grid Margin="0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtLaiBanHang" Grid.Column="0" Text="0" TextAlignment="Right" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="(Tổng tiền lãi bán hàng)" Margin="6,0,0,0" FontStyle="Italic"/>
                    </Grid>
                    <Grid Margin="0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="0" TextAlignment="Right" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="(Tiền giờ)" Margin="6,0,0,0" FontStyle="Italic"/>
                    </Grid>
                    <Grid Margin="0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtTongTienGiamGia" Grid.Column="0" Text="0" TextAlignment="Right" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="(Tổng tiền giảm giá)" Margin="6,0,0,0" FontStyle="Italic"/>
                    </Grid>
                    <Grid Margin="0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="0" TextAlignment="Right" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="(Phí dịch vụ)" Margin="6,0,0,0" FontStyle="Italic"/>
                    </Grid>
                    <Grid Margin="0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="0" TextAlignment="Right" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="(Thuế)" Margin="6,0,0,0" FontStyle="Italic"/>
                    </Grid>
                    <Border BorderBrush="#111" BorderThickness="0,1,0,0" Margin="0,3"/>
                    <Grid Margin="0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtTongTienLai" Grid.Column="0" Text="0" TextAlignment="Right" FontWeight="Bold" FontSize="13" Foreground="#aa0000"/>
                        <TextBlock Grid.Column="1" Text="(Tổng tiền lãi)" Margin="6,0,0,0" FontWeight="Bold" Foreground="#aa0000"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
