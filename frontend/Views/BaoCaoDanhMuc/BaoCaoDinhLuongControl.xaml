<UserControl x:Class="QuanLyBar.Client.Views.BaoCaoDanhMuc.BaoCaoDinhLuongControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1200"
             Background="#759dc9" FontFamily="Segoe UI" FontSize="12"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#a4b8cc"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#e6f2ff"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#70a0d0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#cce4ff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#d0e4f7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#b8d5f0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 0: Left Panel (Tham số báo cáo) -->
            <ColumnDefinition x:Name="LeftPanelCol" Width="220"/>
            <!-- 1: Splitter -->
            <ColumnDefinition Width="Auto"/>
            <!-- 2: Main Report Area -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 0. Left Panel (Tham số báo cáo) -->
        <Border Grid.Column="0" Background="#f0f4f8" BorderBrush="#b6c1cd" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

                <!-- Panel Header -->
                <Border Grid.Row="0" Background="#dbe5f1" Padding="8,6" BorderBrush="#b6c1cd" BorderThickness="0,0,0,1">
                    <DockPanel LastChildFill="True">
                        <TextBlock Text="Tham số báo cáo" FontWeight="Bold" FontSize="12.5" Foreground="#1e3a8a" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- Panel Controls -->
                <StackPanel Grid.Row="1" Margin="10,12">
                    <TextBlock Text="Nhóm hàng" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CboNhomHang" Height="25" Margin="0,0,0,12" SelectionChanged="Filter_Changed" Background="White">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2,1">
                                    <TextBlock Text="{Binding Icon}" Margin="0,0,5,0" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Nút Tải dữ liệu F5 -->
                    <Button x:Name="BtnTaiDuLieu" Style="{StaticResource FlatButtonStyle}" Click="BtnTaiDuLieu_Click" HorizontalAlignment="Stretch" Height="28">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="🔄" Margin="0,0,6,0" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="Tải dữ liệu (F5)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. GridSplitter -->
        <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#b6c1cd"/>

        <!-- 2. Main Report Section -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <!-- 0: Thanh Lọc 2 (Lọc F3, In, Xem, F12) -->
                <RowDefinition Height="Auto"/>
                <!-- 1: Khung Hiển Thị Báo Cáo Trang A4 -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 0. Thanh Lọc Action Toolbar -->
            <Border Grid.Row="0" Background="#e3eaf5" Padding="6,4" BorderBrush="#b6c1cd" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnLocLabel" Style="{StaticResource ActionButtonStyle}" Margin="0,0,2,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📂" Margin="0,0,3,0" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="Lọc (F3):" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBox x:Name="TxtSearch" Width="140" Height="22" VerticalContentAlignment="Center" Margin="0,0,15,0" TextChanged="TxtSearch_TextChanged"/>

                        <Border Width="1" Height="16" Background="#b6c1cd" Margin="0,0,8,0"/>

                        <!-- Xem -->
                        <Button x:Name="BtnXem" Style="{StaticResource ActionButtonStyle}" Click="BtnXem_Click" Margin="0,0,5,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍" Margin="0,0,4,0" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="Xem (Ctrl + Shift + P)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- In -->
                        <Button x:Name="BtnIn" Style="{StaticResource ActionButtonStyle}" Click="BtnIn_Click" Margin="0,0,5,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖨️" Margin="0,0,4,0" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="In (Ctrl + P)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Excel -->
                        <Button x:Name="BtnExcel" Style="{StaticResource ActionButtonStyle}" Click="BtnExcel_Click" Margin="0,0,5,0">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="16" Height="14" Margin="0,0,4,0" VerticalAlignment="Center">
                                    <Rectangle Fill="#1f7244" RadiusX="1" RadiusY="1"/>
                                    <TextBlock Text="X" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="(F12)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    
                    <Separator Width="1" Height="16" Margin="6,0" Background="#b0c4de"/>

                    <Button x:Name="BtnThietKeMau" Style="{StaticResource ActionButtonStyle}" Click="BtnThietKeMau_Click" ToolTip="Thiết kế mẫu bao cao" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#127912;" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Thiết kế mẫu" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Separator Width="1" Height="16" Margin="6,0" Background="#b0c4de"/>

                    <Button x:Name="BtnThamSoTuyChinh" Style="{StaticResource ActionButtonStyle}" Click="BtnThamSoTuyChinh_Click" ToolTip="Tham số tùy chỉnh báo cáo" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#9881;" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Tham số" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Separator Width="1" Height="16" Margin="6,0" Background="#b0c4de"/>

                    <Button x:Name="BtnXemDuLieuTho" Style="{StaticResource ActionButtonStyle}" Click="BtnXemDuLieuTho_Click" ToolTip="Xem du lieu tho dang luoi" Margin="0,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#128203;" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Dữ liệu thô" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 1. Khung Hiển Thị Báo Cáo Trang A4 -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#759dc9">
                <Grid Margin="20">
                    <Border x:Name="A4PageBorder" Width="794" MinHeight="1123" Background="White" HorizontalAlignment="Center" VerticalAlignment="Top" CornerRadius="0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.35" Direction="270" ShadowDepth="4"/>
                        </Border.Effect>

                        <Grid Margin="40,35,40,35">
                            <Grid.RowDefinitions>
                                <!-- Header công ty / nhà hàng -->
                                <RowDefinition Height="Auto"/>
                                <!-- Tiêu đề báo cáo -->
                                <RowDefinition Height="Auto"/>
                                <!-- Nội dung bảng dữ liệu -->
                                <RowDefinition Height="*"/>
                                <!-- Footer chữ ký -->
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 0. Header Thông Tin Nhà Hàng & Logo -->
                            <Grid Grid.Row="0" Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Logo bên trái -->
                                <Image x:Name="ImgLogo" Grid.Column="0" Width="80" Height="80" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Uniform" Visibility="Collapsed"/>
                                <Viewbox x:Name="VbDefaultLogo" Grid.Column="0" Width="75" Height="75" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Grid Width="100" Height="100">
                                        <Border Background="#F8FAFC" BorderBrush="#007ACC" BorderThickness="2" CornerRadius="50" Width="96" Height="96"/>
                                        <Canvas Width="100" Height="100">
                                            <!-- Fork -->
                                            <Path Fill="#007ACC" Data="M 32,24 L 32,42 C 32,46 36,49 40,49 L 40,78 L 44,78 L 44,49 C 48,49 52,46 52,42 L 52,24 L 48,24 L 48,38 L 45,38 L 45,24 L 43,24 L 43,38 L 41,38 L 41,24 L 39,24 L 39,38 L 36,38 L 36,24 Z"/>
                                            <!-- Knife -->
                                            <Path Fill="#2C3E50" Data="M 58,24 C 64,24 68,32 68,44 L 62,44 L 62,78 L 58,78 Z"/>
                                        </Canvas>
                                    </Grid>
                                </Viewbox>

                                <!-- Thông tin nhà hàng bên phải -->
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtCompanyName" Text="NÀNG HƯƠNG QUÁN" FontSize="16" FontWeight="Bold" 
                                               HorizontalAlignment="Right" Foreground="#111" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="TxtCompanyAddress" Text="Địa chỉ: Số 28 Giang Văn Minh - Đội Cấn - Ba Đình - Hà Nội" 
                                               FontSize="10.5" HorizontalAlignment="Right" Foreground="#333" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="TxtCompanyContact" Text="Điện thoại: Điện thoại: 0909090880 Email:" 
                                               FontSize="10.5" HorizontalAlignment="Right" Foreground="#333"/>
                                </StackPanel>
                            </Grid>

                            <!-- 1. Tiêu Đề Báo Cáo -->
                            <StackPanel Grid.Row="1" Margin="0,10,0,15" HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtReportTitle" Text="CÔNG THỨC ĐỊNH LƯỢNG" 
                                           FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"
                                           TextAlignment="Center" Foreground="#000"/>
                                <TextBlock x:Name="TxtSubtitle" Text="Nhóm hàng: Tất cả" 
                                           FontSize="11.5" HorizontalAlignment="Center" Margin="0,4,0,0"
                                           TextAlignment="Center" Foreground="#222"/>
                            </StackPanel>

                            <!-- 2. Bảng Dữ Liệu Báo Cáo -->
                            <StackPanel x:Name="TableContainer" Grid.Row="2" Margin="0,0,0,20">
                                <!-- Bảng động được khởi tạo trong Code-Behind -->
                            </StackPanel>

                            <!-- 3. Chữ Ký Footer -->
                            <Grid Grid.Row="3" Margin="0,25,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Trưởng phòng -->
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="Trưởng phòng" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="(Ký, họ tên)" FontSize="10" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Người lập -->
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="Người lập" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="(Ký, họ tên)" FontSize="10" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    
        <!-- Inline Du Lieu Tho Panel -->
        <Border x:Name="InlineDataBorder" Grid.Row="3" Visibility="Collapsed"
                Background="#f8fafc" BorderBrush="#4a90d9" BorderThickness="0,2,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="260"/>
                </Grid.RowDefinitions>
                <!-- Header -->
                <Border Grid.Row="0" Background="#1e3a5f" Padding="12,6">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="&#128203; Dữ liệu thô - Dữ liệu hiển thị trong báo cáo" Foreground="White"
                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button x:Name="BtnDongDuLieuTho" DockPanel.Dock="Right" Content="&#x2715; Dong"
                                Click="BtnDongDuLieuTho_Click" Background="#c0392b" Foreground="White"
                                BorderThickness="0" Padding="10,4" FontWeight="SemiBold" Cursor="Hand"/>
                        <TextBlock x:Name="TxtSoBanGhi" DockPanel.Dock="Right" Foreground="#aaccee"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    </DockPanel>
                </Border>
                <!-- DataGrid -->
                <DataGrid x:Name="InlineDataGrid" Grid.Row="1"
                          IsReadOnly="True" AutoGenerateColumns="True"
                          CanUserSortColumns="True" CanUserResizeColumns="True"
                          GridLinesVisibility="All"
                          AlternatingRowBackground="#edf2f9"
                          HeadersVisibility="Column"
                          FontSize="12" Margin="0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
