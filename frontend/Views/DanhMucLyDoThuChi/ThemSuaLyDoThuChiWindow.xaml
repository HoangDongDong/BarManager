<Window x:Class="QuanLyBar.Client.Views.DanhMucLyDoThuChi.ThemSuaLyDoThuChiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LÝ DO THU CHI - THÊM MỚI" Height="410" Width="470"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#dbe6f3" WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <!-- Style Toolbar Button -->
        <Style x:Key="SubToolbarBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#fff0b3"/>
                    <Setter Property="BorderBrush" Value="#f5a623"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Footer Button -->
        <Style x:Key="ActionBtnStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="75"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#a0b8d4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e6f0fa"/>
                    <Setter Property="BorderBrush" Value="#6495ed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0. Header -->
            <RowDefinition Height="Auto"/> <!-- 1. Sub Toolbar -->
            <RowDefinition Height="*"/>    <!-- 2. Form content -->
            <RowDefinition Height="Auto"/> <!-- 3. Footer -->
        </Grid.RowDefinitions>

        <!-- 0. HEADER -->
        <Border Grid.Row="0" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Icon Mũi tên xanh + Đồng xu $ -->
                <Grid Width="34" Height="34" Margin="0,0,10,0">
                    <Path Data="M 12,2 L 24,14 L 18,14 L 18,24 L 6,24 L 6,14 L 0,14 Z" Fill="#4fc1e9" Stroke="#3bafda" StrokeThickness="1"/>
                    <Border Width="18" Height="18" Background="#e6af2e" BorderBrush="#c28c1b" BorderThickness="1.5" CornerRadius="9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2">
                        <TextBlock Text="$" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
                <TextBlock Text="Lý do thu chi" FontWeight="Bold" FontSize="13.5" Foreground="#0f172a" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 1. SUB TOOLBAR -->
        <Border Grid.Row="1" Background="#e2ecf8" BorderBrush="#cbd5e1" BorderThickness="0,0,0,1" Padding="4,2">
            <StackPanel Orientation="Horizontal">
                <!-- Phím tắt -->
                <Button Style="{StaticResource SubToolbarBtnStyle}" Margin="2,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="↗️" FontSize="10" Foreground="#2980b9" Margin="0,0,3,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Phím tắt ▾" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Separator Width="1" Background="#b0c4de" Margin="3,2"/>
                <!-- Trước (F10) -->
                <Button x:Name="BtnPrevious" Style="{StaticResource SubToolbarBtnStyle}" Click="BtnPrevious_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⬅️" FontSize="10" Foreground="#2980b9" Margin="0,0,3,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Trước (F10)" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!-- Sau (F11) -->
                <Button x:Name="BtnNext" Style="{StaticResource SubToolbarBtnStyle}" Click="BtnNext_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➡️" FontSize="10" Foreground="#2980b9" Margin="0,0,3,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Sau (F11)" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Separator Width="1" Background="#b0c4de" Margin="3,2"/>
                <!-- Tạo mới -->
                <Button x:Name="BtnTaoMoi" Style="{StaticResource SubToolbarBtnStyle}" Click="BtnTaoMoi_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➕" FontSize="10" Foreground="#27ae60" Margin="0,0,3,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Tạo mới" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- 2. FORM CONTENT -->
        <Border Grid.Row="2" Background="#f0f4fa" Margin="8,8,8,6" BorderBrush="#b6cadf" BorderThickness="1" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="75"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="38"/>
                    <ColumnDefinition Width="65"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Tên lý do & Ảnh -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Tên lý do" VerticalAlignment="Center" FontSize="11.5" Foreground="#1e293b"/>
                <TextBox x:Name="TxtName" Grid.Row="0" Grid.Column="1" Height="23" Background="#eaf5ff" BorderBrush="#7faadc" VerticalContentAlignment="Center" Padding="4,1" FontSize="12"/>
                
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Ảnh:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0" FontSize="11.5"/>
                <ComboBox x:Name="CboIcon" Grid.Row="0" Grid.Column="3" Height="23" Background="White" BorderBrush="#7faadc" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="&lt;Không&gt;" IsSelected="True"/>
                    <!-- Nhóm Số -->
                    <ComboBoxItem Content="0️⃣ 0"/>
                    <ComboBoxItem Content="1️⃣ 1"/>
                    <ComboBoxItem Content="2️⃣ 2"/>
                    <ComboBoxItem Content="3️⃣ 3"/>
                    <ComboBoxItem Content="4️⃣ 4"/>
                    <ComboBoxItem Content="5️⃣ 5"/>
                    <ComboBoxItem Content="6️⃣ 6"/>
                    <ComboBoxItem Content="7️⃣ 7"/>
                    <ComboBoxItem Content="8️⃣ 8"/>
                    <ComboBoxItem Content="9️⃣ 9"/>
                    <ComboBoxItem Content="🔟 10"/>
                    <!-- Nhóm Người -->
                    <ComboBoxItem Content="👤 Người 1"/>
                    <ComboBoxItem Content="👥 Người 2"/>
                    <ComboBoxItem Content="🧑‍💼 Người 3"/>
                    <ComboBoxItem Content="👨‍💼 Người 4"/>
                    <!-- Nhóm Nhãn -->
                    <ComboBoxItem Content="🏷️ Đặt trước"/>
                    <ComboBoxItem Content="📁 Thư mục"/>
                    <ComboBoxItem Content="➖ Phân cách"/>
                </ComboBox>

                <!-- Row 1: Checkbox Là lý do thu & Là lý do chi -->
                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkLaLyDoThu" Content="Là lý do thu" Margin="0,0,25,0" VerticalAlignment="Center" FontSize="11.5" Checked="ChkLaLyDoThu_Checked"/>
                    <CheckBox x:Name="ChkLaLyDoChi" Content="Là lý do chi" IsChecked="True" VerticalAlignment="Center" FontSize="11.5" Checked="ChkLaLyDoChi_Checked"/>
                </StackPanel>

                <!-- Row 2: Loại -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Loại:" VerticalAlignment="Center" FontSize="11.5" Foreground="#1e293b"/>
                <ComboBox x:Name="CboLoai" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Height="23" Background="White" BorderBrush="#7faadc"
                          VerticalContentAlignment="Center" FontSize="11.5">
                    <ComboBoxItem Content="Không lên báo cáo kết quả kinh doanh" Tag="-1" IsSelected="True"/>
                    <ComboBoxItem Content="Chi phí cố định (chi phí phát sinh hàng tháng)" Tag="1"/>
                    <ComboBoxItem Content="Chi phí khác" Tag="2"/>
                </ComboBox>

                <!-- Row 3: Ghi chú -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Ghi chú" VerticalAlignment="Top" Margin="0,5,0,0" FontSize="11.5" Foreground="#1e293b"/>
                <TextBox x:Name="TxtGhiChu" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Background="White" BorderBrush="#7faadc"
                         VerticalContentAlignment="Top" Padding="4,3" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,3,0,0" FontSize="12"/>
            </Grid>
        </Border>

        <!-- 3. FOOTER -->
        <Border Grid.Row="3" Background="#dbe6f3" Padding="8,5,10,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- Nút Lưu -->
                <Button x:Name="BtnLuu" Style="{StaticResource ActionBtnStyle}" Click="BtnLuu_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💾" FontSize="11" Margin="0,0,3,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Lưu" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!-- Nút Lưu & Mới -->
                <Button x:Name="BtnLuuVaMoi" Content="Lưu &amp; Mới" Style="{StaticResource ActionBtnStyle}" Click="BtnLuuVaMoi_Click"/>
                <!-- Nút Lưu & thoát (Viền xanh) -->
                <Button x:Name="BtnLuuVaThoat" Content="Lưu &amp; thoát" Style="{StaticResource ActionBtnStyle}" BorderBrush="#0078d7" BorderThickness="1.5" FontWeight="SemiBold" Click="BtnLuuVaThoat_Click"/>
                <!-- Nút Thoát -->
                <Button Content="Thoát" Style="{StaticResource ActionBtnStyle}" Click="BtnThoat_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
