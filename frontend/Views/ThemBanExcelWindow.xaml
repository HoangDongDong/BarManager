<Window x:Class="QuanLyBar.Client.Views.ThemBanExcelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm nhanh" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#f0f4f9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Margin="10,5">
            <TextBlock Text="📁" FontSize="20" Margin="0,0,10,0"/>
            <TextBlock Text="Mời bạn điền danh sách Bàn vào lưới phía dưới." VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: DataGrid and Toolbar -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ToolBar Grid.Row="0" Background="#dfe7f5" Padding="2">
                    <TextBlock Text="Số dòng" VerticalAlignment="Center" Margin="5,0"/>
                    <TextBox x:Name="TxtSoDong" Text="1" Width="40" Margin="0,0,5,0" TextAlignment="Center" VerticalContentAlignment="Center"/>
                    <Button x:Name="BtnThemDuLieu" Padding="5,2" Click="BtnThemDuLieu_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕" Foreground="Green" Margin="0,0,5,0"/>
                            <TextBlock Text="Thêm dữ liệu"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnXoaDuLieu" Padding="5,2" Click="BtnXoaDuLieu_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="❌" Foreground="Red" Margin="0,0,5,0"/>
                            <TextBlock Text="Xóa dữ liệu"/>
                        </StackPanel>
                    </Button>
                    <Separator/>
                    <Button x:Name="BtnDanDuLieu" Padding="5,2" Click="BtnDanDuLieu_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" Margin="0,0,5,0"/>
                            <TextBlock Text="Dán dữ liệu"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnChonFileExcel" Padding="5,2" Click="BtnChonFileExcel_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" Foreground="Green" Margin="0,0,5,0"/>
                            <TextBlock Text="Chọn file Excel"/>
                        </StackPanel>
                    </Button>
                </ToolBar>

                <DataGrid x:Name="DgThemNhanh" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" Background="White" RowHeaderWidth="25">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tên bàn" Binding="{Binding Name}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Right Panel: Common Properties -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Border Background="#dfe7f5" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Các thuộc tính chung" Foreground="Red" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>

                        <!-- Tên bàn -->
                        <CheckBox Grid.Row="1" Grid.Column="0" IsEnabled="False" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Tên bàn:" VerticalAlignment="Center" Foreground="Gray"/>
                        <TextBox Grid.Row="1" Grid.Column="2" IsEnabled="False" Margin="5,2" Background="#f0f0f0"/>

                        <!-- Khu vực -->
                        <CheckBox x:Name="ChkKhuVuc" Grid.Row="2" Grid.Column="0" IsChecked="True" VerticalAlignment="Center" Margin="0,0,5,0" Checked="ChkColumn_CheckedChanged" Unchecked="ChkColumn_CheckedChanged"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Khu vực:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CboKhuVuc" Grid.Row="2" Grid.Column="2" Margin="5,2" DisplayMemberPath="Name" SelectedValuePath="Id"/>

                        <!-- Nhóm hiển thị -->
                        <CheckBox x:Name="ChkNhomHienThi" Grid.Row="3" Grid.Column="0" IsChecked="True" VerticalAlignment="Center" Margin="0,0,5,0" Checked="ChkColumn_CheckedChanged" Unchecked="ChkColumn_CheckedChanged"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Nhóm hiển thị:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CboNhomHienThi" Grid.Row="3" Grid.Column="2" Margin="5,2" DisplayMemberPath="Name" SelectedValuePath="Id"/>

                        <!-- Loại phòng -->
                        <CheckBox x:Name="ChkLoaiPhong" Grid.Row="4" Grid.Column="0" IsChecked="True" VerticalAlignment="Center" Margin="0,0,5,0" Checked="ChkColumn_CheckedChanged" Unchecked="ChkColumn_CheckedChanged"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="Loại phòng:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CboLoaiPhong" Grid.Row="4" Grid.Column="2" Margin="5,2" DisplayMemberPath="Name" SelectedValuePath="Id"/>

                        <!-- Ghi chú -->
                        <CheckBox x:Name="ChkGhiChu" Grid.Row="5" Grid.Column="0" IsChecked="True" VerticalAlignment="Center" Margin="0,0,5,0" Checked="ChkColumn_CheckedChanged" Unchecked="ChkColumn_CheckedChanged"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="Ghi chú:" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtGhiChu" Grid.Row="5" Grid.Column="2" Margin="5,2"/>

                        <!-- Bảng giá -->
                        <CheckBox x:Name="ChkBangGia" Grid.Row="6" Grid.Column="0" IsChecked="True" VerticalAlignment="Center" Margin="0,0,5,0" Checked="ChkColumn_CheckedChanged" Unchecked="ChkColumn_CheckedChanged"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="Bảng giá:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CboBangGia" Grid.Row="6" Grid.Column="2" Margin="5,2" DisplayMemberPath="Name" SelectedValuePath="Id"/>

                        <!-- Đơn giá -->
                        <CheckBox x:Name="ChkDonGia" Grid.Row="7" Grid.Column="0" IsChecked="True" VerticalAlignment="Center" Margin="0,0,5,0" Checked="ChkColumn_CheckedChanged" Unchecked="ChkColumn_CheckedChanged"/>
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="Đơn giá:" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtDonGia" Grid.Row="7" Grid.Column="2" Margin="5,2" Text="0"/>

                        <!-- Tiền mở bàn -->
                        <CheckBox x:Name="ChkTienMoBan" Grid.Row="8" Grid.Column="0" IsChecked="True" VerticalAlignment="Center" Margin="0,0,5,0" Checked="ChkColumn_CheckedChanged" Unchecked="ChkColumn_CheckedChanged"/>
                        <TextBlock Grid.Row="8" Grid.Column="1" Text="Tiền mở bàn:" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtTienMoBan" Grid.Row="8" Grid.Column="2" Margin="5,2" Text="0"/>
                    </Grid>
                </Border>
            </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#f0f0f0" Padding="10,5" BorderBrush="LightGray" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnXoaBanLoi" Content="Xóa bàn lỗi" Padding="10,5" Background="White" Click="BtnXoaBanLoi_Click"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Chấp nhận" Padding="15,5" Margin="0,0,10,0" FontWeight="Bold" Click="BtnChapNhan_Click"/>
                    <Button Content="Hủy bỏ" Padding="15,5" Click="BtnHuyBo_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
