<UserControl x:Class="QuanLyBar.Client.Views.BaoCaoCongNo.BaoCaoDoiChieuCongNoNccControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100" Background="#f4f7fa" Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3a7afe"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563eb"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#cbd5e1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e2e8f0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Thanh Lọc 1 -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Thanh Thao Tác -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Khung Báo Cáo A4 -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 0. Thanh Lọc 1 -->
        <Border Grid.Row="0" Background="#e9f0f8" Padding="8,5" BorderBrush="#b6c1cd" BorderThickness="0,0,0,1">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Từ ngày:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="4,0,4,0" Foreground="#222"/>
                <DatePicker x:Name="DpTuNgay" Width="110" Height="24" Margin="0,0,10,0" SelectedDateChanged="Filter_Changed"/>

                <TextBlock Text="Đến ngày:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="4,0,4,0" Foreground="#222"/>
                <DatePicker x:Name="DpDenNgay" Width="110" Height="24" Margin="0,0,14,0" SelectedDateChanged="Filter_Changed"/>

                <TextBlock Text="Nhà cung cấp:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="4,0,4,0" Foreground="#222"/>
                <ComboBox x:Name="CboNhaCungCap" Width="200" Height="24" Margin="0,0,14,0" SelectionChanged="Filter_Changed" Background="White">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2,1">
                                <TextBlock Text="{Binding Icon}" Margin="0,0,5,0" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button x:Name="BtnRefresh" Style="{StaticResource FlatButtonStyle}" Click="BtnRefresh_Click" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄" Margin="0,0,4,0" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="Tải dữ liệu (F5)" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Border>

        <!-- 1. Thanh Thao Tác -->
        <Border Grid.Row="1" Background="#d5e0f0" Padding="6,3" BorderBrush="#b6c1cd" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border Background="#fff9c4" BorderBrush="#c2b067" BorderThickness="1" CornerRadius="2" Padding="2,0" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" Margin="4,0,4,0" VerticalAlignment="Center" FontSize="11"/>
                            <TextBlock Text="Lọc (F3):" VerticalAlignment="Center" Margin="0,0,4,0" FontWeight="SemiBold" Foreground="#333"/>
                            <TextBox x:Name="TxtFilter" Width="140" Height="20" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" TextChanged="TxtFilter_TextChanged"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnPreview" Style="{StaticResource ActionButtonStyle}" Click="BtnPreview_Click" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" Margin="0,0,4,0" FontSize="11"/>
                            <TextBlock Text="Xem (Ctrl + Shift + P)" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnPrint" Style="{StaticResource ActionButtonStyle}" Click="BtnPrint_Click" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨️" Margin="0,0,4,0" FontSize="11"/>
                            <TextBlock Text="In (Ctrl + P)" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnExportExcel" Style="{StaticResource ActionButtonStyle}" Click="BtnExportExcel_Click" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" Margin="0,0,4,0" FontSize="11" Foreground="#1e7145"/>
                            <TextBlock Text="(F12)" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Khung Tờ In Báo Cáo A4 -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#5280b8">
            <Grid Margin="20">
                <!-- Tờ giấy A4 -->
                <Border x:Name="ReportPaper" Background="White" Width="760" MinHeight="980" Padding="35,30" HorizontalAlignment="Center" VerticalAlignment="Top" CornerRadius="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Color="#222222" Direction="270" Opacity="0.3" ShadowDepth="4"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- 0: Header Đơn vị -->
                            <RowDefinition Height="Auto"/>
                            <!-- 1: Tiêu đề Báo cáo & Thời gian -->
                            <RowDefinition Height="Auto"/>
                            <!-- 2: Nội dung chi tiết Mua - Trả & Thanh toán -->
                            <RowDefinition Height="*"/>
                            <!-- 3: Khung Tổng Hợp -->
                            <RowDefinition Height="Auto"/>
                            <!-- 4: Chữ ký -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header Đơn vị & Logo -->
                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Image x:Name="ImgLogo" Grid.Column="0" Width="80" Height="80" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Uniform" Visibility="Collapsed"/>
                            <Viewbox x:Name="VbDefaultLogo" Grid.Column="0" Width="75" Height="75" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Grid Width="100" Height="100">
                                    <Border Background="#F8FAFC" BorderBrush="#007ACC" BorderThickness="2" CornerRadius="50" Width="96" Height="96"/>
                                    <Canvas Width="100" Height="100">
                                        <Path Fill="#007ACC" Data="M 32,24 L 32,42 C 32,46 36,49 40,49 L 40,78 L 44,78 L 44,49 C 48,49 52,46 52,42 L 52,24 L 48,24 L 48,38 L 45,38 L 45,24 L 43,24 L 43,38 L 41,38 L 41,24 L 39,24 L 39,38 L 36,38 L 36,24 Z"/>
                                        <Path Fill="#2C3E50" Data="M 58,24 C 64,24 68,32 68,44 L 62,44 L 62,78 L 58,78 Z"/>
                                    </Canvas>
                                </Grid>
                            </Viewbox>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtCompanyName" Text="NÀNG HƯƠNG QUÁN" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#111" Margin="0,0,0,2"/>
                                <TextBlock x:Name="TxtCompanyAddress" Text="Địa chỉ: Số 28 Giang Văn Minh - Đội Cấn - Ba Đình - Hà Nội" FontSize="10.5" HorizontalAlignment="Right" Foreground="#333" Margin="0,0,0,2"/>
                                <TextBlock x:Name="TxtCompanyContact" Text="Điện thoại: 0909090880, Email:" FontSize="10.5" HorizontalAlignment="Right" Foreground="#333"/>
                            </StackPanel>
                        </Grid>

                        <!-- Tiêu đề Báo cáo -->
                        <Grid Grid.Row="1" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                                <TextBlock x:Name="TxtSubTitleDate" Text="Từ ngày 01/09/2026 Đến ngày 08/09/2026" FontSize="11.5" Foreground="#111" Margin="0,0,0,2"/>
                                <TextBlock x:Name="TxtFilterSummary" Text="Nhà cung cấp: ..." FontSize="11" FontWeight="SemiBold" Foreground="#111"/>
                            </StackPanel>

                            <TextBlock x:Name="TxtReportTitle" Grid.Column="1" Text="ĐỐI CHIẾU CÔNG NỢ NHÀ CUNG CẤP" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#000"/>
                        </Grid>

                        <!-- Nội dung Chi tiết Mua - Trả -->
                        <StackPanel Grid.Row="2" Margin="0,0,0,15">
                            <TextBlock Text="MUA - TRẢ" FontWeight="Bold" FontSize="12.5" Foreground="#000" Margin="0,0,0,6"/>

                            <Border BorderBrush="#444" BorderThickness="1">
                                <StackPanel>
                                    <!-- Table Header -->
                                    <Grid Background="#f0f0f0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="55"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" BorderBrush="#888" BorderThickness="0,0,1,1" Padding="4">
                                            <TextBlock Text="STT" FontWeight="Bold" HorizontalAlignment="Center" FontSize="11"/>
                                        </Border>
                                        <Border Grid.Column="1" BorderBrush="#888" BorderThickness="0,0,1,1" Padding="4">
                                            <TextBlock Text="Mã hàng" FontWeight="Bold" HorizontalAlignment="Center" FontSize="11"/>
                                        </Border>
                                        <Border Grid.Column="2" BorderBrush="#888" BorderThickness="0,0,1,1" Padding="4">
                                            <TextBlock Text="Tên hàng" FontWeight="Bold" HorizontalAlignment="Center" FontSize="11"/>
                                        </Border>
                                        <Border Grid.Column="3" BorderBrush="#888" BorderThickness="0,0,1,1" Padding="4">
                                            <TextBlock Text="ĐVT" FontWeight="Bold" HorizontalAlignment="Center" FontSize="11"/>
                                        </Border>
                                        <Border Grid.Column="4" BorderBrush="#888" BorderThickness="0,0,1,1" Padding="4">
                                            <TextBlock Text="Số lượng" FontWeight="Bold" HorizontalAlignment="Center" FontSize="11"/>
                                        </Border>
                                        <Border Grid.Column="5" BorderBrush="#888" BorderThickness="0,0,1,1" Padding="4">
                                            <TextBlock Text="Đơn giá" FontWeight="Bold" HorizontalAlignment="Center" FontSize="11"/>
                                        </Border>
                                        <Border Grid.Column="6" BorderBrush="#888" BorderThickness="0,0,0,1" Padding="4">
                                            <TextBlock Text="Thành tiền" FontWeight="Bold" HorizontalAlignment="Center" FontSize="11"/>
                                        </Border>
                                    </Grid>

                                    <!-- Rows container -->
                                    <StackPanel x:Name="StkDataRows"/>
                                </StackPanel>
                            </Border>

                            <!-- Phần THANH TOÁN (Phiếu chi) -->
                            <TextBlock x:Name="LblThanhToanSection" Text="THANH TOÁN" FontWeight="Bold" FontSize="12.5" Foreground="#000" Margin="0,15,0,6"/>
                            <Border x:Name="BrdThanhToan" BorderBrush="#444" BorderThickness="1">
                                <StackPanel>
                                    <Grid Background="#f0f0f0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" BorderBrush="#888" BorderThickness="0,0,1,1" Padding="4">
                                            <TextBlock Text="STT" FontWeight="Bold" HorizontalAlignment="Center" FontSize="11"/>
                                        </Border>
                                        <Border Grid.Column="1" BorderBrush="#888" BorderThickness="0,0,1,1" Padding="4">
                                            <TextBlock Text="Số phiếu chi" FontWeight="Bold" HorizontalAlignment="Center" FontSize="11"/>
                                        </Border>
                                        <Border Grid.Column="2" BorderBrush="#888" BorderThickness="0,0,1,1" Padding="4">
                                            <TextBlock Text="Ngày" FontWeight="Bold" HorizontalAlignment="Center" FontSize="11"/>
                                        </Border>
                                        <Border Grid.Column="3" BorderBrush="#888" BorderThickness="0,0,1,1" Padding="4">
                                            <TextBlock Text="Diễn giải" FontWeight="Bold" HorizontalAlignment="Center" FontSize="11"/>
                                        </Border>
                                        <Border Grid.Column="4" BorderBrush="#888" BorderThickness="0,0,0,1" Padding="4">
                                            <TextBlock Text="Số tiền chi" FontWeight="Bold" HorizontalAlignment="Center" FontSize="11"/>
                                        </Border>
                                    </Grid>
                                    <StackPanel x:Name="StkPaymentRows"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Khung TỔNG HỢP (Nợ đầu kỳ, Mua trong kỳ, Thanh toán trong kỳ, Nợ cuối kỳ) -->
                        <Grid Grid.Row="3" Margin="0,10,0,25">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="320"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="1" BorderBrush="#333" BorderThickness="0,1,0,1" Padding="6,8">
                                <StackPanel>
                                    <TextBlock Text="TỔNG HỢP" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                                    <Grid Margin="0,2">
                                        <TextBlock Text="NỢ ĐẦU KỲ" FontWeight="Bold" FontSize="11"/>
                                        <TextBlock x:Name="TxtNoDauKy" Text="0" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <TextBlock Text="PHÁT SINH MUA TRONG KỲ" FontWeight="Bold" FontSize="11"/>
                                        <TextBlock x:Name="TxtPhatSinhMua" Text="0" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <TextBlock Text="THANH TOÁN TRONG KỲ" FontWeight="Bold" FontSize="11"/>
                                        <TextBlock x:Name="TxtThanhToan" Text="0" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <TextBlock Text="NỢ CUỐI KỲ" FontWeight="Bold" FontSize="12" Foreground="#c00"/>
                                        <TextBlock x:Name="TxtNoCuoiKy" Text="0" FontWeight="Bold" HorizontalAlignment="Right" FontSize="12" Foreground="#c00"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Chữ ký -->
                        <Grid Grid.Row="4" Margin="0,10,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center" Margin="0,0,30,0">
                                <TextBlock x:Name="TxtSignDate" Text="Ngày 08 tháng 09 năm 2026" FontStyle="Italic" FontSize="11" HorizontalAlignment="Center" Foreground="#333" Margin="0,0,0,4"/>
                                <TextBlock Text="Người lập" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Foreground="#111"/>
                                <TextBlock Text="(Ký, họ tên)" FontStyle="Italic" FontSize="10.5" HorizontalAlignment="Center" Foreground="#666" Margin="0,2,0,50"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
