<UserControl x:Class="QuanLyBar.Client.Views.BaoCaoBanHang.BaoCaoTongHopBanTheoKhachHangControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1200"
             Background="#759dc9" FontFamily="Segoe UI" FontSize="12"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#a4b8cc"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#e6f2ff"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#70a0d0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#cce4ff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#d0e4f7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#b8d5f0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Thanh Lọc 1 -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Thanh Lọc 2 -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Khung Hiển Thị Báo Cáo Trang A4 -->
            <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <!-- 0. Thanh Lọc 1 -->
        <Border Grid.Row="0" Background="#e3eaf5" Padding="6,4" BorderBrush="#b6c1cd" BorderThickness="0,0,0,1">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Ngày" VerticalAlignment="Center" FontWeight="SemiBold" Margin="4,0,3,0" Foreground="#222"/>
                <TextBlock Text="Từ:" VerticalAlignment="Center" Margin="2,0,4,0" Foreground="#333"/>
                <DatePicker x:Name="DpTuNgay" Width="105" Height="24" Margin="0,0,6,0" SelectedDateChanged="Filter_Changed"/>
                <TextBlock Text="Đến" VerticalAlignment="Center" Margin="2,0,4,0" Foreground="#333"/>
                <DatePicker x:Name="DpDenNgay" Width="105" Height="24" Margin="0,0,12,0" SelectedDateChanged="Filter_Changed"/>

                <!-- Khách hàng -->
                <TextBlock Text="Khách hàng" VerticalAlignment="Center" FontWeight="SemiBold" Margin="4,0,5,0" Foreground="#222"/>
                <ComboBox x:Name="CboKhachHang" Width="140" Height="24" Margin="0,0,12,0" SelectionChanged="Filter_Changed" Background="White"/>

                <!-- Kho xuất -->
                <TextBlock Text="Kho xuất" VerticalAlignment="Center" FontWeight="SemiBold" Margin="4,0,5,0" Foreground="#222"/>
                <ComboBox x:Name="CboKhoXuat" Width="140" Height="24" Margin="0,0,12,0" SelectionChanged="Filter_Changed" Background="White"/>

                <!-- Nhân viên xuất -->
                <TextBlock Text="Nhân viên xuất" VerticalAlignment="Center" FontWeight="SemiBold" Margin="4,0,5,0" Foreground="#222"/>
                <ComboBox x:Name="CboNhanVienXuat" Width="140" Height="24" Margin="0,0,14,0" SelectionChanged="Filter_Changed" Background="White"/>

                <!-- Nút Refresh -->
                <Button x:Name="BtnRefresh" Style="{StaticResource FlatButtonStyle}" Click="BtnRefresh_Click" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄" Margin="0,0,4,0" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="Tải dữ liệu (F5)" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Border>

        <!-- 1. Thanh Lọc 2 & Thao tác -->
        <Border Grid.Row="1" Background="#f0f4f9" Padding="6,3" BorderBrush="#b6c1cd" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#ffffff" BorderBrush="#a4b8cc" BorderThickness="1" CornerRadius="2" Padding="4,1" Height="24" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔍" FontSize="11" Foreground="#666" Margin="2,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Lọc (F3):" VerticalAlignment="Center" Foreground="#444" Margin="0,0,4,0"/>
                            <TextBox x:Name="TxtFilter" Width="130" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" TextChanged="TxtFilter_TextChanged"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnXem" Style="{StaticResource ActionButtonStyle}" Click="BtnXem_Click" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📄" Margin="0,0,4,0" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="Xem (Ctrl + Shift + P)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnIn" Style="{StaticResource ActionButtonStyle}" Click="BtnIn_Click" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨️" Margin="0,0,4,0" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="In (Ctrl + P)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnExportExcel" Style="{StaticResource ActionButtonStyle}" Click="BtnExportExcel_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" Margin="0,0,4,0" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="(F12)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <Separator Width="1" Height="16" Margin="6,0" Background="#b0c4de"/>

                    <Button x:Name="BtnThietKeMau" Style="{StaticResource ActionButtonStyle}" Click="BtnThietKeMau_Click" ToolTip="Thiết kế mẫu bao cao" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#127912;" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Thiết kế mẫu" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Separator Width="1" Height="16" Margin="6,0" Background="#b0c4de"/>

                    <Button x:Name="BtnThamSoTuyChinh" Style="{StaticResource ActionButtonStyle}" Click="BtnThamSoTuyChinh_Click" ToolTip="Tham số tùy chỉnh báo cáo" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#9881;" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Tham số" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Separator Width="1" Height="16" Margin="6,0" Background="#b0c4de"/>

                    <Button x:Name="BtnXemDuLieuTho" Style="{StaticResource ActionButtonStyle}" Click="BtnXemDuLieuTho_Click" ToolTip="Xem du lieu tho dang luoi" Margin="0,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#128203;" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Dữ liệu thô" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Khung Tờ In Báo Cáo A4 -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#759dc9" Padding="20">
            <Border x:Name="ReportPaper" Width="800" MinHeight="1050" Background="White" Margin="0,0,0,20" Padding="40,30,40,40" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.3" Direction="270" ShadowDepth="4"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header quán & Logo -->
                        <RowDefinition Height="Auto"/> <!-- Title & Subtitle ngày -->
                        <RowDefinition Height="*"/>    <!-- Bảng dữ liệu -->
                        <RowDefinition Height="Auto"/> <!-- Chữ ký -->
                    </Grid.RowDefinitions>

                    <!-- Header thông tin quán & Logo -->
                    <Grid x:Name="GridCompanyHeader" Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ColLogo" Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Logo bên trái -->
                        <Border x:Name="BrdLogo" Grid.Column="0" Width="80" Height="80" HorizontalAlignment="Left" VerticalAlignment="Top" ClipToBounds="True">
                            <Grid>
                                <Image x:Name="ImgLogo" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <Viewbox x:Name="VbDefaultLogo" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid Width="100" Height="100">
                                        <Border Background="#F8FAFC" BorderBrush="#007ACC" BorderThickness="2" CornerRadius="50" Width="96" Height="96"/>
                                        <Canvas Width="100" Height="100">
                                            <!-- Fork -->
                                            <Path Fill="#007ACC" Data="M 32,24 L 32,42 C 32,46 36,49 40,49 L 40,78 L 44,78 L 44,49 C 48,49 52,46 52,42 L 52,24 L 48,24 L 48,38 L 45,38 L 45,24 L 43,24 L 43,38 L 41,38 L 41,24 L 39,24 L 39,38 L 36,38 L 36,24 Z"/>
                                            <!-- Knife -->
                                            <Path Fill="#2C3E50" Data="M 58,24 C 64,24 68,32 68,44 L 62,44 L 62,78 L 58,78 Z"/>
                                        </Canvas>
                                    </Grid>
                                </Viewbox>
                            </Grid>
                        </Border>

                        <!-- Thông tin nhà hàng bên phải -->
                        <StackPanel x:Name="PnlCompanyText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtCompanyName" Text="NÀNG HƯƠNG QUÁN" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#111" Margin="0,0,0,2"/>
                            <TextBlock x:Name="TxtCompanyAddress" Text="Địa chỉ: Số 28 Giang Văn Minh - Đội Cấn - Ba Đình - Hà Nội" FontSize="10.5" HorizontalAlignment="Right" Foreground="#333" Margin="0,0,0,2"/>
                            <TextBlock x:Name="TxtCompanyContact" Text="Điện thoại: 0909090880, Email:" FontSize="10.5" HorizontalAlignment="Right" Foreground="#333"/>
                        </StackPanel>
                    </Grid>

                    <!-- Tiêu đề báo cáo -->
                    <Grid x:Name="GridReportTitleArea" Grid.Row="1" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ColTitleLeft" Width="*"/>
                            <ColumnDefinition x:Name="ColTitleRight" Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="PnlDateAndFilter" Grid.Column="0" VerticalAlignment="Bottom">
                            <TextBlock x:Name="TxtSubTitleDate" Text="Ngày từ 08/08/2026 đến 07/09/2026" FontSize="11.5" HorizontalAlignment="Left" Foreground="#111" Margin="0,0,0,2"/>
                            <TextBlock x:Name="TxtFilterSummary" Text="Khách hàng: Tất cả | Kho xuất: Tất cả | NV xuất: Tất cả" FontSize="10.5" FontStyle="Italic" HorizontalAlignment="Left" Foreground="#444" Margin="0,0,0,8"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtReportTitle" Grid.Column="1" Text="TỔNG HỢP BÁN THEO KHÁCH HÀNG" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#000"/>
                    </Grid>

                    <!-- Bảng dữ liệu chính -->
                    <DockPanel Grid.Row="2" LastChildFill="True">
                        <!-- Table Header -->
                        <Border DockPanel.Dock="Top" Background="#ffffff" BorderBrush="#000000" BorderThickness="1,1,1,1">
                            <Grid Height="28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="45"/>  <!-- STT -->
                                    <ColumnDefinition Width="100"/> <!-- Mã khách -->
                                    <ColumnDefinition Width="180"/> <!-- Tên khách hàng -->
                                    <ColumnDefinition Width="*"/>   <!-- Địa chỉ -->
                                    <ColumnDefinition Width="110"/> <!-- Tiền hàng -->
                                    <ColumnDefinition Width="90"/>  <!-- Giảm giá -->
                                    <ColumnDefinition Width="120"/> <!-- Tổng cộng -->
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" BorderBrush="#000000" BorderThickness="0,0,1,0">
                                    <TextBlock Text="STT" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#000"/>
                                </Border>
                                <Border Grid.Column="1" BorderBrush="#000000" BorderThickness="0,0,1,0">
                                    <TextBlock Text="Mã khách" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#000"/>
                                </Border>
                                <Border Grid.Column="2" BorderBrush="#000000" BorderThickness="0,0,1,0">
                                    <TextBlock Text="Tên khách hàng" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#000"/>
                                </Border>
                                <Border Grid.Column="3" BorderBrush="#000000" BorderThickness="0,0,1,0">
                                    <TextBlock Text="Địa chỉ" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#000"/>
                                </Border>
                                <Border Grid.Column="4" BorderBrush="#000000" BorderThickness="0,0,1,0">
                                    <TextBlock Text="Tiền hàng" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#000"/>
                                </Border>
                                <Border Grid.Column="5" BorderBrush="#000000" BorderThickness="0,0,1,0">
                                    <TextBlock Text="Giảm giá" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#000"/>
                                </Border>
                                <Border Grid.Column="6">
                                    <TextBlock Text="Tổng cộng" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#000"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Summary Row (TỔNG CỘNG) -->
                        <Border x:Name="BorderSummary" DockPanel.Dock="Bottom" Background="#ffffff" BorderBrush="#000000" BorderThickness="1,0,1,1" Height="26">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="45"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Grid.ColumnSpan="4" BorderBrush="#000000" BorderThickness="0,0,1,0" Padding="0,0,10,0">
                                    <TextBlock Text="TỔNG CỘNG" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#000"/>
                                </Border>
                                <Border Grid.Column="4" BorderBrush="#000000" BorderThickness="0,0,1,0" Padding="4,0,4,0">
                                    <TextBlock x:Name="TxtTotalTienHang" Text="0" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#000"/>
                                </Border>
                                <Border Grid.Column="5" BorderBrush="#000000" BorderThickness="0,0,1,0" Padding="4,0,4,0">
                                    <TextBlock x:Name="TxtTotalGiamGia" Text="0" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#000"/>
                                </Border>
                                <Border Grid.Column="6" Padding="4,0,4,0">
                                    <TextBlock x:Name="TxtTotalTongCong" Text="0" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#000"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Dynamic Data Rows -->
                        <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="StkDataRows"/>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- Khối chữ ký cuối trang -->
                    <Grid x:Name="GridSignatures" Grid.Row="3" Margin="0,30,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="SigCol0" Width="*"/>
                            <ColumnDefinition x:Name="SigCol1" Width="*"/>
                            <ColumnDefinition x:Name="SigCol2" Width="0"/>
                            <ColumnDefinition x:Name="SigCol3" Width="0"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel x:Name="SigBlock0" Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="Trưởng phòng" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                            <TextBlock Text="(Ký, họ tên)" FontStyle="Italic" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel x:Name="SigBlock1" Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="Người lập" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                            <TextBlock Text="(Ký, họ tên)" FontStyle="Italic" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel x:Name="SigBlock2" Grid.Column="2" HorizontalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="Kế toán trưởng" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                            <TextBlock Text="(Ký, họ tên)" FontStyle="Italic" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel x:Name="SigBlock3" Grid.Column="3" HorizontalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="Giám đốc" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                            <TextBlock Text="(Ký, họ tên)" FontStyle="Italic" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </ScrollViewer>
    
        <!-- Inline Du Lieu Tho Panel -->
        <Border x:Name="InlineDataBorder" Grid.Row="3" Visibility="Collapsed"
                Background="#f8fafc" BorderBrush="#4a90d9" BorderThickness="0,2,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="260"/>
                </Grid.RowDefinitions>
                <!-- Header -->
                <Border Grid.Row="0" Background="#1e3a5f" Padding="12,6">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="&#128203; Dữ liệu thô - Dữ liệu hiển thị trong báo cáo" Foreground="White"
                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button x:Name="BtnDongDuLieuTho" DockPanel.Dock="Right" Content="&#x2715; Dong"
                                Click="BtnDongDuLieuTho_Click" Background="#c0392b" Foreground="White"
                                BorderThickness="0" Padding="10,4" FontWeight="SemiBold" Cursor="Hand"/>
                        <TextBlock x:Name="TxtSoBanGhi" DockPanel.Dock="Right" Foreground="#aaccee"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    </DockPanel>
                </Border>
                <!-- DataGrid -->
                <DataGrid x:Name="InlineDataGrid" Grid.Row="1"
                          IsReadOnly="True" AutoGenerateColumns="True"
                          CanUserSortColumns="True" CanUserResizeColumns="True"
                          GridLinesVisibility="All"
                          AlternatingRowBackground="#edf2f9"
                          HeadersVisibility="Column"
                          FontSize="12" Margin="0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
