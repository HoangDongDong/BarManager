<Window x:Class="QuanLyBar.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập" Height="320" Width="500" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#D5E3F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#333333">
            <TextBlock Text="PHẦN MỀM QUẢN LÝ NHÀ HÀNG" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0,0,0"/>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Logo -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Placeholder for Logo -->
                <!-- <Ellipse Width="80" Height="80" Fill="#FF6600"/> -->
                <!-- <TextBlock Text="TÂN AN PHÁT" Foreground="#FF6600" FontWeight="Bold" Margin="0,5,0,0" HorizontalAlignment="Center"/> -->
            </StackPanel>

            <!-- Form -->
            <Grid Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Người dùng:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,0,10"/>
                <TextBox x:Name="txtUsername" Text="Admin" Grid.Row="0" Grid.Column="1" Height="25" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

                <TextBlock Text="Mật khẩu:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,0,10"/>
                <PasswordBox x:Name="txtPassword" Grid.Row="1" Grid.Column="1" Height="25" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

                <CheckBox x:Name="chkRemember" Content="Ghi nhớ mật khẩu" Grid.Row="2" Grid.Column="1" Margin="0,0,0,5"/>
                <CheckBox x:Name="chkAutoLogin" Content="Tự động đăng nhập" Grid.Row="3" Grid.Column="1" Margin="0,0,0,5"/>
            </Grid>
        </Grid>

        <!-- Bottom section with Database link and Buttons -->
        <Grid Grid.Row="2" Margin="20,0,20,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock>
                    <Hyperlink Click="Hyperlink_Click">Cơ sở dữ liệu:</Hyperlink>
                </TextBlock>
                <TextBlock x:Name="lblDbName" Text="DEMO" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnLogin" Content="Đăng nhập" Width="90" Height="30" Margin="0,0,10,0" Background="White" Click="BtnLogin_Click"/>
                <Button x:Name="btnCancel" Content="Hủy bỏ" Width="90" Height="30" Background="White" Click="BtnCancel_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
