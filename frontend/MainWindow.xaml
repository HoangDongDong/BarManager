<Window x:Class="QuanLyBar.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập" 
        Icon="pack://application:,,,/img/logo.png"
        Height="315" Width="465" 
        WindowStartupLocation="CenterScreen" 
        ResizeMode="NoResize" 
        Background="#CADBF2">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="86"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>

        <!-- Header Banner Image -->
        <Image Grid.Row="0" Source="pack://application:,,,/img/Banner.png" Stretch="Fill" VerticalAlignment="Top"/>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="12,10,14,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Logo & Database -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Image x:Name="imgLogo" Grid.Row="0"
                       Source="pack://application:,,,/img/logo.png" 
                       Width="85" Height="85" 
                       Stretch="Uniform" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"
                       Cursor="Hand" 
                       ToolTip="Nhấp để chọn logo quán"
                       MouseLeftButtonDown="BorderLogo_MouseLeftButtonDown"/>

                <!-- Database selection link -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="4,0,0,4">
                    <TextBlock FontSize="12">
                        <Hyperlink Click="Hyperlink_Click" Foreground="#0033CC" TextDecorations="Underline">Cơ sở dữ liệu:</Hyperlink>
                    </TextBlock>
                    <TextBlock x:Name="lblDbName" Text="DEMO" Margin="8,0,0,0" FontSize="12" Foreground="Black" FontWeight="Normal" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Right: Login Form -->
            <Grid Grid.Column="1" Margin="8,4,4,0" VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Người dùng -->
                <TextBlock Text="Người dùng:" Grid.Row="0" Grid.Column="0" 
                           VerticalAlignment="Center" FontWeight="Bold" FontSize="12" 
                           Foreground="Black" Margin="0,0,4,8"/>
                <TextBox x:Name="txtUsername" Text="admin" Grid.Row="0" Grid.Column="1" 
                         Height="24" Margin="0,0,0,8" VerticalContentAlignment="Center" 
                         FontSize="12" Background="White" BorderBrush="#7F9DB9" BorderThickness="1"/>

                <!-- Mật khẩu -->
                <TextBlock Text="Mật khẩu:" Grid.Row="1" Grid.Column="0" 
                           VerticalAlignment="Center" FontWeight="Bold" FontSize="12" 
                           Foreground="Black" Margin="0,0,4,8"/>
                <PasswordBox x:Name="txtPassword" Grid.Row="1" Grid.Column="1" 
                             Height="24" Margin="0,0,0,8" VerticalContentAlignment="Center" 
                             FontSize="12" Background="White" BorderBrush="#7F9DB9" BorderThickness="1"/>

                <!-- Checkboxes -->
                <CheckBox x:Name="chkRemember" Content="Ghi nhớ mật khẩu" 
                          Grid.Row="2" Grid.Column="1" Margin="0,2,0,5" 
                          FontSize="12" Foreground="Black" IsChecked="True"/>
                <CheckBox x:Name="chkAutoLogin" Content="Tự động đăng nhập" 
                          Grid.Row="3" Grid.Column="1" Margin="0,2,0,4" 
                          FontSize="12" Foreground="Black" IsChecked="True"/>
            </Grid>
        </Grid>

        <!-- Horizontal Divider Line -->
        <Border Grid.Row="2" Height="1" Background="#A2B7D4" Margin="14,2,14,6"/>

        <!-- Bottom Buttons -->
        <Grid Grid.Row="3" Margin="0,0,16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="btnLogin" Content="Đăng nhập" Width="82" Height="26" 
                        Margin="0,0,10,0" IsDefault="True" Click="BtnLogin_Click"/>
                <Button x:Name="btnCancel" Content="Hủy bỏ" Width="82" Height="26" 
                        IsCancel="True" Click="BtnCancel_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
