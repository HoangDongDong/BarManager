<Window x:Class="QuanLyBar.Client.DataManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dữ liệu chương trình" Height="450" Width="750" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Title -->
        <TextBlock Grid.Row="0" Text="Tạo dữ liệu mới hoặc mở dữ liệu đã có" 
                   FontSize="20" FontWeight="Bold" Margin="20,15,20,10" Foreground="#1a3a5c"/>

        <!-- Options Panel -->
        <StackPanel Grid.Row="1" Margin="20,0,20,10">
            <!-- Radio: Tạo dữ liệu trắng -->
            <RadioButton x:Name="rbCreateNew" GroupName="DataAction" Margin="0,0,0,8" Checked="RbCreateNew_Checked">
                <TextBlock TextWrapping="Wrap">
                    <Run Text="Tạo dữ liệu trắng" FontWeight="Bold"/>
                    <Run Text=" (khi bạn muốn tạo dữ liệu để sử dụng cho riêng bạn)"/>
                </TextBlock>
            </RadioButton>

            <!-- Radio: Mở lại dữ liệu -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <RadioButton x:Name="rbOpenExisting" GroupName="DataAction" Grid.Column="0" IsChecked="True" Margin="0,0,0,0">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="Mở lại dữ liệu demo hoặc dữ liệu đã mở" FontWeight="Bold"/>
                        <Run Text=" (nhấy đúp để chọn)"/>
                    </TextBlock>
                </RadioButton>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnOpenFile" Content="📂 Mở file" Margin="5,0" Padding="8,4" Background="White" 
                            BorderBrush="#cccccc" Click="BtnOpenFile_Click" Cursor="Hand"/>
                    <Button x:Name="btnEdit" Content="✏️ Sửa" Margin="5,0" Padding="8,4" Background="White" 
                            BorderBrush="#cccccc" Click="BtnEdit_Click" Cursor="Hand"/>
                    <Button x:Name="btnDelete" Content="❌ Xóa" Margin="5,0" Padding="8,4" Background="White" 
                            BorderBrush="#cccccc" Foreground="Red" Click="BtnDelete_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Database List -->
        <Border Grid.Row="2" Margin="20,5,20,10" BorderBrush="#cccccc" BorderThickness="1">
            <DataGrid x:Name="dgDatabases" AutoGenerateColumns="False" 
                      IsReadOnly="True" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" BorderThickness="0"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      MouseDoubleClick="DgDatabases_MouseDoubleClick"
                      Background="White" RowBackground="White" AlternatingRowBackground="#F8F8F8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tên CSDL" Binding="{Binding Name}" Width="150"/>
                    <DataGridTextColumn Header="Đường dẫn" Binding="{Binding Path}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Bottom: Checkbox -->
        <StackPanel Grid.Row="3" Margin="20,0,20,15">
            <CheckBox x:Name="chkDontShow" Content="Không hiển thị lần sau" IsChecked="True"/>
        </StackPanel>
    </Grid>
</Window>
